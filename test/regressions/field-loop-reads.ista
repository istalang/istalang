# outcome: 0
# A field loop's variable read in one pass only still holds every pass's field (§4): what it holds
# in the lease's pass, which never reads it, is counted, and disposed once the loop is done with it.

import * as log from 'log'

shared struct Lease { id: Int }

fn dispose(self: Lease): log.info("disposed " + String(self->id))

struct Pair { a: Int, b: Lease }

fn walk(pair: Pair):
  for key, value in ...pair:
    if key == "a":
      log.info("int " + String(value))
    else:
      log.info("other " + key)

live async fn main() -> Int:
  walk(Pair{a: 1, b: new Lease{id: 7}})
  log.info("after walk")
  0
