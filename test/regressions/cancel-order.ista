# outcome: "won 4, cancelled, other got 7"
# A wait's losing case is cancelled as its waiter stops at the `select`, every case known (§8): a
# later resolve of it does nothing, and its `onCancel` callback runs right after the waiter, before
# an execution readied after (§6).

import * as time from 'time'

struct Cold { value: Int }

live fn onAwait(self: Cold, done: Resolver<Int, "live">):
  done.resolve(self.value)

struct Keep:
  events: Shared<Array<String>>
  kept: Shared<Array<Resolver<Int, "live">>>

live fn onAwait(self: Keep, done: Resolver<Int, "live">):
  const events = self.events
  fn cancelled(): events->value.push("cancelled")
  done.onCancel(cancelled)
  self.kept->value.push(done)

live async fn settled() -> Int: 1

live async fn waiting(events: Shared<Array<String>>, gate: Shared<Array<Resolver<Int, "live">>>):
  const got = await Keep{events, kept: gate}
  events->value.push("other got " + String(got))

live async fn resolving(
  gate: Shared<Array<Resolver<Int, "live">>>
  kept: Shared<Array<Resolver<Int, "live">>>
):
  _ = await settled()
  gate->value[0].resolve(7)
  kept->value[0].resolve(99)
  kept->value[0].resolve(100)

live async fn main() -> String:
  const events: Shared<Array<String>> = new Shared{value: []}
  const gate: Shared<Array<Resolver<Int, "live">>> = new Shared:
    value: []
  const kept: Shared<Array<Resolver<Int, "live">>> = new Shared:
    value: []
  _ = waiting(events, gate)
  _ = resolving(gate, kept)
  const cold = Cold{value: 4}
  const keep = Keep{events, kept}
  const won = await select:
    case cold as value: value
    case keep as value: value
  events->value.push("won " + String(won))
  await time.delay(1ms)
  events->value.join(", ")
