# outcome: 42
# As a run finishes, it lets go of everything it still holds, once its outcome is encoded (§3.12,
# §7): the outcome itself, a call still suspended, which stops, and what a readied callback was to
# be called with, each disposed then.

import * as log from 'log'
import * as time from 'time'

shared struct Lease:
  name: String

fn dispose(self: Lease):
  log.info("disposed " + self->name)

live async fn sleeper(lease: Lease):
  await time.delay(1h)
  log.info("woke " + lease->name)

live async fn main() -> Int:
  _ = sleeper(new Lease{name: "sleeper's"})
  hold _ = sleeper(new Lease{name: "held sleeper's"})
  const called = Resolver.of(fn(lease: Lease): log.info("called with " + lease->name))
  called.resolve(new Lease{name: "callback's"})
  log.info("returning")
  42
