# outcome: 19
# A `Resolver.of` is cancelled once one of the futures it is registered on is disposed (§6): its
# `onCancel` runs once, and the surviving future's value later reaches no callback.

import * as futures from 'futures'
import * as runtime from 'runtime'
import * as time from 'time'

shared struct Seen:
  value: Int
K fn see<K in Persistence>(seen: Seen, value: Int): seen->value = value
ista async fn later(value: Int) -> Int:
  await runtime.commit()
  value
shared struct Kept:
  resolver: Resolver<Int, "ista">? = none
struct Watched:
  seen: Seen
  kept: Kept
  type Mode = "ista"
ista fn onAwait(self: Watched, done: Resolver<Int, "ista">):
  const seen = self.seen
  done.onCancel(fn(): see(seen, -1))
  self.kept->resolver = done
  later(1).onAwait(done)
live async fn main() -> Int: await runtime.run(runtime.id()) _main()
ista async fn _main() -> Int:
  const seen = new Seen{value: 0}
  const kept = later(2)
  if true:
    const watching = Resolver.of(fn(value: Int): see(seen, value * 100))
    watching.onCancel(fn(): see(seen, seen->value - 1))
    const dropped = later(1)
    kept.onAwait(watching)
    dropped.onAwait(watching)
  await runtime.commit()
  const got = await kept
  await runtime.commit()
  got * 10 + seen->value
