# outcome: "draft|0"
# Through `&` a place has its type exactly (§3.7), so a literal member meets a trait taking `&Self`
# only with a function declared on the literal itself, which gets a place holding its one value.

trait Clearable { fn clear(self: &Self) }
fn clear(self: &"draft"):
  self = "draft"
fn clear(self: &Int):
  self = 0

async fn main() -> String:
  let x: "draft" | Int = "draft"
  x.clear()
  let y: "draft" | Int = 5
  y.clear()
  `${x}|${y}`
