# Member parameters (§8.1) take one member of their union, and type arguments in a pattern pick a
# member of a union only (§11.3).

type Status = "draft" | "sent" | "failed"
struct Box<T> { value: T }

fn describe<S in Status>(s: S) -> String: s

fn several(status: Status) -> String: describe(status)

fn outside() -> String: describe("archived")

fn constrained<S in Status is Sendable>(s: S) -> String: s

fn notUnion(b: Box<Int>) -> Int:
  match b:
    case Box<Int>{value}: value

fn target(b: Box<Int>) -> Int:
  const Box<Int>{value} = b
  value

fn arity(x: Box<Int> | Box<String>) -> Int:
  match x:
    case Box<Int, Int>{value}: 1
    case _: 0

fn selfMember<S in S>(s: S) -> String: s

fn mutualMembers<A in B, B in A>(a: A) -> Int: 0
