import * as json from 'json'

type Status = "draft" | "sent" | "failed"
type Endless = Int | Endless

struct Email { to: String }
struct Sms { number: String }
type Contact = Email | Sms

fn clashUnion(x: Int) -> Int: x
fn clashUnion(x: Int | String) -> Int: 0

fn clashLitBase(x: "a") -> Int: 1
fn clashLitBase(x: String) -> Int: 2

fn clashLitUnion(x: "a") -> Int: 1
fn clashLitUnion(x: "a" | "b") -> Int: 2

fn over(x: Int) -> Int: x
fn over(x: String) -> Int: x.length()

fn needDefault<T is Default>() -> T: T.default()
fn needComparable<T is Comparable>(a: T, b: T) -> Int: compare(a, b)
fn needSendable<T is Sendable>(x: T): ()
fn makeMustUse(x: Result<Int> | Int) -> Result<Int> | Int: x
fn describeStatus<S in Status>(s: S) -> String: s

fn badUses(c: Contact, u: Int | String, s: Status, nonSend: Int | Slot<Int>, must: Result<Int> | Int):
  _ = c.to
  _ = u + 1
  _ = over(u)
  _ = needDefault<Int | String>()
  _ = needComparable(u, u)
  needSendable(nonSend)
  makeMustUse(must)
