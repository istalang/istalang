# Conversions into a union (§2, §4): inside a value type as its variance allows (§3.5), never inside
# a handle or through &, never from a base type into a literal type, never into several members,
# never inferred unprompted for branches or arrays, and ? refuses an error not in the union.
type Status = "draft" | "sent"
struct NotFound { id: String }
struct Timeout { ms: Int }
struct Denied { role: String }

ista fn takeSlots(xs: Slot<Int | String>) -> Int: 0
fn takeRef(r: &(Int | String)): ()
fn takeAmbiguous(x: (Int,) | (any Stringable)) -> Int: 0
fn onlyOpt<T>(x: T?) -> T: x!

ista fn bad(xs: Slot<Int>, name: String, c: Bool):
  let n = 1
  const u: Int | String = true
  _ = takeSlots(xs)
  takeRef(&n)
  const s1: Status = name
  const s2: Status = "other"
  const uninferredIf = if c: 1 else: "a"
  const uninferredArr = [1, "a"]
  _ = onlyOpt(none)
  _ = takeAmbiguous(42)
  _ = (u, s1, s2, uninferredIf, uninferredArr)

fn badPropagate(r: Result<Int, Denied>) -> Result<Int, NotFound | Timeout>:
  Ok(r?)
