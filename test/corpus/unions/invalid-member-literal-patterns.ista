# error: 5001 at 8:10
# error: 5016 at 12:3
# A literal no member of a member parameter's union equals is a mistake (§3.5, §3.11), as against
# the union itself.

fn typo<K in "a" | "b">(k: K) -> String:
  match k:
    case "c": "C"
    case _: "other"

fn typoEquals<K in "a" | "b">(k: K) -> Bool:
  k == "c"
