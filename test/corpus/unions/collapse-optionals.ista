# outcome: "true|true|5|true|true|true|true|true|1"
# An optional an instantiation collapses (§2, §3.5): `T?` with `T = None` is `None`, whose one value
# is `none`, so `??` and a chain read it as absent and natives give it back as it is; and `T?` with
# `T = Int?` is `Int?`, which a chain ending in a `T` never wraps again.

struct Box<T> { value: T }

fn coalesce<T>(x: T?, y: T?) -> T?: x ?? y
fn get<T>(b: Box<T>?) -> T?: b?.value

async fn main() -> String:
  let xs: Array<None> = [none, none]
  const m: Map<String, None> = ["k": none]
  const p1 = `${coalesce<None>(none, none) == none}|${get<None>(Box{value: none}) == none}`
  const p2 = `${coalesce<Int?>(none, 5) ?? 0}|${get<None>(none) == none}`
  const p3 = `${xs.at(0) == none}|${xs.pop() == none}|${m.get("k") == none}`
  const p4 = `${get<Int?>(Box<Int?>{value: none}) == none}|${get<Int?>(Box<Int?>{value: 1}) ?? 0}`
  `${p1}|${p2}|${p3}|${p4}`
