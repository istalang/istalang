# outcome: "true|true|true|true|true|false|true|true|2|mail|three"
# `==` on unions (§6): either side fits the other's type, a literal's value compares as its base, and
# values of a union compare their members' types, then the values, so a union is a map key.

type Status = "draft" | "sent"
struct Email { to: String }
async fn main() -> Future<String>:
  const s: Status = "sent"
  const name = "sent"
  const a: Int | String = 1
  const b: Int | String | None = none
  const e: Email | Int = Email{to: "x"}
  const m: Map<Status, Int> = ["draft": 1, "sent": 2]
  const k: Map<Email | Int, String> = [e: "mail", 3: "three"]
  `${s == name}|${name == s}|${s != "draft"}|${a == 1}|${1 == a}|${a == "1"}|${b == none}|${e == Email{to: "x"}}|${m[s]}|${k[Email{to: "x"}]}|${k[3]}`
