type Spot = { y: Int, x: Int }
fn Point.origin() -> Point: Point{x: 0, y: 0}
fn Spot.origin() -> Spot: Spot{x: 1, y: 1}
struct Pixel { x: Int }
type Px = Pixel
fn Pixel.make() -> Pixel: Pixel{x: 0}
fn Px.make() -> Pixel: Pixel{x: 1}
