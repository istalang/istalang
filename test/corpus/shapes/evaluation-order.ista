# outcome: "1 2 3 4 | 3 4 2 1"
# Declaration order matters only to evaluation (§3.1): a shape keeps its fields in name order, but
# a literal evaluates its values as written, whichever order the shape or struct lists its fields,
# and a struct's value converted into its shape keeps each value with its field's name.

struct Late { z: Int; a: Int }

fn next(counter: &Int) -> Int:
  counter += 1
  counter

fn keys(p: { a: Int; z: Int }) -> String:
  "" + p.a + " " + p.z

async fn main():
  let count = 0
  const shape = struct{z: next(&count), a: next(&count)}
  const late = Late{a: next(&count), z: next(&count)}
  "" + shape.z + " " + shape.a + " " + late.a + " " + late.z + " | " + keys(late) + " " + keys(shape)
