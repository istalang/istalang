# outcome: "25 7 | 3 4 | first 5 | 2 | 9 | 2 1"
# A nominal struct's value fits where its equal shape is expected, copied as the shape (§3.1): its
# fields, with its type arguments substituted, are the shape, in any order, at run time and at
# compile time alike. Taking an argument as it is beats converting it (§3.7), and inference sees
# the struct's fields where a shape is expected (§3.5). The wrap into `T?` follows the conversion.

import * as runtime from 'runtime'

type Point = { x: Int, y: Int }

struct Pixel { y: Int, x: Int }

struct Boxed<T> { value: T }

const corner: Point = Pixel{y: 1, x: 2}

fn norm(p: Point) -> Int: p.x * p.x + p.y * p.y

fn sum(p: { y: Int, x: Int }) -> Int: p.x + p.y

fn pick(p: Pixel) -> String: "first"

fn pick(p: Point) -> String: "second"

fn twice<T>(p: { x: T, y: T }) -> (T, T): (p.x, p.y)

fn unwrap(b: { value: Int }) -> Int: b.value

fn maybe(p: Point?) -> Int: p?.x ?? 0

live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  const pixel = Pixel{x: 3, y: 4}
  const point: Point = pixel
  const pair = twice(pixel)
  "" + norm(pixel) + " " + sum(pixel) + " | " + point.x + " " + point.y + " | " + pick(pixel) + " " + (pair.0 + pair.1 - 2) + " | " + unwrap(Boxed{value: 2}) + " | " + (maybe(pixel) + 6) + " | " + corner.x + " " + corner.y
