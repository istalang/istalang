# outcome: "p3p3 45 12"
# A struct's value converts into the shape `*x` is (§3.1, §3.18): spread into `new`, or written to
# `*x`; a function value takes it as a declared function does, and so does a literal's spread.

import * as runtime from 'runtime'

shared struct Lease { name: String, renewals: Int = 0 }

struct Plain { renewals: Int, name: String }

type Pt = { x: Int, y: Int }
struct Px { y: Int, x: Int }

fn norm(p: Pt) -> Int: p.x * 10 + p.y

live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  const plain = Plain{name: "p", renewals: 3}
  const lease = new Lease{...plain}
  const other = new Lease{name: "o"}
  *other = plain
  const g: fn(Pt) -> Int = norm
  const s: Pt = struct{...Px{x: 1, y: 2}}
  lease->name + lease->renewals + other->name + other->renewals + " " + g(Px{x: 4, y: 5}) + " " + s.x + s.y
