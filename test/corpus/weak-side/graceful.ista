# outcome: "job 1, pass, job 2, pass, flushed 2, pass, cleaned up | done"
# Graceful disposal (§7): when the last holder of a call lets go of it, a call waiting on its own
# `disposing()` resumes there at once, within the disposal, and cleans up; its next `await`, here
# the loop's next `select`, stops it. A call waiting on anything else is stopped where it waits.

import Inbox from 'inbox'
import * as time from 'time'
import * as runtime from 'runtime'

fn note(log: Shared<Array<String>>, entry: String):
  log->value = [...log->value, entry]

ista async fn worker(jobs: Inbox<Int>, acks: Inbox<Int>, log: Shared<Array<String>>) -> Unit:
  let handled = 0
  while true:
    await select:
      case jobs.receive() as job:
        handled += 1
        note(log, "job " + String(job))
        acks.send(job)
      case worker.disposing():
        note(log, "flushed " + String(handled))
    note(log, "pass")
  ()

ista async fn idle(log: Shared<Array<String>>) -> Unit:
  await time.delay(1d)
  note(log, "never: idle was stopped")

live async fn main() -> String: await runtime.run(runtime.id()) _main()
ista async fn _main() -> String:
  const empty: Array<String> = []
  const log = new Shared{value: empty}
  const jobs = Inbox.create<Int>()
  const acks = Inbox.create<Int>()
  {
    const running = worker(jobs, acks, log)
    const waiting = idle(log)
    jobs.send(1)
    jobs.send(2)
    const first = await acks.receive()
    const second = await acks.receive()
  }
  note(log, "cleaned up")
  log->value.join(", ") + " | done"
