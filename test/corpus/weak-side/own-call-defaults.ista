# outcome: 1
# An async fn's own call is its body's (§16): a parameter's default runs in the function's prologue,
# before its body starts, so it reads no call, while the body still does.

import * as runtime from 'runtime'

ista async fn worker(n: Int = 1) -> Int:
  _ = worker.disposing()
  n

live async fn main() -> Int:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Int: await worker()
