# outcome: "same true, other false, held true, signalled false | worked 2, watcher pending true"
# Weak references and an async call's own `disposing()` (§7), short of disposing anything:
# `WeakRef(x)` is the one weak reference to `x`, so two are `==` exactly when they refer to the
# same value; while `x` is held, `deref()` gives it and `disposed()` hasn't resolved. A call that
# returns is never disposed: a watch on it, even taken by a closure that outlives the call, never
# resolves.

import * as runtime from 'runtime'
import * as time from 'time'

ista fn resolved(signal: Future<Unit, "ista">) -> Bool:
  select:
    case signal: true
    else: false

ista async fn worker(n: Int) -> Int:
  ista fn watch() -> Future<Unit, "ista">: worker.disposing()
  await select:
    case watch(): 0
    case time.delay(1ms): n + 1

ista async fn watcher() -> ista fn() -> Future<Unit, "ista">:
  fn() -> Future<Unit, "ista">: watcher.disposing()

live async fn main() -> String:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> String:
  const slot = Slot.create<Int>()
  const other = Slot.create<Int>()
  const weak = WeakRef(slot)
  const same = weak == WeakRef(slot)
  const differs = weak == WeakRef(other)
  const held = weak.deref() != none
  const signalled = resolved(weak.disposed())
  const worked = await worker(1)
  const late = await watcher()
  const pending = not resolved(late())
  const refs = "same " + String(same) + ", other " + String(differs)
  const states = "held " + String(held) + ", signalled " + String(signalled)
  refs + ", " + states + " | worked " + String(worked) + ", watcher pending " + String(pending)
