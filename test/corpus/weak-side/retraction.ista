# outcome: "sale | after: durable, then nothing | alone: nothing | b: later"
# Revertible sends (§15.3, as §20.3 uses them): `announce` keeps each holder with `hold _`, so when it
# returns every unread copy is retracted, whether it waited in the backlog (`a`, behind a durable
# message) or already in the inbox's slot (`alone`). A copy received in time (`b`) is final, and
# retracting it leaves `b` taking later messages as before.

import * as runtime from 'runtime'
import * as time from 'time'
import Inbox from 'inbox'

ista async fn announce(boxes: Array<Inbox<String>>, text: String, visibleFor: time.Duration):
  for box in boxes: hold _ = box.sendRevertible(text)
  await time.delay(visibleFor)

ista fn next(box: Inbox<String>) -> String:
  select:
    case box.receive() as message: message
    else: "nothing"

live async fn main() -> String:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> String:
  const a = Inbox.create<String>()
  const b = Inbox.create<String>()
  const alone = Inbox.create<String>()
  a.send("durable")
  const announcing = announce([a, b, alone], "sale", 5ms)
  const got = await b.receive()
  await announcing
  const after = next(a) + ", then " + next(a)
  b.send("later")
  got + " | after: " + after + " | alone: " + next(alone) + " | b: " + next(b)
