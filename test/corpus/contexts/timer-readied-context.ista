# outcome: "context"
# Executions that become ready together run in the order they were created (§6): a context's child
# and the live run wait for one instant, and the context, readied by that instant's timers, answers
# before the live run decides what waited on both.

import * as runtime from 'runtime'
import * as time from 'time'

ista async fn child(due: time.Time) -> Int:
  await time.at(due)
  1

ista async fn parent(due: time.Time) -> String:
  drop await (spawn child(due)).result()
  "context"

live async fn main() -> String:
  const due = time.now() + 5ms
  const rt = await runtime.Runtime.open(runtime.hostStore())
  const call = rt.call("o/1") parent(due)
  await select:
    case call as answer:
      drop answer
      "context"
    case time.at(due): "timer"
