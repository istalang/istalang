# outcome: true
# A `Runtime` is disposable (§17.1), so a weak reference can watch it: one the live run holds derefs to
# itself.

import * as runtime from 'runtime'

live fn watch(rt: runtime.Runtime) -> WeakRef<runtime.Runtime>:
  WeakRef(rt)

live async fn main() -> Bool:
  const rt = await runtime.Runtime.open(runtime.hostStore())
  watch(rt).deref() == rt
