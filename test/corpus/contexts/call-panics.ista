# outcome: 18
# A context call whose code panics answers with `Err` of the panic (§9): its message,
# "no refunds for o/1", is 18 long.

import * as runtime from 'runtime'
import * as time from 'time'

struct Order { id: String, amount: Int }

ista async fn purchase(order: Order) -> Int:
  await time.delay(1s)
  await runtime.commit()
  order.amount * 2

ista async fn refund(order: Order) -> Int:
  panic("no refunds for " + order.id)

live async fn main() -> Int:
  const rt = await runtime.Runtime.open(runtime.hostStore())
  match await rt.call("o1") refund(Order{id: "o/1", amount: 1}):
    case Ok(value): value
    case Err(error): error.message.length()
