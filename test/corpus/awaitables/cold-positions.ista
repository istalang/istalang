# outcome: 12
# A wait holds the futures its `Resolver.at` ones are registered on (§16): the calls `onAwait` starts
# through positions run on, the first to resolve deciding at its position (§15.2).

import * as futures from 'futures'
import * as runtime from 'runtime'
import * as time from 'time'

ista async fn later(value: Int) -> Int:
  await runtime.commit()
  value

struct Earliest { type Mode = "ista" }
ista fn onAwait(self: Earliest, done: Resolver<(Int, Int), "ista">):
  later(2).onAwait(Resolver.at(done, 1))
  later(1).onAwait(Resolver.at(done, 0))

live async fn main() -> Int:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Int:
  const (position, value) = await Earliest
  position * 10 + value
