# panic: A resolver was let go of unresolved, so the wait it was to decide never can. An awaitable keeps the work it starts alive by registering its resolver, or a Resolver.at of it, on that work; to map a value, await it in an async fn.
# A wait's resolver let go of unresolved, never registered, panics the wait it was to resume (§6,
# §7): nothing can decide it any more.

import * as runtime from 'runtime'

shared struct Took:
  first: Bool
  second: Bool

struct Twice:
  took: Took
  type Mode = "ista"

ista fn onAwait(self: Twice, done: Resolver<Int, "ista">):
  _ = self.took

live async fn main() -> Int: await runtime.run(runtime.id()) _main()

ista async fn _main() -> Int:
  const took = new Took{first: false, second: false}
  const got = await Twice{took: took}
  got * 100 + (if took->first: 10 else: 0) + (if took->second: 1 else: 0)
