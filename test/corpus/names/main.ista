# Every way a name is declared and used, across two modules, with no name errors.

import helper, Shape from 'names/lib'
import * as lib from 'names/lib'

const limit: Int = 50_000

extern approvalLimit: Int
extern fn chargeCard(id: String, amount: Int) -> Result<String>
extern sendable struct Queue<T is Sendable>
extern live async fn receive<T is Sendable>(self: Queue<T>) -> T

struct Note { text: String }

struct Pair<A, B>:
  first: A
  second: B @Note{"kept for the formatter"}
  meta:
    tag: String

struct Money { cents: Int }

enum Verdict:
  Approved(by: String)
  Rejected(by: String, reason: String)
  Expired

trait Zero:
  fn Self.zero() -> Self

type Entries<T> = Array<(String, T)>

fn Money.zero() -> Money:
  Money{cents: 0}

fn add(left: Money, right: Money) -> Money:
  Money{cents: left.cents + right.cents}

fn read(self: Note) -> String:
  self.text

fn sum<T is Zero & Addable>(xs: Array<T>) -> T:
  let acc = T.zero()
  for x in xs:
    acc = acc + x
  acc

fn swap<A, B>(p: Pair<A, B>) -> Pair<B, A>:
  Pair{first: p.second, second: p.first, meta: struct{tag: p.meta.tag}}

fn window(start: Int, end: Int = start + 10) -> Int:
  end - start

@Note{"matches every verdict"}
fn describe(v: Verdict) -> String:
  match v:
    case Approved(by):
      "approved by " + by
    case Rejected(by, why) if why != "":
      by + ": " + why
    case Verdict.Expired:
      "expired"
    case _:
      "unknown"

fn positives(results: Array<Result<Int>>) -> Array<Int>:
  [for r in results if r is Ok(value) and value > 0: value]

fn counter(start: Int) -> fn() -> Int:
  let count = start
  fn next() -> Int:
    count += 1
    count
  next

fn countdown(n: Int) -> Int:
  fn loop(left: Int) -> Int: if left > 0: loop(left - 1) else: 0
  loop(n)

fn factorial() -> Int:
  const fact = fn f(n: Int) -> Int: if n < 2: 1 else: n * f(n - 1)
  fact(5)

fn pairs(p: (Int, Int)) -> Int:
  const a, b = p
  match p:
    case (x, _) if x > a:
      x + b
    case _:
      0

fn note(n: Int) -> Int:
  n

ista async fn watch(box: Queue<Int>, stop: Future<Unit, "ista">) -> Int:
  let seen = 0
  _ = defer(fn(): note(seen))
  while seen < limit:
    const got = await select:
      case box.receive() as message:
        message
      case stop:
        return seen
    seen += got
  seen

fn uses() -> Entries<Int>:
  const zero = Money.zero()
  const money = zero + Money{cents: approvalLimit}
  const shape: Shape = lib.circle()
  drop helper(shape)
  const verdict: Verdict = Expired
  const first = 1
  const short = Pair{first, second: "y", meta: struct{tag: "u"}}
  const optional: Int? = none
  _ = chargeCard("id", limit)
  drop [money, zero]
  drop [verdict, describe(verdict)]
  [(short.second, optional ?? first)]
