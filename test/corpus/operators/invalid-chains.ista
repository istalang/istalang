# Each link of a chain is checked as its comparison alone would be; `in`
# needs an `includes` taking the container and the item (§3.9). An operand between two links is
# compared on both sides, so it isn't wrapped into an optional for one.

fn f(x: int, y: int, flag: bool, maybe: int?) -> bool:
  _ = 1 < "a" < 2
  _ = x < y == flag
  _ = maybe == x < y
  1 in 5
