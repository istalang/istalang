# outcome: "iter 0, iter 1, iter 2, while, d-early, r=5, stopped 1, v=3, stopped 7, timer, after select"
# Every way out of a block releases what it holds (§3.4, §7): `break` and `return` run the defers
# of each block they leave, innermost first, and a variable an async call held when `return` left
# its block is released there, before the caller sees the result. A select's loser is disposed
# before the winner's body runs.

import * as time from 'time'
import * as runtime from 'runtime'

fn note(log: Shared<Array<String>>, text: String):
  log->value = [...log->value, text]

ista async fn sleeper(id: Int, log: Shared<Array<String>>):
  _ = defer(fn(): note(log, "stopped " + String(id)))
  await time.delay(1h)

ista fn early(log: Shared<Array<String>>, n: Int) -> Int:
  _ = defer(fn(): note(log, "d-early"))
  for i in 0..5:
    _ = defer(fn(): note(log, "iter " + String(i)))
    if i == n:
      break
  while true:
    _ = defer(fn(): note(log, "while"))
    if n > 0:
      return 5
  0

ista async fn viaReturn(log: Shared<Array<String>>) -> Int:
  const s = sleeper(1, log)
  if true:
    return 3
  4

ista async fn selecting(log: Shared<Array<String>>):
  await select:
    case time.delay(1ms):
      note(log, "timer")
    case sleeper(7, log):
      note(log, "never")
  note(log, "after select")

live async fn main() -> String: await runtime.run(runtime.id()) _main()
ista async fn _main() -> String:
  const empty: Array<String> = []
  const log = new Shared{value: empty}
  const r = early(log, 2)
  note(log, "r=" + String(r))
  const v = await viaReturn(log)
  note(log, "v=" + String(v))
  await selecting(log)
  log->value.join(", ")
