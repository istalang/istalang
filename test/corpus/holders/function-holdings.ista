# outcome: "stopped 1, reassigned, block done, end a, stopped 5, stopped 4, stopped 3, stopped 2, stopped 8, body, arr, stopped 11, stopped 10, arr dropped, copy, m set, stopped 12, copy dropped, stopped 13"
# `hold let`, `hold const` and `hold _` keep what they hold when their block ends, until the
# function ends, where everything left is released newest first (§7.1, §16); a value a `hold let`
# lost to an assignment is released at that assignment. A header's temporaries end before the body, dropping an array
# releases its elements newest first, and a value another holder still reaches (a copy out of a
# `Shared`) survives being overwritten there until the copy goes.

import * as runtime from 'runtime'
import * as time from 'time'

fn note(log: Shared<Array<String>>, text: String):
  log->value = [...log->value, text]

ista async fn sleeper(id: Int, log: Shared<Array<String>>):
  _ = defer(fn(): note(log, "stopped " + String(id)))
  await time.delay(1h)

ista async fn a(log: Shared<Array<String>>):
  hold let h = sleeper(1, log)
  h = sleeper(2, log)
  note(log, "reassigned")
  if true: hold const k = sleeper(3, log)
  note(log, "block done")
  hold _ = sleeper(4, log)
  _ = sleeper(5, log)
  note(log, "end a")

ista async fn withHeader(log: Shared<Array<String>>):
  if sleeper(8, log) is _: note(log, "body")
  const arr = [sleeper(10, log), sleeper(11, log)]
  note(log, "arr")
  drop arr
  note(log, "arr dropped")
  const m = new Shared{value: sleeper(12, log)}
  const copy = m->value
  note(log, "copy")
  m->value = sleeper(13, log)
  note(log, "m set")
  drop copy
  note(log, "copy dropped")

live async fn main() -> String:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> String:
  const empty: Array<String> = []
  const log = new Shared{value: empty}
  await a(log)
  await withHeader(log)
  log->value.join(", ")
