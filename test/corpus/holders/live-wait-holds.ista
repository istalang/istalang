# outcome: "giver after resolve, disposed, after the await"
# A decided wait holds the value deciding it until its waiter moves on (§7): the lease its giver let
# go of is disposed only once `main` resumes past its `await` and drops it, not as the giver goes on.

import * as time from 'time'

fn note(log: Shared<Array<String>>, text: String):
  log->value.push(text)

shared struct Lease:
  log: Shared<Array<String>>

fn dispose(self: Lease): note(self->log, "disposed")

struct Given:
  lease: Lease

struct Box:
  waiting: Shared<Array<Resolver<Given, "live">>>

live fn onAwait(self: Box, done: Resolver<Given, "live">): self.waiting->value.push(done)

live async fn giver(box: Box, log: Shared<Array<String>>):
  await time.delay(1ms)
  box.waiting->value[0].resolve(Given{lease: new Lease{log}})
  note(log, "giver after resolve")

live async fn main() -> String:
  const empty: Array<String> = []
  const log = new Shared{value: empty}
  const pending: Array<Resolver<Given, "live">> = []
  const box = Box{waiting: new Shared{value: pending}}
  const giving = giver(box, log)
  const given = await box
  drop given
  note(log, "after the await")
  await giving
  log->value.join(", ")
