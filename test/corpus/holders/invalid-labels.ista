#
# A label names one loop or block of its function (§3.4, §4): `break` and `continue` name loops
# only, `hold(name)` a loop, a block or the function itself, a label may not repeat one around it
# nor take the function's name, a block's label means nothing after the block, and no name
# crosses into a nested function.

fn labels(xs: Array<Int>):
  for x in xs: break missing
  batch:
    for x in xs: continue batch
  for x in xs:
    hold(nowhere) _ = x
  outer: for x in xs:
    outer: for y in xs: break outer
    break outer
  labels: for x in xs: break labels
  hold(batch) _ = 1
  around: for x in xs:
    fn inner():
      for y in xs: break around
    break around
