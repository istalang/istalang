# outcome: "in case, stopped 1, after match, in if, stopped 2, after if, pass, stopped 3, pass, stopped 4, after while"
# A pattern's bindings belong to the scope they are visible in (§3.11, §7): a `match` case's end
# with its body, an `is` binding's with the body of its `if` or `while`, on every pass. A header's
# temporaries, such as the subject a call made, end before the body, so once a binding ends,
# nothing holds what it held, and it is disposed there.

import * as time from 'time'

fn note(log: Shared<Array<String>>, text: String):
  log->value = [...log->value, text]

ista async fn sleeper(id: Int, log: Shared<Array<String>>):
  _ = defer(fn(): note(log, "stopped " + String(id)))
  await time.delay(1h)

fn maybe(id: Int, log: Shared<Array<String>>) -> Future<Unit, "ista">?:
  sleeper(id, log)

ista async fn bindings(log: Shared<Array<String>>):
  match maybe(1, log):
    case Future as value:
      note(log, "in case")
    case None:
      note(log, "none")
  note(log, "after match")
  if maybe(2, log) is Future as value:
    note(log, "in if")
  note(log, "after if")
  let id = 3
  while id < 5 and maybe(id, log) is Future as value:
    note(log, "pass")
    id += 1
  note(log, "after while")

async fn main() -> String:
  const empty: Array<String> = []
  const log = new Shared{value: empty}
  await bindings(log)
  log->value.join(", ")
