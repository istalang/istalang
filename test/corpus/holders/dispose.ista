# outcome: "inner kept, disposed outer, disposed inner, after nesting"
# A `dispose` declared beside a shared struct makes it disposable (§7, §3.18): it runs as code,
# with the handle, when nothing holds it any more. A value held by another one being disposed
# loses its last holder only once that disposal is done, so a lease is disposed after the lease
# holding it, however old it is.

shared struct Lease:
  name: String
  log: Shared<Array<String>>
  partner: Lease? = none

fn dispose(self: Lease):
  note(self->log, "disposed " + self->name)

fn note(log: Shared<Array<String>>, text: String):
  log->value.push(text)

fn lease(name: String, log: Shared<Array<String>>) -> Lease:
  new Lease{name, log}

fn nesting(log: Shared<Array<String>>):
  const outer = lease("outer", log)
  const inner = lease("inner", log)
  outer->partner = inner
  drop inner
  note(log, "inner kept")
  drop outer
  note(log, "after nesting")

import * as runtime from 'runtime'
live async fn main() -> String: await runtime.run(runtime.id()) _main()
ista async fn _main() -> String:
  const empty: Array<String> = []
  const log = new Shared{value: empty}
  nesting(log)
  log->value.join(", ")
