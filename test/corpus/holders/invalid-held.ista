# A value holding a future, a Result or a disposable must be used, at any depth (§7): a declared
# struct holds its fields and an enum its variants' fields, as a tuple holds its elements, and a
# value of a type parameter constrained to be Disposable is disposable. A recursive type holding
# none of them may be discarded.

struct Pending { job: Future<Int> }

enum Outcome { Done{result: Result<Int>}; Idle }

struct Chain { value: Int; rest: Chain? }

async fn work() -> Future<Int>: 1

fn outcome() -> Outcome: Idle

fn chain() -> Chain: Chain{value: 1, rest: none}

fn keep<T is Disposable>(value: T) -> Int:
  value
  1

async fn main():
  Pending{job: work()}
  outcome()
  chain()
