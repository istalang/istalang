# error: 5720 at 14:3
# Two leases holding each other would be a cycle holding a disposable, which no count could ever
# dispose (§7): the second write closes it, so it is the error. Holding one side through a
# `WeakRef` breaks the cycle.

shared struct Lease { name: String, partner: Lease? = none }

fn dispose(self: Lease): ()

fn cycle():
  const a = new Lease{name: "a"}
  const b = new Lease{name: "b"}
  b->partner = a
  a->partner = b
