# `drop x` releases `x`, which no path may use afterwards (§7), unless a `let` is assigned again
# first: in a later statement, after a branch that dropped it, or in a loop's next pass. Only what
# the function holds itself can be dropped: not a capture, a reference parameter or a top-level
# constant. A disposable must be used, and `defer` takes a function of nothing returning unit.

const limit = 3

fn size(text: String) -> Int:
  text.length()

fn later() -> Int:
  const text = "a"
  drop text
  size(text)

fn branch(flag: Bool) -> Int:
  let text = "a"
  if flag:
    drop text
  const first = size(text)
  text = "b"
  first + size(text)

fn loop():
  const text = "a"
  for _ in 0..2:
    drop text

fn captured():
  const text = "a"
  const f = fn(): { drop text; () }

fn reference(text: &String):
  drop text

fn top():
  drop limit

fn unused():
  Slot.create<Int>()
  defer fn(): 1
