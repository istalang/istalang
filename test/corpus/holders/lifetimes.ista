# outcome: "started 0, stopped 0, started 1, stopped 1, loop done, stopped 10, overwritten, stopped 20, dropped, stopped 30, temporary, stopped 11, subscribed, stopped 60, unsubscribed, kept until return, stopped 41, stopped 40, returned"
# What a block's variables hold is released when the block ends (§3.4, §7), so each pass of a
# loop releases its own: an async call held by `_` in a loop body is disposed at the end of its
# pass, stopped at the await it waits at, and its defers run. Overwriting a variable releases the
# old value, `drop x` releases `x` at once, and a temporary ends with its statement. Setting a
# `Shared` holding the only handle to `none` releases it, as §7 stops a subscription. A `hold _`
# holding lasts until its function returns, across its awaits, and is disposed newest first then.

import * as time from 'time'

fn note(log: Shared<Array<String>>, text: String):
  log->value = [...log->value, text]

async fn sleeper(id: Int, log: Shared<Array<String>>):
  defer fn(): note(log, "stopped " + String(id))
  await time.delay(1h)
  note(log, "woke " + String(id))

async fn passes(log: Shared<Array<String>>):
  for i in 0..2:
    _ = sleeper(i, log)
    note(log, "started " + String(i))
  note(log, "loop done")

async fn released(log: Shared<Array<String>>):
  let held = sleeper(10, log)
  held = sleeper(11, log)
  note(log, "overwritten")
  const dropped = sleeper(20, log)
  drop dropped
  note(log, "dropped")
  drop sleeper(30, log)
  note(log, "temporary")
  drop held

async fn shared(log: Shared<Array<String>>):
  const sub = new Shared<Future<Unit>?>{value: sleeper(60, log)}
  note(log, "subscribed")
  sub->value = none
  note(log, "unsubscribed")

async fn kept(log: Shared<Array<String>>):
  for i in 0..2:
    hold _ = sleeper(40 + i, log)
  await time.delay(1ms)
  note(log, "kept until return")

async fn main() -> Future<String>:
  const empty: Array<String> = []
  const log = new Shared{value: empty}
  await passes(log)
  await released(log)
  await shared(log)
  await kept(log)
  note(log, "returned")
  log->value.join(", ")
