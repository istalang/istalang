# Only a value with an identity of its own can be disposable (§7): a shared struct (§3.18), or an
# extern type a host provides, never a plain struct, whose copies have none. A `dispose` is plain
# code that takes its value and returns unit, it is found beside the type it disposes, and its
# value can't escape it: `self` is used only as `*self`, through `->`, or passed to an extern. A
# `Shared` is the prelude's shared struct, so only the prelude could declare its `dispose`.

struct Plain { n: Int }

shared struct Lease { name: String }

shared struct Holder { lease: Lease }

fn dispose(self: Plain):
  ()

ista async fn dispose(self: Holder):
  ()

fn dispose(self: Lease):
  const copy = self
  const name = self->name
  const later = fn(): self->name

fn dispose(self: Shared<Lease>):
  ()
