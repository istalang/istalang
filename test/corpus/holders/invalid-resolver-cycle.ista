# error: 5720 at 13:5
# A resolver holds its callback, so an item holding a resolver whose callback holds the item is a
# cycle holding a disposable, which no count could ever dispose (§7): the write closing it is the
# error. Holding the item through a `WeakRef` in the callback breaks the cycle.

shared struct Item { id: Int, r: Resolver<Int, "ista">? }
ista fn dispose(self: Item): ()

ista fn pair():
  if true:
    const item = new Item{id: 2, r: none}
    const r = Resolver.of(fn(_: Int): { _ = item->id; () })
    item->r = r
