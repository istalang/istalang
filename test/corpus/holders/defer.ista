# outcome: "7: body, inner, ran 0, iteration 0, iteration 1, ran 2, iteration 2, returning, last 5, held 3, outer"
# `defer f(x)` gives a disposable calling `f(x)` when released, `x` computed now (§7): kept by `_`,
# when its block ends, however it ends, a loop body's at the end of each iteration, `continue`
# included; kept by `hold _`, when its function ends. Several released together run in reverse,
# last first, and what the function returns is computed before they run.

fn note(log: Shared<Array<String>>, text: String):
  log->value = [...log->value, text]

fn blocks(log: Shared<Array<String>>) -> Int:
  _ = defer note(log, "outer")
  let count = 3
  if true:
    hold _ = defer note(log, "held " + String(count))
    _ = defer note(log, "inner")
    note(log, "body")
  for i in 0..3:
    _ = defer note(log, "iteration " + String(i))
    if i == 1:
      continue
    note(log, "ran " + String(i))
  count = 5
  _ = defer note(log, "last " + String(count))
  note(log, "returning")
  7

async fn main() -> Future<String>:
  const empty: Array<String> = []
  const log = new Shared{value: empty}
  const result = blocks(log)
  String(result) + ": " + log->value.join(", ")
