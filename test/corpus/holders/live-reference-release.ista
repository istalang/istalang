# outcome: 1
# Writing through a reference lets go of what the place held at that write (§3.7, §7): the lease
# overwritten through `&` is disposed before the next statement runs, while the step still reads 1.

shared struct Lease { step: Shared<Int>, disposedAt: Shared<Int> }

fn dispose(self: Lease): self->disposedAt->value = self->step->value

fn clear(target: &Lease?, step: Shared<Int>):
  target = none
  step->value = 2

live async fn main() -> Int:
  const step = new Shared{value: 1}
  const disposedAt = new Shared{value: 0}
  let held: Lease? = new Lease{step, disposedAt}
  clear(&held, step)
  disposedAt->value
