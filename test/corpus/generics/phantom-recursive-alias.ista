# outcome: 2
# A recursive alias whose parameter only its own uses name (§4.6): its parts are the same for every
# argument, but the uses it is written through inside itself are its argument's.

import * as runtime from 'runtime'

type Phantom<T> = Int | Array<Phantom<T>>

fn f(x: Phantom<String>) -> Int:
  match x:
    case Int as n: n
    case Array<Phantom<String>> as xs: xs.length()

live async fn main() -> Int:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Int: return f([1, [2]])
