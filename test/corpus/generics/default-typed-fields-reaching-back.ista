# outcome: 2
# A field typed by its default may build a generic struct whose written fields name its own type
# again with its parameter whole, beside fields of its own typed by defaults, generic or not:
# instantiation ends (§8.1), and no default depends on itself (§5.2).

import * as runtime from 'runtime'

struct Phantom<T> { k: Int }

struct Back<U> { n = 1, p = Phantom<U>{k: 1}, a: Ahead<U>? }

struct Ahead<T> { b = Back<T>{a: none} }

live async fn main() -> Int:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Int:
  Ahead<String>{}.b.n + Back<Int>{a: none}.n
