# Variance (§8.1): a handle, a map's keys and a member parameter are invariant, a function's
# parameter is contravariant, and a one-element tuple converts only at the top. Only an extern
# value, a struct or an enum takes `gives` or `takes`, and a struct's or an enum's must agree with
# what its values hold. A shared struct is a handle whatever it holds, as the inbox module's are.
import * as inbox from 'inbox'

type Status = "draft" | "sent"

extern shared struct Handle<gives T>
shared struct Counter<takes T> { value: T }
fn identity<gives T>(x: T) -> T: x
trait Source<takes T> { fn next(self: Self) -> T }
type Alias<gives T> = Array<T>
struct Sink<gives T> { take: fn(T) -> Unit }
struct Tagged<gives S in Status> { tag: S }
struct Reader<T> { read: fn(T) -> Unit }

ista fn bad(
  slot: Slot<Int>
  keys: Map<String, Int>
  singles: Array<(Int,)>
  reader: Reader<Int>
  counter: Counter<Int>
  box: inbox.Inbox<Int>
):
  const wide: Slot<Int?> = slot
  const wideKeys: Map<String?, Int> = keys
  const unwrapped: Array<Int> = singles
  const r: Reader<Int?> = reader
  const c: Counter<Int?> = counter
  const b: inbox.Inbox<Int?> = box
