# outcome: 8
# A field typed by its default may build a generic struct whose own default builds a third, whose
# written field names the second again, beside a field naming the first; or a struct whose default
# builds the first; or a struct whose default calls for a third whose default builds the first: no
# default depends on itself (§3.1), and instantiation ends (§3.5).

import * as runtime from 'runtime'

struct Id<T> { k: Int, b: Back<T>? }

struct Back<U> { p = Id<U>{k: 1, b: none}, a: Ahead<U>? }

struct Ahead<T> { b = Back<T>{a: none} }

struct Made<T> { f = make<T>() }

struct Making<U> { g = Made<U>{}, n = 2 }

fn make<T>() -> Making<T>?: none

struct Outer<T> { f = Middle<T>{} }

struct Middle<U> { h = inner<U>() }

struct Inner<V> { g = Outer<V>{}, n = 3 }

fn inner<U>() -> Inner<U>?: none

live async fn main() -> Int:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Int:
  Ahead<String>{}.b.p.k + Making<Int>{}.n + Inner<Int>{}.n + 2
