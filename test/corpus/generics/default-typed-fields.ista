# outcome: 1
# A generic struct's field may take its type from its default, which names another generic struct
# whose fields name the first again with its parameter whole: instantiation ends (§8.1), and the
# default depends on nothing of its own (§5.2).

import * as runtime from 'runtime'

enum Opt<T> { Some(value: T), Empty }

struct A<T> { b = B<T>{x: 1, a: Opt.Empty} }

struct B<U> { x: Int, a: Opt<A<U>> }

live async fn main() -> Int:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Int: A<String>{}.b.x
