# outcome: "255 3.0 3 -3 12.5 true"
# Static functions are called through their type, a conversion `T(x)` calls `T.from` (§3.7,
# §3.10), and an operator on a declared type finds its function where the type is declared or in
# scope (§3.9, §3.13).

struct Money:
  cents: Int

fn Money.zero() -> Money:
  Money{cents: 0}

fn Money.from(cents: Int) -> Money:
  Money{cents: cents}

fn add(left: Money, right: Money) -> Money:
  Money{cents: left.cents + right.cents}

fn compare(left: Money, right: Money) -> Int:
  left.cents - right.cents

async fn main() -> String:
  const total = Money.zero() + Money(250) + Money(5)
  const half: Float = Float(25) / 2
  String(total.cents) + " " + String(Float(3)) + " " + String(Int(3.7)) + " " + String(Int(-3.7)) + " " + String(half) + " " + String(Money(1) < total)
