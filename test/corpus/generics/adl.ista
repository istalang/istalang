# outcome: 1000
# An operator on a type finds its function in the module declaring the type, though nothing
# imports it by name (§13.1): `+` on a Time and a Duration finds `time`'s `add`.
import * as runtime from 'runtime'
import * as time from 'time'

live async fn main() -> Int:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Int:
  const start = time.now()
  (start + 1s).value - start.value
