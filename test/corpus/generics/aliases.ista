# outcome: "250 x 3"
# An alias is the type it names, and may be generic (§3.17).

struct Pair<A, B>:
  first: A
  second: B

type Cents = Int
type Labeled<T> = Pair<String, T>

fn label<T>(name: String, value: T) -> Labeled<T>:
  Pair{first: name, second: value}

async fn main() -> Future<String>:
  const price: Cents = 250
  const tagged = label("x", 3)
  String(price) + " " + tagged.first + " " + String(tagged.second)
