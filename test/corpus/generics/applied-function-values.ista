# outcome: "3|4 5|ok 6|ok 7|err x|ok 8|one|true|sent 9|10 11|err y|1 a|13"
# Type arguments written after a function named as a value are a call's (§8.1, §6.4): a top-level
# function's, a static function's and a variant's, qualified or bare where the expected type
# gives its enum. They fix what they give, the expected type inferring a defaulted one they leave
# out, as a parameter it is passed for does, and choose among overloads as a call's do. So `map`
# learns from `Result.Ok<Int, String>` the error type it can't infer from `Result.Ok`. A pack is
# written as a tuple type, and the value is the function a union expects among its members. It
# captures nothing, so it is sendable, and it equals another naming the same function with the
# same type arguments.

import * as runtime from 'runtime'

struct Box<T> { item: T }

fn Box.of<T>(item: T) -> Box<T>: Box{item}

fn listed<T>(value: T) -> Array<T>: [value]

fn pick<T>(value: T) -> String: "one"

fn pick<A, B>(first: A, second: B) -> String: "two"

fn shown(result: Result<Int, String>) -> String:
  match result:
    case Ok(value): `ok ${value}`
    case Err(error): `err ${error}`

fn sent(make: sendable fn(Int) -> Box<Int>) -> String:
  `sent ${make(9).item}`

fn failed(make: fn(String) -> Result<Int, String>) -> String:
  shown(make("y"))

fn kept<...A>(...items: A) -> A: items

fn made(make: (fn(Int) -> Box<Int>) | Int) -> Int:
  match make:
    case Int as n: n
    case _ as f: f(13).item

live async fn main() -> String:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> String:
  const list = listed<Int>
  const boxes = [4, 5].map(Box.of<Int>)
  const results = [6].map(Result.Ok<Int, String>)
  const ok: fn(Int) -> Result<Int, String> = Ok<Int, String>
  const failing: fn(String) -> Result<Int, String> = Result.Err<Int>
  const defaulted: fn(Int) -> Result<Int, String> = Result.Ok<Int>
  const chosen = pick<Int>
  const same = listed<Int> == list
  const pair = [10, 11].map(listed<Int>)
  const passed = failed(Result.Err<Int>)
  const keep = kept<(Int, String)>
  const kept1 = keep(1, "a")
  `${list(3)[0]}|${boxes[0].item} ${boxes[1].item}|${shown(results[0])}|${shown(ok(7))}|${shown(failing("x"))}|${shown(defaulted(8))}|${chosen(1)}|${same}|${sent(Box.of<Int>)}|${pair[0][0]} ${pair[1][0]}|${passed}|${kept1.0} ${kept1.1}|${made(Box.of<Int>)}`
