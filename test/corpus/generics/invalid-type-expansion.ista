# A generic type is compiled per instantiation, so one that refers to itself, directly or through
# others, with a type argument built from its own would need endlessly many of them (§3.5): it is
# reported at the field that grows the argument. A field that passes its parameter on whole, or
# reaches the type again only through other parameters, ends.

struct Wrapped<T>:
  value: T
  next: Wrapped<T>?
  grows: Wrapped<(T,)>?

enum Chain<T>:
  End
  Link { head: T, tail: Chain<T> }
  Deeper { head: T, tail: Chain<Array<T>> }

struct Ping<T>:
  pong: Pong<T>?
struct Pong<T>:
  ping: Ping<Array<T>>?

shared struct Cell<T>:
  inner: Cell<(T, T)>?

struct Tree<T>:
  value: T
  children: Array<Tree<T>>
  pairs: Array<(Tree<T>, Tree<T>)>

fn made() -> Wrapped<Int>:
  Wrapped<Int>{value: 1, next: none, grows: none}

fn bare() -> Chain<Int>:
  Deeper{head: 1, tail: End}

fn qualified() -> Chain<Int>:
  Chain.Deeper{head: 1, tail: Chain.End}

async fn main() -> Future<Int>:
  made()
  Tree<Int>{value: 1, children: [], pairs: []}.value

# A value given to a field the expansion error-typed reports nothing more, however much it needs
# the field's type to mean anything: an empty collection, a generic struct without fields, a
# function named among overloads, or a nested function's untyped parameter.
struct Marker<T>

fn scaled(x: Int) -> Int: x
fn scaled(x: String) -> String: x

struct Endless<T>:
  items: Array<Endless<(T,)>>
  entries: Map<String, Endless<(T,)>>
  marker: Marker<Endless<(T,)>>
  named: fn(Endless<(T,)>) -> Int
  nested: fn(Endless<(T,)>) -> Int

fn endless() -> Endless<Int>:
  Endless<Int>{items: [], entries: [:], marker: Marker, named: scaled, nested: fn(x): 0}
