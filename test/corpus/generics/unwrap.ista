# outcome: "4 5"
# `x$` calls `unwrap(x)` and `x$ = v` calls `rewrap(x, v)` (§3.9), found like any call.

struct Meter:
  value: int

fn unwrap(self: Meter) -> int:
  self.value

fn rewrap(self: Meter, value: int):
  if value < 0: panic("a meter is never negative")

async fn main() -> Future<string>:
  const meter = Meter{value: 4}
  meter$ = 9
  string(meter$) + " " + string(meter$ + 1)
