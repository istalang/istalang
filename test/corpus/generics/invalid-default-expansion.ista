# error: 5111 at 26:3
# error: 5111 at 32:40
# A call a default makes counts towards endless instantiation as a written call does (§8.1): a
# struct literal leaving out a field calls its default, and a default calls whatever it names. So
# a cycle that grows a type argument through a field's or a parameter's default is reported where
# it grows, as one through written calls is. A field whose type grows its own argument is
# reported too, at the field.

import * as runtime from 'runtime'

struct Node<T>:
  depth: Int = 0
  seed: Array<T> = []
  next: Array<Node<Array<T>>> = grow(depth, seed)

struct W<T> { v: T, k: Int, n: Int = viaField(v, k) }

fn grow<T>(depth: Int, seed: Array<T>) -> Array<Node<Array<T>>>:
  if depth > 2: return []
  [Node<Array<T>>{depth: depth + 1, seed: [seed]}]

fn viaField<T>(x: T, k: Int) -> Int:
  if k == 0: return 0
  W<Array<T>>{v: [x], k: k - 1}.n

fn viaParameter<T>(x: T, k: Int) -> Int:
  if k == 0: return 0
  defaulted(x, k)

fn defaulted<T>(x: T, k: Int, n: Int = viaParameter([x], k - 1)) -> Int:
  n

live async fn main() -> Int:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Int:
  String(Node<Int>{}.next.length()).length() + viaField(1, 2) + viaParameter(1, 2)
