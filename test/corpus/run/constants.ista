# outcome: "total: 38 432000000 0.5 -0.25"
# Top-level constants (§5.1): literals, a negated number, a duration, a struct built from them, and
# constants built from other constants, each computed while compiling.

import * as runtime from 'runtime'

struct Limits { low: Int, high: Int }

const base = 40
const limits = Limits{low: -2, high: base}
const sameLimits: Limits = limits
const timeout = 5d
const label = "total"
const ratio = 0.5
const shift = -(0.25)

live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  const span = sameLimits.high + sameLimits.low
  label + ": " + span + " " + timeout.value + " " + ratio + " " + shift
