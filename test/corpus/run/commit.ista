# outcome: 3
# Commits without waiting, and a function returning a future its caller awaits.
import * as runtime from 'runtime'
import * as time from 'time'

ista fn soon() -> Future<Unit, "ista">:
  time.delay(1ms)

ista async fn main():
  await runtime.commit()
  await soon()
  const pause = 5ms
  pause.value - 2
