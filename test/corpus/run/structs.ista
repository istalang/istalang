# outcome: "13 true false"
# Structs built with named fields, read by field, nested, and compared by value (§3.1, §3.9).

struct Point { x: int; y: int }

struct Segment:
  start: Point
  end: Point

fn length(s: Segment) -> int:
  const dx = s.end.x - s.start.x
  const dy = s.end.y - s.start.y
  dx + dy

async fn main():
  const s = Segment{start: Point{x: 1, y: 2}, end: Point{x: 4, y: 12}}
  const same = Point{x: 1, y: 2} == s.start
  const other = s.start == s.end
  "" + length(s) + " " + same + " " + other
