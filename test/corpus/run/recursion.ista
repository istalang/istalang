# outcome: 5000050000
# Frames are data (§5): recursion far deeper than a host stack allows still runs.

fn sum(n: Int) -> Int:
  if n == 0:
    return 0
  n + sum(n - 1)

import * as runtime from 'runtime'
live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  sum(100_000)
