# outcome: "odd sum 64, medium, short-circuit ok"
# `if`/`elif`/`else` as expressions, `while` with `break` and `continue`, and `and`/`or` that skip
# their right side (§4, §3.9): the division by zero on a skipped side never runs.

fn size(n: Int) -> String:
  if n < 10: "small" elif n < 100: "medium" else: "large"

async fn main():
  let total = 0
  let i = 0
  while true:
    i += 1
    if i > 15:
      break
    if i % 2 == 0:
      continue
    total += i
  const skipped = (false and 1 // 0 == 0) or (true or 1 // 0 == 0)
  const verdict = if skipped: "short-circuit ok" else: "evaluated"
  "odd sum " + total + ", " + size(total) + ", " + verdict
