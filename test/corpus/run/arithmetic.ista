# outcome: "7 0 3 1 3.5 2.0 0.5 -3 3 big 100000000000000000000 Infinity -Infinity NaN"
# Integers stay exact at any size; `//` floors and `%` follows the divisor's sign (§2, §3.9);
# mixing int and float gives a float, and `/` always does, dividing by zero as IEEE 754 does.

fn describe(a: Int, b: Int) -> String:
  "" + (a + b) + " " + a // b + " " + a % b + " " + -a % b

async fn main():
  const big = 10_000_000_000 * 10_000_000_000
  describe(3, 4) + " " + 7 / 2 + " " + (1.5 + 0.5) + " " + 2 / 4 + " " + -7 // 3 + " " + -7 % 5 + " big " + big + " " + 1 / 0 + " " + -1.5 / 0 + " " + 0.0 / 0.0
