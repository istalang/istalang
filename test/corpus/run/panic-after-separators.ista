# panic: boom
# A panic's trace names the frame it stands in (§3.12), whatever the program's text holds: a
# string with line and paragraph separators counts as no line breaks for where frames stand.

const separators = "\u{2028}\u{2029}"

fn boom(text: String) -> Int:
  if text.length() > 0: panic("boom")
  else: 0

live async fn main() -> Int: boom(separators)
