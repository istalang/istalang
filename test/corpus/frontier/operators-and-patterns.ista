# Bitwise operators, `**`, `in`, `!`, range steps, chained comparisons, and or, range and array
# patterns parse, and are not checked yet (language features, L5).

fn f(a: int, b: int, xs: Array<int>, m: int?) -> bool:
  let n = a
  n **= 2
  n &= 1
  _ = a | b
  _ = a ** b
  _ = ~a
  _ = a in xs
  _ = m!
  _ = 0..10 by 2
  a < b <= n

fn p(x: int) -> int:
  match x:
    case 1 | 2: 1
    case 3..=5: 2
    case _: 0

fn q(xs: Array<int>) -> int:
  match xs:
    case [_, ..._]: 1
    case _: 0
