fn f(a: int, b: int, xs: Array<int>, m: int?) -> bool:
  let n = a
  _ = a in xs
  _ = m!
  _ = 0..10 by 2
  a < b <= n

fn p(x: int) -> int:
  match x:
    case 1 | 2: 1
    case 3..=5: 2
    case _: 0

fn q(xs: Array<int>) -> int:
  match xs:
    case [_, ..._]: 1
    case _: 0
