# A shared struct (§3.18) is built with `new`, and only one is; its fields are read through it
# with `->`, never `.`; and its values have an identity, so they never leave their instance, nor
# does compile time compute one into a top-level const, by itself or as a field's default (§3).
# `?->` reads through an optional shared struct only, and a value read through it is a copy, so a
# method taking `&self` isn't called through it (§4).

struct Tally { count: int }

shared struct Counter { count: int }

struct Holder { counter: Counter = new Counter{count: 0} }

