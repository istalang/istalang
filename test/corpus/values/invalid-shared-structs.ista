  const bare = Counter{count: 1}
  const plain = new Tally{count: 1}
  spawn keep(new Counter{count: 1})
  const read = plain.count + bare.count
  const missing = bare?->count
  const maybe: Tally? = plain
  const inner = maybe?->count
  const log: Shared<Array<int>>? = new Shared{value: [1]}
  log?->value.push(2)
