# outcome: "3 6 9 6 0 4 1.5 1 100"
# A field's default (§3.1) runs at a literal that leaves the field out, seeing the fields before it,
# and a field may take its type from its default. A spread gives every field, so it runs none. A
# variant's fields have defaults too, a generic struct's default meets the constraints its literal
# meets, and a constant computes a default that compile time can.

struct Retry:
  times: int = 3
  backoff = times * 2
  limit: int = backoff + times

struct Box<T is Default>:
  items: T = T.default()
  size: int

enum Shape:
  Circle { r: float = 1.5 }
  Square { side: int }

struct Limits:
  low: int = 1
  high: int = 10

const wide = Limits{high: 100}

fn radius(shape: Shape) -> float:
  match shape:
    case Circle{r}: r
    case Square{side}: float(side) / 2.0

async fn main() -> Future<string>:
  const plain = Retry{}
  const spread = Retry{...plain, times: 10}
  const box = Box<Array<int>>{size: 4}
  const circle: Shape = Circle{}
  [
    string(plain.times),
    string(plain.backoff),
    string(plain.limit),
    string(spread.backoff),
    string(box.items.length()),
    string(box.size),
    string(radius(circle)),
    string(wide.low),
    string(wide.high),
  ].join(" ")
