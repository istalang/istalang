# A field's default must fit its field (§3.1), sees only the fields before it, and can't reach its
# own field when that field takes its type from it. A constant runs a default only when compile
# time computes it, which arithmetic it doesn't, and one whose default builds a value needing that
# default again would never be finished. Only a function returns, so a default has no `return`, as
# a parameter's hasn't. A field with a default is never missing, even where its default can't be
# called, which is reported once, for itself.

struct Typed:
  n: int = "x"

struct Ordered:
  a: int = b
  b: int = 1

struct Looping:
  x = Looping{}.x

struct Doubled:
  base: int = 2
  twice: int = base * 2

const doubled = Doubled{}

struct Nested:
  inner: Nested? = Nested{}

struct Ping:
  n: int = 1
  pong: Pong? = Pong{}

struct Pong:
  ping: Ping? = Ping{}

const nested = Nested{}
const ping = Ping{}

struct Returning:
  x: int = { return "r"; 4 }

fn early(n: int = { return 1; 2 }) -> int:
  n

struct Plain:
  x: int

struct Defaulting<T is Default>:
  items: T = T.default()
  size: int

struct Referencing:
  x: &int = 1
  y: int = x

fn plainBox() -> int:
  Defaulting<Plain>{size: 1}.size

fn referencing() -> int:
  Referencing{}.y

async fn main(): 0
