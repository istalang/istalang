# outcome: [1,2,3,1,2,1,2,3,1,2,3,5,90,2,3,4,90,2,3,4,99]
# Every copy is a value of its own (§2): `const` and `let` copies, a closure's capture and a struct
# passed beside a reference to its own part keep what they had through later changes in place at
# nested paths.

import * as runtime from 'runtime'

struct Inner:
  items: Array<Int>
  tags: Map<String, Int>

struct Outer:
  left: Inner
  right: Inner

fn mutateFirst(items: &Array<Int>, outer: Outer) -> Array<Int>:
  items.push(99)
  outer.left.items

live async fn main() -> Array<Int>: await runtime.run(runtime.id()) _main()
ista async fn _main() -> Array<Int>:
  let o = Outer{
    left: Inner{items: [1, 2], tags: ["a": 1]},
    right: Inner{items: [10], tags: ["b": 2]},
  }
  o.left.items.push(3)
  o.left.tags["c"] = 3
  const snapConst = o
  let snapLet = o
  const readLeft = fn() -> Array<Int>: snapConst.left.items
  o.left.items.push(4)
  o.left.items[0] = 90
  o.left.tags["a"] = 99
  snapLet.left.items.push(5)
  const fromCall = mutateFirst(&o.left.items, o)
  [
    ...snapConst.left.items,
    snapConst.left.tags["a"],
    snapConst.left.tags.size(),
    ...readLeft(),
    ...snapLet.left.items,
    ...fromCall,
    ...o.left.items,
  ]
