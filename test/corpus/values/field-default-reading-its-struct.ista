# outcome: 3
# A field's default may read the struct it belongs to (§3.1): a lambda reading a field whose type
# is written needs no other field typed, so the field it defaults takes its type from it.

struct Counter:
  start: Int = 1
  next = fn(c: Counter) -> Int: c.start + 1

import * as runtime from 'runtime'
live async fn main() -> Int: await runtime.run(runtime.id()) _main()
ista async fn _main() -> Int:
  const c = Counter{}
  c.start + c.next(c)
