# outcome: [10,20,30]
# An instance's outcome is the value its root returned (§9): a `defer` changing the returned local as
# the root exits changes nothing of it.

import * as runtime from 'runtime'

fn unwrap(r: Result<Array<Int>>) -> Array<Int>:
  match r:
    case Ok(xs): xs
    case Err(_): []

ista async fn childWithDefer() -> Array<Int>:
  let xs = [10, 20]
  xs.push(30)
  _ = defer(fn(): { xs.push(999); xs[0] = 888 })
  xs

live async fn main() -> Array<Int>:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Array<Int>:
  unwrap(await (spawn(childWithDefer)).result())
