# outcome: "3 true false 8 counted 1 2 0 2 2 2"
# A shared struct (§5.4) is a type of its own whose values are handles to a cell holding its
# fields: `new Counter{…}` makes one, `x->f` reads and writes a field and `*x` the whole value, for
# every copy, while `==` tells handles apart by identity. A field may hold the shared struct itself,
# since what it holds is a handle, read through when there is one with `?->`, which chains as `?.`
# does (§10.4). A spread of a value behind one decides a generic shared struct's type arguments, as a
# struct's own spread does.

import * as runtime from 'runtime'

shared struct Counter { count: Int, label: String = "counted" }

shared struct Node { value: Int, next: Node? = none }

struct Spot { node: Node }

shared struct Box<T> { value: T }

fn bump(self: Counter): self->count = self->count + 1

live async fn main() -> String:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> String:
  const a = new Counter{count: 1}
  const b = a
  a.bump()
  b->count += 1
  const other = new Counter{...*a}
  *other = struct{...*other, count: 8}
  [
    String(a->count)
    String(a == b)
    String(a == other)
    String(other->count)
    b->label
    nodes()
    boxes()
  ].join(" ")

fn nodes() -> String:
  const head = new Node{value: 1, next: new Node{value: 2}}
  const second = head->next?->value ?? 0
  const third = head->next?->next?->value ?? 0
  const spot: Spot? = Spot{node: head}
  const fromSpot = spot?.node->next?->value ?? 0
  const kept: Shared<Array<Int>>? = new Shared{value: [4, 5]}
  const size = kept?->value.length() ?? 0
  [String(head->value), String(second), String(third), String(fromSpot), String(size)].join(" ")

fn boxes() -> String:
  const b = new Box{value: 1}
  const c = new Box{...*b}
  const s = new Shared{value: 1}
  const d = new Shared{...*s}
  String(c->value + d->value)
