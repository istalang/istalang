# outcome: "10 1|10 1|7 5|9 0|10 1|10 1 1|1 5"
# Writing a part of a value reached through a handle or an element (§7.3, §10.2) changes that part
# of the value as it is when the write happens, so whatever changed another part meanwhile stays
# changed: the right side of a compound assignment, the call a part is passed to by `&`, or
# another execution while an `await` waits. A part passed by `&` to code is a copy: until the call
# returns, the handle still holds the old value.

import * as runtime from 'runtime'
import * as time from 'time'

shared struct Counter { a: Int, b: Int }

struct P { a: Int, b: Int }

shared struct Board { rows: Array<P>, touched: Int }

fn bumpB(c: Counter) -> Int:
  c->b += 1
  10

fn setBoth(x: &Int, c: Counter):
  c->b = 5
  x = 7

fn compound() -> String:
  const c = new Counter{a: 0, b: 0}
  c->a += bumpB(c)
  show(c->a, c->b)

fn desugared() -> String:
  const c = new Counter{a: 0, b: 0}
  c->a = c->a + bumpB(c)
  show(c->a, c->b)

fn referenced() -> String:
  const c = new Counter{a: 0, b: 0}
  setBoth(&c->a, c)
  show(c->a, c->b)

fn writeThenRead(x: &Int, c: Counter) -> Int:
  x = 9
  c->a

fn copied() -> String:
  const c = new Counter{a: 0, b: 0}
  const seen = writeThenRead(&c->a, c)
  show(c->a, seen)

fn element() -> String:
  let xs = [P{a: 0, b: 0}]
  fn g() -> Int:
    xs[0].b = 1
    10

  xs[0].a += g()
  show(xs[0].a, xs[0].b)

fn nested() -> String:
  const board = new Board{rows: [P{a: 0, b: 0}], touched: 0}
  fn g() -> Int:
    board->rows[0].b = 1
    board->touched = 1
    10

  board->rows[0].a += g()
  show(board->rows[0].a, board->rows[0].b) + " " + String(board->touched)

ista async fn later() -> Int:
  await time.delay(10ms)
  1

ista async fn writeB(c: Counter):
  await time.delay(5ms)
  c->b = 5

ista async fn bumpLater(c: Counter): c->a += await later()

ista async fn awaited() -> String:
  const c = new Counter{a: 0, b: 0}
  const w = writeB(c)
  await bumpLater(c)
  await w
  show(c->a, c->b)

fn show(a: Int, b: Int) -> String: String(a) + " " + String(b)

live async fn main() -> String:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> String:
  [compound(), desugared(), referenced(), copied(), element(), nested(), await awaited()].join("|")
