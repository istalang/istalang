# outcome: "15 | 7"
# A reference held across awaits (§7.3, §14): every await commits, so the callee's reference to its
# caller's variable is persisted and resumed with the instance, and so is the variable's cell.
import * as runtime from 'runtime'

struct Counter { count: Int }

ista async fn addTwice(total: &Int, n: Int):
  await runtime.commit()
  total += n
  await runtime.commit()
  total += n

ista async fn tick(self: &Counter):
  await runtime.commit()
  self.count += 1

live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  let total = 5
  await addTwice(&total, 5)
  let counter = Counter{count: 6}
  await counter.tick()
  "" + total + " | " + counter.count
