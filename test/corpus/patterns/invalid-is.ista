# `x is Pattern` tests a value against a pattern of its own type (§3.11), and its bindings exist
# only where the match is known to have succeeded: never after the `if`, and never through `or`.

enum Shape:
  Circle { radius: int }
  Square { side: int }

fn literal(n: int) -> bool:
  n is "one"

fn afterIf(shape: Shape) -> int:
  if shape is Circle{radius}:
    return radius
  radius

fn throughOr(shape: Shape, wide: bool) -> int:
  if shape is Circle{radius} or wide:
    radius
  else:
    0
