# error: 4003 at 13:3
# error: 4004 at 17:5
# `x is Pattern`'s bindings exist only where the match is known to have succeeded (§3.11): never
# after the `if`, and never through `or`.

enum Shape:
  Circle(radius: Int)
  Square(side: Int)

fn afterIf(shape: Shape) -> Int:
  if shape is Circle{radius}:
    return radius
  radius

fn throughOr(shape: Shape, wide: Bool) -> Int:
  if shape is Circle{radius} or wide:
    radius
  else:
    0
