# An `Error`'s `trace` defaults to the frames where it is built (§3.1, §3.12), which compile time
# can't compute: a top-level constant can't be an Error built that way. Its other fields are
# required. `drop` discards a value; dropping a variable releases it (§7).

struct Note:
  message: String
  trace: String

const failure = Error{message: "m", code: "c"}

fn note() -> Note:
  Note{message: "m"}

fn uncoded() -> Error:
  Error{message: "m"}

ista async fn main():
  const kept = note()
  drop kept
