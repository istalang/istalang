# error: 5026 at 14:17
# error: 5014 at 17:3
# error: 5014 at 20:3
# error: 5000 at 24:3
# Only an `Error` may leave out `trace`, which the runtime writes where it is built (§3.12), so
# compile time can't compute one: a top-level constant can't be an Error built that way. Its other
# fields are required. `drop` discards a value; dropping a variable releases it (§7), which isn't
# supported yet.

struct Note:
  message: string
  trace: string

const failure = Error{message: "m", code: "c"}

fn note() -> Note:
  Note{message: "m"}

fn uncoded() -> Error:
  Error{message: "m"}

async fn main():
  const kept = note()
  drop kept
