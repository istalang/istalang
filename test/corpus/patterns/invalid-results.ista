# `?` takes a Result apart (§3.12): never an optional, and only inside a function whose own Result
# holds the same error type, declared or inferred. A Result must be used.

struct Failure { reason: string }

fn parse(text: string) -> Result<int>:
  Ok{1}

fn fromOptional(n: int?) -> Result<int>:
  Ok{n?}

fn notResult() -> int:
  parse("a")?

fn otherError() -> Result<int, Failure>:
  const value = parse("a")?
  Ok{value}

fn inferred(text: string):
  const value = parse(text)?
  Result.Ok{value * 2}

fn inferredNotResult(text: string):
  const value = parse(text)?
  value

async fn main():
  parse("ignored")
  _ = inferred("x")
