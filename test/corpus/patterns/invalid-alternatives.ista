# An or-pattern can fail, so a target refuses it; its alternatives bind the same names, of the same
# types. An array pattern matches an Array, with one rest at most, and a match on arrays covers
# every length. A range pattern matches an int, between int literals that leave room (§3.11).

enum Shape:
  Circle(radius: Int)
  Square(side: String)
  Dot

fn target(pair: (Int, Int)) -> Int:
  let (a, 0) | (0, a) = pair
  a

fn differ(shape: Shape) -> Int:
  match shape:
    case Circle{radius as n} | Square{side as n}: 1
    case Dot | Circle{radius}: 2
    case _: 0

fn notArray(name: String) -> Int:
  match name:
    case [first]: 1
    case "a".."z": 2
    case _: 0

fn rests(xs: Array<Int>) -> Int:
  match xs:
    case [a, ...b, ...c]: a
    case _: 0

fn empty(n: Int) -> Int:
  match n:
    case 5..1: 1
    case 3..3: 2
    case _: 0

fn lengths(xs: Array<Int>) -> Int:
  match xs:
    case []: 0
    case [x]: x
