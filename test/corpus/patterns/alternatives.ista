# outcome: ["small","big","nothing","some",3,4,5,7,2,true]
# An or-pattern matches what any alternative matches, in a case, nested or under `is`, and every
# alternative binds the same names, from whichever matched first (§3.11).

enum Shape:
  Circle(radius: Int)
  Square(side: Int)
  Triangle(base: Int)

fn size(n: Int) -> String:
  match n:
    case 1 | 2: "small"
    case _: "big"

fn kind(value: Int?) -> String:
  match value:
    case none | 0: "nothing"
    case _: "some"

fn measure(shape: Shape) -> Int:
  match shape:
    case Circle(n) | Square(n): n
    case Triangle(base): base + 1

fn other(pair: (Int, Int)) -> Int:
  match pair:
    case (x, 0) | (0, x): x
    case _: -1

fn flagged(pair: (Int, Bool)) -> Int:
  match pair:
    case (1 | 2, true): 2
    case _: 0

async fn main() -> Future<(String, String, String, String, Int, Int, Int, Int, Int, Bool)>:
  const square: Shape = Square(4)
  (size(2), size(3), kind(0), kind(1), measure(Circle(3)), measure(Triangle(3)),
    other((5, 0)), other((0, 7)), flagged((1, true)), square is Circle(n) | Square(n) and n == 4)
