# A type pattern names a type to test (§3.10, §3.11): never a generic one against an `any` value,
# which a pattern can't give type arguments. Never, holding no value, and an alias of an `any`
# type, whose values have their own types, name no type to test; a generic alias stands for no one
# type; and braces take a struct's fields only. A type the value can't hold is only warned of.

trait Named:
  fn name(self: Self) -> String

struct Email { to: String }
struct Box<T> { value: T }

fn name(self: Email) -> String: self.to
fn name<T>(self: Box<T>) -> String: "box"

fn generic(x: any Named) -> Bool:
  x is Box

fn never(x: any Named) -> Bool:
  x is Never

fn braces(x: Int) -> Bool:
  x is Int{}

type List<T> = Array<T>

fn genericAlias(xs: List<Int>) -> Bool:
  match xs:
    case List: true
    case _: false

fn genericAliasInside(x: any Named) -> Bool:
  x is List

type NamedText = any Named & Stringable

fn anyAlias(x: any Named) -> Bool:
  x is NamedText

type Broken = Undeclared

fn broken(n: Int) -> Bool:
  n is Broken

type Bottom = Never

fn bottom(x: any Named) -> Bool:
  x is Bottom

type BoxOf<T> = Box<T>

fn bracedGenericAlias(b: Box<Int>) -> Bool:
  match b:
    case BoxOf{value}: true
    case _: false
