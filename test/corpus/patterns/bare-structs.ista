# outcome: "marker|full|empty|box|pair"
# A struct without fields is written bare in a pattern, as in an expression (§3.1, §3.11). Its
# value is the only one of its type, so it matches with no test and covers the type, a generic
# one taking its type arguments from the part it matches.

struct Marker

struct Box<T>

enum Holder:
  Empty
  Full(marker: Marker)

fn plain(m: Marker) -> String:
  match m:
    case Marker: "marker"

fn nested(slot: Holder) -> String:
  match slot:
    case Full(Marker): "full"
    case Empty: "empty"

fn generic(b: Box<Int>) -> String:
  match b:
    case Box: "box"

fn inTuple(pair: (Marker, Bool)) -> String:
  match pair:
    case (Marker, true): "pair"
    case (Marker, false): "other"

ista async fn main() -> String:
  const box: Box<Int> = Box
  const parts = [plain(Marker), nested(Full(Marker)), nested(Empty), generic(box), inTuple((Marker, true))]
  parts[0] + "|" + parts[1] + "|" + parts[2] + "|" + parts[3] + "|" + parts[4]
