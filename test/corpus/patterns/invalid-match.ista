# error: 5400 at 12:9
# A `match` must cover every value of its subject's type (§11.4, §11.1): a missing variant is
# reported at the subject. A pattern its subject's type can't hold is only warned of, as it never
# runs (§11.3).

enum Decision:
  Approved(by: String)
  Rejected(by: String, reason: String)
  Expired

fn missing(decision: Decision) -> String:
  match decision:
    case Approved(by): by
    case Expired: "expired"

fn unwrapped(n: Int?) -> String:
  match n:
    case 1: "one"
    case _: "other"
