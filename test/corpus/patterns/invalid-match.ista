# A `match` must cover every value of its subject's type (§3.11, §4): a missing variant is
# reported at the subject. A pattern mirrors construction, so a variant with fields takes braces;
# a referring name is a variant, the part's own type or a constant; a literal has the part's
# own type, never wrapped into an optional; and a struct pattern names the value's own type.

enum Decision:
  Approved { by: String }
  Rejected { by: String; reason: String }
  Expired

fn missing(decision: Decision) -> String:
  match decision:
    case Approved{by}: by
    case Expired: "expired"

fn bare(decision: Decision) -> String:
  match decision:
    case Approved: "approved"
    case _: "other"

fn wrongLiteral(n: Int) -> String:
  match n:
    case "one": "string"
    case _: "other"

fn unwrapped(n: Int?) -> String:
  match n:
    case 1: "one"
    case _: "other"

fn otherStruct(decision: Decision) -> String:
  match decision:
    case Error{message}: message
    case _: "other"

struct Point { x: Int; y: Int }

struct Marker

fn otherMarker(decision: Decision) -> String:
  match decision:
    case Marker: "marker"
    case _: "other"

struct Box<T>

fn otherBox(decision: Decision) -> String:
  match decision:
    case Box: "box"
    case _: "other"
