# `?.` and `??` work on optionals (§4). A value read through `?.` is a copy, so a chain is never
# assigned to, not even an element of it, and calls no method taking `&self`. A `?.` or `?->`
# reaches inside one optional only: an optional read further along the chain needs its own.

struct Address { city: string; tags: Array<string> }

struct Person { address: Address? }

shared struct Node { value: int; next: Node? = none }

fn rename(self: &Address, city: string):
  self.city = city

async fn main():
  const count = 5
  const city = count?.city
  const fallback = count ?? 1
  const person = Person{address: none}
  person.address?.rename("y")
  person.address?.tags[0] = "x"
  const maybe: Person? = person
  const town = maybe?.address.city
  const head = new Node{value: 1}
  const second = head->next->value
  const called = count?.()
  const seven: int? = 7
  const result = seven?.()
