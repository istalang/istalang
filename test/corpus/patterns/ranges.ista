# outcome: ["negative","fail","pass","pass","great"]
# A range pattern matches an int between its bounds, either open: `..` leaves its end out, `..=`
# takes it in; it acts as a guard, so the match still ends with `case _` (§3.11).

import * as runtime from 'runtime'

fn grade(score: Int) -> String:
  match score:
    case ..0: "negative"
    case 0..=59: "fail"
    case 60..90: "pass"
    case 90..: "great"
    case _: "unreachable"

live async fn main() -> (String, String, String, String, String):
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> (String, String, String, String, String):
  (grade(-3), grade(59), grade(60), grade(89), grade(90))
