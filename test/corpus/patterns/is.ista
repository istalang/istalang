# outcome: "7|none|big 12|small|3"
# disable-ista-formatter
# `x is Pattern` is a boolean whose bindings exist where the match is known to have succeeded:
# the body of an `if` or `while`, and the right side of an `and` (§3.11).

enum Shape:
  Circle(radius: Int)
  Square(side: Int)

fn radius(shape: Shape) -> String:
  if shape is Circle(radius):
    String(radius)
  else:
    "none"

fn classify(r: Result<Int>) -> String:
  if r is Ok(y) and y > 10:
    "big " + String(y)
  else:
    "small"

fn countdown(start: Int) -> Int:
  let current: Int? = start
  let steps = 0
  while current is Int as value and value > 0:
    steps += 1
    current = if value > 1: value - 1 else: none
  steps

import * as runtime from 'runtime'
live async fn main() -> String: await runtime.run(runtime.id()) _main()
ista async fn _main() -> String:
  (radius(Circle(7)) + "|" + radius(Square(2)) + "|" + classify(Ok(12))
    + "|" + classify(Err(Error{message: "x", code: "y"})) + "|" + String(countdown(3)))
