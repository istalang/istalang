# outcome: ["r1 read 10","t1 take 10","r2 read 20","t2 take 20","last 7"]
# QA M3 (§15.1): one queue per slot, longest waiter first: a read before the first take sees the value, the take empties it, and a read queued behind that take waits for the next put.
import * as runtime from 'runtime'
import Inbox from 'inbox'

ista async fn reader(log: Inbox<String>, s: Slot<Int>, name: String, take: Bool):
  if take:
    const v = await s.take()
    log.send(name + " take " + v.toString())
  else:
    const v = await s.read()
    log.send(name + " read " + v.toString())

live async fn main() -> Array<String>:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Array<String>:
  const log = Inbox.create<String>()
  const s = Slot.create<Int>()
  hold _ = reader(log, s, "r1", false)
  hold _ = reader(log, s, "t1", true)
  hold _ = reader(log, s, "r2", false)
  hold _ = reader(log, s, "t2", true)
  const p1 = s.put(10)
  const p2 = s.put(20)
  await p1
  await p2
  let out: Array<String> = []
  for i in 0..3: out.push(await log.receive())
  const probe: String = select:
    case log.receive() as x: x
    else: "empty"
  out.push(probe)
  _ = s.put(7)
  const t = await s.take()
  out.push("last " + t.toString())
  out
