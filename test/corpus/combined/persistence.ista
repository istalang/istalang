# outcome: "3|1|14|6|3"
# A closure's shared `let` and a collection changed through a closure keep their values across
# awaits and `runtime.commit` (§3.14, §5), with `?` and `match` over a Result in between.
import * as time from 'time'
import * as runtime from 'runtime'

struct Acc { items: Array<Int>; seen: Map<String, Int> }

fn makeCounter(start: Int) -> fn() -> Int:
  let count = start
  fn next() -> Int:
    count += 1
    count

  next

fn check(r: Result<Int>) -> Result<Int>:
  const v = r?
  Ok{(v * 2)}

async fn main() -> Future<String>:
  const next = makeCounter(10)
  let acc = Acc{items: [], seen: [:]}
  const adder = fn(n: Int): { acc.items.push(n); acc.seen[String(n)] = next(); acc.items.length() }
  adder(1)
  await time.delay(10ms)
  adder(2)
  await runtime.commit()
  const tail = acc.items[1..]
  await time.delay(10ms)
  const r = match check(Ok{(adder(3))}):
    case Ok{value}: value
    case Err{error}: -1
  const keys = [for k, v in acc.seen.entries() if v > 10: k + "=" + String(v)]
  String(acc.items.length()) + "|" + String(tail.length()) + "|" + String(next()) + "|" + String(r) + "|" + String(keys.length())
