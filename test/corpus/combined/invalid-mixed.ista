enum Shape:
  Circle(r: Int)
  Rect(w: Int, h: Int)

fn area(s: Shape) -> Int:
  match s:
    case Circle{r}: r
    case Rect{w, h} if w > 0: w * h

fn captures(x: &Int) -> Array<Int>:
  [for i in 0..3: (fn(): x + i)()]

fn parse() -> Result<Int>: Ok(1)

async fn main() -> Future<Int>:
  parse()
