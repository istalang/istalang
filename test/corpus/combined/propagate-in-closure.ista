# outcome: "lambdaErr|localErr|ok101|asyncErr|genericErr"
# `?` in a lambda or local function returns from that function (§3.12, §3.14), not from the
# function around it, which need not return a Result.
fn p(n: Int) -> Result<Int>:
  if n > 0: Ok{(n)} else: Err{Error{message: "bad", code: "c"}}

fn lambdaCase() -> String:
  const f = fn(n: Int) -> Result<Int>: { const v = p(n)?; Ok{(v + 100)} }
  match f(0):
    case Ok{value}: "ok" + String(value)
    case Err{error}: "lambdaErr"

fn localCase() -> String:
  fn g(n: Int) -> Result<Int>:
    const v = p(n)?
    Ok{(v)}

  match g(0):
    case Ok{value}: "ok"
    case Err{error}: "localErr"

async fn asyncCase() -> Future<String>:
  const f = async fn(n: Int) -> Future<Result<Int>>: { const v = p(n)?; Ok{(v)} }
  match await f(0):
    case Ok{value}: "ok"
    case Err{error}: "asyncErr"

fn genericCase<T>(x: T, n: Int) -> String:
  const f = fn() -> Result<T>: { p(n)?; Ok{(x)} }
  match f():
    case Ok{value}: "ok"
    case Err{error}: "genericErr"

async fn main() -> Future<String>:
  const f = fn(n: Int) -> Result<Int>: { const v = p(n)?; Ok{(v + 100)} }
  const ok = match f(1):
    case Ok{value}: "ok" + String(value)
    case Err{error}: "err"
  lambdaCase() + "|" + localCase() + "|" + ok + "|" + await asyncCase() + "|" + genericCase(true, 0)
