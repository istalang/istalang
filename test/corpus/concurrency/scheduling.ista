# outcome: "started,took 7,main,done"
# Every await commits, even on a future that has already resolved, and the execution then runs
# after every execution that became ready before it (§5, §6). Here the put releases the waiting
# call, which becomes ready first, so it runs before the caller that awaited the resolved put.

async fn waiter(s: Slot<int>, log: Shared<Array<string>>):
  log->value = [...log->value, "started"]
  const value = await s.take()
  log->value = [...log->value, "took " + string(value)]

async fn main() -> Future<string>:
  const empty: Array<string> = []
  const log = new Shared{value: empty}
  const s = Slot.create<int>()
  const running = waiter(s, log)
  await s.put(7)
  log->value = [...log->value, "main"]
  await running
  log->value = [...log->value, "done"]
  log->value.join(",")
