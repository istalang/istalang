# select (§8): each case waits on a future. Without `await` it never waits, so it needs `else`;
# with `await` it waits, so it has none, and only an async function may wait. A case without
# `as` discards its value, so a value that must be used, such as a `Result`, is reported. The
# case bodies agree on one type.

async fn checked(s: Slot<Int>) -> Future<Result<Int>>:
  Ok(1)

async fn cases(s: Slot<Int>):
  _ = await select:
    case 3:
      1
  _ = select:
    case s.read():
      1
  _ = await select:
    case s.read():
      1
    else:
      2

fn plain(s: Slot<Int>):
  _ = await select:
    case s.read():
      1

async fn discarded(s: Slot<Int>):
  _ = await select:
    case checked(s):
      1

async fn disagreeing(s: Slot<Int>) -> Future<Int>:
  const value = await select:
    case s.read() as n:
      n
    case s.take():
      "two"
  1
