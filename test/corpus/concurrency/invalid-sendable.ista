# A sendable function type (§3.14) holds code, which only `spawn` sends: it isn't Encodable, so
# an extern's types may not contain one (§9); and a function value capturing a `let`, which is a
# `Shared`, has a plain function type, which doesn't fit where a sendable one is expected. One
# capturing a value that isn't sendable is reported at that capture.

struct Handler { run: sendable fn(Int) -> Int }

extern fn register(f: sendable fn(Int) -> Int)

extern fn handlers() -> Array<Handler>

fn uses():
  let count = 0
  const f: sendable fn() -> Int = fn(): count
  sent(fn(): count)
  count += 1

fn sent(f: sendable fn() -> Int):
  _ = f

fn capturesShared():
  const log = new Shared{value: 1}
  sent(fn(): log->value)
