# An Instance<T> is what spawn gives (§17.1): its result() copies the outcome out, so T must be
# sendable, and as a handle it never crosses to the host.

import * as runtime from 'runtime'

extern fn report(instance: Instance<Int>)

ista fn slot() -> Slot<Int>: Slot.create<Int>()

fn twice(n: Int) -> Int: n * 2

live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  const s = spawn slot()
  drop await s.result()
  const n: Int = spawn twice(1)
