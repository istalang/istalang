# An Instance<T> is what spawn gives (§9): its result() copies the outcome out, so T must be
# sendable, and as a handle it never crosses to the host.

extern fn report(instance: Instance<Int>)

ista fn slot() -> Slot<Int>: Slot.create<Int>()

fn twice(n: Int) -> Int: n * 2

ista async fn main():
  const s = spawn slot()
  drop await s.result()
  const n: Int = spawn twice(1)
