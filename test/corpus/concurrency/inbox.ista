# outcome: "a:1 b:2 c:3 | x y z | first second"
# An inbox (§6) delivers each message to exactly one receiver, the one that has waited longest,
# and in commit order: sends within one segment keep their program order, and a segment that
# commits first is received first. `send` never waits.

import Inbox from 'inbox'
import * as time from 'time'

ista async fn worker(name: String, jobs: Inbox<Int>, results: Inbox<String>):
  const job = await jobs.receive()
  results.send(name + ":" + String(job))

ista async fn sendLater(box: Inbox<String>, wait: time.Duration, message: String):
  await time.delay(wait)
  box.send(message)

ista async fn collect(box: Inbox<String>, count: Int) -> String:
  let received: Array<String> = []
  while received.length() < count:
    received.push(await box.receive())
  received.join(" ")

ista async fn main() -> String:
  const jobs = Inbox.create<Int>()
  const results = Inbox.create<String>()
  _ = worker("a", jobs, results)
  _ = worker("b", jobs, results)
  _ = worker("c", jobs, results)
  jobs.send(1)
  jobs.send(2)
  jobs.send(3)
  const workers = await collect(results, 3)
  const ordered = Inbox.create<String>()
  ordered.send("x")
  ordered.send("y")
  ordered.send("z")
  const backlog = await collect(ordered, 3)
  const timed = Inbox.create<String>()
  _ = sendLater(timed, 4ms, "second")
  _ = sendLater(timed, 1ms, "first")
  workers + " | " + backlog + " | " + await collect(timed, 2)
