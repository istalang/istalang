# outcome: "Err panic: no stock; Ok 3"
# runtime.isolate runs a function as an instance of its own (§17.1): its panic comes back as an Err
# and terminates that instance, so the run fails nothing; its result comes back as an Ok.

import * as runtime from 'runtime'

fn stock(item: String) -> Int:
  if item == "": panic("no stock")
  item.length()

ista async fn checked(item: String) -> String:
  match await runtime.isolate(fn(): stock(item)):
    case Ok(value): "Ok " + value
    case Err(error): "Err " + error.code + ": " + error.message

live async fn main() -> String:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> String:
  await checked("") + "; " + await checked("pen")
