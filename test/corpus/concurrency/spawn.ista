# outcome: 3
# spawn (§9) starts a call as a new instance and goes on at once, from any function: a top-level
# function, async or not, a method, an instance of a generic function, or a value of a sendable
# function type, such as a lambda or local function capturing only sendable values. Its sendable
# arguments are copied into the new instance, which runs to its own outcome.

import * as time from 'time'

struct Order:
  id: Int
  items: Array<String>

fn total(self: Order) -> Int:
  self.items.length()

async fn ship(order: Order) -> Future<String>:
  await time.delay(1ms)
  String(order.id) + ":" + order.items.join(",")

fn echo<T>(value: T) -> T:
  value

fn startAll(order: Order):
  spawn ship(order)
  spawn order.total()

async fn main() -> Future<Int>:
  const order = Order{id: 7, items: ["a", "b"]}
  startAll(order)
  spawn echo<String>("hi")
  const bonus = 10
  const priced = fn(n: Int): n + bonus
  spawn priced(order.id)
  fn named(times: Int) -> Int:
    times * bonus
  spawn named(2)
  const stored: sendable fn(Int) -> Int = priced
  spawn stored(1)
  await time.delay(2ms)
  3
