# outcome: "b2 | none 1 | passes 3 | late | 0"
# select (§8): of the cases whose futures have resolved, the first wins, and `as` binds its value.
# Without `await` a select never waits: `else` runs when no case is ready. A future made once
# races again on every pass of a loop, and a case body may leave its function. The case bodies
# agree on one type, which an expected type decides.

import * as time from 'time'

ista async fn priority() -> String:
  const a = Slot.create<Int>()
  const b = Slot.create<Int>()
  await a.put(1)
  await b.put(2)
  await select:
    case b.read() as fromB:
      "b" + String(fromB)
    case a.read() as fromA:
      "a" + String(fromA)

ista fn tryTake(s: Slot<Int>) -> String:
  select:
    case s.read() as value:
      String(value)
    else:
      "none"

ista async fn passesBefore(deadline: Future<Unit, "ista">, stop: Slot<Unit>) -> Int:
  let passes = 0
  while true:
    const done = await select:
      case deadline:
        true
      case time.delay(1ms):
        false
    if done:
      break
    passes += 1
    if passes == 3:
      await stop.put(())
  passes

ista async fn leaving(s: Slot<String>) -> String:
  const got: String? = await select:
    case s.take() as message:
      message
    case time.delay(1ms):
      return "late"
  got ?? "none"

ista async fn main() -> String:
  const ready = Slot.create<Int>()
  const empty = Slot.create<Int>()
  await ready.put(1)
  const quick = tryTake(empty) + " " + tryTake(ready)
  const stop = Slot.create<Unit>()
  const passes = await passesBefore(stop.read(), stop)
  const late = await leaving(Slot.create<String>())
  const nothing: Int? = select:
    case empty.read() as value:
      value
    else:
      none
  await priority() + " | " + quick +  " | passes " + String(passes) + " | " + late + " | " + String(nothing ?? 0)
