# spawn (§9) starts a call as a new instance: an extern, a function taking a reference, a value of
# a plain function type, a call through `?.` and a function a constraint requires can't be spawned,
# and every argument, a method's receiver included, must be sendable.

import Inbox from 'inbox'
import * as time from 'time'

struct Job:
  box: Inbox<Int>

struct Id:
  value: Int

fn bump(n: &Int):
  n += 1

fn run(self: Job) -> Int:
  1

fn show(self: Id) -> Int:
  self.value

async fn main():
  let n = 1
  spawn 3
  spawn time.now()
  spawn bump(&n)
  const counting = fn(): n
  spawn counting()
  const maybe: Id? = none
  spawn maybe?.show()
  spawn takesBox(Inbox.create<Int>())
  _ = spawn Job{box: Inbox.create<Int>()}.run()

fn doubled<T is Addable & Sendable>(x: T):
  spawn add(x, x)

fn takesBox(box: Inbox<Int>):
  _ = box
