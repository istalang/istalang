# spawn (§17.1) takes a sendable function giving the new instance's outcome, which a deferred call
# gives it (§6.5): `spawn` of no call gives nothing to run. What the call computes now is copied
# into the new instance, so it can't pass a reference, nor capture anything unsendable, a value of a
# plain function type or a receiver included. An extern and a function a constraint requires are
# called in the new instance as anywhere.

import * as runtime from 'runtime'
import * as time from 'time'
import Inbox from 'inbox'

struct Job { box: Inbox<Int> }

struct Id { value: Int }

fn bump(n: &Int): n += 1

ista fn run(self: Job) -> Int: 1

fn show(self: Id) -> Int: self.value

live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  let n = 1
  spawn n
  spawn time.now()
  spawn bump(&n)
  const counting = fn(): n
  spawn counting()
  spawn takesBox(Inbox.create<Int>())
  _ = spawn Job{box: Inbox.create<Int>()}.run()

ista fn doubled<T is Addable & Sendable>(x: T): spawn add(x, x)

ista fn takesBox(box: Inbox<Int>): _ = box
