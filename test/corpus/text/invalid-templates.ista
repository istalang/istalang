# A template's values need a toString that gives a string, and a value inside their braces (§3.1). A
# tagged template is a call, so its values must fit the tag's parameters; a template with values
# isn't computed at compile time (§5.1).
struct Opaque:
  x: Int

struct Odd:
  x: Int

fn toString(self: Odd) -> Int:
  self.x

fn tag(parts: Array<String>, value: Int) -> String:
  parts[0]

const computed = `a ${1}`

fn main():
  const opaque = Opaque{x: 1}
  drop(`no text for ${opaque}`)
  drop(`odd ${Odd{x: 1}}`)
  drop(`empty ${}`)
  drop(tag`wrong ${"text"}`)
