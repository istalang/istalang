# outcome: "replied 42, 2 registered, 8 leaves"
# Static lifetimes accepts what talks without closing a cycle through a disposable (§7): a reply
# channel, a fresh inbox sent in a request to a server holding the requests; a registry of
# workers through weak references, each worker given the registry, which holds only a `WeakRef`
# to its future; and a recursive fan-out whose calls hold their children's futures.

import * as runtime from 'runtime'
import * as time from 'time'
import Inbox from 'inbox'

struct Ask { n: Int, reply: Inbox<Int> }

ista async fn server(requests: Inbox<Ask>):
  const ask = await requests.receive()
  ask.reply.send(ask.n * 2)

ista async fn asked(n: Int) -> Int:
  const requests = Inbox.create<Ask>()
  hold _ = server(requests)
  const reply = Inbox.create<Int>()
  requests.send(Ask{n, reply})
  await reply.receive()

shared struct Registry:
  workers: Array<WeakRef<Future<Unit, "ista">>> = []

ista async fn worker(registry: Registry):
  await time.delay(1h)
  _ = registry->workers.length()

ista fn register(registry: Registry) -> Future<Unit, "ista">:
  const f = worker(registry)
  registry->workers.push(WeakRef(f))
  f

ista async fn registered() -> Int:
  const registry = new Registry{}
  hold _ = register(registry)
  hold _ = register(registry)
  registry->workers.length()

ista async fn leaves(depth: Int) -> Int:
  if depth == 0: return 1
  const left = leaves(depth - 1)
  const right = leaves(depth - 1)
  (await left) + (await right)

live async fn main() -> String:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> String:
  const replied = await asked(21)
  const count = await registered()
  const fanned = await leaves(3)
  "replied " + String(replied) + ", " + String(count) + " registered, " + String(fanned) + " leaves"
