# outcome: "2 7 true false 3 a,b,c 1,2,30 a=1;b=2;c=30; true 2 true 3 false true"
# Maps (§3.3, §19.3): literals, a later equal key winning, spreads of maps and of entry tuples, safe
# `get`, `&self` methods, assignment through an index, iteration in the order keys were first
# set, and `==` that ignores that order.

import * as runtime from 'runtime'

live async fn main() -> String:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> String:
  let m = ["a": 1, "b": 2]
  const size = m.size()
  m["c"] = 3
  m["c"] = 30
  const more = [...m, "d": 7, "d": 7]
  const seven: Int? = more.get("d")
  const removed = m.delete("d")
  let text = ""
  for key, value in m: text = text + key + "=" + value + ";"
  let empty: Map<String, Int> = [:]
  empty["x"] = 1
  const pairs = [("b", 2), ("a", 1)]
  const parts = [
    String(size)
    String(more["d"])
    String(m.has("a"))
    String(removed)
    String(m.size())
    m.keys().join(",")
    [for v in m.values(): String(v)].join(",")
    text
    String(seven == 7)
    String(empty.size() + 1)
    String(["a": 1, "b": 2] == ["b": 2, "a": 1])
    String([...pairs, "z": 0].size())
    String(["a": 1] == ["a": 2])
    String(m.get("z") == none)
  ]
  parts.join(" ")
