# outcome: "2 7 true false 3 a,b,c 1,2,30 a=1;b=2;c=30; true 2 true 3 false true"
# Maps (§2, §3.8): literals, a later equal key winning, spreads of maps and of entry tuples, safe
# `get`, `&self` methods, assignment through an index, iteration in the order keys were first
# set, and `==` that ignores that order.

async fn main() -> Future<string>:
  let m = ["a": 1, "b": 2]
  const size = m.size()
  m["c"] = 3
  m["c"] = 30
  const more = [...m, "d": 7, "d": 7]
  const seven: int? = more.get("d")
  const removed = m.delete("d")
  let text = ""
  for key, value in m:
    text = text + key + "=" + value + ";"
  let empty: Map<string, int> = [:]
  empty["x"] = 1
  const pairs = [("b", 2), ("a", 1)]
  const parts = [
    string(size),
    string(more["d"]),
    string(m.has("a")),
    string(removed),
    string(m.size()),
    m.keys().join(","),
    [for v in m.values(): string(v)].join(","),
    text,
    string(seven == 7),
    string(empty.size() + 1),
    string(["a": 1, "b": 2] == ["b": 2, "a": 1]),
    string([...pairs, "z": 0].size()),
    string(["a": 1] == ["a": 2]),
    string(m.get("z") == none),
  ]
  parts.join(" ")
