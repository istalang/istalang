# panic: The map holds no such key.
# An element passed by `&` is read before its call (§7.3), so a key the map doesn't hold panics
# even when the callee only writes it; assigning `m[k] = v` adds the key instead.

import * as runtime from 'runtime'

fn reset(value: &Int): value = 0

live async fn main() -> Int:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Int:
  let m = ["a": 1]
  reset(&m["b"])
  m["b"]
