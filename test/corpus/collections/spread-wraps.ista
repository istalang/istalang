# outcome: "4 1 -1 b 1 1"
# An array literal's spread gives its items where the literal's items are expected, so each is
# wrapped into `T?` as an element would be (§2): an array's items, which are otherwise copied
# whole, a string's characters and a range's ints alike, as often as the optionals nest.

import * as runtime from 'runtime'
live async fn main() -> String: await runtime.run(runtime.id()) _main()
ista async fn _main() -> String:
  const xs = [1, 2]
  const ys: Array<Int?> = [0, ...xs, none]
  const letters: Array<String?> = [..."ab"]
  const range = 0..2
  const steps: Array<Int?> = [...range]
  const nested: Array<Int??> = [...xs]
  const parts = [
    String(ys.length())
    String(ys[1] ?? -1)
    String(ys[3] ?? -1)
    letters[1] ?? "-"
    String(steps[1] ?? -1)
    String((nested[0] ?? none) ?? -1)
  ]
  parts.join(" ")
