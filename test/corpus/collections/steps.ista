# outcome: "0 3 6 9|10 8 6 4 2 0|[]|[0, 2, 4]|[4, 3, 2, 1, 0]|[9, 1, 9, 3, 9]|true false true|ace"
# Range steps (§3.8, §3.9): the step's sign is the direction, `..=` reaches its end when a step
# lands on it, a range whose end lies the other way is empty, and slicing steps through the items,
# its open ends defaulting by the direction.

fn show(xs: Array<Int>) -> String:
  "[" + [for x in xs: String(x)].join(", ") + "]"

ista async fn main() -> String:
  let xs = [0, 1, 2, 3, 4]
  xs[0..5 by 2] = [9, 9, 9]
  const members = [4 in 0..10 by 2, 5 in 0..10 by 2, 10 in 10..=0 by -5]
  const parts = [
    [for i in 0..10 by 3: String(i)].join(" "),
    [for i in 10..=0 by -2: String(i)].join(" "),
    show([for i in 0..5 by -1: i]),
    show([0, 1, 2, 3, 4, 5][.. by 2]),
    show([0, 1, 2, 3, 4][.. by -1]),
    show(xs),
    [for member in members: String(member)].join(" "),
    "abcde"[.. by 2],
  ]
  parts.join("|")
