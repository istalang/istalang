# outcome: 0
# `Array` and `Map` satisfy `Default` (§19.3), so generic code asking for one gets it empty; the
# type argument of `Array.default<T>()` comes from the `Self` it must give (§8.4).

import * as runtime from 'runtime'

fn empty<T is Default>() -> T: T.default()

live async fn main() -> Int:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Int:
  const xs: Array<Int> = empty()
  const m = empty<Map<String, Int>>()
  xs.length() + m.size()
