# panic: The range 1..5 is out of range for an array of length 3.
# Replacing a span outside the bounds panics (§3.9), as reading one does.

import * as runtime from 'runtime'

live async fn main() -> Int:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Int:
  let xs = [1, 2, 3]
  xs[1..5] = [1]
  xs.length()
