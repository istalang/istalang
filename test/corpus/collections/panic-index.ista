# panic: Index 5 is out of range for an array of length 2.
# Indexing outside an array's bounds is a bug in the program, so it panics (§19.3, §12).

import * as runtime from 'runtime'

live async fn main() -> Int:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Int:
  const xs = [1, 2]
  xs[5]
