# error: 5306 at 18:3
# A collection runs its `index` and `setIndex` at once, inside the place or literal that needs
# them, so neither may be async (§3.9).

struct Bag { values: Map<string, int> }

fn Bag.default() -> Bag:
  Bag{values: [:]}

fn index(self: Bag, key: string) -> int:
  self.values[key]

async fn setIndex(self: &Bag, key: string, value: int):
  self.values[key] = value

async fn main():
  let bag = Bag{values: [:]}
  bag["a"] = 1
