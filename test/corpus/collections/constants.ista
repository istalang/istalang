# outcome: "3 2 b 4 7 2 3 [1, 2]"
# Top-level constants may be arrays and maps built from literals and from spreads of other array
# and map constants, and ranges, structs built from literals (§5.1), and every instance shares their
# values, which a change to a copy must leave alone (§7.2).

import * as runtime from 'runtime'

const primes = [2, 3, 5]
const names = ["a": "first", "b": "second"]
const nested = [[1, 2], [3, 4]]
const more = [...primes, 7]
const lookup = [...names, "c": "third", "a": "again"]
const empty: Map<String, Int> = []
const window = 1..4

live async fn main() -> String:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> String:
  let copy = primes
  copy[0] = 9
  copy.push(7)
  let total = 0
  for i in window: total += i
  const parts = [
    String(primes.length())
    String(primes[0])
    if names["b"] == "second": "b" else: "?"
    String(nested[1][1])
    String(total + copy.length() - 2 - 1)
    String(more.length() + empty.size() - 2)
    String(lookup.size())
    "[" + [for x in nested[0]: String(x)].join(", ") + "]"
  ]
  parts.join(" ")
