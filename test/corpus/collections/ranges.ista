# outcome: "10 6 [] [1, 2] [1, 2, 3] [5, 6] [0, 9, 9, 9, 4] [3, 4] 0"
# Ranges (§2, §3.8, §3.9): half-open and inclusive, open at either end when slicing, iterated when
# both ends are given, and replacing a span of an array with an array of another length.

fn show(xs: Array<Int>) -> String:
  "[" + [for x in xs: String(x)].join(", ") + "]"

async fn main() -> String:
  let total = 0
  for i in 0..5:
    total += i
  let inclusive = 0
  for i in 1..=3:
    inclusive += i
  let xs = [0, 1, 2, 3, 4]
  const copy = xs[1..3]
  xs[1..4] = [9, 9, 9]
  let backwards = 0
  for _ in 5..2:
    backwards += 1
  const parts = [
    String(total),
    String(inclusive),
    show([for i in 3..3: i]),
    show(copy),
    show([1, 2, 3][..]),
    show([4, 5, 6][1..]),
    show(xs),
    show([1, 2, 3, 4][2..]),
    String(backwards),
  ]
  parts.join(" ")
