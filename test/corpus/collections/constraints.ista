# outcome: "6 6 a 2"
# Generic code iterates and indexes a value through its constraints (§3.10): `for` calls the
# `iterate` that `Iterable` requires, and indexing the `index` that `Indexable` requires. Map keys
# that are equal (§3.9) find each other whatever order their maps were built in.

fn total<C is Iterable<int>>(collection: C) -> int:
  let sum = 0
  for x in collection:
    sum += x
  sum

fn first<C is Indexable<int, string>>(collection: C) -> string:
  collection[0]

async fn main() -> Future<string>:
  const forward = ["\u{e9}": 1, "e\u{301}": 1]
  const backward = ["e\u{301}": 1, "\u{e9}": 1]
  const nested = [forward: 7]
  const parts = [
    string(total([1, 2, 3])),
    string(total(1..4)),
    first(["a", "b"]),
    string(if nested.has(backward): 2 else: 0),
  ]
  parts.join(" ")
