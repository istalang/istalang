# outcome: "6 6 a 2"
# Generic code iterates and indexes a value through its constraints (§8.4): `for` calls the
# `iterate` that `Iterable` requires, and indexing the `index` that `Indexable` requires. Map keys
# that are equal (§10.2) find each other whatever order their maps were built in.

import * as runtime from 'runtime'

fn total<C is Iterable<Int>>(collection: C) -> Int:
  let sum = 0
  for x in collection: sum += x
  sum

fn first<C is Indexable<Int, String>>(collection: C) -> String:
  collection[0]

live async fn main() -> String:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> String:
  const forward = ["\u{e9}": 1, "e\u{301}": 1]
  const backward = ["e\u{301}": 1, "\u{e9}": 1]
  const nested = [forward: 7]
  const parts = [
    String(total([1, 2, 3]))
    String(total(1..4))
    first(["a", "b"])
    String(if nested.has(backward): 2 else: 0)
  ]
  parts.join(" ")
