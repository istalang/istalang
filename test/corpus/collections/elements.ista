# outcome: "[10, 2] 5 [[0, 7], [0, 0]] 3 [1, 2, 3] [4] 11 [1, 2]"
# Elements are places (§7.3, §10.2): assigned whole, in part through a field, nested, compounded,
# passed by `&`, and changed by a method taking `&self`. A copy taken before is untouched (§7.2).

import * as runtime from 'runtime'

struct Item { count: Int }

fn bump(value: &Int): value += 1

fn show(xs: Array<Int>) -> String:
  "[" + [for x in xs: String(x)].join(", ") + "]"

live async fn main() -> String:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> String:
  let xs = [1, 2]
  const before = xs
  xs[0] = 10
  let items = [Item{count: 4}]
  items[0].count += 1
  let grid = [[0, 0], [0, 0]]
  grid[0][1] = 7
  let counts = ["a": 2]
  counts["a"] += 1
  let lists: Map<String, Array<Int>> = ["x": [1, 2]]
  lists["x"].push(3)
  lists["y"] = []
  lists["y"].push(4)
  let n = [10]
  bump(&n[0])
  const parts = [
    show(xs)
    String(items[0].count)
    "[" + [for row in grid: show(row)].join(", ") + "]"
    String(counts["a"])
    show(lists["x"])
    show(lists["y"])
    String(n[0])
    show(before)
  ]
  parts.join(" ")
