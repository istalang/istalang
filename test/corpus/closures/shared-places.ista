# outcome: "24 a,b | 12 | 8 1"
# The value behind a handle, `*x`, and any part of it, such as `x->f`, is a place (§7.3, §10.2):
# passed by `&`, or changed by a method taking `&self`, it is copied in and written back when the
# call returns. A whole `*x` is written alone, assigned on its own or among other targets.

import * as runtime from 'runtime'

struct Counter { n: Int, items: Array<String> }

fn bump(n: &Int): n += 1

live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  const c = new Shared{value: Counter{n: 1, items: []}}
  bump(&c->value.n)
  c->value.items.push("a")
  (*c).value.items.push("b")
  c->value.n += 10
  const read = c->value.n
  c->value = Counter{...c->value, n: c->value.n * 2}
  const meter = new Shared{value: 5}
  meter->value = 7
  let a = 0
  a, meter->value = (1, 8)
  String(c->value.n) + " " + c->value.items.join(",") + " | " + String(read) + " | " + String(meter->value) + " " + String(a)
