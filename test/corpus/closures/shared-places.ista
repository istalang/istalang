# outcome: "24 a,b | 12 | 8 1"
# The value behind a handle, `*x`, and any part of it, such as `x->f`, is a place (§3.7, §3.9):
# passed by `&`, or changed by a method taking `&self`, it is copied in and written back when the
# call returns. A whole `*x` is written alone, assigned on its own or among other targets.

struct Counter { n: int; items: Array<string> }

fn bump(n: &int):
  n += 1

async fn main():
  const c = Shared(Counter{n: 1, items: []})
  bump(&c->n)
  c->items.push("a")
  (*c).items.push("b")
  c->n += 10
  const read = c->n
  *c = Counter{...*c, n: c->n * 2}
  const meter = Shared(5)
  *meter = 7
  let a = 0
  a, *meter = (1, 8)
  string(c->n) + " " + c->items.join(",") + " | " + string(read) + " | " + string(*meter) + " " + string(a)
