# A Shared value is written with values of the type `*x` reads (§3.8, §3.9), whole or in part, and
# its fields are read with `->`, never `.`; only a handle has a value behind it. A handle's value
# passed by `&` is a copy for the call (§3.7): never to an async function, and never beside
# another place reached through a handle, since two handles may be one.

struct Counter { n: int }

fn both(a: &int, b: &int):
  a += b

async fn later(n: &int):
  n += 1

async fn subject():
  const c = Shared(Counter{n: 1})
