# outcome: "true false 8 120 true false"
# A top-level const may be a lambda (§3, §3.14): it reads other constants and captures nothing,
# so it is one function value, made once, also inside an array; a named lambda calls itself by
# its own name. A constant's function value equals itself and no other.

const limit = 10

const isLarge = fn(amount: Int): amount > limit

const ops = [fn(x: Int): x + 1, fn(x: Int): x * 2]

const fact: fn(Int) -> Int = fn me(n): if n < 2: 1 else: n * me(n - 1)

ista async fn main():
  const same = isLarge == isLarge
  const other = ops[0] == ops[1]
  String(isLarge(11)) + " " + String(isLarge(3)) + " " + String(ops[1](4)) + " " + String(fact(5)) + " " + String(same) + " " + String(other)
