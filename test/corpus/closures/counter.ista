# outcome: "1 2 3 | 3 | 1 13"
# disable-ista-formatter
# A closure shares the `let`s it captures with the code around it (§3.14): `next` counts on the
# `count` of the call that made it, a copy of the closure shares that count, and a change made
# outside after the closure was made is seen inside it. Each call of `makeCounter` has its own.

fn makeCounter(start: Int) -> fn() -> Int:
  let count = start
  fn next() -> Int:
    count += 1
    count
  next

fn shared() -> String:
  let total = 0
  const add = fn(n: Int): { total += n; total }
  const first = add(1)
  total += 10
  String(first) + " " + String(add(2))

import * as runtime from 'runtime'
live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  const next = makeCounter(0)
  const alias = next
  const a = next()
  const b = alias()
  const other = makeCounter(2)
  const c = next()
  String(a) + " " + String(b) + " " + String(c) + " | " + String(other()) + " | " + shared()
