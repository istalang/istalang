# outcome: "Ares K a@x | 12 | true false | 3"
# A Shared value is a handle (§3.8): every copy reads and writes one value through `$`. Writing
# a part, `u$.name = v`, reads the value, changes it, and writes it back (§3.9); a compound
# assignment does the same. Handles compare by identity. A closure's captured `let` lives in a
# Shared cell of its own, but a Shared value captured by a `const` is still one handle (§3.14).

struct User { name: string; email: string }

struct Pair { first: int; second: int }

fn rename(user: Shared<User>, name: string):
  user->value.name = name

async fn main():
  const u = new Shared{value: User{name: "Ares", email: "a@x"}}
  const alias = u
  rename(alias, "Ares K")
  const shown = u->value.name + " " + u->value.email
  const counts = new Shared{value: Pair{first: 1, second: 2}}
  counts->value.first += 9
  counts->value = Pair{...counts->value, second: counts->value.second}
  const total = counts->value.first + counts->value.second
  const other = new Shared{value: User{name: "Ares K", email: "a@x"}}
  const same = string(alias == u) + " " + string(other == u)
  const tally = new Shared{value: 0}
  const bump = fn(): { tally->value += 1; tally->value }
  const ignored = bump() + bump()
  shown + " | " + string(total) + " | " + same + " | " + string(bump())
