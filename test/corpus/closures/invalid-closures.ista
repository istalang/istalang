# A lambda or local function is one value (§3.14): no default values, rest parameters or type
# parameters. A parameter's type must be written or come from the expected function type; a
# local function calling itself declares its result. A closure can't capture a reference, written
# or taken from the expected function type, and `break`, `continue` and `await` belong to the
# innermost function. A name of several functions needs an expected function type; a method is
# called, not taken as a value; `x.f()` naming both a field and a method is ambiguous. Only a
# function is called, with its parameters' number and types, a reference's exactly.

struct Op { run: fn(Int) -> Int }

fn run(self: Op, n: Int) -> Int: n

fn double(self: Int) -> Int: self * 2

fn pick(n: Int) -> Int: n

fn pick(s: String) -> String: s

ista async fn subject(r: &Int, op: Op, n: Int):
  const d = fn(x: Int = 1): x
  fn g<T>(x: T) -> T: x
  fn h(...xs: Int): 0
  const untyped = fn x: x
  fn again(k: Int):
    if k > 0: again(k - 1)

  const reads = fn(): r + 1
  while n > 0:
    const leave = fn(): {
      if n > 1: break
      await later(n)
    }
  const chosen = pick
  const method = n.double
  const both = op.run(1)
  const value = n(1)
  const arity = (op.run)(1, 2)
  const typed = (op.run)("a")

ista async fn later(n: Int) -> Int: n

fn bumped(f: fn(&Int) -> Int) -> Int:
  let n = 1
  f(&n)

fn inferred() -> Int: bumped(fn x: { const g = fn(): x; g() })

fn clear(r: &Int?): r = none

fn throughValue() -> Int:
  let x = 1
  const f: fn(&Int?) -> Unit = clear
  f(&x)
  x
