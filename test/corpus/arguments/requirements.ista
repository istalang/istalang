# outcome: [21,21,25,3,1]
# A call through a requirement binds its arguments against the required function's parameters
# (§3.10): named, in any order, through a constraint and through an `any` value alike; a function
# meeting it may take more parameters, each with a default it computes; and a rest parameter
# reaches it as one array.
trait Shape:
  fn area(self: Self, scale: int, offset: int) -> int
  fn count(self: Self, ...parts: Array<int>) -> int

struct Square { side: int }

fn area(self: Square, scale: int, offset: int, extra: int = 0) -> int:
  self.side * scale + offset + extra

fn count(self: Square, ...parts: Array<int>) -> int:
  parts.length()

fn measure<T is Shape>(shape: T) -> int:
  shape.area(offset: 1, scale: 10)

fn measureLater<T is Shape>(shape: T) -> int:
  shape.area(10, offset: 5)

fn counted<T is Shape>(shape: T) -> int:
  shape.count(1, ...[2, 3])

async fn main() -> Future<Array<int>>:
  const square = Square{side: 2}
  const any: any Shape = square
  [measure(square), any.area(offset: 1, scale: 10), measureLater(square), counted(square), any.count(...[7])]
