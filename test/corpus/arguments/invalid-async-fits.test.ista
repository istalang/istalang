# An async function never fits a plain function type, and a plain one fits an async type (§6.4),
# inside a value type too (§8.1), but an async one never fits made async again; a mock never makes
# its target async (§18). A plain lambda's `return`s give the future's value, as its body does.
# A rest overload clashes with another one when a call fits both alike (§6.3), and so do overloads
# on the two spellings of one function type.
import * as testing from 'testing'

fn plain() -> Int: 1
ista async fn later() -> Int: 1

fn sum(first: Int, ...more: Array<Int>) -> Int: first
fn sum(...all: Array<Int>) -> Int: 0

ista fn main():
  const wanted: fn() -> Int = later
  drop (testing.mock<(), Future<Int, "ista">>(plain, later))
  const twice: ista async fn() -> Future<Int, "ista"> = later
  const xs: Array<(ista async fn() -> Int) | String> = [later]
  const ys: Array<(ista async fn() -> Future<Int, "ista">) | String> = xs
  const disagreeing: ista async fn(Int) -> Int = fn x: {
    if x > 0: return "wrong"
    1
  }

fn take(f: ista fn() -> Future<Int, "ista">) -> Int: 0
fn take(f: ista async fn() -> Int) -> Int: 1
