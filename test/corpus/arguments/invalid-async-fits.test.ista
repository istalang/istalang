# An async function never fits a plain function type, and a plain one fits an async type (§3.14),
# inside a value type too (§3.5), but an async one never fits made async again; a mock never makes
# its target async (§10). A plain lambda's `return`s agree, as its body's value does. A rest
# overload clashes with another one when a call fits both alike (§3.7), and so do overloads on the
# two spellings of one function type.
import * as testing from 'testing'

fn plain() -> Int: 1
async fn later() -> Future<Int>: 1

fn sum(first: Int, ...more: Array<Int>) -> Int: first
fn sum(...all: Array<Int>) -> Int: 0

fn main():
  const wanted: fn() -> Int = later
  drop(testing.mock<(), Future<Int>>(plain, later))
  const twice: async fn() -> Future<Int> = later
  const xs: Array<(async fn() -> Int) | String> = [later]
  const ys: Array<(async fn() -> Future<Int>) | String> = xs
  const disagreeing: async fn(Int) -> Int = fn(x): {
    if x > 0:
      return "wrong"
    1
  }

fn take(f: fn() -> Future<Int>) -> Int: 0
fn take(f: async fn() -> Int) -> Int: 1
