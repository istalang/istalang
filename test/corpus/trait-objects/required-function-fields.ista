# outcome: [3,5,7]
# A field of a function type a trait requires is called as `x.f(…)` through a type parameter or an
# `any` value, as a struct's own is (§8.3, §6.4).

import * as runtime from 'runtime'

trait Runs { run: fn(Int) -> Int }

struct Adder { run: fn(Int) -> Int }

fn apply<T is Runs>(value: T, n: Int) -> Int: value.run(n)

live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  const one = Adder{run: fn(n: Int): n + 1}
  const two: any Runs = Adder{run: fn(n: Int): n + 2}
  (apply(one, 2), two.run(3), apply(two, 5))
