# A trait an `any` type takes is object safe: its functions take Self first and nowhere else, none
# is static, and no field is built from Self (§8.3). Its traits are a set of traits.

trait Same { fn same(self: Self, other: Self) -> Bool }

trait Zero { fn Self.zero() -> Self }

trait Copied { fn copied(self: Self) -> Self }

trait Counted { fn count(n: Int) -> Int }

trait Linked { next: Self? }

trait Named { fn name(self: Self) -> String }

fn same(x: any Same): ()

fn zero(x: any Zero): ()

fn copied(x: any Copied): ()

fn counted(x: any Counted): ()

fn linked(x: any Linked): ()

fn twice(x: any Named & Named): ()

fn number(x: any Int): ()

fn comparable(x: any Comparable): ()

fn iterable(x: any Iterable<Int>): ()
