# outcome: [["email to a","sms","decided by legal","other","marker"],true,"a"]
# An `any` value is matched against its own type (§3.10): a struct pattern, a struct without
# fields, or a qualified variant, then the rest of the pattern against the value inside; `as`
# binds that value, of its own type.

trait Named:
  fn name(self: Self) -> String

struct Email { to: String }
struct Sms { number: String }
struct Marker {}
enum Decision:
  Approved(by: String)
  Expired

fn name(self: Email) -> String: self.to
fn name(self: Sms) -> String: self.number
fn name(self: Marker) -> String: "marker"
fn name(self: Decision) -> String: "decision"

fn describe(x: any Named) -> String:
  match x:
    case Email{to}:
      "email to " + to
    case Sms{number} as sms:
      if sms.name() == number: "sms" else: "?"
    case Decision.Approved{by}:
      "decided by " + by
    case Marker:
      "marker"
    case _:
      "other"

async fn main():
  const items: Array<any Named> = [Email{to: "a"}, Sms{number: "1"}, Decision.Approved{by: "legal"}, Decision.Expired, Marker]
  const email: any Named = Email{to: "a"}
  const found = if email is Email{to}: to else: "none"
  ([for item in items: describe(item)], email is Email{}, found)
