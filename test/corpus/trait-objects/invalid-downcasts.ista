# Matching an `any` value against what its value can't be (§3.10): a type not meeting its traits,
# a generic one, which a pattern can't give type arguments, a literal or an anonymous struct; and
# a `match` that covers only some of its types, an open set, without `case _`.

trait Named:
  fn name(self: Self) -> String

struct Email { to: String }
struct Plain { text: String }
struct Box<T> { value: T }

fn name(self: Email) -> String: self.to
fn name<T>(self: Box<T>) -> String: "box"

fn describe(x: any Named) -> String:
  match x:
    case Email{to}:
      to

fn never(x: any Named) -> Bool:
  x is Plain{}

fn generic(x: any Named) -> Bool:
  x is Box{}

fn literal(x: any Named) -> Bool:
  x is "a"

fn anonymous(x: any Named) -> Bool:
  x is struct{to}
