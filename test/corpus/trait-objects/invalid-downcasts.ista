# Matching an `any` value against what no pattern names (§8.3): a generic type, which a pattern
# can't give type arguments, or an anonymous struct; and a `match` that covers only some of its
# types, an open set, without `case _`. A type never inside it is only warned of (§11.3).

trait Named { fn name(self: Self) -> String }

struct Email { to: String }
struct Plain { text: String }
struct Box<T> { value: T }

fn name(self: Email) -> String: self.to
fn name<T>(self: Box<T>) -> String: "box"

fn describe(x: any Named) -> String:
  match x:
    case Email{to}: to

fn generic(x: any Named) -> Bool: x is Box{}

fn anonymous(x: any Named) -> Bool: x is struct{to}
