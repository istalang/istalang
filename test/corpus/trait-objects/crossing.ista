# An `any` type is sendable only when its traits make it so, and has no JSON form (§8.3, §17.4).
import * as json from 'json'
import * as runtime from 'runtime'

trait Named { fn name(self: Self) -> String }

struct Email { to: String }
struct Callback { run: fn() -> Unit }

fn name(self: Email) -> String: "email " + self.to

fn name(self: Callback) -> String: "callback"

ista async fn greet(x: any Named): ()

ista async fn greetSendable(x: any Named & Sendable): ()

live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  const email: any Named = Email{to: "a"}
  spawn greet(email)
  spawn greetSendable(Email{to: "b"})
  const callback: any Named & Sendable = Callback{run: fn(): ()}
  json.encode(email)
  const sendable: any Named & Sendable = Email{to: "c"}
  json.encode(sendable)
