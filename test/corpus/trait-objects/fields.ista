# outcome: [3,"b"]
# A field a trait requires is read through an `any` value from the value's own type (§3.10).

trait Sized:
  size: int

struct Box { size: int; label: string }
struct Pair { first: string; size: int }

async fn main():
  const items: Array<any Sized> = [Box{size: 1, label: "a"}, Pair{first: "b", size: 2}]
  const pair = Pair{first: "b", size: 2}
  (items[0].size + items[1].size, pair.first)
