# outcome: ["p5","atrue","as"]
# A function a trait requires may be generic with constraints of its own (§3.10): called through
# a type parameter or an `any` value, its type arguments meet them where the call is.

trait Shower:
  fn show<U is Stringable>(self: Self, u: U) -> String

struct Box { label: String }

fn show<U is Stringable>(self: Box, u: U) -> String:
  self.label + String(u)

fn viaParameter<T is Shower>(x: T) -> String:
  x.show(5)

async fn main():
  const shower: any Shower = Box{label: "a"}
  (viaParameter(Box{label: "p"}), shower.show(true), shower.show("s"))
