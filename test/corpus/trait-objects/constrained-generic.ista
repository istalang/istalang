# outcome: ["p5","atrue","as"]
# A function a trait requires may be generic with constraints of its own (§8.2): called through
# a type parameter or an `any` value, its type arguments meet them where the call is.

import * as runtime from 'runtime'

trait Shower:
  fn show<U is Stringable>(self: Self, u: U) -> String

struct Box { label: String }

fn show<U is Stringable>(self: Box, u: U) -> String:
  self.label + String(u)

fn viaParameter<T is Shower>(x: T) -> String: x.show(5)

live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  const shower: any Shower = Box{label: "a"}
  (
    viaParameter(Box{label: "p"})
    shower.show(true)
    shower.show("s")
  )
