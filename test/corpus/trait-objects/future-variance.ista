# outcome: [2,4]
# A trait whose function gives a future varies in what the future gives, whether the function is
# async or a plain one giving a future, one type (§3.5, §3.14): a call through the `any` type
# a wider argument stands for awaits the future and converts its value.
trait Started<T>:
  fn started(self: Self) -> Future<T>

trait Later<T>:
  async fn later(self: Self) -> Future<T>

struct Counter { n: Int }

async fn bumped(n: Int) -> Future<Int>: n + 1

fn started(self: Counter) -> Future<Int>: bumped(self.n)
async fn later(self: Counter) -> Future<Int>: self.n + 3

async fn main() -> Future<Array<Int?>>:
  const counter: any Started<Int?> = Counter{n: 1}
  const later: any Later<Int?> = Counter{n: 1}
  [await counter.started(), await later.later()]
