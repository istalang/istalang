# outcome: [4,5,6,3,7,8,9,2,11]
# A value meeting one instantiation of a trait goes into an `any` type of another that the trait's
# variance lets stand for it (§3.10): one only giving what its argument names (`Source`) for a wider
# argument, one only taking it (`Sink`) for a narrower one. A call through it converts what it gives
# and takes, a field it requires is read converted, and a downcast finds the value's own type.

trait Source<T>:
  fn next(self: Self) -> T

trait Sink<T>:
  fn put(self: Self, x: T) -> Int

trait Sized<T>:
  size: T

trait Later<T>:
  ista async fn later(self: Self) -> T

struct Counter { n: Int, size: Int }
struct OptionalSink { k: Int }
struct Holder<T> { source: any Source<T> }

fn next(self: Counter) -> Int: self.n
ista async fn later(self: Counter) -> Int: self.n + 1
fn put(self: OptionalSink, x: Int?) -> Int: (x ?? 100) + self.k

fn fromBound<T is Source<Int>>(source: T) -> any Source<Int?>: source

ista async fn main():
  const narrow: any Source<Int> = Counter{n: 4, size: 0}
  const wide: any Source<Int?> = narrow
  const direct: any Source<Int?> = Counter{n: 5, size: 0}
  const found = match direct:
    case Counter as counter: counter.n + 1
    case _: 0
  const sink: any Sink<Int> = OptionalSink{k: 1}
  const sized: any Sized<Int?> = Counter{n: 0, size: 7}
  const holder: Holder<Int> = Holder{source: Counter{n: 8, size: 0}}
  const widened: Holder<Int?> = holder
  const sources: Array<any Source<Int>> = [Counter{n: 9, size: 0}]
  const all: Array<any Source<Int?>> = sources
  const later: any Later<Int?> = Counter{n: 1, size: 0}
  (
    wide.next(),
    direct.next(),
    found,
    sink.put(2),
    sized.size,
    widened.source.next(),
    all[0].next(),
    await later.later(),
    fromBound(Counter{n: 11, size: 0}).next(),
  )
