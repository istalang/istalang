# A trait's variance lets an `any` type stand for another only one way (§3.10): a trait taking what
# its argument names for a narrower one, giving it for a wider one, and one doing both for none. A
# value meeting two instantiations that fit, neither closer, goes into neither. A type meets a trait
# with its own functions, never through one taking a wider type (§3.10's coherence).

trait Source<T>:
  fn next(self: Self) -> T

trait Sink<T>:
  fn put(self: Self, x: T) -> Int

trait Cell<T>:
  fn get(self: Self) -> T
  fn set(self: Self, x: T) -> Int

trait Shown:
  fn shown(self: Self) -> String

struct Either { k: Int }

fn put(self: Either, x: Int?) -> Int: 1
fn put(self: Either, x: Int | String) -> Int: 2
fn shown(self: Array<Int?>) -> String: "array"

fn widenSink(sink: any Sink<Int>) -> any Sink<Int?>: sink
fn narrowSource(source: any Source<Int?>) -> any Source<Int>: source
fn widenCell(cell: any Cell<Int>) -> any Cell<Int?>: cell
fn closest() -> any Sink<Int>: Either{k: 0}
fn throughWider(xs: Array<Int>) -> any Shown: xs
