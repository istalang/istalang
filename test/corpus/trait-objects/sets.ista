# outcome: ["email a","none",true,"x/x"]
# `any T?` is `(any T)?`, and the traits of an `any` type are a set whose order doesn't matter (§8.3).

import * as runtime from 'runtime'

trait Named { fn name(self: Self) -> String }

trait Tagged { fn tag(self: Self) -> String }

struct Email { to: String }

fn name(self: Email) -> String: "email " + self.to
fn tag(self: Email) -> String: "x"

fn first(x: any Named?) -> String: x?.name() ?? "none"

fn flip(x: any Tagged & Named) -> any Named & Tagged: x

live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  const some: any Named? = Email{to: "a"}
  const nothing: any Named? = none
  const both: any Named & Tagged = Email{to: "a"}
  const flipped = flip(both)
  (first(some), first(nothing), flipped == both, flipped.tag() + "/" + flipped.tag())
