# Every instance's entry carries the annotations of a field and of a function, their values
# computed once for the declaration (§3.16), so they name none of its type parameters, written or
# reached through another; a struct declaration's annotations, which no instance carries, may, held
# to the annotation's constraints. Holds and Keeps stand only on the std's externs.

import Encodable from 'json'
import Holds, Keeps from 'lifetimes'

struct Tag<T>
struct CheckedTag<T is Encodable>

@Tag<T>
struct Box<T> { size: Int @Tag<Int>, item: T @Tag<T> }

enum Opt<U> { Some(value: U @Tag<Array<U>>), Empty }

@Tag<(U, Int)>
fn helper<U>(u: U) -> Int: 1

@Tag<Box<U>>
@Tag<Int>
fn pair<U>(u: U) -> Int: 2

@Tag<Int>
fn plain<U>(u: U) -> Int: 3

@CheckedTag<T>
struct Unchecked<T> { item: T }

@Holds<()>
extern struct HostHandle<T>

@Keeps{["x": ["x"]]}
extern fn hostKeep(x: Int)
