# What an extern the host implements takes and gives crosses as JSON (§3.6, §9): its parameters
# must be Encodable, and its result, what a future it returns gives, and an extern constant
# Decodable. A function, a handle and a type parameter not constrained so aren't, and JSON can't be
# written back, so nothing is taken by '&'. A host handle crosses only when it is 'sendable' or a
# 'dispose' makes it a resource (invalid-resources.ista).

import * as runtime from 'runtime'
import Decodable, Encodable from 'json'

extern shared struct Connection

extern fn run(task: fn() -> Int)

extern live async fn later() -> fn() -> Int

extern fn bump(count: &Int)

extern fn keep<T>(value: T)

extern slot: Slot<Int>

extern fn open() -> Connection

extern fn send<T is Encodable>(value: T)

extern live async fn receive<T is Decodable>() -> T

live async fn main(): await runtime.run(runtime.id()) _main()
ista async fn _main():
  send(1)
  await runtime.delegate receive<String>()
