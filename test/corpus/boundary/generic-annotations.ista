# outcome: 3
# An annotation is a struct value of any struct (§3.16): a generic one without fields is given
# its type arguments as its value is (§3.1). A struct declaration takes any annotation, kept for
# tools, and sees its type parameters; a field's and a function's name the types they mean, on
# their own line or before their item on its line.

import * as runtime from 'runtime'

struct Tag<T>

struct Note:
  text: String

@Tag<T>
@Note{"kept for tools"}
struct Box<T>:
  item: T @Tag<Box<Int>>

@Tag<(Int, String)> fn unboxed<U>(box: Box<U>, _tag: Tag<U>) -> U:
  box.item

live async fn main() -> Int: await runtime.run(runtime.id()) _main()
ista async fn _main() -> Int:
  const tag: Tag<Int> = Tag<Int>
  const same = tag == Tag
  unboxed(Box{item: if same: 3 else: 0}, Tag)
