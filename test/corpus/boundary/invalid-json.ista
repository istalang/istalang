import * as json from 'json'
import JsonName from 'json'

struct Point:
  x: Int

struct Label:
  text: String

fn toJson(self: Label) -> json.Json:
  json.encode(self.text)

enum Event:
  Typed(kind: String @JsonName{"_type"})

fn uses():
  const add = fn(n: Int): n + 1
  _ = json.stringify(add)
