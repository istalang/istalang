# outcome: {"at":"2026-10-25T12:00:00.000Z","big":"123456789012345678901234567890","due":"PT1H30M","items":[{"qty":2,"sku":"a"}],"note":null,"order_id":"o1","pair":[3,true],"price":"12.50 EUR","ratio":null,"raw":{"keep":[1,"two",null]},"shape":{"radius":1.5,"type":"Circle"},"tags":{"10":1,"9":2}}
# The JSON form (§9) of every kind of field, written as main's outcome: a @JsonName, structs in an
# array, none as null, a map with int keys written by toString, an enum with its "type" tag, a
# tuple, a Duration and a Time in ISO 8601, a @JsonBigInt int as a string, NaN as null, a struct
# declaring its own toJson as what that gives, and a Json value as itself. The @JsonSkip field is
# left out, and every object's keys are sorted as strings, a struct's fields and a map's keys alike.

import * as time from 'time'
import JsonName, JsonSkip, JsonBigInt, Json, encodeText from 'json'

struct Item:
  sku: String
  qty: Int

enum Shape:
  Circle { radius: Float }
  Dot

struct Money:
  cents: Int
  currency: String

fn toString(self: Money) -> String:
  String(self.cents // 100) + "." + String(self.cents % 100) + " " + self.currency

fn toJson(self: Money) -> Json:
  encodeText(self)

struct Order:
  id: String @JsonName{"order_id"}
  items: Array<Item>
  note: String?
  tags: Map<Int, Int>
  shape: Shape
  pair: (Int, Bool)
  due: time.Duration
  at: time.Time
  big: Int @JsonBigInt
  ratio: Float
  price: Money
  raw: Json
  cache: Map<String, Int> @JsonSkip

async fn main() -> Future<Order>:
  Order{
    id: "o1",
    items: [Item{sku: "a", qty: 2}],
    note: none,
    tags: [9: 2, 10: 1],
    shape: Circle{radius: 1.5},
    pair: (3, true),
    due: 90m,
    at: time.Time{value: 1792929600000},
    big: 123456789012345678901234567890,
    ratio: 0.0 / 0.0,
    price: Money{cents: 1250, currency: "EUR"},
    raw: ["keep": [1, "two", none]],
    cache: ["unused": 1],
  }
