# outcome: ["round trip","none, unknown fields ignored","$.items[0].qty: expected an integer, found a string","$.id: missing","$.shape._type: names no variant 'Square'","$.pair: expected 2 elements, found 1","$.due: 'P1Y' is not an ISO 8601 duration.","$.tags.x: 'x' is not an Int.","$.items[0].qty: expected an integer, found a number","json","123456789012345678901234567890","skipped 7"]
# Reading JSON back by the declared type (§9): what stringify writes parses to an equal value, a
# missing optional field is none and an unknown one is ignored, and a mismatch is an Err whose
# message names the path of the first part that doesn't fit, a struct's fields read in name order
# (§3.1); text that isn't JSON is an Err with code json. A @JsonBigInt field reads the string of digits it was written as, and a @JsonSkip field
# reads back as its type's default().

import * as json, JsonBigInt, JsonSkip from 'json'
import * as runtime from 'runtime'
import * as time from 'time'

struct Item { sku: String, qty: Int }

enum Shape { Circle(radius: Float), Dot }

struct Order:
  id: String
  items: Array<Item>
  note: String?
  tags: Map<Int, Int>
  shape: Shape
  pair: (Int, Bool)
  due: time.Duration

struct Big { value: Int @JsonBigInt }

struct Counter { count: Int }

fn Counter.default() -> Counter: Counter{count: 7}

struct Tally { name: String, counter: Counter @JsonSkip }

fn failure(text: String) -> String:
  match json.parse<Order>(text):
    case Ok(value): "parsed " + value.id
    case Err(error): error.message

fn order(tags: String, shape: String, pair: String, due: String, extra: String) -> String:
  "{\"id\":\"o1\",\"items\":[],\"tags\":" + tags + ",\"shape\":{\"_type\":\"" + shape + "\"},\"pair\":" + pair + ",\"due\":\"" + due + "\"" + extra + "}"

live async fn main() -> Array<String>:
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> Array<String>:
  const original = Order:
    id: "o1"
    items: [Item{sku: "a", qty: 2}]
    note: "n"
    tags: [10: 1]
    shape: Circle(1.5)
    pair: (3, true)
    due: 90m
  const roundTrip = match json.parse<Order>(json.stringify(original)):
    case Ok(value):
      if value == original: "round trip" else: "changed"
    case Err(error): error.message
  const lenient = match json.parse<Order>(
    order("{}", "Dot", "[1,true]", "PT1S", ",\"extra\":[1,2]")
  ):
    case Ok(value):
      if value.note == none: "none, unknown fields ignored"
      else: "a note"
    case Err(error): error.message
  const notJson = match json.parse<Order>("{\"id\":"):
    case Ok(value): value.id
    case Err(error): error.code
  const big = match json.parse<Big>("{\"value\":\"123456789012345678901234567890\"}"):
    case Ok(value): String(value.value)
    case Err(error): error.message
  const skipped = match json.parse<Tally>("{\"name\":\"t\",\"counter\":{\"count\":1}}"):
    case Ok(value): "skipped " + value.counter.count
    case Err(error): error.message
  [
    roundTrip
    lenient
    failure("{\"due\":\"PT1S\",\"id\":\"o1\",\"items\":[{\"sku\":\"a\",\"qty\":\"2\"}]}")
    failure("{\"due\":\"PT1S\",\"items\":[]}")
    failure(order("{}", "Square", "[1,true]", "PT1S", ""))
    failure(order("{}", "Dot", "[1]", "PT1S", ""))
    failure(order("{}", "Dot", "[1,true]", "P1Y", ""))
    failure(order("{\"x\":1}", "Dot", "[1,true]", "PT1S", ""))
    failure("{\"due\":\"PT1S\",\"id\":\"o1\",\"items\":[{\"sku\":\"a\",\"qty\":1.5}]}")
    notJson
    big
    skipped
  ]
