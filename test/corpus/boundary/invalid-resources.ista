# A host type a `dispose` makes disposable has values with an identity of their own (§3.6, §7):
# an `extern shared struct` or `extern ephemeral struct`, never a value or `sendable`, neither
# Encodable nor Decodable, which imply Sendable, and held by no extern constant, which every read
# shares. It still crosses to its own host, kept in a resource while the program holds it.

import * as json from 'json'

extern sendable struct Ticket

extern shared struct Lease

extern fn release(lease: Lease)

fn dispose(self: Ticket):
  ()

fn dispose(self: Lease):
  release(self)

extern fn open() -> Lease

extern lease: Lease

extern fn keep(lease: Lease) -> Future<Lease, "ista">

async fn main():
  const kept = await keep(open())
  release(kept)
  json.encode(open())

extern struct Receipt

fn dispose(self: Receipt):
