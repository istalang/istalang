#
# A mock's target names a function, which has an identity to replace, never a variant, built
# where it is called (§3.11), at a type taking every parameter, since its replacement is given its
# defaults filled; and `handle` makes values of host types only (§10). A mock's target is the one
# place `dispose` may be named (§7).

import handle, mock from 'testing'

extern shared struct Queue
extern fn dispose(self: Queue)

fn greet(name: String) -> String: name

enum Plain { One(by: String), Other }

ista async fn targets():
  const named = greet
  hold _ = mock(named, fn(name: String): name)
  hold _ = mock(fn(name: String): name, fn(name: String): name)
  const n: Int = handle<Int>()
  hold _ = mock(greet, fn(name: String): name)
  const q: Queue = handle<Queue>()
  const future: Future<Int, "ista"> = handle<Future<Int, "ista">>()
  hold _ = mock(dispose, fn(queue: Queue): ())
  const disposer: fn(Queue) -> Unit = dispose
  hold _ = mock(Plain.One, fn(by: String): Plain.One("mocked"))
  drop n
  drop q
  drop disposer
  drop future

fn hello(a: Int, b: String = "x") -> Int: a

ista async fn shorter():
  hold _ = mock<(Int,), Int>(hello, fn(a: Int): a)
