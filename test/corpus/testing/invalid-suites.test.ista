#
# A suite function only builds its list (§10), in an instance: an fn or ista fn, not async, taking
# nothing and returning Array<Test>, whose own body calls no extern and makes no shared struct or
# slot. What the tests it builds do runs later, so a test's body may do any of it, and so may a
# deferred call's call, though not what that call computes now (§3.14).

import Suite, Test, test from 'testing'

extern fn fetch() -> Int

shared struct Box:
  n: Int

@Suite{"async"}
ista async fn asyncSuite() -> Array<Test>: []

@Suite{"takes"}
fn takes(n: Int) -> Array<Test>: []

@Suite{"gives"}
fn gives() -> Array<Int>: []

@Suite{"calls an extern"}
fn callsExtern() -> Array<Test>:
  drop fetch()
  []

@Suite{"makes a shared struct"}
fn makesShared() -> Array<Test>: _with(new Box{n: 1})

@Suite{"makes a slot"}
ista fn makesSlot() -> Array<Test>: _of(Slot.create<Int>())

struct Bag {}
extern fn Bag.default() -> Bag

@Suite{"calls an extern implicitly"}
fn callsImplicitExtern() -> Array<Test>:
  const b: Bag = []
  []

@Suite{"a test may do anything"}
fn fine() -> Array<Test>: [Case(title: "t", body: async fn(): { drop fetch(); () })]

fn _with(box: Box) -> Array<Test>: []
ista fn _of(slot: Slot<Int>) -> Array<Test>: []

ista async fn check(n: Int):
  drop n

ista async fn checkFetched():
  drop fetch()

@Suite{"a deferred call computes what it passes now"}
ista fn computesNow() -> Array<Test>: [test("t") check(fetch())]

@Suite{"a deferred call makes its call later"}
ista fn callsLater() -> Array<Test>: [test("t") checkFetched()]

@Suite{"live"}
live fn liveSuite() -> Array<Test>: []
