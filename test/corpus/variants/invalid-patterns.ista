# A call pattern binds its arguments as a call binds them (§11.3): a field no default or rest lets
# a call leave out must be given, or left with a last `...`; arguments past the fields, a name no
# field has, a field given twice and a spread with no rest field to take it are refused, as are a
# second spread, a `...` anywhere but last and an argument by position after one by name; what
# can't bind still takes the field it names, typed as it is. Only a variant is taken apart as a
# call is written, whatever is matched, in a target too, and a target or parameter, which must
# always match, takes none.

enum Verdict:
  Approved
  Rejected(by: String, reason = "no reason given")

enum Node:
  Text(value: String)
  Group(title: String, open: Bool = false, ...children: Array<Node>)

struct Point:
  x: Int
  y: Int

fn missing(v: Verdict) -> Int:
  match v:
    case Rejected(): 1
    case _: 0

fn tooMany(v: Verdict) -> Int:
  match v:
    case Rejected(p, q, r): 2
    case _: 0

fn unnamed(v: Verdict) -> Int:
  match v:
    case Rejected(x: "1"): 3
    case _: 0

fn twice(v: Verdict) -> Int:
  match v:
    case Rejected("a", by: "b"): 4
    case _: 0

fn noRest(n: Node) -> Int:
  match n:
    case Text(...rest): 1
    case _: 0

fn twoSpreads(n: Node) -> Int:
  match n:
    case Group(t, ...one, ...two): 2
    case _: 0

fn othersFirst(n: Node) -> Int:
  match n:
    case Group(..., t): 3
    case _: 0

fn structNamed(p: Point) -> Int:
  match p:
    case Point(x, y): x + y

fn target(r: Result<Int>) -> Int:
  const Ok(value) = r
  value

fn byName(n: Node) -> Int:
  match n:
    case Group(open: true): 1
    case _: 0

fn otherType(s: Int) -> Int:
  match s:
    case Point(x, y): x + y
    case _: 0

fn structTarget(p: Point) -> Int:
  const Point(x, y) = p
  x + y

fn param(Ok(value): Result<Int>) -> Int: value

fn reached(v: Verdict) -> String:
  match v:
    case Rejected(reason: r):
      const n: Int = r
      ""
    case _: ""

fn twiceByName(v: Verdict) -> Int:
  match v:
    case Rejected(by: "a", by: "b", ...): 1
    case _: 0

fn afterNamed(v: Verdict) -> Int:
  match v:
    case Rejected(reason: r, b): 1
    case _: 0
