# A variant with fields named without a call is a function value unless its own enum is expected:
# bare, it needs the expected function type's result to give its enum, so `map`, whose result is
# still open, names the variant to write; where its enum is expected it is given its fields, and a
# generic one needs a function type, as any generic function does. Where another enum, or a
# function type its parameters don't take, is expected, it is its own function, which doesn't fit;
# a generic one fits none, its parameters taking the expected ones exactly. A variant without
# fields is a value, never a function.

enum Verdict:
  Approved
  Rejected(by: String, reason = "no reason given")

enum Color { Red, Green }

enum Wrap<T> { Item(value: T?) }

fn main() -> Int:
  const a = [1].map(Ok)
  const b: fn(Int) -> Int = Ok
  const c = Ok
  const d: Result<Int> = Ok
  const e: Verdict = Rejected
  const f = Result.Ok
  const g: fn() -> Verdict = Verdict.Approved
  const h: Color = Verdict.Rejected
  const i: fn(Int) -> Verdict = Rejected
  const j = [1].map(Wrap.Item)
  0
