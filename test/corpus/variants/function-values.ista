# outcome: "1 2 3|4|legal: late|ops: no reason given|2 t|true false|5 6|x: no reason given|function a: b 2|x: no reason given z: no reason given|value result|oops 0 l"
# A variant with fields is a function value (§3.14) named as a static function is: qualified, as
# `Result.Ok` passed to `map`, whose result it infers as a lambda's would, or bare where the
# expected function type's result is its enum, also as a member of an expected union or a
# parameter of one overload of several, which its result tells apart. It fits a function type
# leaving defaulted fields or its rest out, as a value or an argument, computing them at each
# call, and takes its rest as one array; where nothing gives its parameters it is its whole
# function, so a generic call infers from it, in each pass of a field loop as that pass's types
# make it, and a result the call knows in part gives what its fields don't. It captures nothing,
# so its type is sendable, and it equals another value naming it with the same type arguments,
# never one naming another variant.

enum Verdict:
  Approved
  Rejected(by: String, reason = "no reason given")

enum Action:
  Now(value: Int)
  Later

type Move = Action | fn(Int) -> Action

enum Node:
  Text(value: String)
  Group(title: String, open: Bool = false, ...children: Array<Node>)
  Empty

fn describe(verdict: Verdict) -> String:
  match verdict:
    case Approved: "approved"
    case Rejected(by, reason): `${by}: ${reason}`

fn shown(node: Node) -> String:
  match node:
    case Group(title: title, children: children, ...): `${children.length()} ${title}`
    case _: ""

fn valueOf(result: Result<Int>) -> Int:
  match result:
    case Ok(value): value
    case Err(...): -1

fn apply(f: fn(Int) -> Result<Int>, value: Int) -> Result<Int>: f(value)

fn sent(make: sendable fn(String) -> Verdict) -> String: describe(make("x"))

fn kept<T>(value: T) -> T: value

fn grouped(make: fn(String) -> Node) -> String: shown(make("l"))

fn told(make: fn(Int) -> Result<Int>) -> String: "result"

fn told(make: fn(String) -> String) -> String: "string"

fn failed<A, E>(value: A, make: fn(A) -> Result<String, E>) -> Result<String, E>: make(value)

struct Pair:
  a: Int
  b: String

fn each(pair: Pair) -> Int:
  let count = 0
  for _, value in ...pair:
    count = count + [value].map(Result.Ok).length()
  count

fn chosen(action: Action) -> String: "value"

fn chosen(make: fn(Int) -> Action) -> String: "function"

async fn main() -> String:
  const results = [1, 2, 3].map(Result.Ok)
  const wrap: fn(Int) -> Result<Int> = Ok
  const reject = Verdict.Rejected
  const short: fn(String) -> Verdict = Rejected
  const group: fn(String, Bool, Array<Node>) -> Node = Node.Group
  const again: fn(Int) -> Result<Int> = Result.Ok
  const succeeding: fn(Int) -> Result<Int, Int> = Result.Ok
  const failing: fn(Int) -> Result<Int, Int> = Result.Err
  const listed = results.map(valueOf)
  const values = `${listed[0]} ${listed[1]} ${listed[2]}`
  const same = `${wrap == again} ${succeeding == failing}`
  const passed = `${valueOf(apply(Ok, 5))} ${valueOf(apply(Result.Ok, 6))}`
  const made = describe(reject("legal", "late"))
  const whole = kept(Verdict.Rejected)
  const move: Move = Now
  const picked = `${chosen(Now)} ${describe(whole("a", "b"))}`
  const shorter = ["z"].map(Verdict.Rejected)
  const left = `${sent(Verdict.Rejected)} ${describe(shorter[0])}`
  const result = `${chosen(Action.Later)} ${told(Result.Ok)}`
  const failure = match failed("oops", Result.Err):
    case Err(error): `${error} ${grouped(Node.Group)}`
    case _: ""
  `${values}|${valueOf(wrap(4))}|${made}|${describe(short("ops"))}|${shown(group("t", true, [Node.Empty, Node.Text("a")]))}|${same}|${passed}|${sent(Rejected)}|${picked} ${each(Pair{a: 1, b: "x"})}|${left}|${result}|${failure}`
