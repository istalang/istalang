# outcome: "1 2|legal: no reason given|ops: late|approved|3 t true|0|7|5|boom 1|1 a|2 4|t 6|1 2 none 3 4 7"
# A variant with fields is a function of its enum (§3.11): a call binds its arguments to the fields
# as to parameters, by position, then by name, leaving defaults out and a rest collecting the
# others; the expected enum gives its type arguments, those written give theirs and the arguments
# infer the rest; a variant without fields is its name alone. A spawned call starts the
# constructor as any function. A field named `self` is a field, never a receiver, and a
# `struct{…}` comprehension takes the field's type: built as it where its fields are known,
# waiting for it where they aren't or its values need it.

enum Verdict:
  Approved
  Rejected(by: String, reason = "no reason given")

enum Node:
  Text(value: String)
  Group(title: String, open: Bool = false, ...children: Array<Node>)
  Empty

enum Pair<A, B = Int>:
  Both(first: A, second: B)
  Neither

fn describe(verdict: Verdict) -> String:
  match verdict:
    case Approved: "approved"
    case Rejected(by, reason): `${by}: ${reason}`

fn count(node: Node) -> Int:
  match node:
    case Group(children: children, ...): children.length()
    case _: 0

fn sum(pair: Pair<Int>) -> Int:
  match pair:
    case Both(first, second): first + second
    case Neither: 0

fn wrapped(value: Int?) -> Result<Int?, String>: Ok(value)

enum Named:
  Of(self: Int, other: String)

struct Bag<S is struct { [_]: Int }>:
  fields: S
  type Doubled = match S:
    case _: { [F in keyof S]: Int }

fn doubled<S is struct { [_]: Int }>(bag: Bag<S>) -> Result<Bag<S>.Doubled>:
  Ok(struct{for f, n in ...bag.fields: [f]: n * 2})

fn tagged<S is struct { [_]: Int }>(
  bag: Bag<S>,
) -> Result<{ tag: String, value: Bag<S>.Doubled }>:
  Ok(struct{tag: "t", value: struct{for f, n in ...bag.fields: [f]: n * 3}})

fn named() -> String:
  match Named.Of(self: 1, other: "a"):
    case Of(self, other): `${self} ${other}`

fn comprehended() -> String:
  const two = match doubled(Bag{fields: struct{a: 1, b: 2}}):
    case Ok(value): `${value.a} ${value.b}`
    case _: ""
  const one = match tagged(Bag{fields: struct{a: 2}}):
    case Ok(value): `${value.tag} ${value.value.a}`
    case _: ""
  `${two}|${one}`

struct Point:
  x: Int
  y: Int

type Partial = { x: Int?, y: Int? }

type Tagged = { tag: String?, x: Int, y: Int }

fn kept<T>(t: T) -> T: t

fn asPoint(p: Point) -> Result<Point>: Ok(struct{for k, v in ...p: [k]: v})

fn asPartial(p: Point, keep: Bool) -> Result<Partial>:
  Ok(struct{for k, v in ...p: [k]: if keep: v else: none})

fn asTagged(p: Point) -> Result<Tagged>: Ok(struct{tag: none, for k, v in ...p: [k]: v + 2})

fn known() -> String:
  const p = Point{x: 1, y: 2}
  const point = match asPoint(p):
    case Ok(value): `${value.x} ${value.y}`
    case _: ""
  const partial = match asPartial(p, false):
    case Ok(value): if value.x == none: "none" else: "some"
    case _: ""
  const tagged = match asTagged(p):
    case Ok(value): `${value.x} ${value.y}`
    case _: ""
  const sum = kept(struct{for k, v in ...p: [k]: v + 2})
  `${point} ${partial} ${tagged} ${sum.x + sum.y}`

fn inferred() -> String:
  const failed = Result.Err<Int>("boom")
  const passed: Result<Int, String> = Result.Ok<Int>(1)
  match (failed, passed):
    case (Err(error), Ok(value)): `${error} ${value}`
    case _: ""

ista async fn main() -> String:
  const pair: Pair<Int> = Both(1, 2)
  const both = match pair:
    case Both(first, second): `${first} ${second}`
    case Neither: ""
  const group = Node.Group("t", true, Node.Text("a"), Node.Empty, ...[Node.Text("b")])
  const shown = match group:
    case Node.Group(title, open): `${count(group)} ${title} ${open}`
    case _: ""
  const instance = spawn Pair.Both(3, 4)
  const spawned = match await instance.result():
    case Ok(value): sum(value)
    case _: -1
  const kept = match wrapped(5):
    case Ok(value): value ?? 0
    case _: -1
  [
    both,
    describe(Rejected(by: "legal")),
    describe(Verdict.Rejected("ops", "late")),
    describe(Approved),
    shown,
    String(count(Node.Group(title: "u"))),
    String(spawned),
    String(kept),
    inferred(),
    named(),
    comprehended(),
    known(),
  ].join("|")
