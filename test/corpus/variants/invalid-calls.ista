# A variant's field is given by position only in a call (§3.11): in braces every field is named, so
# `Ok{42}`, `Ok{(v)}`, `Ok{v}` and `Ok{"a"}` name the call they mean, and so does a lone shorthand
# naming no field where one argument would do, a rest aside, leaving no field missing and no type
# argument to infer; a variant without fields takes no value at all. A variant without fields takes
# no arguments, a call needs the arguments its fields do, and a bare variant an expected enum. A
# call's written type arguments are counted once, and met, constraints and type `match`es alike,
# with or without fields. A failed call of a variant with fields can't be spawned for its own
# failure only, and a field's `&`, refused, takes no reference.

enum Verdict:
  Approved
  Rejected(by: String, reason = "no reason given")

enum Box<A, B>:
  Val(x: A)

enum Gate<T is Sendable>:
  Open

shared struct Lock:
  n: Int

enum Keyed<K in "a" | "b">:
  Nil

enum Picked<T>:
  Full(value: T)
  Empty
  type Data = match T:
    case Int: String

enum Held:
  Of(x: &Int)

fn f(v: Int) -> Int:
  const a: Result<Int> = Ok{42}
  const b: Result<Int> = Ok{(v)}
  const c: Result<Int> = Ok{v}
  const d: Verdict = Approved(1)
  const e: Verdict = Rejected()
  const g = Rejected("x")
  const h: Result<String> = Ok{"a"}
  const i: Verdict = Rejected{v}
  const j: Verdict = Verdict.Approved{42}
  v

fn typed():
  const a = Box.Val<Int>(1)
  const b = Gate.Open<Lock>()
  const c = Keyed.Nil<"c">()
  const d = Picked.Full("x")
  drop a
  drop b
  drop c
  drop d

fn spawned():
  drop spawn Verdict.Rejected()
  drop spawn Verdict.Rejected(1)

fn held() -> Held: Held.Of(1)

enum Node:
  Group(title: String, open: Bool = false, ...children: Array<Node>)

fn unexpected(v: Int, t: String) -> Node:
  const a = Result.Ok{42}
  const b = Result.Ok{v}
  drop a
  drop b
  Node.Group{t}

async fn main(): 0
