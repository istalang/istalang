# outcome: [3,2,true]
# A program's own type takes the bitwise operators through `Bitwise` (§3.9), as a set of flags.

struct Flags:
  bits: Int

fn bitAnd(left: Flags, right: Flags) -> Flags: Flags{left.bits & right.bits}
fn bitOr(left: Flags, right: Flags) -> Flags: Flags{left.bits | right.bits}
fn bitXor(left: Flags, right: Flags) -> Flags: Flags{left.bits ^ right.bits}
fn bitNot(value: Flags) -> Flags: Flags{~value.bits}

fn either<T is Bitwise>(left: T, right: T) -> T: left | right

import * as runtime from 'runtime'
live async fn main() -> (Int, Int, Bool): await runtime.run(runtime.id()) _main()
ista async fn _main() -> (Int, Int, Bool):
  const read = Flags{1}
  const write = Flags{2}
  const both = either(read, write)
  (both.bits, (both & ~read).bits, both ^ write == read)
