# error: 5001 at 11:7
# error: 5001 at 11:11
# error: 5001 at 12:12
# error: 5001 at 13:4
# A prefix directly before `**`'s left operand reads either way, so it needs parentheses; bitwise
# operators and shifts take ints only (§10.2).

fn f(x: Float, n: Int) -> Int:
  _ = -n ** 2
  _ = x & 1.0
  _ = n << 1.5
  ~x
