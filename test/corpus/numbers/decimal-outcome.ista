# outcome: {"each":"6.63","total":"19.9"}
# A Decimal crosses to the host as the JSON string of its text (§9), here in a struct outcome.

import Decimal from 'decimal'
import * as decimal from 'decimal'

struct Split:
  total: Decimal
  each: Decimal

ista async fn main() -> Split:
  const total = Decimal(1990) / 100
  Split{total, each: decimal.divide(total, 3, 2)}
