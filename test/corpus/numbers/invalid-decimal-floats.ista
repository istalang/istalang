# A Decimal mixes with ints only: no float operand or conversion from a float, whose rounding is what
# a Decimal avoids (§3.8, §3.9).
import Decimal from 'decimal'

fn mixed(price: Decimal) -> bool:
  const total = price + 1.5
  const converted = Decimal(2.5)
  price < 0.5
