# outcome: "a1,b2|7|3"
# Array comprehension elements agree as an array literal's do, so tuples of different key literals
# widen (§4, §5); under `[_]: Int` a member-parameter key reads and writes as an Int, every field
# being one (§8).

struct P { b: Int, a: Int }

fn bump<T is struct { [_]: Int }, K in keyof T>(t: &T, k: K) -> Int:
  t[k] += 1
  t[k]

import * as runtime from 'runtime'
live async fn main() -> String: await runtime.run(runtime.id()) _main()
ista async fn _main() -> String:
  let p = P{b: 2, a: 6}
  const pairs = [for k, v in ...p: (k, v)]
  const literal = [("a", 1), ("b", 2)]
  const joined = [for (k, v) in literal: `${k}${v}`].join(",")
  const seven = bump(&p, "a")
  `${joined}|${seven}|${pairs.length() + 1}`
