# outcome: 42
# A variable declared in a field loop takes each pass's type (§11.2): in the pass where it is a struct,
# a field of it is written and read as that struct's.

struct BoxB { onlyInB: Int }

fn make(n: Int) -> Int: n

fn make(s: String) -> BoxB: BoxB{onlyInB: 1}

struct Pair { a: Int, b: String }

fn walk(pair: Pair) -> Int:
  let total = 0
  for key, value in ...pair:
    let made = make(value)
    if key == "b":
      made.onlyInB = 42
      total += made.onlyInB
  total

live async fn main() -> Int: walk(Pair{a: 1, b: "hi"})
