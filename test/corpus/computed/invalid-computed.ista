# Invalid computed-type constructs across §1–§8: self-referential associated type, associated
# type clashing with a variant, non-conforming struct constraint, non-object-safe trait using
# Self.Data, inference through associated type and type match, no matching case in type match,
# endless type match reduction, &s[k] with a union key, multi-key write not fitting every field,
# compound assignment across mixed-type keys, and struct comprehension without expected type over
# a constrained type parameter.

trait FormNode:
  type Data
  fn validate(self: Self, data: Self.Data) -> Array<String>

struct Field<T>:
  value: T?
  type Data = T

fn validate<T>(self: Field<T>, data: T) -> Array<String>: []

struct SelfAssoc:
  type Loop = Loop

enum VariantClash:
  Red
  type Red = Int

type OnlyField<D> = match D:
  case Field<infer T>: T

type Endless<T> = match T:
  case _: Endless<Array<T>>

struct Settings { retries: Int; region: String }

fn needStruct<S is struct { [_] is FormNode }>(s: S): ()
fn inferAssoc<T>(x: Field<T>.Data) -> T: x
fn inferMatch<D>(x: OnlyField<D>) -> Int: 0
fn takeRef(r: &(Int | String)): ()

fn badObjectSafety(x: any FormNode): ()

fn badNoCase(x: OnlyField<Int>): ()

fn badEndless(x: Endless<Int>): ()

fn badComprehension<S is struct { [_] is FormNode }>(s: S):
  const out = struct{for k, v in ...s: [k]: v}
  _ = out

fn badUses(s: Settings, k: keyof Settings):
  needStruct(123)
  _ = inferAssoc(1)
  _ = inferMatch(1)
  let m = s
  takeRef(&m[k])
  m[k] = 10
  m[k] += 1
