# outcome: "10:union:str|7|bool"
# Type match (§3.17): a repeated infer, a constrained infer, a struct case binding an infer from a
# field, a literal matching its base type, union distribution, and a tuple subject matched whole.

struct Box<T> { value: T }
struct Pair<A, B> { first: A, second: B }

type Describe<T> = match T:
  case Pair<infer X, X>: X
  case Box<infer V is Sendable>: V
  case struct { tag: infer K }: K
  case Bool: "bool"
  case _: Never

type WholeTuple<D> = match (D,):
  case (Int | String,): "union"
  case _: "other"

type Unwrapped<T> = match T:
  case Box<infer V>:
    V
  case _: T

fn unwrap<T>(box: Box<T>) -> Unwrapped<Box<T>>:
  box.value

async fn main() -> String:
  const d1: Describe<Pair<Int, Int>> = 10
  const d2: Describe<Box<Int> | { tag: String, extra: Bool }> = "str"
  const d3: WholeTuple<Int | String> = "union"
  const d4: Describe<true> = "bool"
  const label: "union" = d3
  `${d1}:${label}:${d2}|${unwrap(Box{value: 7})}|${d4}`
