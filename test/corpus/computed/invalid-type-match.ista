# A type match no case of matches its use, one whose reductions never end, inference through a
# type match, and `infer` outside a case's pattern (§3.5, §3.17).

struct Field<T> { value: T }

type OnlyField<D> = match D:
  case Field<infer T>: T

type Endless<T> = match T:
  case _: Endless<Array<T>>

fn misplaced(x: Array<infer T>): ()
fn inferMatch<D>(x: OnlyField<D>) -> Int: 0
fn badNoCase(x: OnlyField<Int>): ()

fn badUses():
  _ = inferMatch(1)
