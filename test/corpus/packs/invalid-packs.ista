# A pack is a function's, with no constraint or default, and stands only where a tuple of types
# can (§3.5): a function type's rest is a pack, a pack's arguments come by position or as one
# spread of its own pack's value, and a written pack is a tuple type. A pack's items are any type
# to overload clashes (§3.7).
struct Boxed<...A>:
  value: A

fn constrained<...A is Sendable>(...args: A): ()

fn defaulted<...A = (int,)>(...args: A): ()

fn arrayRest(f: fn(int, ...Array<int>)): ()

fn call<...A, R>(f: fn(...A) -> R, ...args: A) -> R: f(...args)

fn plus(x: int, y: int) -> int: x + y

fn opaque<...A>(f: fn(...A) -> int, ...args: A) -> int:
  f(1, 2)

fn mixed<...A>(f: fn(...A) -> int, ...args: A) -> int:
  call(f, 1, ...args)

fn main():
  drop call(plus, args: (1, 2))
  drop call(plus, ...[1, 2])
  drop call<int, int>(plus, 1)
  drop call(plus, 1, "two")
  const lambda = fn(...xs: Array<int>): xs

fn spread<...A>(...xs: A): ()
fn spread<...B>(...ys: B): ()

fn either<T>(...xs: Array<T>): ()
fn either<...A>(...xs: A): ()
