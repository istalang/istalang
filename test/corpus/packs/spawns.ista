# outcome: [{"_type":"Ok","value":10},{"_type":"Ok","value":6},{"_type":"Ok","value":3}]
# A spawned call passes what a rest parameter collects as a call does, spreads included, and the
# new instance fills its parameters (§6.1, §8.1, §17.1).
import * as runtime from 'runtime'

fn total(...xs: Array<Int>) -> Int:
  let t = 0
  for x in xs: t += x
  t

fn call<...A, R>(f: fn(...A) -> R, ...args: A) -> R: f(...args)
fn add3(a: Int, b: Int, c: Int) -> Int: a + b + c
live async fn main() -> (Result<Int>, Result<Int>, Result<Int>):
  await runtime.run(runtime.id()) _main()

ista async fn _main() -> (Result<Int>, Result<Int>, Result<Int>):
  const xs = [2, 3]
  (
    await (spawn total(1, ...xs, 4)).result()
    await (spawn call(add3, 1, 2, 3)).result()
    await (spawn total(...0..3)).result()
  )
