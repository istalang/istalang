# Spec §10's suite for §12.1's purchase approval, its elided bodies written out. The end-to-end
# test (src/cli/commands/test.test.ts) writes §12.1's code, read from the spec, into purchase.ista
# beside this module, and runs both with `ista test`.
#
# The fake host: a FakeClock for time, a FakeQueue per message type, and the receipts of the
# program's revertible sends, each kept with the message it stands for, so the program's disposing
# of a receipt retracts that message (§3.6).

import Suite, Test, test, group, assertEq, FakeClock, FakeQueue, FakeReceipts, withClock, Mock, mock, calls, handle, idle from 'testing'
import * as testing from 'testing'
import * as app from './purchase'
import PurchaseRequest, ReviewRequest, Verdict, Notice, Cancel, ChargeResult, Queue, Sent from './purchase'

struct PurchaseEnv:
  clock: FakeClock
  reviews: FakeQueue<Queue<ReviewRequest>, ReviewRequest>
  verdicts: FakeQueue<Queue<Verdict>, Verdict>
  cancels: FakeQueue<Queue<Cancel>, Cancel>
  notices: FakeQueue<Queue<Notice>, Notice>
  charges: Mock<fn(String, Int) -> Result<String>>

async fn withPurchaseEnv(test: async fn(PurchaseEnv)):
  await withClock(async fn(clock): {
    const env = PurchaseEnv{
      clock,
      reviews: FakeQueue<Queue<ReviewRequest>, ReviewRequest>{make: handle},
      verdicts: FakeQueue<Queue<Verdict>, Verdict>{make: handle},
      cancels: FakeQueue<Queue<Cancel>, Cancel>{make: handle},
      notices: FakeQueue<Queue<Notice>, Notice>{make: handle},
      charges: mock(app.chargeCard, fn(id: String, amount: Int) -> Result<String>: Ok{value: "r-" + id + "-" + amount}),
    }
    hold _ = mock(app.reviewQueue, env.reviews.open)
    hold _ = mock(app.verdicts, env.verdicts.open)
    hold _ = mock(app.cancels, env.cancels.open)
    hold _ = mock(app.notifications, env.notices.open)
    hold _ = mock(app.receive, env.verdicts.receive)
    hold _ = mock(app.receive, env.cancels.receive)
    const receipts = FakeReceipts<Sent>{make: handle}
    hold _ = mock(app._sendRevertible, receipts.revertibleSender(env.reviews))
    hold _ = mock(app._sendRevertible, receipts.revertibleSender(env.notices))
    hold _ = mock(app.dispose, receipts.dispose)
    await test(env)
  })

const laptop = PurchaseRequest{id: "p1", item: "laptop", amount: 900}

fn approveAll(env: PurchaseEnv, roles: Array<String>):
  for role in roles:
    env.verdicts.post("p1", Verdict{role, ok: true, comment: ""})

@Suite{"purchase approval"}
fn approvalSuite() -> Array<Test>: [
  test("expires after 5 days", withPurchaseEnv, async fn(env): {
    const t = spawn app.purchase(laptop)
    await t.idle()
    env.clock.advance(5d)
    assertEq(await t.result(), Ok("expired"))
  }),
  test("reminds the roles yet to review every day, until it ends", withPurchaseEnv, async fn(env): {
    const t = spawn app.purchase(laptop)
    await t.idle()
    env.verdicts.post("p1", Verdict{role: "legal", ok: true, comment: ""})
    await t.idle()
    env.clock.advance(1d)
    await t.idle()
    assertEq(env.notices.pending("legal").length(), 0)
    assertEq(env.notices.pending("finance").length(), 1)
    env.clock.advance(4d)
    assertEq(await t.result(), Ok("expired"))
    assertEq(env.notices.pending("finance"), [])
  }),
  test("is rejected by the first role saying no", withPurchaseEnv, async fn(env): {
    const t = spawn app.purchase(laptop)
    env.verdicts.post("p1", Verdict{role: "finance", ok: false, comment: "over budget"})
    assertEq(await t.result(), Ok("rejected by finance"))
    assertEq(env.charges.calls(), [])
  }),
  group("with cancellation", [
    test("retracts review requests", withPurchaseEnv, async fn(env): {
      const t = spawn app.purchase(laptop)
      await t.idle()
      assertEq(env.reviews.pending("legal"), [ReviewRequest{purchaseId: "p1", item: "laptop", amount: 900}])
      env.cancels.post("p1", Cancel{reason: "changed my mind"})
      assertEq(await t.result(), Ok("cancelled: changed my mind"))
      assertEq(env.reviews.pending("legal"), [])
      assertEq(env.reviews.pending("finance"), [])
    }),
    test("cancels after a verdict has come", withPurchaseEnv, async fn(env): {
      const t = spawn app.purchase(laptop)
      await t.idle()
      env.verdicts.post("p1", Verdict{role: "legal", ok: true, comment: ""})
      await t.idle()
      env.cancels.post("p1", Cancel{reason: "too late"})
      assertEq(await t.result(), Ok("cancelled: too late"))
    }),
  ]),
  test("takes the verdicts that come after a reminder", withPurchaseEnv, async fn(env): {
    const t = spawn app.purchase(laptop)
    await t.idle()
    env.clock.advance(1d)
    await t.idle()
    approveAll(env, ["legal", "finance"])
    assertEq(await t.result(), Ok("paid: r-p1-900"))
  }),
  ...[for amount in [10, 50_000, 60_000]:
    test("amount " + amount, withPurchaseEnv, async fn(env): {
      const roles = if amount > 50_000: ["legal", "finance", "cfo"] else: ["legal", "finance"]
      const t = spawn app.purchase(PurchaseRequest{id: "p1", item: "laptop", amount})
      await t.idle()
      assertEq(env.reviews.pending("cfo").length(), if amount > 50_000: 1 else: 0)
      approveAll(env, roles)
      assertEq(await t.result(), Ok("paid: r-p1-" + amount))
      assertEq(env.charges.calls(), [("p1", amount)])
    })],
  test("charges twice when its segment runs twice, so charging must be idempotent", withPurchaseEnv, async fn(env): {
    const t = testing.spawnCrashingEveryAwait(fn(): app.charge(laptop))
    assertEq(await t.result(), Ok(ChargeResult{ok: true, receipt: "r-p1-900"}))
    assertEq(env.charges.calls(), [("p1", 900), ("p1", 900)])
  }),
]
