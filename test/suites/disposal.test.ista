# Disposal order (spec §7): values losing their last holder together are disposed last made first,
# each holder before what it holds. Each rule is its own function, and its test asserts what the old
# runtime's unit test did.

import * as runtime from 'runtime'
import Inbox from 'inbox'
import assertEq, spawnCrashingEveryAwait, Suite, Test, test from 'testing'

shared struct Lease:
  name: String
  log: Shared<Array<String>>
  child: Lease? = none

fn dispose(self: Lease):
  self->log->value.push("disposed " + self->name)

ista async fn disposalRounds() -> String:
  const log = new Shared<Array<String>>{value: []}
  if true:
    const l0 = new Lease{name: "0", log}
    const l1 = new Lease{name: "1", log}
    const l2 = new Lease{name: "2", log, child: l0}
    drop l0
  await runtime.commit()
  log->value.join(", ")

ista async fn answersUntilGone(owner: WeakRef<Inbox<String>>, asked: Inbox<Int>) -> String:
  while true:
    await select:
      case asked.receive() as n:
        owner.deref()?.send("answer " + String(n))
      case owner.disposed(): return "gone"
  "never"

ista async fn disposedWatchedInALoop() -> String:
  const asked = Inbox.create<Int>()
  let answers = ""
  const answering = {
    const answered = Inbox.create<String>()
    const started = answersUntilGone(WeakRef(answered), asked)
    asked.send(1)
    const first = await answered.receive()
    asked.send(2)
    answers = first + ", " + await answered.receive()
    started
  }
  answers + ", " + await answering

ista async fn ticksUntilDisposed(ticks: Inbox<Int>, replies: Inbox<String>) -> String:
  while true:
    await select:
      case ticks.receive() as n: replies.send("tick " + String(n))
      case ticksUntilDisposed.disposing():
        replies.send("disposing")
        return "stopped"
  "never"

ista async fn disposingWatchedInALoop() -> Array<String>:
  const ticks = Inbox.create<Int>()
  const replies = Inbox.create<String>()
  if true:
    const ticking = ticksUntilDisposed(ticks, replies)
    ticks.send(1)
    _ = await replies.receive()
    ticks.send(2)
    _ = await replies.receive()
  [await replies.receive()]

@Suite{"disposal"}
fn suite() -> Array<Test>: [
  test(
    "the current round finishes before what a disposal in that round held is disposed"
    async fn(): assertEq(await disposalRounds(), "disposed 2, disposed 1, disposed 0")
  )
  test(
    "a disposed() watch awaited again after nothing held it between waits still resolves, with every segment re-run"
    async fn(): assertEq(
      await spawnCrashingEveryAwait(disposedWatchedInALoop).result()
      Ok("answer 1, answer 2, gone")
    )
  )
  test(
    "a disposing() watch awaited again after nothing held it between waits still resolves, with every segment re-run"
    async fn(): assertEq(
      await spawnCrashingEveryAwait(disposingWatchedInALoop).result()
      Ok(["disposing"])
    )
  )
]
