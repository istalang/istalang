# `Resolver.of` callbacks (spec §6, §7): when a callback runs, how long it lives, and when it is
# cancelled instead. Each rule is its own function, and its test asserts what the old runtime's unit
# test did.

import Suite, Test, test, assertEq, spawnCrashingEveryAwait from 'testing'
import * as futures from 'futures'
import * as runtime from 'runtime'
import * as time from 'time'

shared struct Seen:
  value: Int

K fn see<K in Persistence>(seen: Seen, value: Int): seen->value = value

ista async fn later(value: Int) -> Int:
  await runtime.commit()
  value

shared struct Kept:
  resolver: Resolver<Int, "ista">? = none

struct Watched:
  seen: Seen
  kept: Kept
  type Mode = "ista"

ista fn onAwait(self: Watched, done: Resolver<Int, "ista">):
  const seen = self.seen
  done.onCancel(fn(): see(seen, -1))
  self.kept->resolver = done
  later(1).onAwait(done)

ista async fn afterResolverWaits() -> Int:
  const seen = new Seen{value: 0}
  const done = Resolver.of(fn(value: Int): see(seen, value))
  done.resolve(3)
  const before = seen->value
  await runtime.commit()
  before * 10 + seen->value

ista async fn withoutAwait() -> Int:
  const seen = new Seen{value: 0}
  const pending = later(7)
  pending.onAwait(Resolver.of(fn(value): see(seen, value)))
  const before = seen->value
  await runtime.commit()
  await runtime.commit()
  before * 10 + seen->value

struct Either:
  slow: Future<Int, "ista">
  seen: Seen
  type Mode = "ista"

ista fn offer(done: Resolver<Int, "ista">, value: Int): _ = done.tryResolve(value)

ista fn onAwait(self: Either, done: Resolver<Int, "ista">):
  const watching = Resolver.of(fn(value: Int): offer(done, value))
  const seen = self.seen
  watching.onCancel(fn(): see(seen, -1))
  self.slow.onAwait(watching)
  done.resolve(3)

ista async fn livesWithFuture() -> Int:
  const seen = new Seen{value: 0}
  const slow = later(9)
  const got = await Either{slow, seen}
  await runtime.commit()
  got * 10 + seen->value + 0 * await slow

ista async fn survivingPosition() -> Int:
  const seen = new Seen{value: 0}
  const cancelled = new Seen{value: 0}
  const kept = later(7)
  if true:
    const done = Resolver.of(fn(pair: (Int, Int)): see(seen, (pair.0 + 1) * 10 + pair.1))
    done.onCancel(fn(): see(cancelled, 100))
    const at0 = Resolver.at(done, 0)
    at0.onCancel(fn(): see(cancelled, cancelled->value + 1))
    const at1 = Resolver.at(done, 1)
    at1.onCancel(fn(): see(cancelled, cancelled->value + 10))
    const dropped = later(1)
    dropped.onAwait(at0)
    kept.onAwait(at1)
  await runtime.commit()
  _ = await kept
  await runtime.commit()
  seen->value * 100 + cancelled->value

ista async fn nestedPositions() -> Int:
  const seen = new Seen{value: 0}
  const survived = later(5)
  if true:
    const gone = Resolver.of(fn(pair: (Int, Int)): see(seen, pair.1))
    gone.onCancel(fn(): see(seen, seen->value + 3))
    later(1).onAwait(Resolver.at(gone, 0))
    later(2).onAwait(Resolver.at(gone, 1))
    const nested = Resolver.of(fn(outer: (Int, (Int, Int))): see(seen, seen->value + outer.0 * 100 + outer.1.0 * 10 + outer.1.1))
    survived.onAwait(Resolver.at(Resolver.at(nested, 2), 4))
  await runtime.commit()
  _ = await survived
  await runtime.commit()
  seen->value

ista async fn tracked(seen: Seen, tag: Int) -> Int:
  await select:
    case time.delay(10s): tag
    case tracked.disposing():
      see(seen, seen->value + tag)
      0

ista async fn losersDisposed() -> Int:
  const seen = new Seen{value: 0}
  const s = Slot.create<Int>()
  const won = await select:
    case futures.first([tracked(seen, 10), s.take()]) as pair: pair.1
    case tracked(seen, 20) as slow: slow
    case later(4) as fast: fast
  _ = s.put(9)
  const left = await s.take()
  won * 1000 + left * 100 + seen->value

ista async fn unregistered() -> Int:
  const seen = new Seen{value: 0}
  if true:
    const dropped = Resolver.of(fn(value: Int): see(seen, value))
    dropped.onCancel(fn(): see(seen, -1))
  await runtime.commit()
  seen->value

ista async fn rankedAcrossCommits() -> Array<String>:
  const order = new Shared<Array<String>>{value: []}
  const s = Slot.create<Int>()
  drop Resolver.of(fn(value: Int): order->value.push("dropped"))
  const before = Resolver.of(fn(value: Int): order->value.push("before"))
  const readBefore = s.read()
  readBefore.onAwait(before)
  await runtime.commit()
  const after = Resolver.of(fn(value: Int): order->value.push("after"))
  const readAfter = s.read()
  readAfter.onAwait(after)
  await s.put(1)
  await runtime.commit()
  _ = (readBefore, readAfter)
  order->value

@Suite{"callbacks"}
fn suite() -> Array<Test>: [
  test("a callback is called once resolved, after the code resolving it waits", async fn(): assertEq(await afterResolverWaits(), 3))
  test("a callback waits on a future without await, through its onAwait", async fn(): assertEq(await withoutAwait(), 7))
  test("a callback lives as long as its future, even once what it would decide is decided", async fn(): assertEq(await livesWithFuture(), 30))
  test("a callback stays alive through a surviving Resolver.at registration when another position future is let go of", async fn(): assertEq(await survivingPosition(), 2701))
  test("a callback is cancelled once every Resolver.at future holding its chain is let go of, and resolves through nested chains", async fn(): assertEq(await nestedPositions(), 248))
  test("the losing futures.first and select cases are disposed when the winner resolves across commits", async fn(): assertEq(await losersDisposed(), 4930))
  test("a callback let go of unresolved, registered on nothing, is cancelled", async fn(): assertEq(await unregistered(), -1))
  test("callbacks settled together run in the order their resolvers were made, across commits", async fn(): assertEq(await rankedAcrossCommits(), ["before", "after"]))
  test("callbacks settled together run in creation order with every segment re-run", async fn(): assertEq(await spawnCrashingEveryAwait(rankedAcrossCommits).result(), Ok(["before", "after"])))
]
