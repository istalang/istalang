# Awaitables (spec §3.10) and the resolvers a wait gives them (§6, §7): what `onAwait` starts and
# decides, a decided wait's other resolvers, `tryResolve`, `Resolver.at` positions and `onCancel`.
# Each rule is its own function, and its test asserts what the old runtime's unit test did.

import Suite, Test, test, assertEq, expectPanic from 'testing'
import * as runtime from 'runtime'
import * as futures from 'futures'
import * as time from 'time'
import Inbox from 'inbox'

shared struct Starts:
  count: Int

struct Cold:
  starts: Starts
  value: Int
  type Mode = "ista"

ista fn onAwait(self: Cold, done: Resolver<Int, "ista">):
  self.starts->count = self.starts->count + 1
  done.resolve(self.value)

ista async fn coldStart() -> Int:
  const starts = new Starts{count: 0}
  const awaited = Cold{starts: starts, value: 7}
  const before = starts->count
  const got = await awaited
  before * 100 + starts->count * 10 + got

struct Delegated:
  inner: Future<Int, "ista">
  type Mode = "ista"

ista fn onAwait(self: Delegated, done: Resolver<Int, "ista">): self.inner.onAwait(done)

ista async fn later(value: Int) -> Int:
  await runtime.commit()
  value

ista async fn futureOnAwait() -> Int: await Delegated{inner: later(42)}

ista async fn selectOnAwait() -> Int:
  const starts = new Starts{count: 0}
  await select:
    case Delegated{inner: later(1)} as slow: slow
    case Cold{starts: starts, value: 2} as fast: fast * 10 + starts->count

struct Peek:
  inner: Future<Int, "ista">
  type Mode = "ista"

ista fn onAwait(self: Peek, done: Resolver<Int, "ista">):
  select:
    case self.inner as ready: done.resolve(ready + 100)
    else: self.inner.onAwait(done)

ista async fn now(value: Int) -> Int: value

ista async fn nestedSelect() -> Int:
  const first = await Peek{inner: now(1)}
  first * 10 + await Peek{inner: later(2)}

struct Left:
  x: Int

struct Right:
  y: Int

ista fn onAwait(self: Left | Right, done: Resolver<Int, "ista">):
  match self:
    case Left{x}: done.resolve(x)
    case Right{y}: done.resolve(y)

ista async fn convertedOperand() -> Int:
  const a = await Left{x: 20}
  const b = await (later(22),)
  a + b

shared struct Log:
  text: String

ista async fn worker(starts: Starts, log: Log):
  await select:
    case Cold{starts: starts, value: 1}: log->text = "cold"
    case worker.disposing(): log->text = "cleaned up"

ista async fn cleanupCaseWins() -> String:
  const starts = new Starts{count: 0}
  const log = new Log{text: "none"}
  {
    const running = worker(starts, log)
  }
  log->text

shared struct KeptDone:
  done: Resolver<Int, "ista">?

struct Keep:
  kept: KeptDone
  type Mode = "ista"

ista fn onAwait(self: Keep, done: Resolver<Int, "ista">): self.kept->done = done

ista async fn decidedResolver() -> Int:
  const kept = new KeptDone{done: none}
  const starts = new Starts{count: 0}
  const got = await select:
    case Keep{kept: kept} as never: never
    case Cold{starts: starts, value: 3} as value: value
  match kept->done:
    case None: -1
    case done:
      done.resolve(9)
      got * 10 + (if done.tryResolve(9): 1 else: 0)

shared struct Kept:
  done: Resolver<Int, "ista">?

struct KeepLosingResolverCancelled:
  kept: Kept
  type Mode = "ista"

ista fn onAwait(self: KeepLosingResolverCancelled, done: Resolver<Int, "ista">):
  self.kept->done = done

ista async fn losingResolverCancelled() -> Int:
  const starts = new Starts{count: 0}
  await select:
    case Cold{starts: starts, value: 3} as value: value
    case KeepLosingResolverCancelled{kept: new Kept{done: none}} as never: never

shared struct TookOnce:
  took: Bool

struct TryAfter:
  took: TookOnce
  type Mode = "ista"

ista fn onAwait(self: TryAfter, done: Resolver<Int, "ista">): self.took->took = done.tryResolve(99)

ista async fn tryResolveDecided() -> Int:
  const starts = new Starts{count: 0}
  const took = new TookOnce{took: true}
  const got = await select:
    case Cold{starts: starts, value: 3} as value: value
    case TryAfter{took: took} as never: never
  got * 10 + (if took->took: 1 else: 0)

shared struct Took:
  first: Bool
  second: Bool

struct Twice:
  took: Took
  type Mode = "ista"

ista fn onAwait(self: Twice, done: Resolver<Int, "ista">):
  self.took->first = done.tryResolve(4)
  self.took->second = done.tryResolve(5)

ista async fn tryResolveTook() -> Int:
  const took = new Took{first: false, second: false}
  const got = await Twice{took: took}
  got * 100 + (if took->first: 10 else: 0) + (if took->second: 1 else: 0)

shared struct HeldWeak:
  weak: WeakRef<Resolver<Int, "ista">>?

struct WatchResolver:
  held: HeldWeak
  type Mode = "ista"

ista fn onAwait(self: WatchResolver, done: Resolver<Int, "ista">):
  self.held->weak = WeakRef(done)
  done.resolve(42)

ista async fn weakResolver() -> Int:
  const held = new HeldWeak{weak: none}
  const v = await WatchResolver{held: held}
  await runtime.commit()
  match held->weak:
    case None: -1
    case weak:
      if weak.deref() == none: v
      else: 0

shared struct TookPositionAfterDecision:
  took: Bool

struct Late:
  took: TookPositionAfterDecision
  type Mode = "ista"

ista fn onAwait(self: Late, done: Resolver<(Int, Int), "ista">):
  done.resolve((7, 8))
  self.took->took = Resolver.at(done, 0).tryResolve(1)

ista async fn positionAfterDecision() -> Int:
  const took = new TookPositionAfterDecision{took: true}
  const (position, value) = await Late{took}
  position * 10 + value + (if took->took: 100 else: 0)

shared struct SeenAt:
  cancelled: Int
  took: Bool

struct ResolveAt:
  seen: SeenAt
  type Mode = "ista"

ista fn onAwait(self: ResolveAt, done: Resolver<(Int, Int), "ista">):
  done.onCancel(fn(): { self.seen->cancelled += 1; () })
  Resolver.at(done, 0).resolve(9)

struct TryAt:
  seen: SeenAt
  type Mode = "ista"

ista fn onAwait(self: TryAt, done: Resolver<(Int, Int), "ista">):
  done.onCancel(fn(): { self.seen->cancelled += 10; () })
  self.seen->took = Resolver.at(done, 0).tryResolve(9)

ista async fn losingPosition() -> (Int, Int, Bool):
  const seen = new SeenAt{cancelled: 0, took: true}
  const got = await select:
    case runtime.commit(): 1
    case ResolveAt{seen} as pair: pair.1
    case TryAt{seen} as pair: pair.1
  await runtime.commit()
  (got, seen->cancelled, seen->took)

ista async fn inboxWorker(box: Inbox<Int>, log: Inbox<String>):
  await select:
    case box.receive(): log.send("received")
    case inboxWorker.disposing(): log.send("cleaned up")

ista async fn disposedAfterDecision() -> String:
  const box = Inbox.create<Int>()
  const log = Inbox.create<String>()
  if true:
    const w = inboxWorker(box, log)
    await runtime.commit()
    box.send(1)
  await log.receive()

shared struct Seen:
  value: Int

K fn see<K in Persistence>(seen: Seen, value: Int): seen->value = value

shared struct KeptOnCancelLoser:
  resolver: Resolver<Int, "ista">? = none

struct Watched:
  seen: Seen
  kept: KeptOnCancelLoser
  type Mode = "ista"

ista fn onAwait(self: Watched, done: Resolver<Int, "ista">):
  const seen = self.seen
  done.onCancel(fn(): see(seen, -1))
  self.kept->resolver = done
  later(1).onAwait(done)

ista async fn onCancelLoser() -> Int:
  const seen = new Seen{value: 0}
  const got = await select:
    case Watched{seen, kept: new KeptOnCancelLoser{}} as slow: slow
    case runtime.commit(): 5
  await runtime.commit()
  got * 10 + seen->value

shared struct KeptOnCancelAlready:
  resolver: Resolver<Int, "ista">? = none

struct WatchedOnCancelAlready:
  seen: Seen
  kept: KeptOnCancelAlready
  type Mode = "ista"

ista fn onAwait(self: WatchedOnCancelAlready, done: Resolver<Int, "ista">):
  const seen = self.seen
  done.onCancel(fn(): see(seen, -1))
  self.kept->resolver = done
  later(1).onAwait(done)

ista async fn onCancelAlready() -> Int:
  const seen = new Seen{value: 0}
  const kept = new KeptOnCancelAlready{}
  _ = await select:
    case WatchedOnCancelAlready{seen, kept} as slow: slow
    case runtime.commit(): 5
  await runtime.commit()
  _ = kept->resolver?.onCancel(fn(): see(seen, -2))
  await runtime.commit()
  seen->value

struct ResolvedTwice:
  type Mode = "ista"

ista fn onAwait(self: ResolvedTwice, done: Resolver<Int, "ista">):
  done.resolve(1)
  done.resolve(2)

struct LetGo:
  took: Took
  type Mode = "ista"

ista fn onAwait(self: LetGo, done: Resolver<Int, "ista">): _ = self.took

const droppedResolver = "A resolver was let go of unresolved, so the wait it was to decide never can. An awaitable keeps the work it starts alive by registering its resolver, or a Resolver.at of it, on that work; to map a value, await it in an async fn."

@Suite{"awaitables"}
fn suite() -> Array<Test>: [
  test(
    "an awaitable starts its work only once it is awaited"
    async fn(): assertEq(await coldStart(), 17)
  )
  test(
    "an awaitable waits on a future through that future's onAwait"
    async fn(): assertEq(await futureOnAwait(), 42)
  )
  test(
    "an awaitable races in a select, a case's value given by its own onAwait"
    async fn(): assertEq(await selectOnAwait(), 21)
  )
  test(
    "an awaitable may run a select of its own in onAwait, a wait apart from the one it was called for"
    async fn(): assertEq(await nestedSelect(), 1012)
  )
  test(
    "an awaited operand that fits onAwait is awaited through an implicit conversion"
    async fn(): assertEq(await convertedOperand(), 42)
  )
  test(
    "a disposed call runs its disposing() case in a select even when an earlier case resolved in onAwait"
    async fn(): assertEq(await cleanupCaseWins(), "cleaned up")
  )
  test(
    "a resolver does nothing once another case decided its wait, kept or not"
    async fn(): assertEq(await decidedResolver(), 30)
  )
  test(
    "a later losing case resolver is cancelled before its case holdings are released when an earlier case resolved in onAwait"
    async fn(): assertEq(await losingResolverCancelled(), 3)
  )
  test(
    "tryResolve gives false on a later case resolver once an earlier case decided the wait in onAwait"
    async fn(): assertEq(await tryResolveDecided(), 30)
  )
  test(
    "a resolver resolved twice panics"
    async fn(): assertEq(
      await expectPanic(async fn(): await ResolvedTwice)
      "A resolver was resolved twice."
    )
  )
  test(
    "a wait's resolver let go of unresolved, never registered, panics"
    async fn(): assertEq(
      await expectPanic(async fn(): await LetGo{took: new Took{first: false, second: false}})
      droppedResolver
    )
  )
  test(
    "tryResolve says whether it took the value"
    async fn(): assertEq(await tryResolveTook(), 410)
  )
  test(
    "a WeakRef to a resolved or cancelled resolver clears once it is let go of, without breaking a commit"
    async fn(): assertEq(await weakResolver(), 42)
  )
  test(
    "a Resolver.at made for a resolver no longer pending is cancelled at once"
    async fn(): assertEq(await positionAfterDecision(), 78)
  )
  test(
    "a losing case resolver is cancelled when its Resolver.at is resolved or tried after an earlier case decided the wait in onAwait"
    async fn(): assertEq(await losingPosition(), (1, 11, false))
  )
  test(
    "a call disposed after its select was decided on its disposing() case resumes there"
    async fn(): assertEq(await disposedAfterDecision(), "cleaned up")
  )
  test(
    "a resolver's onCancel runs once another case decides its wait"
    async fn(): assertEq(await onCancelLoser(), 49)
  )
  test(
    "an onCancel runs at once when given to a resolver cancelled already"
    async fn(): assertEq(await onCancelAlready(), -2)
  )
]
