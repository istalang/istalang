# Defaults, constants and function values (spec §3.3, §3.4, §3.14): when a default left out is
# computed and what it sees, and constants another module computes. Each rule is its own function,
# and its test asserts what the old lowering's unit test did.

import Suite, Test, test, assertEq from 'testing'
import * as strings from 'strings'
import Decimal from 'decimal'
import * as lib from './functions-lib'

fn note(log: Shared<String>, what: String, n: Int) -> Int:
  log->value += what
  n

fn f(log: Shared<String>, a: Int = note(log, "a ", 1), b: Int = note(log, "b ", a + 1)):
  log->value += `body ${a} ${b}`

fn defaultAfterArguments() -> String:
  const log = new Shared{value: ""}
  f(log, b: note(log, "given ", 5))
  log->value

fn stamp(counter: Shared<Int>, at: Int = counter->value) -> Int: at

fn kept(g: fn() -> Int) -> fn() -> Int: g

fn deferredDefault() -> Int:
  const counter = new Shared{value: 1}
  const later = kept stamp(counter)
  counter->value = 5
  later()

struct Retry { times: Int = 3, backoff = times * 2, cap: Int }

enum Shape:
  Circle(r: Int = 2)
  Square(side: Int)

fn area(shape: Shape) -> Int:
  match shape:
    case Circle(r): r * r
    case Square(side): side * side

fn shown(r: Retry) -> String: `${r.times}/${r.backoff}/${r.cap}`

fn builtDefaults() -> Array<String>:
  const circle: fn() -> Shape = Shape.Circle
  const pad: fn(String, Int) -> String = strings.padStart
  [
    `${shown(Retry{cap: 1})} ${shown(Retry{times: 1, cap: 2})} ${shown(Retry{backoff: 1, times: 5, cap: 3})}`
    `${area(Shape.Circle())} ${area(Shape.Circle(3))} ${area(circle())}`
    `${strings.padStart("ab", 4)}|${strings.padStart("ab", 4, "*")}|${pad("ab", 3)}`
    `${strings.indexOf("hello", "l")} ${strings.indexOf("hello", "l", 3)}`
    `${strings.slice("hello", 1)} ${strings.slice("hello", 1, 3)}`
    `${Decimal.from(3).toFixed(1)} ${Decimal.from(3).toFixed(2)}`
  ]

ista async fn namespaceFunctionConstant() -> Int:
  match await (spawn lib.twice(1)).result():
    case Ok(value): lib.twice(20) + value
    case Err(_): 0

const beyondDouble = 9007199254740993

const negativeZero = -0.0

const largeFloat = 1152921504606847000.0

fn literalsKept() -> (Int, Bool, Bool):
  (beyondDouble - 9007199254740992, 1.0 / negativeZero < -1e308, largeFloat == 1152921504606846976.0)

fn onlyElse() -> Int:
  select:
    else: 42

@Suite{"functions"}
fn suite() -> Array<Test>: [
  test("a default left out is computed in the function, after the call's arguments, each seeing the parameters before it", fn(): assertEq(defaultAfterArguments(), "given a body 1 5"))
  test("a default left out of a deferred call is computed when it runs, reading what it reads then", fn(): assertEq(deferredDefault(), 5))
  test("defaults of a struct, a variant and a std function are computed when left out, and taken when given", fn(): assertEq(builtDefaults(), ["3/6/1 1/2/2 5/1/3", "4 9 4", "  ab|**ab| ab", "2 3", "ello el", "3.0 3.00"]))
  test("a constant is computed in its own module, even when another imports it", fn(): assertEq(lib.limits.high + lib.limits.high, 14))
  test("a namespace's function-typed constant is called, and spawned", async fn(): assertEq(await namespaceFunctionConstant(), 42))
  test("a select with only an else runs its else body", fn(): assertEq(onlyElse(), 42))
  test("a constant evaluates to the value it spells: an Int beyond a double, -0 and a large Float", fn(): assertEq(literalsKept(), (1, true, true)))
]
