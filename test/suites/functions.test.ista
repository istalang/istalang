# Defaults, constants and function values (spec §3.3, §3.4, §3.14): when a default left out is
# computed and what it sees, and constants another module computes. Each rule is its own function,
# and its test asserts what the old lowering's unit test did.

import Suite, Test, test, assertEq, mock, idle, waitingAt, spawnCrashingEveryAwait from 'testing'
import * as runtime from 'runtime'
import * as time from 'time'
import * as strings from 'strings'
import Decimal from 'decimal'
import * as lib from './functions-lib'

fn note(log: Shared<String>, what: String, n: Int) -> Int:
  log->value += what
  n

fn f(log: Shared<String>, a: Int = note(log, "a ", 1), b: Int = note(log, "b ", a + 1)):
  log->value += `body ${a} ${b}`

fn defaultAfterArguments() -> String:
  const log = new Shared{value: ""}
  f(log, b: note(log, "given ", 5))
  log->value

fn stamp(counter: Shared<Int>, at: Int = counter->value) -> Int: at

fn kept(g: fn() -> Int) -> fn() -> Int: g

fn deferredDefault() -> Int:
  const counter = new Shared{value: 1}
  const later = kept stamp(counter)
  counter->value = 5
  later()

struct Retry:
  times: Int = 3
  backoff = times * 2
  cap: Int

enum Shape:
  Circle(r: Int = 2)
  Square(side: Int)

fn area(shape: Shape) -> Int:
  match shape:
    case Circle(r): r * r
    case Square(side): side * side

fn shown(r: Retry) -> String: `${r.times}/${r.backoff}/${r.cap}`

fn builtDefaults() -> Array<String>:
  const circle: fn() -> Shape = Shape.Circle
  const pad: fn(String, Int) -> String = strings.padStart
  [
    `${shown(Retry{cap: 1})} ${shown(Retry{times: 1, cap: 2})} ${shown(Retry{backoff: 1, times: 5, cap: 3})}`
    `${area(Shape.Circle())} ${area(Shape.Circle(3))} ${area(circle())}`
    `${strings.padStart("ab", 4)}|${strings.padStart("ab", 4, "*")}|${pad("ab", 3)}`
    `${strings.indexOf("hello", "l")} ${strings.indexOf("hello", "l", 3)}`
    `${strings.slice("hello", 1)} ${strings.slice("hello", 1, 3)}`
    `${Decimal.from(3).toFixed(1)} ${Decimal.from(3).toFixed(2)}`
  ]

ista async fn namespaceFunctionConstant() -> Int:
  match await (spawn lib.twice(1)).result():
    case Ok(value): lib.twice(20) + value
    case Err(_): 0

const beyondDouble = 9007199254740993

const negativeZero = -0.0

const largeFloat = 1152921504606847000.0

fn literalsKept() -> (Int, Bool, Bool):
  (
    beyondDouble - 9007199254740992
    1.0 / negativeZero < -1e308
    largeFloat == 1152921504606846976.0
  )

fn onlyElse() -> Int:
  select:
    else: 42

ista async fn hello() -> Int: 1

ista async fn mockedHello() -> (Result<Int?>, Result<Int?>):
  hold _ = mock(hello, async fn() -> Int: 2)
  (await spawn<Int?>(hello).result(), await runtime.isolate<Int?>(hello))

ista async fn step() -> Int:
  @Waypoint{"step-1"}
  await time.delay(1h)
  1

ista async fn widenedWaitingAt() -> Array<String>:
  const widened: sendable ista async fn() -> Int? = step
  const instance = spawn(widened)
  await instance.idle()
  instance.waitingAt()

ista async fn worker(log: Shared<Array<String>>) -> Int:
  await select:
    case time.delay(1h): 1
    case worker.disposing():
      log->value.push("worker disposing")
      2

ista async fn widenedDisposal() -> Array<String>:
  const log = new Shared<Array<String>>{value: []}
  const widened: ista async fn(Shared<Array<String>>) -> Int? = worker
  if true:
    _ = defer(fn(): log->value.push("earlier defer"))
    _ = widened(log)
  log->value

ista async fn later(value: Int) -> Int:
  await runtime.commit()
  value

ista async fn widenedAcrossCommits() -> (Int?, Int?):
  const widened: ista async fn(Int) -> Int? = later
  const pending = widened(4)
  await runtime.commit()
  (await pending, await widened(5))

shared struct Stored:
  future: Future<Int, "ista">

ista fn storedFuture(stored: Stored) -> Future<Int, "ista">: stored->future

ista async fn widenedSharedFuture() -> (Int?, Int):
  const stored = new Stored{future: later(6)}
  const widened: ista fn(Stored) -> Future<Int?, "ista"> = storedFuture
  (await widened(stored), await stored->future)

ista fn watched(log: Shared<Array<Int>>) -> Future<Int, "ista">:
  const future = later(7)
  future.onAwait(Resolver.of(fn(value: Int): log->value.push(value + 100)))
  future

ista async fn widenedWatchedFuture() -> (Int?, Array<Int>):
  const log = new Shared<Array<Int>>{value: []}
  const widened: ista async fn(Shared<Array<Int>>) -> Int? = watched
  const value = await widened(log)
  await time.delay(1ms)
  (value, log->value)

shared struct WeakFuture:
  weak: WeakRef<Future<Int, "ista">>?

ista fn weaklyWatched(out: WeakFuture) -> Future<Int, "ista">:
  const future = later(8)
  out->weak = WeakRef(future)
  future

ista async fn widenedWeaklyWatchedFuture() -> (Int?, Int):
  const out = new WeakFuture{weak: none}
  const widened: ista async fn(WeakFuture) -> Int? = weaklyWatched
  const pending = widened(out)
  if out->weak is WeakRef<Future<Int, "ista">> as weak and weak.deref() is Future<Int, "ista"> as original:
    const value = await original
    (await pending, value + 100)
  else: (none, 0)

ista fn greetingDefault() -> Int:
  drop greeting(2)
  10

ista async fn greeting(x: Int = greetingDefault()) -> Int: x + 1

ista async fn hundredfold(x: Int) -> Int: x * 100

ista async fn mockedGreeting() -> (Result<Int>, Result<Int>, Array<(Int,)>):
  const greetings = mock(greeting, hundredfold)
  (await spawn(greeting).result(), await runtime.isolate(greeting), greetings.calls())

@Suite{"functions"}
fn suite() -> Array<Test>: [
  test(
    "a default left out is computed in the function, after the call's arguments, each seeing the parameters before it"
    fn(): assertEq(defaultAfterArguments(), "given a body 1 5")
  )
  test(
    "a default left out of a deferred call is computed when it runs, reading what it reads then"
    fn(): assertEq(deferredDefault(), 5)
  )
  test(
    "defaults of a struct, a variant and a std function are computed when left out, and taken when given"
    fn(): assertEq(builtDefaults(), [
      "3/6/1 1/2/2 5/1/3"
      "4 9 4"
      "  ab|**ab| ab"
      "2 3"
      "ello el"
      "3.0 3.00"
    ])
  )
  test(
    "a constant is computed in its own module, even when another imports it"
    fn(): assertEq(lib.limits.high + lib.limits.high, 14)
  )
  test(
    "a namespace's function-typed constant is called, and spawned"
    async fn(): assertEq(await namespaceFunctionConstant(), 42)
  )
  test("a select with only an else runs its else body", fn(): assertEq(onlyElse(), 42))
  test(
    "a constant evaluates to the value it spells: an Int beyond a double, -0 and a large Float"
    fn(): assertEq(literalsKept(), (1, true, true))
  )
  test(
    "an async function widened and started is no call of it, which a mock would replace"
    async fn(): assertEq(await mockedHello(), (Ok(1), Ok(1)))
  )
  test(
    "an async function widened runs as its own call, with no frame of the widening"
    async fn(): assertEq(await widenedWaitingAt(), ["step-1"])
  )
  test(
    "an async function widened is disposed as its own call, before an earlier defer"
    async fn(): assertEq(await widenedDisposal(), ["worker disposing", "earlier defer"])
  )
  test(
    "an async function widened gives its value converted across commits"
    async fn(): assertEq(await widenedAcrossCommits(), (4, 5))
  )
  test(
    "an async function widened gives its value converted with every segment re-run"
    async fn(): assertEq(await spawnCrashingEveryAwait(widenedAcrossCommits).result(), Ok((4, 5)))
  )
  test(
    "a future something else holds, widened, is awaited and stays as it was for its holder"
    async fn(): assertEq(await widenedSharedFuture(), (6, 6))
  )
  test(
    "a future a callback waits on, widened, is awaited and the callback is given its value as it was"
    async fn(): assertEq(await widenedWatchedFuture(), (7, [107]))
  )
  test(
    "a function started is no call of it a mock replaces, even when its default calls it first"
    async fn(): assertEq(await mockedGreeting(), (Ok(11), Ok(11), [(2,), (2,)]))
  )
  test(
    "a future a weak reference refers to, widened, is awaited and stays as it was for what derefs it"
    async fn(): assertEq(await widenedWeaklyWatchedFuture(), (8, 108))
  )
]
