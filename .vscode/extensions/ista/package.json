{
  "name": "ista",
  "displayName": "Istalang",
  "description": "Istalang sources (.ista): highlighting, and the language server `ista lsp`",
  "publisher": "local",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./dist/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a workspace you haven't trusted, the language server doesn't start: starting it runs the workspace's own `ista`."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "ista",
        "aliases": [
          "Istalang",
          "ista"
        ],
        "extensions": [
          ".ista"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ista",
        "scopeName": "source.ista",
        "path": "./syntaxes/ista.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[ista]": {
        "editor.defaultFormatter": "local.ista",
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false,
        "editor.wordBasedSuggestions": "off",
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        }
      }
    },
    "configuration": {
      "title": "Istalang",
      "properties": {
        "ista.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `ista` executable that runs the language server (`ista lsp --stdio`), from the workspace's first folder. Empty: the workspace's `node_modules/.bin/ista`, else `ista` from the PATH. Takes effect when the window reloads."
        }
      }
    }
  }
}
