# outcome: "cleaned up | job unhandled"
# The `disposing()` case wins in live code too (§7): the job's case decides the worker's wait first,
# readying it, but its last holder lets go of it before it runs, so it resumes on its `disposing()`
# case, which stays registered until the worker moves on, though it comes later in the `select`.

fn note(log: Shared<Array<String>>, entry: String):
  log->value = [...log->value, entry]

struct Gate:
  waiting: Shared<Array<Resolver<Int, "live">>>

live fn onAwait(self: Gate, done: Resolver<Int, "live">): self.waiting->value.push(done)

live async fn worker(gate: Gate, log: Shared<Array<String>>) -> Unit:
  await select:
    case gate as job:
      note(log, "job " + String(job))
    case worker.disposing():
      note(log, "cleaned up")

live async fn main() -> String:
  const empty: Array<String> = []
  const log = new Shared{value: empty}
  const pending: Array<Resolver<Int, "live">> = []
  const gate = Gate{waiting: new Shared{value: pending}}
  {
    const running = worker(gate, log)
    gate.waiting->value[0].resolve(3)
  }
  note(log, "job unhandled")
  log->value.join(" | ")
