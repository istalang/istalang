# The futures module's combinators (spec §3.8). Each scenario waits across a commit before what it
# waits on arrives, so the combinator resumes from the snapshot that commit took (§5), and each runs
# twice: in the test's own instance, and in one that discards and re-runs every segment before
# committing it (§10).

import (
  Suite
  Test
  test
  assertEq
  expectPanic
  FakeClock
  withClock
  mock
  spawnCrashingEveryAwait
  idle
) from 'testing'
import * as testing from 'testing'
import runAndReRun from '../testing/re-runs.test'
import * as futures from 'futures'
import * as runtime from 'runtime'
import * as time from 'time'

# What the futures under test give: a value, or the name of what failed.
type Outcome = Result<Int, String>

# Fills `slot` with `value` once a commit has passed, as another execution would.
ista async fn later<T>(slot: Slot<T>, value: T) -> Unit:
  await runtime.commit()
  await slot.put(value)

ista async fn firstOfTwo() -> (Int, Int):
  const (a, b) = (Slot.create<Int>(), Slot.create<Int>())
  const raced = futures.first([a.read(), b.read()])
  await later(b, 2)
  await raced

ista async fn firstArrivedBeforeItsAwait() -> (Int, Int):
  const (a, b) = (Slot.create<Int>(), Slot.create<Int>())
  const (fromA, fromB) = (a.read(), b.read())
  await later(b, 2)
  await later(a, 1)
  await futures.first([fromA, fromB])

ista async fn firstPolledWhenOneArrived() -> (Int, Int):
  const (a, b) = (Slot.create<Int>(), Slot.create<Int>())
  const (fromA, fromB) = (a.read(), b.read())
  await later(b, 2)
  let got = (-1, -1)
  select:
    case futures.first([fromA, fromB]) as arrived: got = arrived
    else: got = (-2, -2)
  got

@Suite{"futures › first"}
fn firstSuite() -> Array<Test>: [
  ...runAndReRun(
    "is decided at once in a select that doesn't wait, when one has arrived"
    firstPolledWhenOneArrived
    (1, 2)
  )
  ...runAndReRun("gives the position and value of the first to arrive", firstOfTwo, (1, 2))
  ...runAndReRun(
    "gives the lowest position among those arrived before it was awaited"
    firstArrivedBeforeItsAwait
    (0, 1)
  )
  test("wins in a select when its future resolves with or before a later case's", async fn(): {
    const s = Slot.create<Int>()
    const r0 = s.read()
    const r1 = s.read()
    _ = later(s, 7)
    const got = await select:
      case futures.first([r0]) as pair: pair.1
      case r1: -1
    assertEq(got, 7)
  })
  test("loses cleanly in a select after an earlier case already resolved", async fn(): {
    const s = Slot.create<Int>()
    const passedOver = s.take()
    _ = await select:
      case passedOver: 0
      case runtime.commit(): -1
    _ = s.put(42)
    const blocking = await select:
      case runtime.commit(): 1
      case futures.first([runtime.commit()]): 2
      case futures.first([passedOver]): 3
    const nonBlocking = select:
      case runtime.commit(): 10
      case futures.first([runtime.commit()]): 20
      else: 30
    const leftInS = select:
      case s.take() as v: v
      else: -1
    assertEq((blocking, nonBlocking, leftInS), (1, 10, 42))
  })
  test("panics awaited with no futures", async fn(): {
    assertEq(
      await expectPanic(async fn(): await futures.first<Int, "ista">([]))
      "futures.first was given no futures."
    )
  })
]

ista async fn allArrivingOutOfOrder() -> Result<Array<Int>, String>:
  const (a, b) = (Slot.create<Outcome>(), Slot.create<Outcome>())
  const all = futures.all([a.read(), b.read()])
  await later(b, Ok(2))
  await later(a, Ok(1))
  await all

ista async fn allWithOneFailing() -> Result<Array<Int>, String>:
  const (a, b) = (Slot.create<Outcome>(), Slot.create<Outcome>())
  const all = futures.all([a.read(), b.read()])
  await later(b, Err("b"))
  await all

ista async fn allOfNone() -> Result<Array<Int>, String>: await futures.all<Int, String, "ista">([])

@Suite{"futures › all"}
fn allSuite() -> Array<Test>: [
  ...runAndReRun(
    "gives every Ok value in position order, whatever order they arrive in"
    allArrivingOutOfOrder
    Ok([1, 2])
  )
  ...runAndReRun(
    "gives the first Err as soon as it arrives, while the others still wait"
    allWithOneFailing
    Err("b")
  )
  ...runAndReRun("of no futures is Ok and empty", allOfNone, Ok([]))
]

ista async fn allSettledWithAFailure() -> Array<Outcome>:
  const (a, b) = (Slot.create<Outcome>(), Slot.create<Outcome>())
  const settled = futures.allSettled([a.read(), b.read()])
  await later(b, Err("b"))
  await later(a, Ok(1))
  await settled

@Suite{"futures › allSettled"}
fn allSettledSuite() -> Array<Test>: [
  ...runAndReRun(
    "gives every value in position order once all arrived, failures included"
    allSettledWithAFailure
    [Ok(1), Err("b")]
  )
]

ista async fn raceOfTwo() -> Int:
  const (a, b) = (Slot.create<Int>(), Slot.create<Int>())
  const first = futures.race([a.read(), b.read()])
  await later(b, 2)
  await first

@Suite{"futures › race"}
fn raceSuite() -> Array<Test>: [
  ...runAndReRun("gives the first value to arrive", raceOfTwo, 2)
  test("panics on no futures", async fn(): {
    assertEq(
      await expectPanic(async fn(): await futures.race<Int, "ista">([]))
      "futures.first was given no futures."
    )
  })
]

ista async fn anyAfterAnError() -> Result<Int, Array<String>>:
  const (a, b) = (Slot.create<Outcome>(), Slot.create<Outcome>())
  const either = futures.any([a.read(), b.read()])
  await later(a, Err("a"))
  await later(b, Ok(2))
  await either

ista async fn anyAllFailing() -> Result<Int, Array<String>>:
  const (a, b) = (Slot.create<Outcome>(), Slot.create<Outcome>())
  const either = futures.any([a.read(), b.read()])
  await later(b, Err("b"))
  await later(a, Err("a"))
  await either

ista async fn anyOfNone() -> Result<Int, Array<String>>: await futures.any<Int, String, "ista">([])

@Suite{"futures › any"}
fn anySuite() -> Array<Test>: [
  ...runAndReRun("gives the first Ok to arrive, past the errors before it", anyAfterAnError, Ok(2))
  ...runAndReRun(
    "gives every error in position order once all failed"
    anyAllFailing
    Err(["a", "b"])
  )
  ...runAndReRun("of no futures is an empty Err", anyOfNone, Err([]))
]

ista async fn quorumReached() -> Result<Array<Int>, Array<String>>:
  const (a, b, c) = (Slot.create<Outcome>(), Slot.create<Outcome>(), Slot.create<Outcome>())
  const two = futures.quorum(2, [a.read(), b.read(), c.read()])
  await later(c, Ok(3))
  await later(a, Err("a"))
  await later(b, Ok(2))
  await two

ista async fn quorumOutOfReach() -> Result<Array<Int>, Array<String>>:
  const (a, b, c) = (Slot.create<Outcome>(), Slot.create<Outcome>(), Slot.create<Outcome>())
  const two = futures.quorum(2, [a.read(), b.read(), c.read()])
  await later(c, Err("c"))
  await later(a, Err("a"))
  await two

ista async fn quorumOfZero() -> Result<Array<Int>, Array<String>>:
  await futures.quorum(0, [Slot.create<Outcome>().read()])

@Suite{"futures › quorum"}
fn quorumSuite() -> Array<Test>: [
  ...runAndReRun("gives the first n Ok values in the order they arrived", quorumReached, Ok([3, 2]))
  ...runAndReRun(
    "fails once n can't be reached, with the errors in position order"
    quorumOutOfReach
    Err(["a", "c"])
  )
  ...runAndReRun("of zero is Ok and empty", quorumOfZero, Ok([]))
  test("panics when n is more than the futures", async fn(): {
    const message = await expectPanic(async fn(): await futures.quorum<Int, String, "ista">(1, []))
    assertEq(message, "A quorum of 1 can't be reached among 0 futures.")
  })
  test("panics when n is negative", async fn(): {
    const message = await expectPanic(async fn(): await futures.quorum<Int, String, "ista">(-1, []))
    assertEq(message, "A quorum of -1 can't be reached among 0 futures.")
  })
]

# Each combinator's takes wait in their slot's queue from the call on, ahead of a take made after
# it, between the arrivals it waits for as before the first: `late` gets only what comes once the
# combinator returned.
ista async fn allKeepingItsPlace() -> (Result<Array<Int>, String>, Outcome):
  const s = Slot.create<Outcome>()
  const all = futures.all([s.take(), s.take()])
  const late = s.take()
  await runtime.commit()
  drop s.put(Ok(1))
  drop s.put(Ok(2))
  const got = await all
  drop s.put(Ok(3))
  (got, await late)

ista async fn anyKeepingItsPlace() -> (Result<Int, Array<String>>, Outcome):
  const s = Slot.create<Outcome>()
  const either = futures.any([s.take(), s.take()])
  const late = s.take()
  await runtime.commit()
  drop s.put(Err("a"))
  drop s.put(Ok(2))
  const got = await either
  drop s.put(Ok(3))
  (got, await late)

ista async fn quorumKeepingItsPlace() -> (Result<Array<Int>, Array<String>>, Outcome):
  const s = Slot.create<Outcome>()
  const two = futures.quorum(2, [s.take(), s.take(), s.take()])
  const late = s.take()
  await runtime.commit()
  drop s.put(Ok(1))
  drop s.put(Ok(2))
  const got = await two
  drop s.put(Ok(3))
  (got, await late)

# A take that lost a select is passed over until awaited again (§8): `allSettled` awaits it from
# the call on, not once the futures before it arrived.
ista async fn allSettledAwaitingFromTheCall() -> (Array<Int>, Int):
  const (a, s) = (Slot.create<Int>(), Slot.create<Int>())
  const fromS = s.take()
  _ = await select:
    case fromS: -1
    case runtime.commit(): 0
  const settled = futures.allSettled([a.take(), fromS])
  const late = s.take()
  await runtime.commit()
  drop s.put(10)
  drop a.put(5)
  const got = await settled
  drop s.put(11)
  (got, await late)

@Suite{"futures › watching from the call on"}
fn watchingSuite() -> Array<Test>: [
  ...runAndReRun(
    "all keeps its takes' place between arrivals"
    allKeepingItsPlace
    (Ok([1, 2]), Ok(3))
  )
  ...runAndReRun("any keeps its takes' place between arrivals", anyKeepingItsPlace, (Ok(2), Ok(3)))
  ...runAndReRun(
    "quorum keeps its takes' place between arrivals"
    quorumKeepingItsPlace
    (Ok([1, 2]), Ok(3))
  )
  ...runAndReRun(
    "allSettled awaits a passed-over take from the call on"
    allSettledAwaitingFromTheCall
    ([5, 10], 11)
  )
]

ista async fn timeoutInTime() -> Int?:
  const value = Slot.create<Int>()
  const limited = futures.timeout(value.read(), 5s)
  await later(value, 1)
  await limited

@Suite{"futures › timeout"}
ista fn timeoutSuite() -> Array<Test>: [
  ...runAndReRun("gives the value when it arrives in time", timeoutInTime, 1)
  test("gives none once the limit passes first", withClock, async fn(clock): {
    const limited = futures.timeout(Slot.create<Int>().read(), 5s)
    await runtime.commit()
    clock.advance(5s)
    assertEq(await limited, none)
  })
  test("gives the value when it arrives just before the limit passes", withClock, async fn(clock): {
    const value = Slot.create<Int>()
    const limited = futures.timeout(value.read(), 5s)
    await runtime.commit()
    drop value.put(1)
    clock.advance(5s)
    assertEq(await limited, 1)
  })
  test("gives none when the value arrives just after the limit passes", withClock, async fn(
    clock
  ): {
    const value = Slot.create<Int>()
    const limited = futures.timeout(value.read(), 5s)
    await runtime.commit()
    clock.advance(5s)
    drop value.put(1)
    assertEq(await limited, none)
  })
]

# Retries, its default three times, a second apart as named past the default it leaves out, an
# attempt that succeeds the third time: the outcome, and when each attempt started.
ista async fn succeedingThirdTime() -> (Outcome, Array<Int>):
  let startedAt: Array<Int> = []
  const attempt = async fn() -> Outcome: {
    startedAt.push(time.now().value)
    if startedAt.length() < 3: Err("failed")
    else: Ok(startedAt.length())
  }
  (await futures.retry(attempt, backoff: 1s), startedAt)

# Moves `clock` through the backoffs of `retrying`, an instance running `succeedingThirdTime`.
ista async fn backingOff(clock: FakeClock, retrying: Instance<(Outcome, Array<Int>)>):
  await retrying.idle()
  clock.advance(1s)
  await retrying.idle()
  clock.advance(2s)
  assertEq(await retrying.result(), Ok((Ok(3), [0, 1000, 3000])))

# Retries, twice a second apart, a plain attempt that always fails.
ista async fn failingTwice() -> Outcome:
  let attempts = 0
  await futures.retry(fn() -> Outcome: { attempts += 1; Err("attempt " + attempts) }, 2, 1s)

ista async fn succeedingFirstTime() -> Outcome: await futures.retry(fn() -> Outcome: Ok(1))

@Suite{"futures › retry"}
ista fn retrySuite() -> Array<Test>: [
  test(
    "waits backoff before the first retry and twice as long before the next"
    withClock
    async fn(clock): {
      await backingOff(clock, spawn succeedingThirdTime())
    }
  )
  test(
    "waits backoff before the first retry and twice as long before the next, with every segment re-run"
    withClock
    async fn(clock): {
      await backingOff(clock, spawnCrashingEveryAwait(succeedingThirdTime))
    }
  )
  test("gives the last Err once every attempt failed", withClock, async fn(clock): {
    const retrying = spawn failingTwice()
    await retrying.idle()
    clock.advance(1s)
    assertEq(await retrying.result(), Ok(Err("attempt 2")))
  })
  ...runAndReRun("gives the first Ok without waiting", succeedingFirstTime, Ok(1))
  test("panics with no attempt to make", async fn(): {
    const message = await expectPanic(async fn(): await futures.retry(fn() -> Outcome: Ok(1), 0))
    assertEq(message, "retry needs at least one attempt, not 0.")
  })
]
