# The futures module's combinators (spec §3.8). Each scenario waits across a commit before what it
# waits on arrives, so the combinator resumes from the snapshot that commit took (§5), and each runs
# twice: in the test's own instance, and in one that discards and re-runs every segment before
# committing it (§10).

import Suite, Test, test, assertEq, expectPanic, FakeClock, withClock, mock, spawnCrashingEveryAwait, idle from 'testing'
import * as testing from 'testing'
import runAndReRun from '../testing/re-runs.test'
import * as futures from 'futures'
import * as runtime from 'runtime'
import * as time from 'time'

# What the futures under test give: a value, or the name of what failed.
type Outcome = Result<Int, String>

# Fills `slot` with `value` once a commit has passed, as another execution would.
async fn later<T>(slot: Slot<T>, value: T) -> Future<Unit>:
  await runtime.commit()
  await slot.put(value)

async fn allArrivingOutOfOrder() -> Future<Result<Array<Int>, String>>:
  const (a, b) = (Slot.create<Outcome>(), Slot.create<Outcome>())
  const all = futures.all([a.read(), b.read()])
  await later(b, Ok{(2)})
  await later(a, Ok{(1)})
  await all

async fn allWithOneFailing() -> Future<Result<Array<Int>, String>>:
  const (a, b) = (Slot.create<Outcome>(), Slot.create<Outcome>())
  const all = futures.all([a.read(), b.read()])
  await later(b, Err{("b")})
  await all

async fn allOfNone() -> Future<Result<Array<Int>, String>>: await futures.all<Int, String>([])

@Suite{"futures › all"}
fn allSuite() -> Array<Test>: [
  ...runAndReRun(
    "gives every Ok value in position order, whatever order they arrive in",
    allArrivingOutOfOrder,
    Ok{([1, 2])},
  ),
  ...runAndReRun(
    "gives the first Err as soon as it arrives, while the others still wait",
    allWithOneFailing,
    Err{("b")},
  ),
  ...runAndReRun("of no futures is Ok and empty", allOfNone, Ok{([])}),
]

async fn allSettledWithAFailure() -> Future<Array<Outcome>>:
  const (a, b) = (Slot.create<Outcome>(), Slot.create<Outcome>())
  const settled = futures.allSettled([a.read(), b.read()])
  await later(b, Err{("b")})
  await later(a, Ok{(1)})
  await settled

@Suite{"futures › allSettled"}
fn allSettledSuite() -> Array<Test>: [
  ...runAndReRun(
    "gives every value in position order once all arrived, failures included",
    allSettledWithAFailure,
    [Ok{(1)}, Err{("b")}],
  ),
]

async fn raceOfTwo() -> Future<Int>:
  const (a, b) = (Slot.create<Int>(), Slot.create<Int>())
  const first = futures.race([a.read(), b.read()])
  await later(b, 2)
  await first

@Suite{"futures › race"}
fn raceSuite() -> Array<Test>: [
  ...runAndReRun("gives the first value to arrive", raceOfTwo, 2),
  test("panics on no futures", async fn(): {
    assertEq(
      await expectPanic(async fn(): await futures.race<Int>([])),
      "futures.first was given no futures.",
    )
  }),
]

async fn anyAfterAnError() -> Future<Result<Int, Array<String>>>:
  const (a, b) = (Slot.create<Outcome>(), Slot.create<Outcome>())
  const either = futures.any([a.read(), b.read()])
  await later(a, Err{("a")})
  await later(b, Ok{(2)})
  await either

async fn anyAllFailing() -> Future<Result<Int, Array<String>>>:
  const (a, b) = (Slot.create<Outcome>(), Slot.create<Outcome>())
  const either = futures.any([a.read(), b.read()])
  await later(b, Err{("b")})
  await later(a, Err{("a")})
  await either

async fn anyOfNone() -> Future<Result<Int, Array<String>>>: await futures.any<Int, String>([])

@Suite{"futures › any"}
fn anySuite() -> Array<Test>: [
  ...runAndReRun(
    "gives the first Ok to arrive, past the errors before it",
    anyAfterAnError,
    Ok{(2)},
  ),
  ...runAndReRun(
    "gives every error in position order once all failed",
    anyAllFailing,
    Err{(["a", "b"])},
  ),
  ...runAndReRun("of no futures is an empty Err", anyOfNone, Err{([])}),
]

async fn quorumReached() -> Future<Result<Array<Int>, Array<String>>>:
  const (a, b, c) = (Slot.create<Outcome>(), Slot.create<Outcome>(), Slot.create<Outcome>())
  const two = futures.quorum(2, [a.read(), b.read(), c.read()])
  await later(c, Ok{(3)})
  await later(a, Err{("a")})
  await later(b, Ok{(2)})
  await two

async fn quorumOutOfReach() -> Future<Result<Array<Int>, Array<String>>>:
  const (a, b, c) = (Slot.create<Outcome>(), Slot.create<Outcome>(), Slot.create<Outcome>())
  const two = futures.quorum(2, [a.read(), b.read(), c.read()])
  await later(c, Err{("c")})
  await later(a, Err{("a")})
  await two

async fn quorumOfZero() -> Future<Result<Array<Int>, Array<String>>>:
  await futures.quorum(0, [Slot.create<Outcome>().read()])

@Suite{"futures › quorum"}
fn quorumSuite() -> Array<Test>: [
  ...runAndReRun(
    "gives the first n Ok values in the order they arrived",
    quorumReached,
    Ok{([3, 2])},
  ),
  ...runAndReRun(
    "fails once n can't be reached, with the errors in position order",
    quorumOutOfReach,
    Err{(["a", "c"])},
  ),
  ...runAndReRun("of zero is Ok and empty", quorumOfZero, Ok{([])}),
  test("panics when n is more than the futures", async fn(): {
    const message = await expectPanic(async fn(): await futures.quorum<Int, String>(1, []))
    assertEq(message, "A quorum of 1 can't be reached among 0 futures.")
  }),
  test("panics when n is negative", async fn(): {
    const message = await expectPanic(async fn(): await futures.quorum<Int, String>(-1, []))
    assertEq(message, "A quorum of -1 can't be reached among 0 futures.")
  }),
]

async fn timeoutInTime() -> Future<Int?>:
  const value = Slot.create<Int>()
  const limited = futures.timeout(value.read(), 5s)
  await later(value, 1)
  await limited

@Suite{"futures › timeout"}
fn timeoutSuite() -> Array<Test>: [
  ...runAndReRun("gives the value when it arrives in time", timeoutInTime, 1),
  test("gives none once the limit passes first", withClock, async fn(clock): {
    const limited = futures.timeout(Slot.create<Int>().read(), 5s)
    await runtime.commit()
    clock.advance(5s)
    assertEq(await limited, none)
  }),
  test("gives the value when it is there as the limit passes", withClock, async fn(clock): {
    const value = Slot.create<Int>()
    const limited = futures.timeout(value.read(), 5s)
    await runtime.commit()
    clock.advance(5s)
    drop value.put(1)
    assertEq(await limited, 1)
  }),
]

# Retries, its default three times, a second apart as named past the default it leaves out, an
# attempt that succeeds the third time: the outcome, and when each attempt started.
async fn succeedingThirdTime() -> Future<(Outcome, Array<Int>)>:
  let startedAt: Array<Int> = []
  const attempt = async fn() -> Future<Outcome>: {
    startedAt.push(time.now().value)
    if startedAt.length() < 3: Err{("failed")}
    else: Ok{(startedAt.length())}
  }
  (await futures.retry(attempt, backoff: 1s), startedAt)

# Moves `clock` through the backoffs of `retrying`, an instance running `succeedingThirdTime`.
async fn backingOff(clock: FakeClock, retrying: Instance<(Outcome, Array<Int>)>):
  await retrying.idle()
  clock.advance(1s)
  await retrying.idle()
  clock.advance(2s)
  assertEq(await retrying.result(), Ok{(Ok{(3)}, [0, 1000, 3000])})

# Retries, twice a second apart, a plain attempt that always fails.
async fn failingTwice() -> Future<Outcome>:
  let attempts = 0
  await futures.retry(fn() -> Outcome: { attempts += 1; Err{("attempt " + attempts)} }, 2, 1s)

async fn succeedingFirstTime() -> Future<Outcome>: await futures.retry(fn() -> Outcome: Ok{(1)})

@Suite{"futures › retry"}
fn retrySuite() -> Array<Test>: [
  test(
    "waits backoff before the first retry and twice as long before the next",
    withClock,
    async fn(clock): {
      await backingOff(clock, spawn succeedingThirdTime())
    },
  ),
  test(
    "waits backoff before the first retry and twice as long before the next, with every segment re-run",
    withClock,
    async fn(clock): {
      await backingOff(clock, spawnCrashingEveryAwait(succeedingThirdTime))
    },
  ),
  test("gives the last Err once every attempt failed", withClock, async fn(clock): {
    const retrying = spawn failingTwice()
    await retrying.idle()
    clock.advance(1s)
    assertEq(await retrying.result(), Ok{Err{("attempt 2")}})
  }),
  ...runAndReRun("gives the first Ok without waiting", succeedingFirstTime, Ok{(1)}),
  test("panics with no attempt to make", async fn(): {
    const message = await expectPanic(async fn(): await futures.retry(fn() -> Outcome: Ok{(1)}, 0))
    assertEq(message, "retry needs at least one attempt, not 0.")
  }),
]
