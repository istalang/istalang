# The futures module (spec §19.2): waiting on several futures at once, in live code as in ista.
#
# Each function is written once over the kind (proposal 8, Rule 6), `K fn …<…, K in Persistence>`,
# so futures of two kinds in one call are an inference error. `first` is an awaitable: once
# awaited, it registers a `Resolver.at` of its wait's resolver on each future, in position order,
# so it decides as a `select`'s cases do (§15.4): at the lowest position among those resolved already,
# at the first the event resolves among those resolving together (§15.2), and the others take nothing,
# a pending `take` no value. The others are async functions, so they watch their futures from the
# call on, and `timeout`'s limit counts from it.
# Those waiting for several arrivals await each future in a call of its own (`_arrivals`), started
# with theirs, and a `First` of those calls still out, turn after turn: a `First` lets go of its
# losers, which a slot then passes over (§15.4), so between two turns only the calls keep the futures
# waiting in their queues. Calls are readied as their futures arrive, so racing them keeps the
# arrival order and, among those arriving together, the event's order (§15.2).
#
# A failure is a `Result`, never a rejection, so `all`, `any` and `quorum` read `Ok` and `Err` to
# decide when to stop. None disposes a future it is given (§16): it lets go of them when it returns,
# so a loser the caller doesn't hold either is disposed then, while one held in a variable lives on.

import * as time from 'time'

# The first of `futures` at `positions` to arrive once it is awaited: its position and value.
# Awaited with no positions, it panics.
struct First<T, K in Persistence>:
  futures: Array<Future<T, K>>
  positions: Array<Int>
  type Mode = K

K fn first<T, K in Persistence>(futures: Array<Future<T, K>>) -> First<T, K>:
  First<T, K>{futures, positions: _everyPosition(futures)}

K fn onAwait<T, K in Persistence>(self: First<T, K>, done: Resolver<(Int, T), K>):
  if self.positions.length() == 0:
    panic("futures.first was given no futures.")
  for position in self.positions:
    self.futures[position].onAwait(Resolver.at(done, position))

# Every `Ok` value in position order, or the first `Err` as soon as it arrives.
K async fn all<T, E, K in Persistence>(
  futures: Array<Future<Result<T, E>, K>>
) -> Result<Array<T>, E>:
  const arrivals = _arrivals(futures)
  let values: Map<Int, T> = [:]
  let out = _everyPosition(futures)
  while out.length() > 0:
    const (position, result) = await First<Result<T, E>, K>{
      futures: arrivals
      positions: out
    }
    out = _without(out, position)
    match result:
      case Ok(value): values[position] = value
      case Err(error): return Err(error)
  Ok(_inOrder(values, futures.length()))

# Every value in position order, once all resolved.
K async fn allSettled<T, K in Persistence>(futures: Array<Future<T, K>>) -> Array<T>:
  let values: Array<T> = []
  for arrival in _arrivals(futures): values.push(await arrival)
  values

# The first value to arrive; panics on an empty list, as `first` does.
K async fn race<T, K in Persistence>(futures: Array<Future<T, K>>) -> T:
  (await first(futures)).1

# The first `Ok` to arrive, or every error in position order once all failed.
K async fn any<T, E, K in Persistence>(
  futures: Array<Future<Result<T, E>, K>>
) -> Result<T, Array<E>>:
  const arrivals = _arrivals(futures)
  let errors: Map<Int, E> = [:]
  let out = _everyPosition(futures)
  while out.length() > 0:
    const (position, result) = await First<Result<T, E>, K>{
      futures: arrivals
      positions: out
    }
    out = _without(out, position)
    match result:
      case Ok(value): return Ok(value)
      case Err(error): errors[position] = error
  Err(_inOrder(errors, futures.length()))

# The first `n` `Ok` values in the order they arrived, or the errors in position order once `n`
# can't be reached.
K async fn quorum<T, E, K in Persistence>(
  n: Int
  futures: Array<Future<Result<T, E>, K>>
) -> Result<Array<T>, Array<E>>:
  if n < 0 or n > futures.length():
    panic("A quorum of " + n + " can't be reached among " + futures.length() + " futures.")
  const arrivals = _arrivals(futures)
  let values: Array<T> = []
  let errors: Map<Int, E> = [:]
  let out = _everyPosition(futures)
  while values.length() < n:
    const (position, result) = await First<Result<T, E>, K>{
      futures: arrivals
      positions: out
    }
    out = _without(out, position)
    match result:
      case Ok(value): values.push(value)
      case Err(error):
        errors[position] = error
        if errors.size() > futures.length() - n:
          return Err(_inOrder(errors, futures.length()))
  Ok(values)

# The value of `future`, or `none` if `limit` passes first. When both are there, the value wins.
K async fn timeout<T, K in Persistence>(future: Future<T, K>, limit: time.Duration) -> T?:
  await select:
    case future as value: value
    case time.delay(limit): none

# Calls `attempt` until it gives an `Ok`, at most `times` times, waiting `backoff` before the first
# retry and twice as long before each next one: the first `Ok`, or the last `Err`.
K async fn retry<T, E, K in Persistence>(
  attempt: Fn<(), Future<Result<T, E>, K>, K>
  times: Int = 3
  backoff: time.Duration = 1s
) -> Result<T, E>:
  if times < 1:
    panic("retry needs at least one attempt, not " + times + ".")
  let wait = backoff
  for _ in 1..times:
    const result = await attempt()
    if result is Ok(...): return result
    await time.delay(wait)
    wait = wait * 2
  await attempt()

# Each of `futures` awaited from now on in a call of its own, in position order.
K fn _arrivals<T, K in Persistence>(futures: Array<Future<T, K>>) -> Array<Future<T, K>>: [
  for future in futures: _arrival(future)
]

K async fn _arrival<T, K in Persistence>(future: Future<T, K>) -> T:
  await future

# Every position of `items`, in order.
fn _everyPosition<T>(items: Array<T>) -> Array<Int>: [for position in 0..items.length(): position]

# `positions` without `position`.
fn _without(positions: Array<Int>, position: Int) -> Array<Int>: [
  for other in positions if other != position: other
]

# The values of `byPosition` in position order, among the positions below `count`.
fn _inOrder<T>(byPosition: Map<Int, T>, count: Int) -> Array<T>: [
  for position in 0..count if byPosition.has(position): byPosition[position]
]
