# The runtime module's `id`, `version` and `isolate` (spec §3.8, §9); `commit` is the corpus's.
# `isolate`'s failing case is a panic it gives back as an `Err`.

import * as runtime from 'runtime'
import assert, assertEq, Suite, Test, test from 'testing'

fn ownId() -> String: runtime.id()

fn ownVersion() -> String: runtime.version()

fn three() -> Int: 3

fn broken() -> Int: panic("broken")

@Suite{"runtime"}
fn suite() -> Array<Test>: [
  test("id is the instance's name, a spawned one's after its parent's", async fn(): {
    assertEq(runtime.id(), "test")
    assertEq(await (spawn ownId()).result(), Ok("test/1"))
  })
  test("version is the program's content hash, the same in every instance of it", async fn(): {
    assertEq(runtime.version().length(), 64)
    assertEq(await (spawn ownVersion()).result(), Ok(runtime.version()))
  })
  test("isolate gives a function's result, or its panic as an Err", async fn(): {
    assertEq(await runtime.isolate(fn(): three()), Ok(3))
    const failed = await runtime.isolate(fn(): broken())
    assert(failed is Err(error) and error.message == "broken" and error.code == "panic")
  })
]
