# The runtime module (spec §3.8): what an instance can ask of the runtime about itself, and
# `isolate`, which runs a function as an instance of its own.
#
# `commit` returns an already-resolved future, so `await runtime.commit()` commits without
# waiting (§5).

# The instance's name, as its host gave it or as its parent's spawn made it (§9).
extern fn id() -> String

# The content hash of the program the instance runs, fixed for its life (§5).
extern fn version() -> String

extern fn commit() -> Future<Unit>

# Runs `f` as an instance of its own and waits for its end (§9): `f`'s result, or its panic as an
# `Err`. The panic also terminates that instance at once, disposing what it holds, so no operator
# has to.
fn isolate<T is Sendable>(f: sendable async fn() -> T) -> Future<Result<T>>: _isolated(f).result()

# Spawns `f` as an instance a panic terminates at once.
extern fn _isolated<T>(f: sendable async fn() -> T) -> Instance<T>
