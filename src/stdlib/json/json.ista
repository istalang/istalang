# The json module (spec §3.8, §9): JSON held in values, and the traits of every type that crosses
# as JSON, with the codecs of the types the language itself has.
#
# A type crosses through its `toJson` and `fromJson` (§3.10): those this module declares for
# primitives, `Json` and the prelude's containers, those a module declares beside its own type, or,
# for a struct, an enum, a tuple or a host type that declares neither, the two the compiler derives
# (`_toJson`, `_fromJson`, docs/arch/boundary.md), since a derived form reads a type's fields and
# annotations. What reads or writes JSON text is natives.
#
# `Json` is a recursive union (§3.17), so JSON of any nesting is written as plain values, which go
# into it by the conversion every union has, and taken apart by type patterns (`case Int as n`).
# A JSON number is an `Int` where it is whole, else a `Float`; `null` is `none`, so `Json?` is
# `Json`, and only `has(k)` tells a missing key from a stored `null`.

type Json = None | Bool | Int | Float | String | Array<Json> | Map<String, Json>

# Each implies Sendable (§3.10): a value read from JSON is a copy, so it may go anywhere.
trait Encodable:
  fn toJson(self: Self) -> Json

trait Decodable:
  fn Self.fromJson(json: Json, path: String) -> Result<Self>

# Annotations on fields (§3.16): the name a field has in JSON, a field left out of it, and an int
# written as a string of its digits, for readers that would round a large number.
struct JsonName:
  name: String

struct JsonSkip

struct JsonBigInt

fn encode<T is Encodable>(value: T) -> Json: value.toJson()

fn decode<T is Decodable>(json: Json) -> Result<T>: T.fromJson(json, "$")

fn stringify<T is Encodable>(value: T) -> String: _write(value.toJson())

fn parse<T is Decodable>(text: String) -> Result<T>:
  match _read(text):
    case Ok(value): T.fromJson(value, "$")
    case Err(error): Err(_error(error))

# The codecs of a type that crosses as the text its toString writes, read back through its parse,
# such as `Time` and `Duration`: a type declares its own as one call to each.
fn encodeText<T is Stringable>(value: T) -> Json: value.toString()

fn decodeText<T is Parsable>(json: Json, path: String) -> Result<T>:
  match json:
    case String as value: _parsed(T.parse(value), path)
    case _: _mismatch(json, path, "a string")

# The two the compiler writes, per type, for a struct, an enum, a tuple or a host type. A host type
# a `dispose` makes disposable has them to cross to its own host, though it isn't Encodable or
# Decodable, which imply Sendable.
extern fn _toJson<T>(value: T) -> Json

extern fn _fromJson<T>(json: Json, path: String) -> Result<T>

# What crosses from the host (§9). A result, what its future gives, or an extern constant's value
# that doesn't fit is a bug in the host, so it panics the code reading it; JSON a host starts an
# instance with fails the host's call instead, and nothing that call ran commits.
fn _hostResult<T>(read: Result<T>) -> T:
  match read:
    case Ok(value): value
    case Err(error): panic("The host gave what doesn't fit: " + error.message)

fn _hostInput<T>(read: Result<T>) -> T:
  match read:
    case Ok(value): value
    case Err(error): _refuse(error.message)

extern fn _refuse(message: String) -> Never

# JSON text: written as JavaScript's JSON.stringify writes it, and read with integers kept exact.
extern fn _write(json: Json) -> String

extern fn _read(text: String) -> Result<Json, String>

# Writing. A float JSON can't hold, NaN or an infinity, is written as null, as JavaScript does; an
# object's keys are sorted when it is written, so equal values give the same JSON.
fn toJson(self: Int) -> Json: self

fn toJson(self: Float) -> Json: self

fn toJson(self: Bool) -> Json: self

fn toJson(self: String) -> Json: self

fn toJson(self: Unit) -> Json: none

# A `none` given for a `T?` leaves `T` unknown (§3.5), so `None` writes its own `null`.
fn toJson(self: None) -> Json: self

fn toJson(self: Json) -> Json: self

# A function giving `Never` gives no value, so its outcome is never written, yet it has a codec.
fn toJson(self: Never) -> Json: self

fn toJson<T is Encodable>(self: Array<T>) -> Json:
  const items: Array<Json> = [for each in self: each.toJson()]
  items

fn toJson<T is Encodable>(self: T?) -> Json:
  match self:
    case None: none
    case value: value.toJson()

fn toJson<K is Stringable, V is Encodable>(self: Map<K, V>) -> Json:
  let fields: Map<String, Json> = [:]
  for key, each in self:
    fields[key.toString()] = each.toJson()
  fields

fn _encodeBigInt(value: Int) -> Json: String(value)

extern fn _encodeHandle<T>(value: T) -> Json

# Reading. Each takes the path of the JSON it reads, which a failure names: `$.items[2].amount`.
fn Int.fromJson(json: Json, path: String) -> Result<Int>:
  match json:
    case Int as value: Ok(value)
    case _: _mismatch(json, path, "an integer")

fn Float.fromJson(json: Json, path: String) -> Result<Float>:
  match json:
    case Int as value: Ok(Float(value))
    case Float as value: Ok(value)
    case _: _mismatch(json, path, "a number")

fn Bool.fromJson(json: Json, path: String) -> Result<Bool>:
  match json:
    case Bool as value: Ok(value)
    case _: _mismatch(json, path, "a boolean")

fn String.fromJson(json: Json, path: String) -> Result<String>:
  match json:
    case String as value: Ok(value)
    case _: _mismatch(json, path, "a string")

fn Unit.fromJson(json: Json, path: String) -> Result<Unit>:
  match json:
    case None: Ok(())
    case _: _mismatch(json, path, "null")

fn Json.fromJson(json: Json, path: String) -> Result<Json>: Ok(json)

fn Array.fromJson<T is Decodable>(json: Json, path: String) -> Result<Array<T>>:
  match json:
    case Array<Json> as items:
      let decoded: Array<T> = []
      for each in items: decoded.push(T.fromJson(each, _elementPath(path, decoded.length()))?)
      Ok(decoded)
    case _: _mismatch(json, path, "an array")

fn Optional.fromJson<T is Decodable>(json: Json, path: String) -> Result<T?>:
  match json:
    case None: Ok(none)
    case _: Ok(T.fromJson(json, path)?)

fn Map.fromJson<K is Parsable, V is Decodable>(json: Json, path: String) -> Result<Map<K, V>>:
  match json:
    case Map<String, Json> as fields:
      let decoded: Map<K, V> = [:]
      for key, each in fields:
        const at = _fieldPath(path, key)
        decoded[_parsed(K.parse(key), at)?] = V.fromJson(each, at)?
      Ok(decoded)
    case _: _mismatch(json, path, "an object")

fn _decodeBigInt(json: Json, path: String) -> Result<Int>:
  match json:
    case Int as value: Ok(value)
    case String as value: _parsed(Int.parse(value), path)
    case _: _mismatch(json, path, "an integer")

extern fn _decodeHandle<T>(json: Json, path: String) -> Result<T>

# The parts derived codecs of structs, enums, tuples and literals are made of.
fn _fields(json: Json, path: String) -> Result<Map<String, Json>>:
  match json:
    case Map<String, Json> as fields: Ok(fields)
    case _: _mismatch(json, path, "an object")

# `Json?` is `Json`, so a missing field and a stored `null` look alike but to `has`.
fn _field(fields: Map<String, Json>, name: String, path: String) -> Result<Json>:
  if fields.has(name): Ok(fields.get(name))
  else: _failure(_fieldPath(path, name), "missing")

fn _optionalField(fields: Map<String, Json>, name: String) -> Json: fields.get(name)

fn _tag(fields: Map<String, Json>, key: String, path: String) -> Result<String>:
  String.fromJson(_field(fields, key, path)?, _fieldPath(path, key))

fn _unknownVariant<T>(tag: String, key: String, path: String) -> Result<T>:
  _failure(_fieldPath(path, key), "names no variant '" + tag + "'")

# A literal type's, or a union of literals', JSON holding none of its `literals`, spelled as types.
fn _notAmong<T>(json: Json, path: String, literals: String) -> Result<T>:
  _failure(path, "expected " + literals + ", found " + _write(json))

fn _elements(json: Json, path: String, count: Int) -> Result<Array<Json>>:
  match json:
    case Array<Json> as items:
      if items.length() == count: Ok(items)
      else: _failure(path, "expected " + count + " elements, found " + items.length())
    case _: _mismatch(json, path, "an array")

fn _element(items: Array<Json>, index: Int) -> Json: items[index]

fn _fieldPath(path: String, name: String) -> String: path + "." + name

fn _elementPath(path: String, index: Int) -> String: path + "[" + index + "]"

fn _parsed<T>(read: Result<T>, path: String) -> Result<T>:
  match read:
    case Ok(value): Ok(value)
    case Err(error): _failure(path, error.message)

fn _mismatch<T>(json: Json, path: String, expected: String) -> Result<T>:
  _failure(path, "expected " + expected + ", found " + _kind(json))

fn _failure<T>(path: String, message: String) -> Result<T>: Err(
  _error(path + ": " + message)
)

# The Error every read of JSON fails with.
fn _error(message: String) -> Error: Error{message: message, code: "json"}

fn _kind(json: Json) -> String:
  match json:
    case None: "null"
    case Bool: "a boolean"
    case Int: "an integer"
    case Float: "a number"
    case String: "a string"
    case Array<Json>: "an array"
    case Map<String, Json>: "an object"
