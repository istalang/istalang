# The testing module (spec §10): suites, mocks, waits on spawned instances and host handles, and
# the test library over them.
#
# Only test modules may import it (§10), so production code can never install a mock. The runtime
# provides mocks, the inspection of spawned instances and handles through externs; the rest is
# written here.
#
# `mock` and `calls` take a pack (§3.5), one declaration for plain functions and one for async
# ones. Setups map each of their types (each test's function takes the setups' environments), which
# a pack can't say, so `setups` stays one overload per arity, up to six, over one function.
#
# `ista test` lists and runs a suite's tests through `_list` and `_run`, the one place a suite's
# tests are flattened, so the listing and each test's own instance (§10) walk the same list.
#
# The fakes' fields are functions, since a mock's replacement is a function value and a method
# isn't one: `mock(time.now, clock.now)`. A field default sees the fields before it, so each fake
# is built as a literal, and its state is a shared struct its copies share.

import * as json from 'json'
import Encodable from 'json'
import Inbox, Revertible from 'inbox'
import * as time from 'time'
import Time, Duration from 'time'

# Marks a function returning a suite's tests: `@Suite{"purchase approval"}`.
struct Suite:
  title: string

# A test, or a group of tests, as the library builds them (§10), marked by `skip` and `only`,
# which a group's marks reach every test of.
enum Test:
  Case { title: string; body: async fn() -> unit; skipped: bool = false; only: bool = false }
  Group { title: string; tests: Array<Test>; skipped: bool = false; only: bool = false }

# A test as the runner lists it: its full title, and whether the run skips or focuses it.
struct Listed:
  title: string
  skipped: bool
  only: bool

# A listed test with its body.
struct _Entry:
  listed: Listed
  body: async fn() -> unit

# Every test of `suite`, depth first, titled under `title`, the suite's.
fn _list(suite: fn() -> Array<Test>, title: string) -> Array<Listed>: [
  for entry in _entries(title, suite(), false, false): entry.listed
]

# Runs test `position` of `suite`, once sure its listing still puts `expected` there (§10).
async fn _run(suite: fn() -> Array<Test>, title: string, position: int, expected: string):
  const entry = _entries(title, suite(), false, false).at(position)
  if entry is Some{value as found} and found.listed.title == expected: await found.body()
  else:
    panic(
      "The suite listed other tests when it was called again, so test '" +
        expected +
        "' can't be found.",
    )

# The tests of `tests`, depth first, titled under `title`, each with its own marks and `skipping`
# and `focusing`, its groups'.
fn _entries(title: string, tests: Array<Test>, skipping: bool, focusing: bool) -> Array<_Entry>:
  let entries: Array<_Entry> = []
  for each in tests:
    match each:
      case Case{title as own, body, skipped, only as focused}:
        const listed = Listed{
          title: title + " › " + own,
          skipped: skipped or skipping,
          only: focused or focusing,
        }
        entries.push(_Entry{listed, body})
      case Group{title as own, tests as inner, skipped, only as focused}:
        entries = [
          ...entries,
          ..._entries(title + " › " + own, inner, skipped or skipping, focused or focusing),
        ]
  entries

# A mock's handle (§10): while it is held, calls to its target run its replacement, and the
# arguments of each are recorded. The runtime disposes it.
extern struct Mock<F>
extern fn dispose<F>(self: Mock<F>)

extern fn _mock<F>(target: F, replacement: F) -> Mock<F>
extern fn _calls<F, A>(self: Mock<F>) -> Array<A>

fn mock<...A, R>(target: fn(...A) -> R, replacement: fn(...A) -> R) -> Mock<fn(...A) -> R>:
  _mock(target, replacement)
fn mock<...A, R>(target: async fn(...A) -> R, replacement: async fn(...A) -> R) -> Mock<async fn(
  ...A,
) -> R>:
  _mock(target, replacement)

# The arguments of every call so far, oldest first, a tuple per call: `(x,)` for a function of one
# parameter, and `()`, the unit, for one of none.
fn calls<...A, R>(self: Mock<fn(...A) -> R>) -> Array<A>: _calls(self)
fn calls<...A, R>(self: Mock<async fn(...A) -> R>) -> Array<A>: _calls(self)

# Where an instance stands, as its last commit says (§10).
enum InstanceState:
  Running
  Waiting
  Panicked
  Finished
  Terminated

# Spawns `f` as a new instance once the caller's segment commits (§9), with every segment run,
# discarded and run again before it commits (§10).
extern fn spawnCrashingEveryAwait<T>(f: sendable async fn() -> T) -> Instance<T>

# Resolves once every execution of the instance is waiting, or it has finished.
extern fn idle<R>(self: Instance<R>) -> Future<unit>
# Resolves once an execution of the instance is suspended at waypoint `label`.
extern fn reaches<R>(self: Instance<R>, label: string) -> Future<unit>
# The waypoint of every wait of the instance, or its source location where it has none.
extern fn waitingAt<R>(self: Instance<R>) -> Array<string>
extern fn state<R>(self: Instance<R>) -> InstanceState

# A value of extern type `T` equal to no other, for mocks that must return one (§10).
extern fn handle<T>() -> T

# A test of `body`, run in an instance of its own (§10).
fn test(title: string, body: async fn() -> unit) -> Test: Case{title, body}

# A test of `body`, run inside the environment `setup` prepares (§10).
fn test<E>(title: string, setup: Setup<E>, body: async fn(E) -> unit) -> Test:
  test(title, async fn(): await setup(body))

fn group(title: string, tests: Array<Test>) -> Test: Group{title, tests}

# `entry`, reported but not run, even if `only` marks it too (§10).
fn skip(entry: Test) -> Test: _marked(entry, true, false)

# `entry`, which runs while every test of the run `only` doesn't mark is skipped (§10).
fn only(entry: Test) -> Test: _marked(entry, false, true)

# `entry` with its own marks, and `skipping` and `focusing` added.
fn _marked(entry: Test, skipping: bool, focusing: bool) -> Test:
  match entry:
    case Case{title, body, skipped, only as focused}: Case{
      title,
      body,
      skipped: skipped or skipping,
      only: focused or focusing,
    }
    case Group{title, tests, skipped, only as focused}: Group{
      title,
      tests,
      skipped: skipped or skipping,
      only: focused or focusing,
    }

# An environment for tests (§10): prepares it, runs the test inside it, and tears it down after.
type Setup<E> = async fn(async fn(E) -> unit) -> unit

# Several environments as one (§10): the first outermost, the test receiving them as a tuple.
fn setups<A, B>(a: Setup<A>, b: Setup<B>) -> Setup<(A, B)>: _joined(a, b, fn(x: A, y: B): (x, y))
fn setups<A, B, C>(a: Setup<A>, b: Setup<B>, c: Setup<C>) -> Setup<(A, B, C)>:
  _joined(setups(a, b), c, fn(p: (A, B), z: C): (p.0, p.1, z))
fn setups<A, B, C, D>(a: Setup<A>, b: Setup<B>, c: Setup<C>, d: Setup<D>) -> Setup<(A, B, C, D)>:
  _joined(setups(a, b, c), d, fn(p: (A, B, C), z: D): (p.0, p.1, p.2, z))
fn setups<A, B, C, D, E>(a: Setup<A>, b: Setup<B>, c: Setup<C>, d: Setup<D>, e: Setup<E>) -> Setup<(
  A,
  B,
  C,
  D,
  E,
)>:
  _joined(setups(a, b, c, d), e, fn(p: (A, B, C, D), z: E): (p.0, p.1, p.2, p.3, z))
fn setups<A, B, C, D, E, G>(
  a: Setup<A>,
  b: Setup<B>,
  c: Setup<C>,
  d: Setup<D>,
  e: Setup<E>,
  g: Setup<G>,
) -> Setup<(A, B, C, D, E, G)>:
  _joined(setups(a, b, c, d, e), g, fn(p: (A, B, C, D, E), z: G): (p.0, p.1, p.2, p.3, p.4, z))

# `outer` around `inner`, the test receiving their environments as `join` makes one of them.
fn _joined<O, I, J>(outer: Setup<O>, inner: Setup<I>, join: fn(O, I) -> J) -> Setup<J>:
  async fn(body: async fn(J) -> unit): await outer(
    async fn(o: O): await inner(async fn(i: I): await body(join(o, i))),
  )

# Panics unless `condition` holds (§10).
fn assert(condition: bool): assert(condition, "The assertion failed.")
fn assert(condition: bool, message: string):
  if not condition: panic(message)

# Panics unless `actual` equals `expected`, showing both as JSON (§10).
fn assertEq<T is Encodable>(actual: T, expected: T):
  if actual != expected:
    panic("expected " + json.stringify(expected) + ", found " + json.stringify(actual))

# Spawns `f` as an instance of its own, since a panic freezes the instance it happens in (§5), and
# waits for its end: the message it panics with. Panics if `f` returns instead (§10).
async fn expectPanic<R is Sendable>(f: sendable async fn() -> R) -> Future<string>:
  await _panicOf(spawn f())

async fn _panicOf<R is Sendable>(instance: Instance<R>) -> Future<string>:
  match await instance.result():
    case Err{error}: error.message
    case _: panic("expectPanic expected a panic, but the function returned.")

# A clock standing still at `start` until `advance` moves it (§10): `now` and `at` replace
# `time.now` and `time.at`.
struct FakeClock:
  start: Time
  _state: _Clock = new _Clock{now: start}
  now: fn() -> Time = fn(): _state->now
  at: fn(Time) -> Future<unit> = fn(deadline: Time): _waitUntil(_state, deadline)

# A fake clock's time, and the waits it fills as it passes their deadlines: ordered by deadline,
# ties in the order they began, so it fills them in that order.
shared struct _Clock:
  now: Time
  waits: Array<_Wait> = []

struct _Wait:
  deadline: Time
  slot: Slot<unit>

fn _waitUntil(clock: _Clock, deadline: Time) -> Future<unit>:
  const slot = Slot.create<unit>()
  const (due, later) = _splitDue(clock->waits, deadline)
  clock->waits = [...due, _Wait{deadline, slot}, ...later]
  _fillDue(clock)
  slot.take()

# Moves the clock forward by `by`, filling every wait whose deadline it passes (§10).
fn advance(self: FakeClock, by: Duration):
  if by < Duration{value: 0}: panic("A fake clock only moves forward, not by " + by + ".")
  const clock = self._state
  clock->now = clock->now + by
  _fillDue(clock)

# A setup installing a `FakeClock` starting at 0 as `time.now` and `time.at` (§10).
async fn withClock(body: async fn(FakeClock) -> unit):
  const clock = FakeClock{start: Time{value: 0}}
  hold _ = mock(time.now, clock.now)
  hold _ = mock(time.at, clock.at)
  await body(clock)

# Fills every wait whose deadline the clock has reached, in order, and lets go of them.
fn _fillDue(clock: _Clock):
  const (due, later) = _splitDue(clock->waits, clock->now)
  clock->waits = later
  for each in due: drop each.slot.put(())

# `waits` split at `time`: those due by then, and the later ones, each in their order.
fn _splitDue(waits: Array<_Wait>, time: Time) -> (Array<_Wait>, Array<_Wait>):
  const due = [for each in waits if each.deadline <= time: each]
  const later = [for each in waits if each.deadline > time: each]
  (due, later)

# A host's queues of type `Q` carrying `T`, one per key, each faked with an inbox (§10). Its fields
# replace the program's externs: `open` a queue factory, `send` and `receive` a queue's own.
struct FakeQueue<Q, T, K = string>:
  make: fn() -> Q
  _queues: _Queues<Q, T, K> = new _Queues<Q, T, K>{}
  open: fn(K) -> Q = fn(key: K): _opened(_queues, make, key).queue
  send: fn(Q, T) -> unit = fn(queue: Q, message: T): _inboxOf(_queues, queue).send(message)
  receive: fn(Q) -> Future<T> = fn(queue: Q): _inboxOf(_queues, queue).receive()

shared struct _Queues<Q, T, K>:
  opened: Array<_Queue<Q, T, K>> = []

struct _Queue<Q, T, K>:
  key: K
  queue: Q
  inbox: Inbox<T>

# The messages waiting in the queue of `key`, oldest first.
fn pending<Q, T, K>(self: FakeQueue<Q, T, K>, key: K) -> Array<T>:
  _opened(self._queues, self.make, key).inbox.pending()

# Sends `message` into the queue of `key`.
fn post<Q, T, K>(self: FakeQueue<Q, T, K>, key: K, message: T):
  _opened(self._queues, self.make, key).inbox.send(message)

# Sends `message` into `queue` revertibly, for a program's own revertible send to answer with.
fn sendRevertible<Q, T, K>(self: FakeQueue<Q, T, K>, queue: Q, message: T) -> Revertible<T>:
  _inboxOf(self._queues, queue).sendRevertible(message)

# The queue of `key`, made the first time.
fn _opened<Q, T, K>(queues: _Queues<Q, T, K>, make: fn() -> Q, key: K) -> _Queue<Q, T, K>:
  for each in queues->opened:
    if each.key == key: return each
  const made = _Queue{key, queue: make(), inbox: Inbox.create<T>()}
  queues->opened.push(made)
  made

fn _inboxOf<Q, T, K>(queues: _Queues<Q, T, K>, queue: Q) -> Inbox<T>:
  for each in queues->opened:
    if each.queue == queue: return each.inbox
  panic("This FakeQueue didn't open the queue it was given.")

# The receipts of a host's revertible sends, of extern type `R` (§3.6, §10): `revertibleSender(queues)`
# replaces a revertible send into `queues`, and `dispose` replaces `R`'s `dispose`, retracting the
# message the receipt stood for.
struct FakeReceipts<R>:
  make: fn() -> R
  _entries: _Receipts<R> = new _Receipts<R>{}
  dispose: fn(R) -> unit = fn(receipt: R): _disposeReceipt(_entries, receipt)

shared struct _Receipts<R>:
  held: Array<_Receipt<R>> = []

struct _Receipt<R>:
  receipt: R
  retract: fn() -> unit

# A replacement for a host's revertible send into `queues`, returning a receipt `self.make` builds.
fn revertibleSender<R, Q, T, K>(self: FakeReceipts<R>, queues: FakeQueue<Q, T, K>) -> fn(Q, T) -> R:
  fn sendInto(queue: Q, message: T) -> R:
    const receipt = (self.make)()
    const held = new Shared<Revertible<T>?>{value: queues.sendRevertible(queue, message)}
    fn retract(): held->value = none
    self._entries->held.push(_Receipt{receipt, retract})
    receipt
  sendInto

fn _disposeReceipt<R>(entries: _Receipts<R>, receipt: R):
  let remaining: Array<_Receipt<R>> = []
  for each in entries->held:
    if each.receipt == receipt: (each.retract)()
    else: remaining.push(each)
  entries->held = remaining
