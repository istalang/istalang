# The crypto module (spec §3.8): hashes, HMACs, constant-time comparison and text encodings.
#
# There is no bytes type, so text goes in as its UTF-8, keys included, and every digest comes out as
# text in the encoding asked for; `decode` gives text too, so it fails on bytes that aren't UTF-8.

enum Hash:
  Sha1 # for interop with older systems only
  Sha256
  Sha384
  Sha512

enum Encoding:
  Hex
  Base64
  Base64Url # unpadded, as JWT writes it

extern fn hash(algorithm: Hash, data: String, encoding: Encoding = Encoding.Hex) -> String

extern fn hmac(
  algorithm: Hash
  key: String
  data: String
  encoding: Encoding = Encoding.Hex
) -> String

# Takes the same time whatever two strings of one length hold; strings of different lengths are
# unequal at once.
extern fn timingSafeEqual(a: String, b: String) -> Bool

extern fn encode(text: String, encoding: Encoding) -> String

# Fails on text that isn't the encoding's canonical form (hex in either case), or whose bytes
# aren't UTF-8.
fn decode(text: String, encoding: Encoding) -> Result<String>:
  const decoded, problem = _decoded(text, encoding)
  if problem == "": Ok(decoded) else: Err(Error{message: problem, code: "decode"})

# The text `text` decodes to, and what is wrong with it, `""` where nothing is.
extern fn _decoded(text: String, encoding: Encoding) -> (String, String)
