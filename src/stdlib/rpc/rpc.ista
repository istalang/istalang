# The rpc module (spec §19.2): calls and replies between the executions of one instance.
#
# A method's calls queue in an inbox, so its servers share them by the inbox's rules (§15.3): each
# call goes to one server, the one that has waited longest. A call is sent revertibly, and its
# caller's wait holds the holder, so a call its caller lets go of before a server takes it is
# withdrawn, as a `select`'s losing send is (§15.4). The wait holds nothing else, so waiting callers
# don't keep the method alive.
#
# Each call carries its reply's one-shot slot inside a `_Reply`, whose `dispose` answers
# `unanswered` when the call is let go without a reply: the server handling it was disposed, or the
# method died with the call still queued. Replying lets go of the slot, so a reply is given once,
# and that `dispose` then does nothing.

import Inbox, Revertible from 'inbox'

shared struct Method<P, R>:
  _calls: Inbox<_Call<P, R>> = Inbox.create<_Call<P, R>>()

struct _Call<P, R> { message: P, reply: _Reply<R> }

shared struct _Reply<R> { slot: Slot<Result<R>>? }

ista fn create<P, R>() -> Method<P, R>: new Method<P, R>{}

# Sends `message` to the method's servers: the reply, or an `Err` when the call is let go without one.
ista fn call<P, R>(self: Method<P, R>, message: P) -> Future<Result<R>, "ista">:
  const slot = Slot.create<Result<R>>()
  _replyTo(
    self->_calls.sendRevertible(
      _Call{message, reply: new _Reply<R>{slot}}
    )
    slot
  )

# Serves the method's calls one at a time, in the order they arrived, until it is disposed.
ista async fn onMessage<P, R>(self: Method<P, R>, handler: ista async fn(P) -> R) -> Unit:
  while true:
    const call = await self->_calls.receive()
    const reply = await handler(call.message)
    if call.reply->slot is Slot as slot:
      drop slot.put(Ok(reply))
      call.reply->slot = none

ista fn dispose<R>(self: _Reply<R>):
  if self->slot is Slot as slot:
    drop slot.put(
      Err(
        Error{
          message: "The call was let go without a reply."
          code: "unanswered"
        }
      )
    )

# The reply arriving in `slot`, waited for while holding `sent`, the call's revertible send.
ista async fn _replyTo<P, R>(sent: Revertible<_Call<P, R>>, slot: Slot<Result<R>>) -> Result<R>:
  await slot.take()
