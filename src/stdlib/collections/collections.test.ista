# The collections module's WeakMap (spec §3.8, §7).

import Suite, Test, test, assert, assertEq, spawnCrashingEveryAwait from 'testing'
import WeakMap from 'collections'
import Inbox from 'inbox'
import * as runtime from 'runtime'

type Boxes = WeakMap<Inbox<Int>, Inbox<Int>>

# Weak references to an entry's key and value, which tell when each is let go of.
struct Watched:
  key: WeakRef<Inbox<Int>>
  value: WeakRef<Inbox<Int>>

# Sets an entry of `map` for the key `holder` holds, to a value only the map holds.
fn entryOf(map: Boxes, holder: Shared<Inbox<Int>?>) -> Watched:
  if holder->value is Inbox as key:
    const value = Inbox.create<Int>()
    map.set(key, value)
    return Watched{key: WeakRef(key), value: WeakRef(value)}
  panic("The holder holds no key.")

ista async fn evictedAcrossSnapshots() -> String:
  const map: Boxes = WeakMap.create()
  const holder = new Shared<Inbox<Int>?>{value: Inbox.create<Int>()}
  const watched = entryOf(map, holder)
  await runtime.commit()
  assert(watched.value.deref() is Inbox)
  holder->value = none
  await watched.value.disposed()
  "evicted"

@Suite{"collections › WeakMap"}
fn weakMap() -> Array<Test>: [
  test("gives what was set for a key, and none for another", fn(): {
    const map = WeakMap.create<Inbox<Int>, String>()
    const key = Inbox.create<Int>()
    const other = Inbox.create<Int>()
    map.set(key, "a")
    assertEq(map.get(key), "a")
    assert(map.has(key) and key in map)
    assertEq(map.get(other), none)
    assert(not map.has(other) and other not in map)
  })
  test("setting a key again replaces its value", fn(): {
    const map = WeakMap.create<Inbox<Int>, String>()
    const key = Inbox.create<Int>()
    map.set(key, "a")
    map.set(key, "b")
    assertEq(map.get(key), "b")
  })
  test("delete says whether the map held the key", fn(): {
    const map = WeakMap.create<Inbox<Int>, String>()
    const key = Inbox.create<Int>()
    map.set(key, "a")
    assert(map.delete(key))
    assert(not map.has(key))
    assert(not map.delete(key))
  })
  test("keeps an entry while its key lives", async fn(): {
    const map: Boxes = WeakMap.create()
    const holder = new Shared<Inbox<Int>?>{value: Inbox.create<Int>()}
    const watched = entryOf(map, holder)
    await runtime.commit()
    assert(watched.value.deref() is Inbox)
  })
  test("holds no key", fn(): {
    const map: Boxes = WeakMap.create()
    const holder = new Shared<Inbox<Int>?>{value: Inbox.create<Int>()}
    const watched = entryOf(map, holder)
    holder->value = none
    assert(watched.key.deref() is None)
  })
  test("lets go of an entry and its value once its key is disposed", async fn(): {
    const map: Boxes = WeakMap.create()
    const holder = new Shared<Inbox<Int>?>{value: Inbox.create<Int>()}
    const watched = entryOf(map, holder)
    holder->value = none
    await watched.value.disposed()
    assert(watched.value.deref() is None)
  })
  test("deleting an entry lets go of its value", async fn(): {
    const map: Boxes = WeakMap.create()
    const holder = new Shared<Inbox<Int>?>{value: Inbox.create<Int>()}
    const watched = entryOf(map, holder)
    if holder->value is Inbox as key: assert(map.delete(key))
    await watched.value.disposed()
  })
  test("lets go of an entry whose key is disposed after a snapshot", async fn(): {
    assertEq(await spawnCrashingEveryAwait(evictedAcrossSnapshots).result(), Ok("evicted"))
  })
]
