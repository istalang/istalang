# The prelude: what every module sees without importing it (spec §3.8, §3.10, §3.12, §3.13).
#
# Built-in types the runtime implements are extern declarations, the same mechanism programs use
# (§3.6). Primitive types (Int, Float, Bool, String, Unit, Never) are part of the language, not
# declared here. Functions and methods each type offers arrive with the features that use them.
#
# `Holds` and `Keeps` say what the runtime's handles hold and its natives keep, which no code shows
# (§3.16): a handle holds its type arguments, and a native keeps nothing but through `&`, unless
# they say otherwise.

import resultOfEnding from 'endings'
import Holds, Keeps from 'lifetimes'

# An array's items and a map's values are covariant (§3.5): an `Array<Int>` is an `Array<Int?>`,
# rebuilt where its layout changes. A map's keys are invariant: widening them would rehash each.
extern struct Array<gives T>
extern struct Map<K, gives V>
# A weak reference holds nothing of its referent, which `deref` gives back.
@Holds<()>
extern shared struct WeakRef<T is Disposable>

# Data is simple, live or ista, and code is marked with the data it may handle (proposal 8): unmarked
# code handles simple data, `live` code waits in memory and never commits, `ista` code commits at
# every wait. `Persistence` is the two kinds, and a future is of the kind of the code waiting on it,
# its `Mode`.
type Mark = "simple" | "live" | "ista"
type Persistence = "live" | "ista"
# A future (§3.3) is what an async call, a timer or a host gives: the run's object, which settles
# once and then calls, in the settle order, what waits on it (ir-first design, decision 6). It holds
# its value and what waits on it, as a callback's chain is held from its futures up (spec §7); a
# call's future also holds its call, which belongs to the language.
@Holds<(T, Fn<(T,), Unit, K>, Fn<(), Int, K>, Fn<(), Unit, K>)>
extern shared struct Future<T, K in Persistence>:
  type Mode = K

# What `await x` and a `select`'s case wait on (proposal 8, Rule 5): the waiting code makes `done`,
# a resolver for that one wait, and calls `x.onAwait(done)`, which can't itself wait; the waiting
# code resumes with what `done` is resolved with, waiting in `Mode`, its code's kind. A type meets it
# with a `Mode` of its own, so its work starts only once it is awaited.
trait Awaitable<T>:
  type Mode in Persistence
  Self.Mode fn onAwait(self: Self, done: Resolver<T, Self.Mode>)

# A future resolves `done` at once when it has settled, else as it settles: whichever of the futures
# `done` is registered on resolves it first decides it, and the others do nothing (§6). What `done`
# comes down to deciding holds the future (`_registered`).
@Keeps{["self": ["done"]]}
K fn onAwait<T, K in Persistence>(self: Future<T, K>, done: Resolver<T, K>):
  const resolution = done->resolution
  # Never called: what holds it holds the future.
  K fn holding(): _ = self
  if _registered(_decidedBy(resolution)) is _Call as waiting: _awaiting(waiting, holding)
  if _settled(self): drop _decides(done, _valueOf(self))
  else:
    K fn arrived(value: T): drop _decides(done, value)
    _onSettled(self, arrived, resolution->rank, _standingOf(resolution), _cancellerOf(resolution))

# One wait's one-shot resolver (Rule 5). A second `resolve` panics, and `tryResolve` says whether it
# decided the wait, for races; once another case decided it, neither decides anything, and it is
# cancelled as its waiter goes on with that case, even resolved to no effect. It is what it decides
# with a value, `decide`, and the rest of it, which takes no value (`_Resolution`), so only what
# passes the value on is compiled per type of value.
shared struct Resolver<T, K in Persistence>:
  decide: Fn<(T,), Bool, K>
  resolution: _Resolution<K>

# A resolver's state. One let go of unresolved is cancelled, unless it is a case's never registered
# on anything while its wait hasn't begun or still waits, which panics: an awaitable dropped it
# (`_released`). It holds its `onCancel` callbacks and what it calls, never the futures it is
# registered on. Its rank is where it decides among what settles together (spec §8): a case's by its
# waiter and position, an at-resolver's by the resolver it decides and its position, a callback's
# after every case, by when it was made.
shared struct _Resolution<K in Persistence>:
  rank: Array<Int>
  decides: _Decides<K>
  state: _ResolverState = Pending
  cancels: Array<Fn<(), Unit, K>> = []
  # A case's or a callback's: whether it, or a `Resolver.at` one deciding it, is registered.
  registered: Bool = false

# Where a resolver stands: pending; resolved; cancelled; withdrawn, cancelled by a `select` that
# didn't wait (§8); or resolved to no effect, still to be cancelled.
enum _ResolverState:
  Pending
  Resolved
  Cancelled
  Withdrawn
  Unheeded

# Whether a resolver in `state` was resolved, to effect or not.
fn _wasResolved(state: _ResolverState) -> Bool: state is Resolved or state is Unheeded

# Whether a resolver in `state` may still be cancelled: pending, or resolved to no effect.
fn _cancellable(state: _ResolverState) -> Bool: state is Pending or state is Unheeded

# What a resolver comes down to deciding (§7): a wait's case, the wait reached weakly, since its call
# holds what its cases' chains are registered on, and that call's handle; the resolver a
# `Resolver.at` one decides; or a callback.
enum _Decides<K in Persistence>:
  Case(wait: WeakRef<_Wait<K>>, call: _Call)
  At(done: _Resolution<K>)
  Callback

# What a resolver stands for to a future it is registered on: it may still decide; it lost, decided
# otherwise or let go of; or it was withdrawn by a `select` that didn't wait, which gives up on
# nothing (§8).
enum _Standing:
  MayDecide
  Lost
  Withdrawn

# Where `resolution` stands (`_Standing`). An at-resolver stands for what the resolver it decides
# does while pending.
K fn _standing<K in Persistence>(resolution: _Resolution<K>) -> _Standing:
  if resolution->state is Withdrawn: return Withdrawn
  if not (resolution->state is Pending): return Lost
  match resolution->decides:
    case Case(_, _):
      if _caseWait(resolution)?->decided is Undecided: MayDecide
      else: Lost
    case At(done): _standing(done)
    case Callback: MayDecide

# What a future `resolution` is registered on asks of where it stands, as the run reads it: 0 while
# it may still decide, 1 once it lost, 2 once withdrawn (run/run-primitives.ts `standingCodes`).
K fn _standingOf<K in Persistence>(resolution: _Resolution<K>) -> Fn<(), Int, K>:
  K fn standing() -> Int:
    match _standing(resolution):
      case MayDecide: 0
      case Lost: 1
      case Withdrawn: 2
  standing

# The wait `resolution`, a case's, decides, while its waiter holds it; none for any other.
K fn _caseWait<K in Persistence>(resolution: _Resolution<K>) -> _Wait<K>?:
  match resolution->decides:
    case Case(weak, _): _waitOf(weak)
    case _: none

# What a future `resolution` is registered on runs if it is disposed first: it cancels `resolution`.
K fn _cancellerOf<K in Persistence>(resolution: _Resolution<K>) -> Fn<(), Unit, K>:
  K fn cancelled(): _cancel(resolution)
  cancelled

# Notes that `deciding`, what a resolver comes down to deciding (`_decidedBy`), is registered on
# something, itself or through `Resolver.at` ones; the call of its wait, for a case's, which holds
# what it is registered on while the wait lasts (§7, `_awaiting`).
K fn _registered<K in Persistence>(deciding: _Resolution<K>) -> _Call?:
  deciding->registered = true
  match deciding->decides:
    case Case(_, call): call
    case _: none

# What `resolution` comes down to deciding: itself, or what the resolver a `Resolver.at` one decides
# comes down to.
K fn _decidedBy<K in Persistence>(resolution: _Resolution<K>) -> _Resolution<K>:
  match resolution->decides:
    case At(done): _decidedBy(done)
    case _: resolution

@Keeps{[:]}
K fn resolve<T, K in Persistence>(self: Resolver<T, K>, value: T):
  if _wasResolved(self->resolution->state): panic("A resolver was resolved twice.")
  drop _decides(self, value)

@Keeps{[:]}
K fn tryResolve<T, K in Persistence>(self: Resolver<T, K>, value: T) -> Bool: _decides(self, value)

# Resolves `resolver`, if pending, with `value`; whether that decided what it decides. A case's
# resolved as its call is disposed decides even cancelled, while the call hasn't gone on: the case on
# its own `disposing()` wins (§7).
K fn _decides<T, K in Persistence>(resolver: Resolver<T, K>, value: T) -> Bool:
  const resolution = resolver->resolution
  if not (resolution->state is Pending) and not _overrides(resolution): return false
  resolution->state = Resolved
  const decide = resolver->decide
  if decide(value): return true
  resolution->state = Unheeded
  false

# Whether `resolution` is a case's whose wait was decided while its call is being disposed.
K fn _overrides<K in Persistence>(resolution: _Resolution<K>) -> Bool:
  if _caseWait(resolution) is _Wait as wait: _disposingOverrides(wait)
  else: false

# A resolver deciding no wait, calling `callback` with its value instead: code hands one to an
# awaitable's `onAwait` to wait on it without `await`. The callback runs as a call of its own once
# the value arrives, so in ista code in a segment of its own, and whatever it decides is decided only
# then: a `select` case resolving through one decides later than the value arrived, and a value it
# took, such as a slot's, is lost when another case wins first.
K fn Resolver.of<T, K in Persistence>(callback: Fn<(T,), Unit, K>) -> Resolver<T, K>:
  K fn later(value: T) -> Bool:
    K fn called(): callback(value)
    _later(called)
    true
  new Resolver<T, K>{
    decide: later
    resolution: new _Resolution<K>{rank: [1, _made()], decides: Callback}
  }

# A resolver deciding `done` with `(position, value)` as it is resolved, in the same step: pending
# while `done` is, so an awaitable racing several through one each, as `futures.first` does,
# decides as a `select` case does and takes nothing once `done` is decided.
K fn Resolver.at<T, K in Persistence>(done: Resolver<(Int, T), K>, position: Int) -> Resolver<T, K>:
  K fn decided(value: T) -> Bool: done.tryResolve((position, value))
  const deciding = done->resolution
  new Resolver<T, K>{
    decide: decided
    resolution: new _Resolution<K>{rank: [...deciding->rank, position], decides: At(deciding)}
  }

# Has `callback` called once `self` is cancelled: another case decided its wait, its waiter moved on
# without it, or a future it is registered on was disposed. It runs as a `Resolver.of` callback
# does, and at once when `self` was cancelled already; never once `self` resolved.
K fn onCancel<T, K in Persistence>(self: Resolver<T, K>, callback: Fn<(), Unit, K>):
  const resolution = self->resolution
  if resolution->state is Cancelled or resolution->state is Withdrawn: _later(callback)
  if _cancellable(resolution->state): resolution->cancels.push(callback)

K fn dispose<T, K in Persistence>(self: Resolver<T, K>): _released(self->resolution)

# A resolver's state is disposable only so its wait reaches it weakly (`_caseResolution`): letting
# go of its resolver did what letting go of it does, as only what holds its resolver holds it.
K fn dispose<K in Persistence>(self: _Resolution<K>): ()

# A resolver let go of (`dispose`): cancelled, or, a case's never registered while its wait hasn't
# begun or still waits, a panic: nothing can decide the wait through it any more (§6).
K fn _released<K in Persistence>(resolution: _Resolution<K>):
  if resolution->state is Pending and not resolution->registered and _awaited(resolution):
    panic(
      "A resolver was let go of unresolved, so the wait it was to decide never can. An awaitable keeps the work it starts alive by registering its resolver, or a Resolver.at of it, on that work; to map a value, await it in an async fn."
    )
  _cancel(resolution)

# Whether `resolution` is a case's whose wait hasn't begun, its cases still being given their
# resolvers, or still waits.
K fn _awaited<K in Persistence>(resolution: _Resolution<K>) -> Bool:
  if _caseWait(resolution) is _Wait as wait: not wait->known or wait->decided is Undecided
  else: false

# Cancels `resolution`, still pending or resolved to no effect, running its `onCancel` callbacks;
# `withdrawn` by a `select` that didn't wait. It keeps nothing of the resolution, which a resolver
# let go of passes it.
@Keeps{[:]}
K fn _cancel<K in Persistence>(resolution: _Resolution<K>, withdrawn: Bool = false):
  if _cancellable(resolution->state):
    resolution->state = if withdrawn: Withdrawn else: Cancelled
    const callbacks = resolution->cancels
    resolution->cancels = []
    for callback in callbacks: _later(callback)

# One `await`'s or `select`'s wait (Rule 5): the call parked on it, how it was decided, whether its
# call stopped at it, every case known, and what cancels each case's resolver, which it reaches
# weakly, so a resolver an awaitable dropped is still let go of. Its call holds the futures its
# cases' chains are registered on while it lasts (`_awaiting`).
shared struct _Wait<K in Persistence>:
  call: _Call
  decided: _Decision = Undecided
  known: Bool = false
  # each takes whether its resolver is withdrawn
  cancels: Array<Fn<(Bool,), Unit, K>> = []

# How a wait was decided: not yet; for the case at `position`; or given up, by a `select` that
# didn't wait, no case having decided it (§8).
enum _Decision:
  Undecided
  For(position: Int)
  GivenUp

K fn _wait<K in Persistence>(call: _Call) -> _Wait<K>: new _Wait<K>{call}

# A wait let go of, its waiter gone on or disposed, cancels the cases it wasn't decided for, and
# what it held of what they wait on is let go of.
K fn dispose<K in Persistence>(self: _Wait<K>):
  _cancelledBut(self->cancels, self->decided)
  _waitEnded(self->call)

# The wait `weak` reaches, while its waiter holds it.
K fn _waitOf<K in Persistence>(weak: WeakRef<_Wait<K>>) -> _Wait<K>?: weak.deref()

# The resolver of `wait`'s case at `position`: resolved first among its wait's, it puts its value
# into `into` and readies the waiting call to go on with its position, the other cases cancelled once
# every case is known (`_losersCancelled`). One resolved as its call is disposed decides the wait
# even if another did first, cancelled or not, while the call hasn't gone on (`_overrides`).
K fn _caseResolver<T, K in Persistence>(
  wait: _Wait<K>
  position: Int
  into: Shared<Array<T>>
) -> Resolver<T, K>:
  const weak = WeakRef(wait)
  K fn decide(value: T) -> Bool:
    if _waitOf(weak) is _Wait as waiting:
      if _decidable(waiting):
        into->value = [value]
        _decide(waiting, position)
        return true
    false
  new Resolver<T, K>{decide, resolution: _caseResolution(wait, position)}

# Where a case's resolver puts its value (`_caseResolver`), empty until then: an array, never an
# optional, so a case's code is one instance for every type of value of one lifetime (§3.5).
fn _caseInto<T>() -> Shared<Array<T>>: new Shared<Array<T>>{value: []}

# The value a case's resolver put into `into`, taken out: a resolver outliving its wait still
# reaches `into`, and must not keep the value its waiter moved on with (§7).
fn _caseTaken<T>(into: Shared<Array<T>>) -> T:
  const taken = into->value
  into->value = []
  taken[0]

# Whether a case of `wait` may decide it now: it is pending, or decided and its call being disposed.
K fn _decidable<K in Persistence>(wait: _Wait<K>) -> Bool:
  wait->decided is Undecided or _disposingOverrides(wait)

# Whether `wait` was decided while its call is being disposed, which its case on its own
# `disposing()` decides again (§7).
K fn _disposingOverrides<K in Persistence>(wait: _Wait<K>) -> Bool:
  wait->decided is For(_) and _disposingWins(wait->call)

# Decides `wait` for `position`: readies its call to go on with it, the other cases cancelled once
# every case is known.
K fn _decide<K in Persistence>(wait: _Wait<K>, position: Int):
  wait->decided = For(position)
  _unpark(wait->call, position)
  if wait->known: _losersCancelled(wait)

# The state of the resolver of `wait`'s case at `position` (`_caseResolver`), which `wait` cancels
# through a weak reference once another case decides it.
K fn _caseResolution<K in Persistence>(wait: _Wait<K>, position: Int) -> _Resolution<K>:
  const resolution = new _Resolution<K>{
    rank: [0, _idOf(wait->call), position]
    decides: Case(WeakRef(wait), wait->call)
  }
  const weak = WeakRef(resolution)
  K fn cancel(withdrawn: Bool):
    if weak.deref() is _Resolution as pending: _cancel(pending, withdrawn)
  wait->cancels.push(cancel)
  resolution

# Notes that `wait`'s call stops at it, every case known: decided already, the others are cancelled.
K fn _parking<K in Persistence>(wait: _Wait<K>):
  wait->known = true
  if wait->decided is For(_): _losersCancelled(wait)

# Cancels the resolvers of the cases `wait` wasn't decided for: a `select`'s losers (§8), each
# `onCancel` running right after the waiter.
K fn _losersCancelled<K in Persistence>(wait: _Wait<K>):
  const cancels = wait->cancels
  wait->cancels = []
  _cancelledBut(cancels, wait->decided)

# Runs each of a wait's `cancels` but the one of the case it was `decided` for.
K fn _cancelledBut<K in Persistence>(cancels: Array<Fn<(Bool,), Unit, K>>, decided: _Decision):
  const kept: Int? = if decided is For(position): position else: none
  for index in 0..cancels.length():
    if index != kept:
      const cancel = cancels[index]
      cancel(false)

# The position `wait` was decided for already, as a `select` with an `else` asks (§8), its call going
# on without parking; -1, as lowering reads it, where no case decided it, every case then withdrawn.
K fn _decided<K in Persistence>(wait: _Wait<K>) -> Int:
  if wait->decided is For(position):
    _stayRunning(wait->call)
    _losersCancelled(wait)
    return position
  wait->decided = GivenUp
  const cancels = wait->cancels
  wait->cancels = []
  for cancel in cancels: cancel(true)
  -1

# The run's primitives the futures above stand on (ir-first design, decision 6).
@_Parametric
extern K fn _settled<T, K in Persistence>(future: Future<T, K>) -> Bool
@_Parametric
extern K fn _valueOf<T, K in Persistence>(future: Future<T, K>) -> T
# `callback` waits on `future` at `rank` while its resolver may still decide, as `standing` says
# (`_standing`): one that can't is dropped, and a future such ones waited on, one of them having
# lost, and nothing waits on now is given up on. `cancelled` runs if `future` is disposed first.
@Keeps{["future": ["callback", "standing", "cancelled"]]}
@_Parametric
extern K fn _onSettled<T, K in Persistence>(
  future: Future<T, K>
  callback: Fn<(T,), Unit, K>
  rank: Array<Int>
  standing: Fn<(), Int, K>
  cancelled: Fn<(), Unit, K>
)
@_Parametric
extern K fn _givenUp<T, K in Persistence>(future: Future<T, K>) -> Bool
# `callback` runs each time something comes to wait on `future`.
@Keeps{["future": ["callback"]]}
@_Parametric
extern K fn _onAwaited<T, K in Persistence>(future: Future<T, K>, callback: Fn<(), Unit, K>)
@_Parametric
extern K fn _pendingFuture<T, K in Persistence>() -> Future<T, K>
# A future of `U` following `future`, a `T`'s, as a function widened gives it (§3.14): it settles as
# `future` does, together with it, with what `convert` makes of its value, and leaves `future` as it
# is for whatever else reaches it. It holds `future` until that settles, as an unwidened caller holds
# its call's future, and `convert`, a conversion's entry capturing nothing.
@Keeps{[:]}
@_Parametric
extern K fn _converted<T, U, K in Persistence>(
  future: Future<T, K>
  convert: fn(T) -> U
) -> Future<U, K>
@_Parametric
extern K fn _settle<T, K in Persistence>(future: Future<T, K>, value: T)
# Settles each of `futures` with `value`, as one event.
@_Parametric
extern K fn _settleAll<T, K in Persistence>(futures: Array<Future<T, K>>, value: T)
extern K fn _later<K in Persistence>(callback: Fn<(), Unit, K>)
extern fn _unpark(call: _Call, position: Int)
# Has `call` hold `holding` until its wait is let go of (`_waitEnded`): a wait holds the futures its
# cases' chains are registered on (§7). The run holds it, as a future may reach what its callbacks
# do, so no value could hold it without a cycle the analysis of lifetimes refuses.
@Keeps{[:]}
extern K fn _awaiting<K in Persistence>(call: _Call, holding: Fn<(), Unit, K>)
# Lets go of what `call` holds for its wait (`_awaiting`).
extern fn _waitEnded(call: _Call)
extern fn _stayRunning(call: _Call)
# Whether `call` is being disposed, its `disposing()` future settling (§7).
extern fn _disposingWins(call: _Call) -> Bool
extern fn _idOf(call: _Call) -> Int
# A number above any this instance drew before, across its commits: a callback's rank by creation.
extern fn _made() -> Int

# What a function's values may capture (§3.14): only sendable values, only inert ones, which reach
# no disposable, or any. Each allows the one before it.
type Sendability = "sendable" | "inert" | "plain"

# The one function type (§3.14): `Args` is the tuple of its parameters, `(A,)` for one, a pack, or
# items written `&T` for parameters taken by reference. Every other spelling is its sugar:
# `sendable live fn(A) -> R` is `Fn<(A,), R, "live", "sendable">`.
extern struct Fn<Args, Result, Kind in Mark = "simple", Send in Sendability = "plain">

# What `spawn` gives (§9): a handle to the new instance, compared by identity, which holds nothing.
# `result()` resolves with its first end: `Ok` of its outcome, or `Err` of its panic.
extern sendable struct Instance<T>
ista async fn result<T is Sendable>(self: Instance<T>) -> Result<T>:
  resultOfEnding(await self._ended())

# How an instance ended, as the run tells it: its outcome alone, finished, or none with its panic's
# message and trace.
extern ista fn _ended<T is Sendable>(self: Instance<T>) -> Future<(
  Array<T>
  String
  String
), "ista">

# Starts `f` as a new, independent instance once the caller's segment commits, and goes on at once
# (§9). The instance awaits the future `f` gives and ends with its value, so `spawn purchase(req)`,
# a deferred call (§3.14), copies `req` into it now and calls `purchase` there, async or not.
extern ista fn spawn<R>(f: sendable ista async fn() -> R) -> Instance<R>

# A slot (§6), empty or full: full, its one value is its contents' one item, so a value of any type,
# `none` among them, fills it. Its waiting operations are one queue, longest waiter first, which
# holds nothing (§7): it reaches each one's future, and a put's offer, weakly, so an operation its
# holders let go of leaves the queue, as an inbox's retracted message does, and a put's value goes
# with its future, which alone holds it while it waits. An operation that can complete when it is
# called completes then, its future settled, and a full slot never has a read or take waiting that
# it would serve, nor an empty one such a put, so completing at once never jumps a waiter. Its
# operations declare what they keep: serving reads the queue's futures back through weak
# references, which the analysis of lifetimes can't follow (§7).
shared struct Slot<T>:
  contents: Array<T> = []
  waiting: Array<_SlotOperation<T>> = []

enum _SlotOperation<T>:
  Put(future: WeakRef<Future<Unit, "ista">>, offer: WeakRef<_Offer<T>>)
  Take(future: WeakRef<Future<T, "ista">>)
  Read(future: WeakRef<Future<T, "ista">>)

ista fn Slot.create<T>() -> Slot<T>: new Slot<T>{}

# Fills the slot once it is empty.
@Keeps{["self": ["value"]]}
ista fn put<T>(self: Slot<T>, value: T) -> Future<Unit, "ista">:
  const future = _pendingFuture<Unit, "ista">()
  if self->contents.length() == 0:
    self->contents = [value]
    _settle(future, ())
    _serve(self)
  else:
    const offer = new _Offer<T>{value}
    self->waiting.push(Put(WeakRef(future), WeakRef(offer)))
    _onAwaited(future, _serving(self))
    _onAwaited(future, _keeping(offer))
  future

# The value a waiting put fills its slot with, held by the put's future alone (`_keeping`), so the
# value is let go of as the put settles or is disposed. Disposable only so its slot's queue reaches
# it weakly.
shared struct _Offer<T>:
  value: T

ista fn dispose<T>(self: _Offer<T>): ()

# What keeps `offer` while its put waits: run as the put is awaited, it does nothing.
ista fn _keeping<T>(offer: _Offer<T>) -> Fn<(), Unit, "ista">:
  ista fn kept(): _ = offer
  kept

# Empties the slot once it is full, giving its value.
@Keeps{[:]}
ista fn take<T>(self: Slot<T>) -> Future<T, "ista">:
  const future = _pendingFuture<T, "ista">()
  if self->contents.length() == 1:
    const value = self->contents[0]
    self->contents = []
    _settle(future, value)
    _serve(self)
  else:
    self->waiting.push(Take(WeakRef(future)))
    _onAwaited(future, _serving(self))
  future

# Gives the slot's value once it is full, leaving it there.
@Keeps{[:]}
ista fn read<T>(self: Slot<T>) -> Future<T, "ista">:
  const future = _pendingFuture<T, "ista">()
  if self->contents.length() == 1: _settle(future, self->contents[0])
  else:
    self->waiting.push(Read(WeakRef(future)))
    _onAwaited(future, _serving(self))
  future

# What serves `slot`, run as an operation's future is awaited: one given up on is passed over, and
# awaited again, it is served where it stands.
ista fn _serving<T>(slot: Slot<T>) -> Fn<(), Unit, "ista">:
  ista fn served(): _serve(slot)
  served

# Serves `slot`'s queue from its head, one event after another, as far as it can.
ista fn _serve<T>(slot: Slot<T>):
  let serving = true
  while serving: serving = _servedOnce(slot)

# Serves the next event of `slot`'s queue, if its head can be served: while it is full, the reads
# at the head yield its value together, or else the take at the head empties it, so a `select` the
# reads decide has cancelled a losing take before it is reached; while it is empty, the put at the
# head fills it. An operation no longer held is dropped, one given up on, every case awaiting it
# lost, passed over (§8).
ista fn _servedOnce<T>(slot: Slot<T>) -> Bool:
  const waiting = slot->waiting
  const full = slot->contents.length() == 1
  let readers: Array<Future<T, "ista">> = []
  let kept: Array<_SlotOperation<T>> = []
  for index in 0..waiting.length():
    const operation = waiting[index]
    match operation:
      case Read(weak):
        if _waiting(weak) is Future<T, "ista"> as future:
          if not full: return _readersServed(slot, readers, [...kept, ...waiting.slice(index)])
          # Not pushed in place: a future pushed into a local it may reach would make the cycle §7
          # forbids, which the analysis can't rule out.
          readers = [...readers, future]
        elif weak._held(): kept.push(operation)
      case Take(weak):
        if _waiting(weak) is Future<T, "ista"> as future:
          if not full or readers.length() > 0:
            return _readersServed(slot, readers, [...kept, ...waiting.slice(index)])
          const value = slot->contents[0]
          slot->contents = []
          slot->waiting = [...kept, ...waiting.slice(index + 1)]
          _settle(future, value)
          return true
        elif weak._held(): kept.push(operation)
      case Put(weak, offered):
        if _waiting(weak) is Future<Unit, "ista"> as future:
          if full: return _readersServed(slot, readers, [...kept, ...waiting.slice(index)])
          # A put still waiting keeps its offer.
          slot->contents = [offered._referent()->value]
          slot->waiting = [...kept, ...waiting.slice(index + 1)]
          _settle(future, ())
          return true
        elif weak._held(): kept.push(operation)
  _readersServed(slot, readers, kept)

# Settles `readers` with `slot`'s value as one event, `waiting` then its queue; whether there were any.
ista fn _readersServed<T>(
  slot: Slot<T>
  readers: Array<Future<T, "ista">>
  waiting: Array<_SlotOperation<T>>
) -> Bool:
  slot->waiting = waiting
  if readers.length() == 0: return false
  _settleAll(readers, slot->contents[0])
  true

# The future `weak` reaches, while something holds it and a case may still take what it gives.
ista fn _waiting<U>(weak: WeakRef<Future<U, "ista">>) -> Future<U, "ista">?:
  if weak.deref() is Future<U, "ista"> as future:
    if not _givenUp(future): return future
  none

# Weak references (§7): `WeakRef(x)` is the one weak reference to `x`, which holds nothing.
extern fn WeakRef.from<T is Disposable>(value: T) -> WeakRef<T>
fn deref<T is Disposable>(self: WeakRef<T>) -> T?:
  if self._held(): self._referent()
  else: none
# Whether something still holds a weak reference's referent, which `_referent` then gives.
extern fn _held<T is Disposable>(self: WeakRef<T>) -> Bool
extern fn _referent<T is Disposable>(self: WeakRef<T>) -> T
extern ista fn disposed<T is Disposable>(self: WeakRef<T>) -> Future<Unit, "ista">

# An async call's handle, a weak reference to the call, which the function's own name is before a
# `.` (§7): `worker.disposing()` is the future that resolves when the call is disposed.
extern shared struct _Call
extern K fn disposing<K in Persistence>(self: _Call) -> Future<Unit, K>

# A Shared value (§3.8) is a shared struct of any one value (§3.18): `new Shared{value: v}` makes
# one, and `x->value` reads and writes it, for every copy.
shared struct Shared<T>:
  value: T

# The cell a variable lives in when it is passed by `&` or a closure captures it (§3.7, §3.14),
# which the runtime makes, reads and writes as it does a shared struct's.
extern shared struct _Cell<T>

# Disposal (§7): the runtime disposes a future and a slot once nothing holds them. Declaring their
# `dispose` is what makes them Disposable (§3.10). A future's is the runtime's own. A slot's is ista,
# so a slot is ista data, which only ista code handles (proposal 8, Rule 6); a slot dies along with
# the values in it, so its disposal lets go of its contents, disposed in the slot's own round before
# anything created before them.
@_Parametric
extern K fn dispose<T, K in Persistence>(self: Future<T, K>)
ista fn dispose<T>(self: Slot<T>): self->contents = []

# What `defer` gives (§7): a disposable whose release calls `run`, so `_ = defer log(x)` computes
# `x` now and logs when the block ends, and `hold _ = defer log(x)` when the function does. Its
# function is of the mark of the code deferring it (§3.3), which its release runs in, so ista code
# defers an ista call and simple code a simple one.
shared struct Deferred<M in Mark>:
  run: Fn<(), Unit, M>

M fn defer<M in Mark>(f: Fn<(), Unit, M>) -> Deferred<M>: new Deferred<M>{run: f}

M fn dispose<M in Mark>(self: Deferred<M>): self->run()

# `T?` is `T | None` (§2); this alias names it, so the statics declared on it are `T?`'s (§3.17).
type Optional<T> = T?

# Default, as an Array and a Map are: what a skipped JSON field reads back as (§9).
fn Optional.default<T>() -> T?: none

enum Result<T, E = Error>:
  Ok(value: T)
  Err(error: E)

# What a cursor gives each time it is called (§3.10): the next item, or that there are no more. An
# enum of its own, never `T?`, since an item may itself be `none` and `T??` is `T?`, so a stored
# `none` would read as the end.
enum Step<T>:
  Next(value: T)
  Done

struct Error:
  message: String
  code: String
  trace: String = _trace()

struct Range:
  start: Int?
  end: Int?
  step: Int = 1

# The range `..=` builds: its end stored one past the written one in the step's direction, so
# every range is half-open (§3.8).
fn _inclusiveRange(start: Int?, end: Int, step: Int) -> Range: Range{
  start
  end: if step < 0: end - 1 else: end + 1
  step
}

extern fn includes(self: Range, value: Int) -> Bool

extern fn panic(message: String) -> Never

# Collections (§3.8, §3.9, §3.10). Indexing panics outside the bounds, while `at` and `get` return an
# optional, and `at` and `slice` count a negative index from the end, as JavaScript does. A string
# counts code points. Methods taking a function are code, below, since only code calls one.
@_Parametric
extern fn length<T>(self: Array<T>) -> Int
fn at<T>(self: Array<T>, index: Int) -> T?:
  const position = _positionOf(index, self.length())
  if position == -1: none
  else: self[position]
@_Parametric
extern fn push<T>(self: &Array<T>, item: T)
fn pop<T>(self: &Array<T>) -> T?:
  if self.length() == 0: none
  else: self._popLast()
# Removes and gives the last item of an array, which has one.
@_Parametric
extern fn _popLast<T>(self: &Array<T>) -> T
@_Parametric
extern fn slice<T>(self: Array<T>, start: Int = 0, end: Int? = none) -> Array<T>
@_Parametric
extern fn index<T>(self: Array<T>, key: Int) -> T
@_Parametric
extern fn index<T>(self: Array<T>, key: Range) -> Array<T>
@_Parametric
extern fn setIndex<T>(self: &Array<T>, key: Int, value: T)
@_Parametric
extern fn setIndex<T>(self: &Array<T>, key: Range, value: Array<T>)
@_Parametric
extern fn Array.default<T>() -> Array<T>

fn indexOf<T>(self: Array<T>, item: T) -> Int: self.findIndex(fn(each): each == item)

fn lastIndexOf<T>(self: Array<T>, item: T) -> Int: self.findLastIndex(fn(each): each == item)

fn includes<T>(self: Array<T>, item: T) -> Bool: self.indexOf(item) >= 0

fn reverse<T>(self: &Array<T>):
  const last = self.length() - 1
  self = [for position in 0..=last: self[last - position]]

fn flat<T>(self: Array<Array<T>>) -> Array<T>:
  let items: Array<T> = []
  for inner in self:
    for item in inner: items.push(item)
  items

fn join(self: Array<String>, separator: String) -> String:
  let joined = ""
  for position in 0..self.length():
    if position > 0: joined += separator
    joined += self[position]
  joined

# What an array pattern reads once its length test passed (§3.11): the item `offset` from the start,
# or from the end when negative, and the items between the first `before` and the last `after`.
@_Parametric
extern fn _patternItem<T>(self: Array<T>, offset: Int) -> T
@_Parametric
extern fn _patternRest<T>(self: Array<T>, before: Int, after: Int) -> Array<T>

@_Parametric
extern fn size<K, V>(self: Map<K, V>) -> Int
fn get<K, V>(self: Map<K, V>, key: K) -> V?:
  const position = self._find(key)
  if position == -1: none
  else: self._valueAt(position)
# Where `key`'s entry is in a map's own order; -1 where it has none.
@_Parametric
extern fn _find<K, V>(self: Map<K, V>, key: K) -> Int
# The value of the entry at `position` in a map's own order.
@_Parametric
extern fn _valueAt<K, V>(self: Map<K, V>, position: Int) -> V
@_Parametric
extern fn has<K, V>(self: Map<K, V>, key: K) -> Bool
@_Parametric
extern fn delete<K, V>(self: &Map<K, V>, key: K) -> Bool
@_Parametric
extern fn index<K, V>(self: Map<K, V>, key: K) -> V
@_Parametric
extern fn setIndex<K, V>(self: &Map<K, V>, key: K, value: V)
@_Parametric
extern fn Map.default<K, V>() -> Map<K, V>

fn includes<K, V>(self: Map<K, V>, key: K) -> Bool: self.has(key) # as `has`, for `in`

fn keys<K, V>(self: Map<K, V>) -> Array<K>: [for key, _ in self: key]

fn values<K, V>(self: Map<K, V>) -> Array<V>: [for _, value in self: value]

fn entries<K, V>(self: Map<K, V>) -> Array<(K, V)>: [for entry in self: entry]

extern fn length(self: String) -> Int
fn at(self: String, index: Int) -> String?:
  const position = _positionOf(index, self.length())
  if position == -1: none
  else: self[position]

# Where `index` falls in a sequence of `length`, counting from the end when negative; -1 past either
# end (§3.9).
extern fn _positionOf(index: Int, length: Int) -> Int
extern fn includes(self: String, search: String) -> Bool
extern fn index(self: String, key: Int) -> String
extern fn index(self: String, key: Range) -> String

# Methods taking a function (§3.8), with JavaScript's names. Each calls its function on the items in
# order, a search only until it finds one.
M fn map<T, U, M in Mark>(self: Array<T>, f: Fn<(T,), U, M>) -> Array<U>: [
  for item in self: f(item)
]

M fn filter<T, M in Mark>(self: Array<T>, keep: Fn<(T,), Bool, M>) -> Array<T>: [
  for item in self if keep(item): item
]

M fn flatMap<T, U, M in Mark>(self: Array<T>, f: Fn<(T,), Array<U>, M>) -> Array<U>:
  self.map(f).flat()

M fn find<T, M in Mark>(self: Array<T>, test: Fn<(T,), Bool, M>) -> T?:
  self._itemAt(self.findIndex(test))

M fn findLast<T, M in Mark>(self: Array<T>, test: Fn<(T,), Bool, M>) -> T?:
  self._itemAt(self.findLastIndex(test))

M fn findIndex<T, M in Mark>(self: Array<T>, test: Fn<(T,), Bool, M>) -> Int:
  for position in 0..self.length():
    if test(self[position]): return position
  -1

M fn findLastIndex<T, M in Mark>(self: Array<T>, test: Fn<(T,), Bool, M>) -> Int:
  let position = self.length() - 1
  while position >= 0 and not test(self[position]): position -= 1
  position

M fn some<T, M in Mark>(self: Array<T>, test: Fn<(T,), Bool, M>) -> Bool: self.findIndex(test) >= 0

M fn every<T, M in Mark>(self: Array<T>, test: Fn<(T,), Bool, M>) -> Bool:
  not self.some(fn(item): not test(item))

M fn reduce<T, A, M in Mark>(self: Array<T>, f: Fn<(A, T), A, M>, initial: A) -> A:
  let result = initial
  for item in self: result = f(result, item)
  result

# Sorting is a merge sort, so it is stable: of two items the order puts level, the earlier stays
# first.
fn sort<T is Comparable>(self: &Array<T>): self.sort(fn(left, right): compare(left, right))

M fn sort<T, M in Mark>(self: &Array<T>, order: Fn<(T, T), Int, M>): self = _sorted(self, order)

M fn Map.groupBy<K, T, M in Mark>(items: Array<T>, key: Fn<(T,), K, M>) -> Map<K, Array<T>>:
  let groups: Map<K, Array<T>> = [:]
  for item in items:
    const group = key(item)
    groups[group] = [...(groups.get(group) ?? []), item]
  groups

# A map converted part by part (§3.5): each value made what `f` makes of it, its key kept.
M fn _mapValues<K, V, W, M in Mark>(self: Map<K, V>, f: Fn<(V,), W, M>) -> Map<K, W>:
  let mapped: Map<K, W> = [:]
  for (key, value) in self: mapped[key] = f(value)
  mapped

# The item at `position`, which a search found, or none for the -1 of a search that found none.
fn _itemAt<T>(self: Array<T>, position: Int) -> T?:
  if position < 0: none
  else: self[position]

M fn _sorted<T, M in Mark>(items: Array<T>, order: Fn<(T, T), Int, M>) -> Array<T>:
  if items.length() <= 1: return items
  const middle = items.length() // 2
  _merged(_sorted(items[..middle], order), _sorted(items[middle..], order), order)

# `left` and `right`, each sorted, merged into one sorted array; `left`'s items go first on a tie.
M fn _merged<T, M in Mark>(left: Array<T>, right: Array<T>, order: Fn<(T, T), Int, M>) -> Array<T>:
  let merged: Array<T> = []
  let fromLeft = 0
  let fromRight = 0
  while fromLeft < left.length() and fromRight < right.length():
    if order(right[fromRight], left[fromLeft]) < 0:
      merged.push(right[fromRight])
      fromRight += 1
    else:
      merged.push(left[fromLeft])
      fromLeft += 1
  [...merged, ...left[fromLeft..], ...right[fromRight..]]

# Iteration (§3.10): `iterate` gives a cursor, which gives the next item each time it is called and
# `Done` once there are no more. A cursor holds what it runs over as `iterate` was given it, so
# changing the original meanwhile changes nothing, and it persists as any closure does: a range's
# holds two ints, never its items.
fn iterate<T>(self: Array<T>) -> fn() -> Step<T>:
  _cursor(self.length(), fn(position): self[position])

fn iterate<K, V>(self: Map<K, V>) -> fn() -> Step<(K, V)>:
  _cursor(self.size(), fn(position): self._entryAt(position))

fn iterate(self: Range) -> fn() -> Step<Int>:
  const start, step, count = self._steps()
  _cursor(count, fn(position): start + position * step)

# A range's start, its step and how many ints it reaches; one without both ends panics.
extern fn _steps(self: Range) -> (Int, Int, Int)

# A string's cursor steps over its code points by where each starts in its UTF-16 text, so reading
# the next one never counts from the start.
fn iterate(self: String) -> fn() -> Step<String>:
  let offset = 0
  fn next() -> Step<String>:
    const character, after = self._characterAt(offset)
    if character == "": return Done
    offset = after
    Next(character)
  next

# The cursor of `count` items, the item at each position read by `item`.
fn _cursor<T>(count: Int, item: fn(Int) -> T) -> fn() -> Step<T>:
  let position = 0
  fn next() -> Step<T>:
    if position == count: return Done
    position += 1
    Next(item(position - 1))
  next

# The entry at `position` in a map's own order.
@_Parametric
extern fn _entryAt<K, V>(self: Map<K, V>, position: Int) -> (K, V)

# The code point starting at UTF-16 `offset` in a string, and the offset after it; `""` at the end.
extern fn _characterAt(self: String, offset: Int) -> (String, Int)

# Where the running frames are, innermost first, from the code that called for the value: the
# default of an `Error`'s `trace`, which runs in an entry of its own (§3.1, §3.12).
extern fn _trace() -> String

# Operators on primitives (§3.9). The runtime implements those on two operands of one type, and
# declaring them here lets an operator resolve like any other call. Mixed operands are overloads,
# as a program's own are, written over those: mixing int and float converts the int and gives a
# float, and `/` always gives a float.
extern fn add(left: Int, right: Int) -> Int
extern fn add(left: Float, right: Float) -> Float
fn add(left: Int, right: Float) -> Float: Float(left) + right
fn add(left: Float, right: Int) -> Float: left + Float(right)
extern fn add(left: String, right: String) -> String
extern fn subtract(left: Int, right: Int) -> Int
extern fn subtract(left: Float, right: Float) -> Float
fn subtract(left: Int, right: Float) -> Float: Float(left) - right
fn subtract(left: Float, right: Int) -> Float: left - Float(right)
extern fn multiply(left: Int, right: Int) -> Int
extern fn multiply(left: Float, right: Float) -> Float
fn multiply(left: Int, right: Float) -> Float: Float(left) * right
fn multiply(left: Float, right: Int) -> Float: left * Float(right)
fn divide(left: Int, right: Int) -> Float: Float(left) / Float(right)
extern fn divide(left: Float, right: Float) -> Float
fn divide(left: Int, right: Float) -> Float: Float(left) / right
fn divide(left: Float, right: Int) -> Float: left / Float(right)
extern fn floorDivide(left: Int, right: Int) -> Int
extern fn remainder(left: Int, right: Int) -> Int
# An int to an int power stays an int, which a negative exponent can't; a float operand makes the
# result a float.
extern fn power(base: Int, exponent: Int) -> Int
extern fn power(base: Float, exponent: Float) -> Float
fn power(base: Int, exponent: Float) -> Float: Float(base) ** exponent
fn power(base: Float, exponent: Int) -> Float: base ** Float(exponent)
# The bitwise operators work on an int's two's complement of unbounded width, as Python's do, so
# `~x` is `-x - 1` and `>>` rounds toward negative infinity; a negative shift count panics.
extern fn bitAnd(left: Int, right: Int) -> Int
extern fn bitOr(left: Int, right: Int) -> Int
extern fn bitXor(left: Int, right: Int) -> Int
extern fn bitNot(value: Int) -> Int
extern fn shiftLeft(value: Int, count: Int) -> Int
extern fn shiftRight(value: Int, count: Int) -> Int
extern fn negate(value: Int) -> Int
extern fn negate(value: Float) -> Float
extern fn compare(left: Int, right: Int) -> Int
extern fn compare(left: Float, right: Float) -> Int
fn compare(left: Int, right: Float) -> Int: compare(Float(left), right)
fn compare(left: Float, right: Int) -> Int: compare(left, Float(right))
extern fn compare(left: String, right: String) -> Int

# Conversions (§3.10): only the ones that can't fail are written T(x). `Int(x)` truncates toward
# zero; a float that is no number (NaN, an infinity) has no int, which is a bug, so it panics.
# `String(x)` is `toString`, the one place a type says how it is written; a whole float keeps its
# `.0`, so `1.0` never reads as the int `1`. `parse` reads back what `toString` writes, and fails
# with a Result, since text from outside may be anything.
extern fn Float.from(value: Int) -> Float
extern fn Int.from(value: Float) -> Int

fn String.from<T is Stringable>(value: T) -> String: value.toString()

# Adding any Stringable value to a string, on either side, appends the text its `toString` writes.
fn add<T is Stringable>(left: String, right: T) -> String: left + right.toString()

fn add<T is Stringable>(left: T, right: String) -> String: left.toString() + right

extern fn toString(self: Int) -> String
extern fn toString(self: Float) -> String

fn toString(self: Bool) -> String:
  if self: "true"
  else: "false"

fn toString(self: String) -> String: self

fn Int.parse(text: String) -> Result<Int>: _parsed(Int._read(text), text, "an Int")
fn Float.parse(text: String) -> Result<Float>: _parsed(Float._read(text), text, "a Float")

# What `text` reads as, as `toString` writes it: one value, or none.
extern fn Int._read(text: String) -> Array<Int>
extern fn Float._read(text: String) -> Array<Float>

fn Bool.parse(text: String) -> Result<Bool>:
  if text == "true": Ok(true)
  elif text == "false": Ok(false)
  else: Err(Error.unparsed(text, "a Bool"))

# The error a `parse` gives (§3.10) for `text` that doesn't read as `what`, as `an Int`.
fn Error.unparsed(text: String, what: String) -> Error: Error{
  message: "'" + text + "' is not " + what + "."
  code: "parse"
}

# The one value `read` holds, else the error of `text` not reading as `what`.
fn _parsed<T>(read: Array<T>, text: String, what: String) -> Result<T>:
  if read.length() == 1: Ok(read[0])
  else: Err(Error.unparsed(text, what))

fn String.parse(text: String) -> Result<String>: Ok(text)

trait Sendable

trait Inert

trait DataKind<K in Mark>

trait Disposable:
  fn dispose(self: Self)

trait Iterable<T, C = Self>:
  fn iterate(self: C) -> fn() -> Step<T>

# What `item in c` asks (§3.9).
trait Container<T, C = Self>:
  fn includes(self: C, item: T) -> Bool

trait Indexable<K, V, C = Self>:
  fn index(self: C, key: K) -> V

trait IndexAssignable<K, V, C = Self>:
  fn setIndex(self: &C, key: K, value: V)

trait Convertible<From, T = Self>:
  fn Self.from(value: From) -> Self

trait Default:
  fn Self.default() -> Self

trait Addable<T = Self>:
  fn add(left: T, right: T) -> T

trait Subtractable<T = Self>:
  fn subtract(left: T, right: T) -> T

trait Multipliable<T = Self>:
  fn multiply(left: T, right: T) -> T

trait Divisible<T = Self>:
  fn divide(left: T, right: T) -> T

trait FloorDivisible<T = Self>:
  fn floorDivide(left: T, right: T) -> T
  fn remainder(left: T, right: T) -> T

trait Negatable<T = Self>:
  fn negate(value: T) -> T

# The exponent may have a type of its own: a Decimal is `Powerable<Int>`.
trait Powerable<E = Self, T = Self>:
  fn power(base: T, exponent: E) -> T

# Apart from shifts, which a set of flags has no use for.
trait Bitwise<T = Self>:
  fn bitAnd(left: T, right: T) -> T
  fn bitOr(left: T, right: T) -> T
  fn bitXor(left: T, right: T) -> T
  fn bitNot(value: T) -> T

trait Shiftable<T = Self>:
  fn shiftLeft(value: T, count: Int) -> T
  fn shiftRight(value: T, count: Int) -> T

trait Comparable<T = Self>:
  fn compare(left: T, right: T) -> Int

trait Stringable:
  fn toString(self: Self) -> String

trait Parsable:
  fn Self.parse(text: String) -> Result<Self>

# Names the suspension point of the statement it annotates, for tests and operators (§10).
struct Waypoint:
  label: String

# Shared instances (§3.5): an instance is compiled once for every type of one representation at a
# type parameter its code uses only opaquely (lowering/tables/stencils.ts), taking a primitive for its
# own, else one of these stand-ins: a pointer its backend never counts, an enum's bare tag, a heap
# value, a value that may reach a disposable. No value is of them.
extern struct _Handle
enum _Tag:
  Tag
struct _Heap
struct _Counted:
  reaches: fn()

# On a std extern function: its native reads none of its type arguments, so one entry serves every
# type of one representation at each (`_Handle`).
struct _Parametric
