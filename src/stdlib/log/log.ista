# The log module (spec §3.8): structured log records, which reach the host only when their segment
# commits, so a segment that is discarded logged nothing (§5, §9).
#
# `write` is the module's one extern; the rest is code over it, so mocking `write` captures every
# record (§10).

import * as json from 'json'
import Encodable from 'json'

enum Level:
  Debug
  Info
  Warn
  Error

extern fn write(level: Level, message: String, fields: json.Json)

fn debug(message: String): write(Level.Debug, message, _noFields())

fn debug<F is Encodable>(message: String, fields: F):
  write(Level.Debug, message, json.encode(fields))

fn info(message: String): write(Level.Info, message, _noFields())

fn info<F is Encodable>(message: String, fields: F): write(Level.Info, message, json.encode(fields))

fn warn(message: String): write(Level.Warn, message, _noFields())

fn warn<F is Encodable>(message: String, fields: F): write(Level.Warn, message, json.encode(fields))

fn error(message: String): write(Level.Error, message, _noFields())

fn error<F is Encodable>(message: String, fields: F):
  write(Level.Error, message, json.encode(fields))

# A record without fields has an empty object, so a host reads every record's fields one way.
fn _noFields() -> json.Json: [:]
