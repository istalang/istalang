# The strings module (spec §3.8). Positions and lengths count code points, so every group checks
# a string holding one beyond UTF-16's first plane ("😀" is one code point and two UTF-16 units).

import Suite, Test, test, group, assert, assertEq, expectPanic from 'testing'
import * as strings from 'strings'
import trim, padStart from 'strings'

@Suite{"strings"}
fn suite() -> Array<Test>: [
  group("searching", [
    test("indexOf gives the first position from `from`, or -1", fn(): {
      assertEq(strings.indexOf("abcabc", "c"), 2)
      assertEq(strings.indexOf("abcabc", "c", 3), 5)
      assertEq(strings.indexOf("abc", "x"), -1)
      assertEq(strings.indexOf("😀ab", "b"), 2)
      assertEq(strings.indexOf("😀a😀a", "a", 2), 3)
      assertEq(strings.indexOf("abc", "a", -5), 0)
      assertEq(strings.indexOf("abc", "", 9), 3)
    }),
    test("lastIndexOf gives the last position, or -1", fn(): {
      assertEq(strings.lastIndexOf("abcabc", "b"), 4)
      assertEq(strings.lastIndexOf("😀b😀b", "b"), 3)
      assertEq(strings.lastIndexOf("abc", "x"), -1)
    }),
    test("includes, startsWith and endsWith", fn(): {
      assert(strings.includes("a😀b", "😀"))
      assert(not strings.includes("ab", "c"))
      assert(strings.startsWith("😀ab", "😀"))
      assert(not strings.startsWith("ab", "b"))
      assert(strings.endsWith("ab😀", "😀"))
      assert(not strings.endsWith("ab", "a"))
    }),
  ]),
  group("cutting", [
    test("slice clamps, counting a negative index from the end", fn(): {
      assertEq(strings.slice("a😀bc", 1, 3), "😀b")
      assertEq(strings.slice("a😀bc", 2), "bc")
      assertEq(strings.slice("a😀bc", -2), "bc")
      assertEq(strings.slice("abc", 1, 99), "bc")
      assertEq(strings.slice("abc", 2, 1), "")
      assertEq(strings.slice("abc"), "abc")
    }),
    test("split cuts around each separator", fn(): {
      assertEq(strings.split("a,b,,c,", ","), ["a", "b", "", "c", ""])
      assertEq(strings.split("abc", ","), ["abc"])
      assertEq(strings.split("", ","), [""])
    }),
    test("split by an empty separator gives the code points", fn(): {
      assertEq(strings.split("a😀b", ""), ["a", "😀", "b"])
      assertEq(strings.split("", ""), [])
    }),
    test("trim, trimStart and trimEnd", fn(): {
      assertEq(strings.trim("  a b \n"), "a b")
      assertEq(strings.trimStart("  a "), "a ")
      assertEq(strings.trimEnd("  a "), "  a")
    }),
  ]),
  group("building", [
    test("padStart and padEnd fill to a length, cutting the fill to fit", fn(): {
      assertEq(strings.padStart("7", 3), "  7")
      assertEq(strings.padStart("7", 3, "0"), "007")
      assertEq(strings.padEnd("ab", 7, "😀x"), "ab😀x😀x😀")
      assertEq(strings.padStart("abc", 2), "abc")
      assertEq(strings.padStart("ab", 5, ""), "ab")
    }),
    test("repeat", fn(): {
      assertEq(strings.repeat("😀a", 3), "😀a😀a😀a")
      assertEq(strings.repeat("a", 0), "")
    }),
    test("repeat panics on a negative count", async fn(): {
      assertEq(await expectPanic(fn(): strings.repeat("a", -1)), "A string can't be repeated -1 times.")
    }),
    test("replace and replaceAll match plain text, writing a `$` as it is", fn(): {
      assertEq(strings.replace("a.b.c", ".", "$&"), "a$&b.c")
      assertEq(strings.replaceAll("a.b.c", ".", "$$"), "a$$b$$c")
      assertEq(strings.replace("abc", "x", "y"), "abc")
    }),
    test("an empty search matches before every code point and at the end", fn(): {
      assertEq(strings.replace("a😀", "", "-"), "-a😀")
      assertEq(strings.replaceAll("a😀", "", "-"), "-a-😀-")
      assertEq(strings.replaceAll("", "", "-"), "-")
    }),
    test("toUpperCase and toLowerCase map case by Unicode's default", fn(): {
      assertEq(strings.toUpperCase("straße i"), "STRASSE I")
      assertEq(strings.toLowerCase("İSTANBUL ABC"), "i̇stanbul abc")
    }),
  ]),
  group("format", [
    test("{} takes the next value and {n} value n", fn(): {
      assertEq(strings.format("{} of {}", "1", "3"), "1 of 3")
      assertEq(strings.format("{1} before {0}, then {}", "a", "b"), "b before a, then a")
      assertEq(strings.format("no placeholders", "unused"), "no placeholders")
    }),
    test("{{ and }} write a brace", fn(): {
      assertEq(strings.format("{{{}}}", "x"), "{x}")
    }),
    test("a placeholder without a value panics", async fn(): {
      assertEq(
        await expectPanic(fn(): strings.format("{} and {}", "one")),
        "The template '{} and {}' has no value for placeholder 1: it was given 1.",
      )
    }),
    test("a stray brace panics", async fn(): {
      assertEq(
        await expectPanic(fn(): strings.format("a } b")),
        "The template 'a } b' has a stray '}'; '}}' writes one.",
      )
      assertEq(
        await expectPanic(fn(): strings.format("{name}", "x")),
        "The template '{name}' has a stray '{'; '{{' writes one.",
      )
    }),
  ]),
  group("characters", [
    test("graphemes splits into user-perceived characters", fn(): {
      assertEq(strings.graphemes("e\u{301}👍🏽a"), ["e\u{301}", "👍🏽", "a"])
      assertEq(strings.graphemes(""), [])
    }),
    test("utf16Length counts what JavaScript counts", fn(): {
      assertEq(strings.utf16Length("a😀"), 3)
      assertEq("a😀".length(), 2)
    }),
  ]),
  test("an imported method is called on a string", fn(): {
    assertEq("  x ".trim(), "x")
    assertEq("5".padStart(2, "0"), "05")
  }),
]
