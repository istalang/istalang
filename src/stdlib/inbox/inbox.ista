# The inbox module (spec §6): `Inbox<T>`, an unbounded FIFO message queue built on a slot, and
# `Revertible<T>`, the holder of a message sent revertibly.
#
# Receivers wait on the slot itself: `receive()` is the slot's `take`, so the slot's queue gives
# the receiver rules (each message goes to exactly one receiver, the one that has waited longest),
# and a receive that loses a `select` consumes nothing. Each message waits on the slot too, as a
# `put` queued in the order sent, which is the order their segments committed: the slot moves the
# next one in as soon as a receiver takes one, however that receive came to be awaited, so no
# inbox code runs between two receives. A message is only in its put, then in the slot, so once
# received it is nowhere, and what it holds is let go of then.
#
# The inbox keeps each message's number beside its put, oldest first, to retract one. Puts are
# served in order, so the ones served come first, and only the last of them can still be in the
# slot: it is while the slot is full. A `select` that doesn't wait leaves what it asks about as it
# was (§8), so asking whether a put was served (`_settles`) keeps it in the queue. Listing the
# messages takes them all out of the slot and queues them again, in one step, so no receiver sees
# it. Segments run one at a time, so nothing else runs between reading the inbox's fields and
# writing them back.
#
# Retracting a message removes it wherever it waits: in the queue by letting go of its put, which
# a slot's queue drops (§7), in the slot by taking it out. Once received, a message is no longer
# anywhere, so retracting it changes nothing.

struct Queued { number: Int, put: Future<Unit, "ista"> }

shared struct Inbox<T>:
  slot: Slot<T>
  # the puts of the messages not known to be received, oldest first
  queued: Array<Queued> = []
  # how many messages were ever sent, which numbers the next
  sent: Int = 0

# A revertible message's holder: disposing it calls `retract`, which the queue that made it
# supplies, so every queue, the host's included (§3.6), hands out this one type.
shared struct Revertible<T> { retract: ista fn() -> Unit }

# A holder whose retraction lets go of `resource`, which disposes it: how a queue the host provides
# hands out a revertible send, a disposable host type its host retracts (§3.6). It makes a
# `Revertible`, whose release runs ista code, so it is ista.
ista fn Revertible.holding<T, R is Disposable>(resource: R) -> Revertible<T>:
  const held = new Shared<R?>{value: resource}
  fn retract(): held->value = none
  new Revertible<T>{retract}

ista fn Inbox.create<T>() -> Inbox<T>:
  new Inbox<T>{slot: Slot.create<T>()}

ista fn send<T>(self: Inbox<T>, message: T):
  drop _queue(self, message)

# The holder retracts the message when its last holder lets go of it, unless it was received. It
# reaches the inbox weakly, so holding it keeps no inbox alive.
ista fn sendRevertible<T>(self: Inbox<T>, message: T) -> Revertible<T>:
  const number = _queue(self, message)
  const inbox = WeakRef(self)
  new Revertible<T>{retract: fn(): _retract(inbox, number)}

ista fn receive<T>(self: Inbox<T>) -> Future<T, "ista">:
  self->slot.take()

# The messages waiting, oldest first, without receiving them: taken out of the slot one after
# another, as their puts move them in, and queued again in that order.
ista fn pending<T>(self: Inbox<T>) -> Array<T>:
  _forgetReceived(self)
  let messages: Array<T> = []
  let waiting = true
  while waiting:
    select:
      case self->slot.take() as message: messages.push(message)
      else: waiting = false
  const numbers = [for each in self->queued: each.number]
  self->queued = [
    for index in 0..messages.length(): Queued{
      number: numbers[index]
      put: self->slot.put(messages[index])
    }
  ]
  messages

# Disposing an inbox (§6, §7) lets go of its fields, so the slot dies with the message in it, and
# the puts queued with theirs. Declaring `dispose` is what makes an inbox disposable, and so
# something a `WeakRef` can watch.
ista fn dispose<T>(self: Inbox<T>): ()

ista fn dispose<T>(self: Revertible<T>): self->retract()

# Queues `message` behind the others; its number.
ista fn _queue<T>(self: Inbox<T>, message: T) -> Int:
  _forgetReceived(self)
  const number = self->sent
  self->queued.push(Queued{number, put: self->slot.put(message)})
  self->sent += 1
  number

# Forgets the messages received: those whose put was served, but the last one while the slot,
# full, still holds it.
ista fn _forgetReceived<T>(self: Inbox<T>):
  let served = 0
  while served < self->queued.length() and _settles(self->queued[served].put):
    served += 1
  const inSlot = served > 0 and _settles(self->slot.read())
  self->queued = self->queued[
    (if inSlot: served - 1 else: served)..
  ]

# Removes message `number` from the inbox, if the inbox is still there and the message unread.
ista fn _retract<T>(inbox: WeakRef<Inbox<T>>, number: Int):
  if inbox.deref() is Inbox as box:
    _forgetReceived(box)
    const queued = box->queued
    if queued.length() > 0 and queued[0].number == number and _settles(queued[0].put):
      drop _settles(box->slot.take())
    box->queued = [for each in queued if each.number != number: each]

# Whether `operation` settled. One that didn't is as it was (§8), and one let go with the parameter
# does nothing (§6), so a `take` that doesn't settle consumes nothing.
ista fn _settles<T>(operation: Future<T, "ista">) -> Bool:
  select:
    case operation: true
    else: false
