# The fanout module (spec §3.8): one stream of messages that every subscriber reads.
#
# The stream is a chain of slots, each holding a message and the slot after it. The bus holds the
# empty slot at the end, which the next message fills. A subscriber walks the chain with `read`,
# which leaves each message for the others, so the chain behind the slowest subscriber is let go as
# it moves on. A subscription starts at the end of the chain and watches the bus weakly, so it never
# keeps the bus alive. Once the bus is disposed it reaches the end of the chain, since nothing can
# fill it any more, and ends there: it prefers the next message to the bus's disposal.
#
# A revertible message carries a flag its holder sets when released (§6). A subscriber skips a
# message flagged by the time it reaches it, while one that read it before keeps it, since a
# received message is final.

import Revertible from 'inbox'

shared struct Bus<M>:
  _end: Slot<_Link<M>> = Slot.create<_Link<M>>()

struct _Link<M>:
  message: M
  retracted: Shared<bool>
  next: Slot<_Link<M>>

fn create<M>() -> Bus<M>:
  new Bus<M>{}

fn send<M>(self: Bus<M>, message: M):
  drop _publish(self, message)

# Sends `message`, retracted from every subscriber that hasn't read it when the holder is released.
fn sendRevertible<M>(self: Bus<M>, message: M) -> Revertible<M>:
  const retracted = _publish(self, message)
  fn retract():
    retracted->value = true
  new Revertible<M>{retract}

# Runs `handler` for each message sent from now on, in the order they were sent, one at a time,
# until the future it returns is disposed, or the bus is and every message sent before is handled.
fn subscribe<M>(self: Bus<M>, handler: async fn(M) -> unit) -> Future<unit>:
  _follow(self->_end, WeakRef(self), handler)

fn subscribe<M>(self: Bus<M>, handler: fn(M) -> unit) -> Future<unit>:
  subscribe(self, async fn(message: M): handler(message))

# Disposing a bus (§7) lets go of the end of its chain. Declaring `dispose` is what makes a bus
# disposable, and so something its subscriptions can watch.
fn dispose<M>(self: Bus<M>):
  ()

# Appends `message` to the stream: the flag that retracts it.
fn _publish<M>(bus: Bus<M>, message: M) -> Shared<bool>:
  const retracted = new Shared<bool>{value: false}
  const next = Slot.create<_Link<M>>()
  drop bus->_end.put(_Link{message, retracted, next})
  bus->_end = next
  retracted

async fn _follow<M>(start: Slot<_Link<M>>, bus: WeakRef<Bus<M>>, handler: async fn(M) -> unit) -> Future<unit>:
  let at = start
  while true:
    const link = await select:
      case at.read() as link:
        link
      case bus.disposed():
        return
    if not link.retracted->value:
      await handler(link.message)
    at = link.next
