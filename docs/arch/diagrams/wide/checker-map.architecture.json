    {
      "dot": "cyan",
      "title": "Lazy",
      "items": [
        "A body is checked the first time diagnostics, lowering or result inference asks",
        "Std modules are skipped by diagnose; lowering checks what a program uses"
      ]
    },
    {
      "dot": "emerald",
      "title": "Incremental",
      "items": [
        "Every answer is an entry with its reads and notes",
        "A checker made after an edit takes over entries whose reads answer alike"
      ]
    },
    {
      "dot": "amber",
      "title": "Layers inside",
      "items": [
        "diagnostics, types, inference, traits, resolution, calls, patterns, flow, rules, declarations, closures, expressions, statements, lookup",
