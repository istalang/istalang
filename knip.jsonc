{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // `vscode` is the editor's own module, given to the VS Code client at run time (its types come
  // from @types/vscode), so no package can list it.
  "ignoreDependencies": ["vscode"],
  // The form builder prototype is run by hand, outside the package's entries, and a scenario's host
  // module is loaded by its path, as `ista run --host` loads one.
  "ignoreFiles": ["examples/FormBuilder/**", "test/golden/scenarios/*.host.mjs"]
}
