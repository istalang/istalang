{
  "name": "istalang",
  "version": "0.0.0",
  "private": true,
  "description": "Toolchain for Istalang, a strongly typed language for durable, long-running workflows",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "ista": "dist/cli/main.js"
  },
  "exports": {
    "./runtime": {
      "types": "./dist/runtime/host.d.ts",
      "default": "./dist/runtime/host.js"
    },
    "./stdlib": {
      "types": "./dist/stdlib/natives.d.ts",
      "default": "./dist/stdlib/natives.js"
    }
  },
  "scripts": {
    "build": "tsdown --log-level silent && tsc -p tsconfig.declarations.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome ci && depcruise src",
    "fix": "biome check --write",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run knip && npm test && npm run build",
    "bench": "vitest bench --run --reporter=verbose",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.0",
    "fast-check": "4.10.2",
    "knip": "^6.43.0",
    "tsdown": "0.23.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "commander": "15.0.0",
    "lossless-json": "4.3.3",
    "zod": "4.6.7"
  }
}
