{
  "name": "istalang",
  "version": "0.0.0",
  "private": true,
  "description": "Toolchain for Istalang, a strongly typed language for durable, long-running workflows",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome ci && depcruise src",
    "fix": "biome check --write",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@swc/core": "1.16.20",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
