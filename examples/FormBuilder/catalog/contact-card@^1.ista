# contact-card@^1.ista — catalog form mounted by supplier.form.json.

import Field, Group, Prop, FieldView, LayoutView, View, User from '../forms'
import FieldWidget, LayoutWidget from '../forms'
import * as forms from '../forms'

struct Params:
  name: String

struct Ctx:
  params: Params
  user: User

struct Model:
  phone: Field<String>

fn model() -> Group<Model>: Group{fields: Model{phone: new Field<String>{}}}

fn view(m: Model, k: String) -> any View<forms.Scope<Group<Model>.Seen, Ctx>>: LayoutView{
  key: `${k}/n1`
  parent: none
  widget: Prop.Fixed(LayoutWidget.Section(title: none, description: none, collapsible: none, labels: none))
  children: [
    new FieldView{
      key: `${k}/n2`
      parent: none
      field: m.phone
      widget: Prop.Fixed(FieldWidget.Input(none))
      label: Prop.Fixed("Phone")
      checks: [forms.answered()]
    }
  ]
}
