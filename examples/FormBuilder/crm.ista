# crm.ista — external CRM source for the supplier form.

struct User:
  id: String
  name: String

type Order = { note: String? }

extern fn users(search: String) -> Future<Array<User>, "ista">
extern fn user(id: String) -> Future<User?, "ista">
extern fn creditLimit(vatId: String) -> Future<Int?, "ista">
extern fn orders(vatId: String) -> Future<Array<Order>, "ista">
