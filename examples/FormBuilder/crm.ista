# crm.ista — external CRM source for the supplier form.

struct User:
  id: String
  name: String

type Order = { note: String? }

extern live async fn users(search: String) -> Array<User>
extern live async fn user(id: String) -> User?
extern live async fn creditLimit(vatId: String) -> Int?
extern live async fn orders(vatId: String) -> Array<Order>
