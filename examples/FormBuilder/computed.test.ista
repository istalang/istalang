# The computed module (docs/work/computed/design.md; plan C1's criteria).

import Suite, Test, test, assertEq, expectPanic from 'testing'
import Graph, Computed from './computed'

@Suite{"computed"}
fn computedSuite() -> Array<Test>: [
  test("a view evaluates each computed once", onceAView)
  test("only what read a changed source re-evaluates", onlyWhatChanged)
  test("an equal result stops the update", equalResultStops)
  test("a deep diamond chain is walked once per view", deepDiamonds)
  test("a computed may give none", givesNone)
  test("reads behind a flipped condition stay untouched", flippedCondition)
  test("a computed reading itself gets its previous value", readsItself)
  test("a cycle through another reads the previous value, then catches up", readsThroughAnother)
  test("reading itself in its first evaluation panics", async fn(): {
    assertEq(
      await expectPanic(readsItselfFirst)
      "A computed read itself in its first evaluation, before it had a value."
    )
  })
  test("reading another graph's node in a view panics", async fn(): {
    assertEq(
      await expectPanic(readsAnotherGraph)
      "A view reads one graph: another graph's ticks don't compare with its own."
    )
  })
]

# A computed of `graph` counting its evaluations in `runs`.
fn counted<T is Inert>(graph: Graph, runs: Shared<Int>, eval: inert fn() -> T) -> Computed<T>:
  graph.computed(fn(): { runs->value += 1; eval() })

fn onceAView():
  const graph = new Graph{}
  const base = graph.source(1)
  const runs = new Shared<Int>{value: 0}
  const double = counted(graph, runs, fn(): base.read() * 2)
  const both = graph.computed(fn(): double.read() + double.read())
  assertEq(both.read(), 4)
  assertEq(runs->value, 1)
  assertEq(both.read(), 4)
  assertEq(runs->value, 1)

fn onlyWhatChanged():
  const graph = new Graph{}
  const first = graph.source(1)
  const second = graph.source(10)
  const firstRuns = new Shared<Int>{value: 0}
  const secondRuns = new Shared<Int>{value: 0}
  const topRuns = new Shared<Int>{value: 0}
  const fromFirst = counted(graph, firstRuns, fn(): first.read() + 1)
  const fromSecond = counted(graph, secondRuns, fn(): second.read() + 1)
  const top = counted(graph, topRuns, fn(): fromFirst.read() + fromSecond.read())
  assertEq(top.read(), 13)
  first.set(2)
  assertEq(top.read(), 14)
  assertEq((firstRuns->value, secondRuns->value, topRuns->value), (2, 1, 2))
  first.set(2)
  assertEq(top.read(), 14)
  assertEq((firstRuns->value, secondRuns->value, topRuns->value), (2, 1, 2))

fn equalResultStops():
  const graph = new Graph{}
  const base = graph.source(1)
  const parity = graph.computed(fn(): base.read() % 2)
  const aboveRuns = new Shared<Int>{value: 0}
  const above = counted(graph, aboveRuns, fn(): parity.read())
  assertEq(above.read(), 1)
  base.set(3)
  assertEq(above.read(), 1)
  assertEq(aboveRuns->value, 1)

# A layer of a diamond chain: two computeds reading `below`, and one reading both, giving
# `below - 1`. Walking every path instead of every node would visit the base 2^depth times.
fn layer(graph: Graph, runs: Shared<Int>, below: Computed<Int>) -> Computed<Int>:
  const left = counted(graph, runs, fn(): below.read() + 1)
  const right = counted(graph, runs, fn(): below.read() + 2)
  counted(graph, runs, fn(): left.read() - right.read() + below.read())

# Each change evaluates every node once, and a view with no change walks every branch, evaluating
# none.
fn deepDiamonds():
  const graph = new Graph{}
  const base = graph.source(100)
  const runs = new Shared<Int>{value: 0}
  let top = counted(graph, runs, fn(): base.read())
  for _ in 0..60: top = layer(graph, runs, top)
  assertEq(top.read(), 40)
  assertEq(runs->value, 181)
  base.set(200)
  assertEq(top.read(), 140)
  assertEq(runs->value, 362)
  assertEq(top.read(), 140)
  assertEq(runs->value, 362)

fn givesNone():
  const graph = new Graph{}
  const base = graph.source(0)
  const positive = graph.computed(fn(): if base.read() > 0: base.read() else: none)
  assertEq(positive.read(), none)
  base.set(5)
  assertEq(positive.read(), 5)
  base.set(0)
  assertEq(positive.read(), none)

fn flippedCondition():
  const graph = new Graph{}
  const shown = graph.source(true)
  const value = graph.source(1)
  const runs = new Shared<Int>{value: 0}
  const expensive = counted(graph, runs, fn(): value.read() * 10)
  const field = graph.computed(fn(): if shown.read(): expensive.read() else: 0)
  assertEq(field.read(), 10)
  shown.set(false)
  value.set(2)
  assertEq(field.read(), 0)
  assertEq(runs->value, 1)

# Sums every value `base` was set to, reading its own previous sum. Its own read is no change to
# catch up on, since its value already holds the one it read, so a view with no change to `base`
# evaluates it no more.
fn readsItself():
  const graph = new Graph{}
  const base = graph.source(1)
  const runs = new Shared<Int>{value: 0}
  let sum: Computed<Int>? = none
  const running = counted(graph, runs, fn(): {
    const now = base.read()
    if now > 1: (sum ?? panic("unset")).read() + now
    else: now
  })
  sum = running
  assertEq(running.read(), 1)
  base.set(2)
  assertEq(running.read(), 3)
  base.set(5)
  assertEq(running.read(), 8)
  assertEq(running.read(), 8)
  assertEq(runs->value, 3)

fn readsThroughAnother():
  const graph = new Graph{}
  const base = graph.source(1)
  let first: Computed<Int>? = none
  const tens = graph.computed(fn(): (first ?? panic("unset")).read() * 10)
  const sum = graph.computed(fn(): if base.read() > 1: tens.read() + base.read() else: base.read())
  first = sum
  assertEq(sum.read(), 1)
  assertEq(tens.read(), 10)
  base.set(2)
  assertEq(sum.read(), 12)
  assertEq(tens.read(), 120)

ista async fn readsItselfFirst() -> Int:
  const graph = new Graph{}
  let me: Computed<Int>? = none
  const looped = graph.computed(fn(): (me ?? panic("unset")).read() + 1)
  me = looped
  looped.read()

ista async fn readsAnotherGraph() -> Int:
  const first = new Graph{}
  const second = new Graph{}
  const base = second.source(1)
  const copied = first.computed(fn(): base.read())
  copied.read()
