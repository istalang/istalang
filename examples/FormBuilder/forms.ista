# forms.ista — the generic form runtime.
#
# Written once; every form uses it. A form contributes only its generated module (a model, its
# factory and a view; see order.gen.ista). This module does everything else: the loop,
# drawing, validation, routing events, tasks for awaited expressions, and reading the result.

import Inbox from 'inbox'
import Decodable, Encodable from 'json'
import * as json from 'json'
import * as regex from 'regex'
import replaceAll from 'strings'

type Date = String # ISO date
type DateTime = String # RFC 3339
type FileId = String # an upload's id; the bytes travel separately

# Formats an optional or concrete value for message templates (${…}), where Seen values are T?.
fn text<T is Stringable>(v: T?) -> String:
  match v:
    case None: ""
    case x: String(x)

# ═════════════════════════ The model: a form's data, holding its values ═════════════════════════
# Data: what submit returns. Seen: what expressions see, none wherever something is unanswered or
# hidden. Both are computed through the tree, so no form declares its data type.

trait FormNode:
  type Data
  type Seen
  fn seen(self: Self) -> Self.Seen
  fn read(self: Self) -> Result<Self.Data> # Err when something is unanswered
  fn load(self: Self, v: Self.Seen) -> Unit # fills from a value: default and computed rows

# One value. Shared: the model and every view writing it hold the same handle.
shared struct Field<T>:
  value: T? = none
  touched: Bool = false
  parseError: String? = none
  edited: Bool = false # set by the user: stops re-running a default
  type Data = T
  type Seen = T?

fn seen<T>(self: Field<T>) -> T?: self->value
fn read<T>(self: Field<T>) -> Result<T>:
  match self->value:
    case None: Err(Error{message: "unanswered", code: "unanswered"})
    case v: Ok(v)
fn load<T>(self: Field<T>, v: T?) -> Unit: self->value = v

# Fields by name: an object in the data.
struct Group<S is struct { [_] is FormNode }>:
  fields: S
  type Data = match S:
    case _: { [F in keyof S]: S[F].Data }
  type Seen = match S:
    case _: { [F in keyof S]: S[F].Seen }

fn seen<S is struct { [_] is FormNode }>(self: Group<S>) -> Group<S>.Seen: struct{
  for f, node in ...self.fields: [f]: node.seen()
}
fn read<S is struct { [_] is FormNode }>(self: Group<S>) -> Result<Group<S>.Data>: Ok(struct{for f, node in ...self.fields: [f]: node.read()?})
fn load<S is struct { [_] is FormNode }>(self: Group<S>, v: Group<S>.Seen) -> Unit:
  for f, node in ...self.fields: node.load(v[f])

# A repeat. R is the row's node: a Group, a single Field (a multiselect's choice), or a mounted form.
shared struct List<R is FormNode>:
  rows: Array<ListRow<R>> = []
  make: fn() -> R # a new row's nodes
  count: Int = 0
  edited: Bool = false # rows added or removed by the user
  type Data = Array<R.Data>
  type Seen = Array<R.Seen>

struct ListRow<R is FormNode>:
  key: String # from the instance (r1, r2…), or from rowKey
  node: R

fn seen<R is FormNode>(self: List<R>) -> Array<R.Seen>: [for row in self->rows: row.node.seen()]
fn read<R is FormNode>(self: List<R>) -> Result<Array<R.Data>>:
  let out: Array<R.Data> = []
  for row in self->rows: out.push(row.node.read()?)
  Ok(out)
fn load<R is FormNode>(self: List<R>, v: Array<R.Seen>) -> Unit:
  self->rows = []
  for x in v: self.add(none).node.load(x)
fn add<R is FormNode>(self: List<R>, key: String?) -> ListRow<R>:
  self->count += 1
  const row = ListRow{key: key ?? `r${self->count}`, node: self->make()}
  self->rows.push(row)
  row
fn remove<R is FormNode>(self: List<R>, key: String) -> Unit:
  self->rows = self->rows.filter(fn(r): r.key != key)

# Rows from data (a default or computed rows) keyed by rowKey: rows whose key stays keep their
# nodes and so their filled-in values; rows whose key disappears are dropped with their data.
fn sync<R is FormNode>(self: List<R>, v: Array<R.Seen>, key: fn(R.Seen) -> String?) -> Result<Unit>:
  const keys = [for x in v: key(x) ?? ""]
  for i in 0..keys.length():
    if keys.indexOf(keys[i]) != i:
      return Err(Error{message: "Duplicate row keys", code: "duplicate_key"})
  let next: Array<ListRow<R>> = []
  for x in v: {
    const k = key(x) ?? ""
    match self->rows.filter(fn(r): r.key == k).at(0):
      case None: {
        const row = ListRow{key: k, node: self->make()}
        row.node.load(x)
        next.push(row)
      }
      case row: next.push(row)
  }
  self->rows = next
  Ok(())

# A variant: every case's group node, and a tag naming the active case. The tag is a Field, so the
# variant's picker, any other field, or a computed value can write it.
struct Variant<C is struct { [_] is FormNode }>:
  tag: Field<keyof C> # a literal union of the case ids
  cases: C
  type Data = { tag: keyof C, value: { [K in keyof C]: C[K].Data? } }
  type Seen = { tag: (keyof C)?, value: { [K in keyof C]: C[K].Seen? } }

fn seen<C is struct { [_] is FormNode }>(self: Variant<C>) -> Variant<C>.Seen:
  const active = self.tag.seen()
  const activeStr: String? = match active:
    case None: none
    case a: a
  struct{
    tag: active
    value: struct{for k, g in ...self.cases: [k]: if activeStr == k: g.seen() else: none}
  }
fn read<C is struct { [_] is FormNode }>(self: Variant<C>) -> Result<Variant<C>.Data>:
  const active = self.tag.read()?
  const activeStr: String = active
  Ok(struct{
      tag: active
      value: struct{for k, g in ...self.cases: [k]: if activeStr == k: g.read()? else: none}
    })
fn load<C is struct { [_] is FormNode }>(self: Variant<C>, v: Variant<C>.Seen) -> Unit:
  self.tag.load(v.tag)
  for k, g in ...self.cases:
    match v.value[k]:
      case None: ()
      case x: g.load(x)

# A node `when` can hide. Drawing sets `shown` when any view writing it is drawn.
shared struct Hidden<N is FormNode>:
  node: N
  shown: Bool = false
  type Data = N.Data?
  type Seen = N.Seen?

fn seen<N is FormNode>(self: Hidden<N>) -> N.Seen?:
  if self->shown: self->node.seen()
  else: none
fn read<N is FormNode>(self: Hidden<N>) -> Result<N.Data?>:
  if self->shown: Ok(self->node.read()?)
  else: Ok(none)
fn load<N is FormNode>(self: Hidden<N>, v: N.Seen?) -> Unit:
  match v:
    case None: ()
    case x: self->node.load(x)

# A value kept out of the output (store "none"): expressions see it, validation checks it.
shared struct Local<N is FormNode>:
  node: N
  type Data = None
  type Seen = N.Seen

fn seen<N is FormNode>(self: Local<N>) -> N.Seen: self->node.seen()
fn read<N is FormNode>(self: Local<N>) -> Result<None>:
  self->node.read()?
  Ok(none)
fn load<N is FormNode>(self: Local<N>, v: N.Seen) -> Unit: self->node.load(v)

# A mounted dynamic form: data no expression outside it reads. Validated by its own runtime.
shared struct Dynamic:
  form: FormSnapshot? = none
  value: String? = none # JSON
  type Data = String
  type Seen = None

fn seen(self: Dynamic) -> None: none
fn read(self: Dynamic) -> Result<String>:
  match self->value:
    case None: Err(Error{message: "unanswered", code: "unanswered"})
    case v: Ok(v)
fn load(self: Dynamic, v: None) -> Unit: ()

struct FormSnapshot:
  id: String
  version: String
  module: String # a compiled form, loaded by the host

# Lets drawing mark any Hidden as shown, whatever it wraps, and clear it before the next pass.
trait Showable:
  fn show(self: Self)
  fn hide(self: Self)
fn show<N is FormNode>(self: Hidden<N>): self->shown = true
fn hide<N is FormNode>(self: Hidden<N>): self->shown = false

# ═════════════════════════ Props, scopes and tasks ═════════════════════════

# A prop: a literal, a lambda over the scope, or an awaited lambda run as the node's pending says.
enum Prop<Sc, T>:
  Fixed(value: T)
  Computed(eval: fn(Sc) -> T)
  Awaited(pending: Pending, eval: ista async fn(Sc) -> T, task: Task<Sc, T>)

enum Pending:
  Form # the whole form waits: drawn again once it has its value
  Node # its own task: the node shows Loading
  Hidden # its own task: the node stays hidden

ista fn awaited<Sc, T>(pending: Pending, eval: ista async fn(Sc) -> T) -> Prop<Sc, T>: Prop.Awaited(
  pending: pending
  eval: eval
  task: new Task<Sc, T>{}
)

# An awaited expression's run, and its value. It runs again only when the scope it ran with changes,
# so a finished task doesn't restart on the redraw it causes. Sources cache, so a rerun is cheap.
shared struct Task<Sc, T>:
  sc: Sc? = none
  value: T? = none
  done: Bool = false
  running: Future<Unit, "ista">? = none # replacing it releases, and so stops, the old run

# Declaring `dispose` is what makes a task disposable, and so something its run's `WeakRef` can
# refer to: the run doesn't hold the task holding it, which would be a cycle (§7).
ista fn dispose<Sc, T>(self: Task<Sc, T>): ()

# The value now, or none while pending. A Form prop keeps its value for the scope it ran with; for
# a new scope it queues its run, which the loop awaits before drawing again (the form waits).
ista fn peek<Sc, T>(self: Prop<Sc, T>, sc: Sc, out: &Drawing) -> T?:
  match self:
    case Fixed(value): value
    case Computed(eval): eval(sc)
    case Awaited(Pending.Form, eval, task): {
      if task->sc != sc:
        out.waits.push(async fn(): {
          task->value = await eval(sc)
          task->sc = sc
          task->done = true
        })
      task->value
    }
    case Awaited(_, eval, task): {
      if task->sc != sc: {
        task->sc = sc
        task->value = none
        task->done = false
        task->running = _run(WeakRef(task), eval(sc), out.events)
      }
      if not task->done: out.valid = false
      task->value
    }

ista fn evalNow<Sc, T>(self: Prop<Sc, T>, sc: Sc) -> T?:
  match self:
    case Fixed(value): value
    case Computed(eval): eval(sc)
    case Awaited(_, _, task): task->value

ista fn isHiddenPending<Sc, T>(self: Prop<Sc, T>) -> Bool:
  match self:
    case Awaited(Pending.Hidden, ...): true
    case _: false

ista async fn _run<Sc, T>(task: WeakRef<Task<Sc, T>>, call: Future<T, "ista">, events: Inbox<FormEvent>) -> Unit:
  const value = await call
  match task.deref():
    case None: ()
    case held: { held->value = value; held->done = true }
  events.send(FormEvent.Resolved)

# The scope of a form's top level. Inside repeats, variants and mounts, generated code defines
# wider scopes ({ data, ctx, item }) and moves into them through a ScopedView.
struct Scope<D, C>:
  data: D
  ctx: C

# ═════════════════════════ Checks ═════════════════════════

enum Check<Sc, T>:
  Now(test: ista fn(Sc, T?) -> String?) # an error message, or none; on every draw
  Later(test: ista async fn(Sc) -> String?, pending: ista fn(Sc) -> String, task: Task<Sc, String?>)
  # a rule with `pending` (an approval): its own task once the user submits; submit waits

ista fn later<Sc, T>(test: ista async fn(Sc) -> String?, pending: fn(Sc) -> String) -> Check<Sc, T>:
  Check.Later(test: test, pending: pending, task: new Task<Sc, String?>{})

enum Format:
  Email
  Uri
  Uuid

# One helper per constraint. The generator adds answered() to every stored field without a default
# or computed value: everything must be answered. required() is the schema's `required`: non-empty.
ista fn answered<Sc, T>() -> Check<Sc, T>: Check.Now(
  fn(sc, v): if v == none: "Required" else: none
)
ista fn required<Sc>(on: Prop<Sc, Bool>) -> Check<Sc, String>: Check.Now(
  fn(sc, v): if on.evalNow(sc) == true and (v == none or v == ""): "Required" else: none
)
ista fn someItems<Sc, T>(on: Prop<Sc, Bool>) -> Check<Sc, Array<T>>: Check.Now(
  fn(sc, v): {
    match v:
      case None:
        if on.evalNow(sc) == true: "Required"
        else: none
      case items:
        if on.evalNow(sc) == true and items.length() == 0: "Required"
        else: none
  }
)
ista fn minLength<Sc>(n: Prop<Sc, Int>) -> Check<Sc, String>: Check.Now(
  fn(sc, v): {
    match (v, n.evalNow(sc)):
      case (String as s, Int as bound) if s.length() < bound: `Minimum length is ${bound}`
      case _: none
  }
)
ista fn maxLength<Sc>(n: Prop<Sc, Int>) -> Check<Sc, String>: Check.Now(
  fn(sc, v): {
    match (v, n.evalNow(sc)):
      case (String as s, Int as bound) if s.length() > bound: `Maximum length is ${bound}`
      case _: none
  }
)
ista fn pattern<Sc>(p: Prop<Sc, String>) -> Check<Sc, String>: Check.Now(
  fn(sc, v): {
    match (v, p.evalNow(sc)):
      case (String as s, String as pat): {
        match regex.Regex.parse(pat):
          case Ok(re):
            if re.test(s): none
            else: "Invalid format"
          case Err(...): "Invalid format"
      }
      case _: none
  }
)
ista fn format<Sc>(f: Format) -> Check<Sc, String>: Check.Now(
  fn(sc, v): {
    match v:
      case None: none
      case s: {
        const pat = match f:
          case Email: "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
          case Uri: "^[a-zA-Z][a-zA-Z0-9+.-]*://"
          case Uuid: "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        if regex.Regex{pattern: pat}.test(s): none
        else: "Invalid format"
      }
  }
)
ista fn min<Sc, T is Comparable>(n: Prop<Sc, T>) -> Check<Sc, T>: Check.Now(
  fn(sc, v): {
    match v:
      case None: none
      case val: {
        match n.evalNow(sc):
          case None: none
          case bound:
            if val < bound: "Too small"
            else: none
      }
  }
)
ista fn max<Sc, T is Comparable>(n: Prop<Sc, T>) -> Check<Sc, T>: Check.Now(
  fn(sc, v): {
    match v:
      case None: none
      case val: {
        match n.evalNow(sc):
          case None: none
          case bound:
            if val > bound: "Too large"
            else: none
      }
  }
)
ista fn multipleOf<Sc>(n: Prop<Sc, Float>) -> Check<Sc, Float>: Check.Now(
  fn(sc, v): {
    match (v, n.evalNow(sc)):
      case (Float as val, Float as step) if step != 0.0: {
        const q = val / step
        if Float(Int(q)) == q: none
        else: "Invalid step"
      }
      case _: none
  }
)
ista fn accept<Sc>(types: Array<String>) -> Check<Sc, FileId>: Check.Now(fn(sc, v): none)
ista fn maxBytes<Sc>(n: Int) -> Check<Sc, FileId>: Check.Now(fn(sc, v): none)
ista fn minItems<Sc, T>(n: Prop<Sc, Int>) -> Check<Sc, Array<T>>: Check.Now(
  fn(sc, v): {
    match v:
      case None: none
      case items: {
        match n.evalNow(sc):
          case None: none
          case bound:
            if items.length() < bound: `Minimum items is ${bound}`
            else: none
      }
  }
)
ista fn maxItems<Sc, T>(n: Prop<Sc, Int>) -> Check<Sc, Array<T>>: Check.Now(
  fn(sc, v): {
    match v:
      case None: none
      case items: {
        match n.evalNow(sc):
          case None: none
          case bound:
            if items.length() > bound: `Maximum items is ${bound}`
            else: none
      }
  }
)
ista fn rule<Sc, T>(check: fn(Sc) -> Bool, message: fn(Sc) -> String) -> Check<Sc, T>: Check.Now(
  fn(sc, v): if check(sc): none else: message(sc)
)

# A Template in a language: its translation with $0…$n filled in, else the rendered original.
fn t(
  table: Map<String, Map<String, String>>
  lang: String
  original: String
  rendered: String
  args: Array<String>
) -> String:
  match table.get(original)?.get(lang):
    case None: rendered
    case tr: {
      let out = tr
      for i in 0..args.length(): out = out.replaceAll(`$${i}`, args[i])
      out
    }

# ═════════════════════════ The view: a static tree, built once ═════════════════════════

# A view node in scope Sc. It draws zero nodes when hidden, a Loading node while waiting, and
# records in `out` what the loop needs: errors, inputs to route events to, rows to add, and what the
# form waits for. Drawing never awaits: each await of a live run ends a segment, which costs more
# than the drawing.
trait View<Sc>:
  ista fn draw(self: Self, sc: Sc, out: &Drawing) -> Array<Node>

struct Item<Sc, T>:
  value: T
  label: Prop<Sc, String> # a static option
struct Choice<T>:
  value: T
  label: String # an option from rows

enum Options<Sc, T>:
  Items(items: Array<Item<Sc, T>>)
  Rows(from: Prop<Sc, Array<Choice<T>>>, resolve: Prop<Sc, Bool>)
  # The widget provides ctx.search: `from` takes the typed text. `same` tells whether two values
  # are the same choice (a snapshot is a whole row, compared by id).
  Search(
    from: ista async fn(Sc, String) -> Array<Choice<T>>
    resolve: Prop<Sc, Bool>
    same: fn(T, T) -> Bool
  )

enum Recompute:
  RowsEdited
  AnyEdit

# A field, as drawn. One FieldView per writer: two views may hold one Field.
shared struct FieldView<Sc, T>:
  key: String # n2; n6@r1 in a row; address/n2 in a mount
  parent: Prop<Sc, ParentUi>?
  when: Prop<Sc, Bool>? = none
  field: Field<T>? # none: pathless, shows `value` only
  hide: (any Showable)? = none # the Hidden wrapping `field`, if `when` can hide it
  widget: Prop<Sc, FieldWidget>
  label: Prop<Sc, String>
  help: Prop<Sc, String>? = none
  value: Prop<Sc, T>? = none # computed: written on every draw, read-only
  default: Prop<Sc, T>? = none # re-evaluated until the user edits the field
  checks: Array<Check<Sc, T>> = []
  options: Options<Sc, T>? = none
  search: String = "" # the text typed into a search widget
  searchedSc: Sc? = none # the scope and text `found` was fetched for
  searchedText: String = ""
  found: Array<Choice<T>> = []

ista fn _check<Sc, T>(
  checks: Array<Check<Sc, T>>
  sc: Sc
  v: T?
  touched: Bool
  out: &Drawing
) -> (Array<String>, Array<String>):
  let errors: Array<String> = []
  let waiting: Array<String> = []
  for c in checks: {
    match c:
      case Now(test): {
        match test(sc, v):
          case None: ()
          case msg: {
            out.valid = false
            if touched or out.submitted: errors.push(msg)
          }
      }
      case Later(test, pending, task): {
        if out.submitted: {
          if task->sc != sc: {
            task->sc = sc
            task->value = none
            task->done = false
            task->running = _run(WeakRef(task), test(sc), out.events)
          }
          if not task->done: { out.valid = false; waiting.push(pending(sc)) }
          elif task->value is String as msg: { out.valid = false; errors.push(msg) }
        }
      }
  }
  (errors, waiting)

ista fn draw<Sc, T is Encodable & Decodable>(
  self: FieldView<Sc, T>
  sc: Sc
  out: &Drawing
) -> Array<Node>:
  # 1. Visibility. A hidden field draws nothing, and its Hidden stays unshown.
  match self->when:
    case None: ()
    case w: {
      match w.peek(sc, &out):
        case None:
          return if w.isHiddenPending(): [] else: [Node.Loading(key: self->key, label: none)]
        case false: return []
        case true: ()
    }
  out.markShown(self->hide)
  match self->field:
    case None: ()
    case f: out.inputs[self->key] = f
  # 2. Computed and default values.
  match self->value:
    case None: ()
    case p: {
      const v = p.peek(sc, &out)
      if v == none and p.isHiddenPending(): return []
      _ = self->field?.load(v)
    }
  match self->default:
    case None: ()
    case p: {
      match self->field:
        case None: ()
        case f:
          if not f->edited: {
            const v = p.peek(sc, &out)
            if v == none and p.isHiddenPending(): return []
            f.load(v)
          }
    }
  # 3. Options, then checks; then the node. Inputs register for events by key.
  let opts: Array<Option> = []
  let resolveFail = false
  match self->options:
    case None: ()
    case opt: {
      match opt:
        case Items(items): {
          for it in items: {
            const lbl = it.label.peek(sc, &out) ?? ""
            opts.push(Option{value: json.stringify(it.value), label: lbl})
          }
        }
        case Options.Rows(from, resolve): {
          match from.peek(sc, &out):
            case None:
              return if from.isHiddenPending(): [] else: [Node.Loading(key: self->key, label: none)]
            case rows: {
              for ch in rows: opts.push(Option{value: json.stringify(ch.value), label: ch.label})
            }
          if self->field?->value != none: {
            match resolve.peek(sc, &out):
              case false: resolveFail = true
              case _: ()
          }
        }
        case Search(from: from, resolve: resolve, ...): {
          out.searches[self->key] = self
          const text = self->search
          if self->searchedSc != sc or self->searchedText != text:
            out.waits.push(async fn(): {
              self->found = await from(sc, text)
              self->searchedSc = sc
              self->searchedText = text
            })
          for ch in self->found: opts.push(Option{value: json.stringify(ch.value), label: ch.label})
          if self->field?->value != none: {
            match resolve.peek(sc, &out):
              case false: resolveFail = true
              case _: ()
          }
        }
    }
  const widget = self->widget.peek(sc, &out)
  const label = self->label.peek(sc, &out)
  if widget == none or label == none: return [Node.Loading(key: self->key, label: none)]
  const parent: ParentUi? = match self->parent:
    case None: none
    case p: p.peek(sc, &out)
  const help: String? = match self->help:
    case None: none
    case h: h.peek(sc, &out)
  const current = self->field?->value
  const touched = self->field?->touched ?? false
  const checked, _ = _check(self->checks, sc, current, touched, &out)
  let errors = checked
  if self->field?->parseError is String as pe: {
    out.valid = false
    if touched or out.submitted: errors.push(pe)
  }
  if resolveFail: {
    out.valid = false
    if touched or out.submitted: errors.push("Invalid choice")
  }
  const encoded: String? = match current:
    case None: none
    case val: json.stringify(val)
  [
    Node.Field(
      key: self->key
      widget: widget ?? FieldWidget.Raw
      parent: parent
      label: label ?? ""
      help: help
      value: encoded
      options: opts
      errors: errors
      readOnly: self->value != none
    )
  ]

shared struct RepeatView<Sc, R is FormNode>:
  key: String
  parent: Prop<Sc, ParentUi>?
  when: Prop<Sc, Bool>? = none
  list: List<R>
  hide: (any Showable)? = none
  widget: Prop<Sc, RepeatWidget>
  label: Prop<Sc, String>? = none
  checks: Array<Check<Sc, Array<R.Data>>> = []
  canAdd: Bool = true # false: editableCount false, or computed rows
  rows: Prop<Sc, Array<R.Seen>>? = none # a default, or computed rows
  computedRows: Bool = false # rows always follow `rows`, read-only
  rowKey: (fn(R.Seen) -> String?)? = none
  recomputeUntil: Recompute = Recompute.AnyEdit
  item: ista fn(R, String) -> any View<Sc> # a row's view, from its node and key
  views: Map<String, any View<Sc>> = [:] # built once per row, by row key
  seeded: Bool = false

ista fn addRow<Sc, R is FormNode>(self: RepeatView<Sc, R>) -> Unit:
  self->list->edited = true
  _ = self->list.add(none)

ista fn removeRow<Sc, R is FormNode>(self: RepeatView<Sc, R>, key: String) -> Unit:
  self->list->edited = true
  self->list.remove(key)

ista fn draw<Sc, R is FormNode>(
  self: RepeatView<Sc, R>
  sc: Sc
  out: &Drawing
) -> Array<Node>:
  match self->when:
    case None: ()
    case w: {
      match w.peek(sc, &out):
        case None:
          return if w.isHiddenPending(): [] else: [Node.Loading(key: self->key, label: none)]
        case false: return []
        case true: ()
    }
  out.markShown(self->hide)
  match self->rows:
    case None: ()
    case rProp: {
      const isFixed = match rProp:
        case Fixed(...): true
        case _: false
      const keepRunning = not isFixed and self->recomputeUntil == Recompute.RowsEdited
      const shouldLoad = self->computedRows or (not self->list->edited and (not self->seeded or keepRunning))
      if shouldLoad: {
        match rProp.peek(sc, &out):
          case None:
            return if rProp.isHiddenPending(): [] else: [Node.Loading(key: self->key, label: none)]
          case v: {
            self->seeded = true
            match self->rowKey:
              case None: self->list.load(v)
              case kf: {
                match self->list.sync(v, kf):
                  case Ok(...): ()
                  case Err(...): out.valid = false
              }
          }
      }
    }
  let drawnRows: Array<Row> = []
  for row in self->list->rows: {
    const v = match self->views.get(row.key):
      case None: {
        const created = (self->item)(row.node, row.key)
        self->views[row.key] = created
        created
      }
      case existing: existing
    const nodes = v.draw(sc, &out)
    if nodes.at(0) is Node as first: drawnRows.push(Row{key: row.key, node: first})
  }
  const widget = self->widget.peek(sc, &out)
  if widget == none: return [Node.Loading(key: self->key, label: none)]
  const parent: ParentUi? = match self->parent:
    case None: none
    case p: p.peek(sc, &out)
  const label: String? = match self->label:
    case None: none
    case l: l.peek(sc, &out)
  const dataVal: Array<R.Data>? = match self->list.read():
    case Ok(d): d
    case Err(...): none
  const errors, _ = _check(self->checks, sc, dataVal, self->list->edited, &out)
  if self->canAdd: out.lists[self->key] = self
  [
    Node.Repeat(
      key: self->key
      widget: widget ?? RepeatWidget.Table(none)
      parent: parent
      label: label
      rows: drawnRows
      canAdd: self->canAdd
      errors: errors
    )
  ]

# A variant. Each case body is wrapped by the generated code in a ScopedView that adds the
# variable bound to that case's fields.
struct VariantView<Sc, C is struct { [_] is FormNode }>:
  key: String
  parent: Prop<Sc, ParentUi>?
  when: Prop<Sc, Bool>? = none
  variant: Variant<C>
  hide: (any Showable)? = none
  widget: Prop<Sc, VariantWidget>
  label: Prop<Sc, String>? = none
  checks: Array<Check<Sc, Unit>> = []
  default: Prop<Sc, keyof C>? = none # the initial case
  tagValue: Prop<Sc, keyof C>? = none # a computed tag
  cases: { [K in keyof C]: CaseView<Sc> }

struct CaseView<Sc>:
  label: Prop<Sc, String>
  body: any View<Sc>

ista fn draw<Sc, C is struct { [_] is FormNode }>(
  self: VariantView<Sc, C>
  sc: Sc
  out: &Drawing
) -> Array<Node>:
  match self.when:
    case None: ()
    case w: {
      match w.peek(sc, &out):
        case None:
          return if w.isHiddenPending(): [] else: [Node.Loading(key: self.key, label: none)]
        case false: return []
        case true: ()
    }
  out.markShown(self.hide)
  match self.tagValue:
    case None: ()
    case tv: self.variant.tag.load(tv.peek(sc, &out))
  match self.default:
    case None: ()
    case d:
      if not self.variant.tag->edited: self.variant.tag.load(d.peek(sc, &out))
  const active = self.variant.tag.seen()
  const activeStr: String? = match active:
    case None: none
    case a: a
  let caseOpts: Array<Option> = []
  let bodyNode: Node? = none
  for k, c in ...self.cases: {
    const lbl = c.label.peek(sc, &out) ?? ""
    caseOpts.push(Option{value: k, label: lbl})
    if activeStr == k: { const nodes = c.body.draw(sc, &out); bodyNode = nodes.at(0) }
  }
  const widget = self.widget.peek(sc, &out)
  if widget == none: return [Node.Loading(key: self.key, label: none)]
  const parent: ParentUi? = match self.parent:
    case None: none
    case p: p.peek(sc, &out)
  const label: String? = match self.label:
    case None: none
    case l: l.peek(sc, &out)
  const errors, _ = _check(self.checks, sc, (), self.variant.tag->touched, &out)
  out.inputs[self.key] = self.variant
  [
    Node.Variant(
      key: self.key
      widget: widget ?? VariantWidget.Inline
      parent: parent
      label: label
      cases: caseOpts
      active: activeStr
      body: bodyNode
      errors: errors
    )
  ]

struct LayoutView<Sc>:
  key: String
  parent: Prop<Sc, ParentUi>?
  when: Prop<Sc, Bool>? = none
  widget: Prop<Sc, LayoutWidget>
  label: Prop<Sc, String>? = none # control layouts only
  checks: Array<Check<Sc, Unit>> = [] # rules; an `errors` layout shows only these
  children: Array<any View<Sc>> = []

ista fn draw<Sc>(self: LayoutView<Sc>, sc: Sc, out: &Drawing) -> Array<Node>:
  match self.when:
    case None: ()
    case w: {
      match w.peek(sc, &out):
        case None:
          return if w.isHiddenPending(): [] else: [Node.Loading(key: self.key, label: none)]
        case false: return []
        case true: ()
    }
  const widget = self.widget.peek(sc, &out)
  if widget == none: return [Node.Loading(key: self.key, label: none)]
  const parent: ParentUi? = match self.parent:
    case None: none
    case p: p.peek(sc, &out)
  const label: String? = match self.label:
    case None: none
    case l: l.peek(sc, &out)
  let children: Array<Node> = []
  for ch in self.children: {
    const nodes = ch.draw(sc, &out)
    for n in nodes: children.push(n)
  }
  const errors, waiting = _check(self.checks, sc, (), out.submitted, &out)
  [
    Node.Layout(
      key: self.key
      widget: widget ?? LayoutWidget.Divider
      parent: parent
      label: label
      errors: errors
      waiting: waiting
      children: children
    )
  ]

# Moves drawing into a wider or different scope: a repeat row ({ data, ctx, item }), a variant
# case ({ data, ctx, pay }), or a mounted form (its own data, and its params as ctx).
struct ScopedView<Sc, Sc2>:
  key: String? = none
  parent: Prop<Sc, ParentUi>? = none
  when: Prop<Sc, Bool>? = none
  hide: (any Showable)? = none
  label: Prop<Sc, String>? = none
  scope: ista fn(Sc) -> Sc2
  view: any View<Sc2>

ista fn draw<Sc, Sc2>(self: ScopedView<Sc, Sc2>, sc: Sc, out: &Drawing) -> Array<Node>:
  match self.when:
    case None: ()
    case w: {
      match w.peek(sc, &out):
        case None:
          return if w.isHiddenPending(): [] else: [Node.Loading(key: self.key ?? "", label: none)]
        case false: return []
        case true: ()
    }
  out.markShown(self.hide)
  const sc2 = (self.scope)(sc)
  self.view.draw(sc2, &out)

# A mounted form chosen at run time. The host loads its compiled module; its data stays opaque.
shared struct DynamicView<Sc>:
  key: String
  parent: Prop<Sc, ParentUi>?
  when: Prop<Sc, Bool>? = none
  value: Dynamic
  hide: (any Showable)? = none
  label: Prop<Sc, String>? = none
  schema: Prop<Sc, FormSnapshot?>

ista fn draw<Sc>(self: DynamicView<Sc>, sc: Sc, out: &Drawing) -> Array<Node>:
  match self->when:
    case None: ()
    case w: {
      match w.peek(sc, &out):
        case None:
          return if w.isHiddenPending(): [] else: [Node.Loading(key: self->key, label: none)]
        case false: return []
        case true: ()
    }
  out.markShown(self->hide)
  const parent: ParentUi? = match self->parent:
    case None: none
    case p: p.peek(sc, &out)
  const label: String? = match self->label:
    case None: none
    case l: l.peek(sc, &out)
  const form = self->schema.peek(sc, &out)
  match form:
    case None: []
    case snap: { self->value->form = snap; [Node.Mount(key: self->key, parent: parent, label: label, form: snap)] }

# ═════════════════════════ Widgets (generated from the widget registry) ═════════════════════════
# One enum per node kind, one variant per widget, its ui props as fields.

enum LabelStyle:
  Top
  Start
  Hidden

enum Orientation:
  Horizontal
  Vertical

enum Gap:
  Sm
  Md
  Lg

enum FieldWidget:
  Input(placeholder: String?)
  Textarea(rows: Int?)
  Select(placeholder: String?)
  Autocomplete(placeholder: String?) # provides ctx.search
  Radio(orientation: Orientation?)
  Segmented
  Checkbox # draws its own label
  Toggle # draws its own label
  Datepicker
  Upload(dropzone: Bool?)
  Choice # drawn by its repeat
  Raw # drawn by its repeat or control layout

enum RepeatWidget:
  Multiselect(placeholder: String?)
  Checkboxes(orientation: Orientation?)
  List(addLabel: String?, reorderable: Bool?)
  Table(addLabel: String?)
  Cards(addLabel: String?, title: String?)

enum VariantWidget:
  Inline # a case picker that writes the tag, and the case
  Panel(title: String?) # the active case only

enum LayoutWidget:
  Section(title: String?, description: String?, collapsible: Bool?, labels: LabelStyle?)
  Labeled(labels: LabelStyle?)
  Money # a control: amount and currency as one input
  Hstack(gap: Gap?, labels: LabelStyle?)
  Wizard
  Step(title: String, labels: LabelStyle?)
  Tablerow
  Markdown(markdown: String)
  Errors
  Divider

# What a parent widget reads about a child (its ui.parent), by parent widget.
enum ParentUi:
  Section(span: Int?)
  Hstack(grow: Float?)
  Tablerow(width: Int?)

# ═════════════════════════ The tree the frontend draws ═════════════════════════

struct Option:
  value: String
  label: String # value JSON-encoded

enum Node:
  Layout(
    key: String
    widget: LayoutWidget
    parent: ParentUi?
    label: String?
    errors: Array<String>
    waiting: Array<String>
    children: Array<Node>
  )
  Field(
    key: String
    widget: FieldWidget
    parent: ParentUi?
    label: String
    help: String?
    value: String?
    options: Array<Option>
    errors: Array<String>
    readOnly: Bool
  )
  Repeat(
    key: String
    widget: RepeatWidget
    parent: ParentUi?
    label: String?
    rows: Array<Row>
    canAdd: Bool
    errors: Array<String>
  )
  Variant(
    key: String
    widget: VariantWidget
    parent: ParentUi?
    label: String?
    cases: Array<Option>
    active: String?
    body: Node?
    errors: Array<String>
  )
  Mount(key: String, parent: ParentUi?, label: String?, form: FormSnapshot) # a dynamic ref
  Loading(key: String, label: String?)

struct Row:
  key: String
  node: Node

# ═════════════════════════ Events and the loop ═════════════════════════

enum FormEvent:
  Set(key: String, value: String) # value JSON; a key names its row: n6@r1
  Search(key: String, text: String) # typed into a search widget
  AddRow(key: String)
  RemoveRow(key: String, row: String)
  Submit
  Resolved # a task finished: draw again

# Anything an event can be routed to, whatever its type.
trait Settable:
  fn setJson(self: Self, value: String)

fn setJson<T is Decodable>(self: Field<T>, value: String):
  self->touched = true
  self->edited = true
  match json.parse<T>(value):
    case Ok(v): { self->value = v; self->parseError = none }
    case Err(error): self->parseError = error.message

fn setJson<C is struct { [_] is FormNode }>(self: Variant<C>, value: String):
  self.tag->touched = true
  self.tag->edited = true
  for k, _ in ...self.cases:
    if value == `"${k}"` or value == k: { self.tag->value = k; self.tag->parseError = none; return }
  self.tag->parseError = "Invalid option"

trait Searchable:
  ista fn setSearch(self: Self, text: String)

ista fn setSearch<Sc, T>(self: FieldView<Sc, T>, text: String): self->search = text

trait Rows:
  ista fn addRow(self: Self)
  ista fn removeRow(self: Self, key: String)

struct User: # the person filling in the form; from the platform
  id: String
  name: String
  lang: String
  role: String
  today: Date # in the person's time zone

# What one drawing pass collects.
struct Drawing:
  events: Inbox<FormEvent>
  submitted: Bool
  inputs: Map<String, any Settable> = [:]
  searches: Map<String, any Searchable> = [:]
  lists: Map<String, any Rows> = [:]
  valid: Bool = true # no errors, nothing pending
  shown: Array<any Showable> = [] # Hiddens drawn this pass
  waits: Array<ista async fn() -> Unit> = [] # runs the form waits for before drawing again

ista fn markShown(self: &Drawing, h: (any Showable)?):
  match h:
    case None: ()
    case s: { s.show(); self.shown.push(s) }

# Runs a form until a valid submit, and returns its data, typed Group<M>.Data.
ista async fn run<M is struct { [_] is FormNode }, C>(
  model: Group<M>
  view: any View<Scope<Group<M>.Seen, C>>
  ctx: C
  translations: Map<String, Map<String, String>>
  events: Inbox<FormEvent>
  views: Inbox<Node>
) -> Group<M>.Data:
  let submitted = false
  let shown: Array<any Showable> = []
  while true: {
    # Draw until visibility settles and nothing is waited for: a `when` may depend on another node's
    # visibility, and what a drawing queued in `waits` is awaited before drawing again.
    let out = Drawing{events, submitted}
    let tree: Array<Node> = []
    let before = model.seen()
    for _ in 0..8: { # five redraws for `when` chains, and rounds of waits
      for h in shown: h.hide()
      out = Drawing{events, submitted}
      tree = view.draw(Scope{data: before, ctx}, &out)
      shown = out.shown
      for w in out.waits: await w()
      const after = model.seen()
      if out.waits.length() == 0 and after == before: break
      before = after
    }
    if submitted and out.valid:
      match model.read():
        case Ok(d): return d
        case Err(...): ()
    views.send(tree[0])
    match await events.receive():
      case Submit: submitted = true
      case Resolved: ()
      case Set(key, value): _ = out.inputs.get(key)?.setJson(value)
      case Search(key: key, text: text, ...): _ = out.searches.get(key)?.setSearch(text)
      case AddRow(key): _ = out.lists.get(key)?.addRow()
      case RemoveRow(key, row): _ = out.lists.get(key)?.removeRow(row)
  }
  panic("unreachable")
