fn supplierView(m: SupplierModel) -> any View<SupplierScope>: LayoutView<SupplierScope>{
  key: "n1",
  parent: none,
  widget: Prop.Fixed{LayoutWidget.Wizard},
  children: [
    LayoutView<SupplierScope>{
      key: "n2",
      parent: none,
      widget: Prop.Computed{
        eval: fn(sc: SupplierScope): {
          const struct{data, ctx} = sc
          LayoutWidget.Step{
            title: forms.t(translations, ctx.user.lang, "Company", "Company", []),
            labels: LabelStyle.Start,
          }
        },
      },
      children: [
        LayoutView<SupplierScope>{
          key: "n3",
          parent: none,
          widget: Prop.Computed{
            eval: fn(sc: SupplierScope): {
              const struct{data, ctx} = sc
              LayoutWidget.Markdown{
                markdown: (`Welcome, **${ctx.user.name}**. Tier: ${ctx.params.tier}.`),
              }
            },
          },
          children: [],
        },
        LayoutView<SupplierScope>{
          key: "n4",
          parent: none,
          widget: Prop.Computed{
            eval: fn(sc: SupplierScope): {
              const struct{data, ctx} = sc
              LayoutWidget.Section{
                title: forms.t(translations, ctx.user.lang, "Company", "Company", []),
                description: "Legal details",
                collapsible: false,
                labels: none,
              }
            },
          },
          children: [
            LayoutView<SupplierScope>{
              key: "n5",
              parent: none,
              widget: Prop.Fixed{LayoutWidget.Hstack{gap: Gap.Md, labels: none}},
              children: [
                new FieldView<SupplierScope, String>{
                  key: "n6",
                  parent: Prop.Fixed{ParentUi.Hstack{grow: 2.0}},
                  field: m.company.fields.name,
                  widget: Prop.Fixed{FieldWidget.Input{placeholder: "ACME Ltd."}},
                  label: Prop.Fixed{"Name"},
                  help: Prop.Fixed{"As registered"},
                  checks: [
                    forms.answered(),
                    forms.required(Fixed{true}),
                    forms.minLength(Fixed{2}),
                    forms.maxLength(Fixed{100}),
                  ],
                },
                new FieldView<SupplierScope, String>{
                  key: "n7",
                  parent: Prop.Fixed{ParentUi.Hstack{grow: 1.0}},
                  field: m.company.fields.vatId,
                  widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
                  label: Prop.Fixed{"VAT ID"},
                  checks: [forms.answered(), forms.pattern(Fixed{"^[A-Z]{2}[0-9]{6,12}$"})],
                },
              ],
            },
            new FieldView<SupplierScope, String>{
              key: "n8",
              parent: none,
              field: m.company.fields.email,
              widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
              label: Prop.Fixed{"Email"},
              checks: [forms.answered(), forms.format(Format.Email)],
            },
            new FieldView<SupplierScope, String>{
              key: "n9",
              parent: none,
              field: m.confirmEmail->node,
              widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
              label: Prop.Fixed{"Confirm email"},
              checks: [
                forms.answered(),
                forms.rule(
                  fn(sc: SupplierScope): {
                    const struct{data, ctx} = sc
                    data.confirmEmail == data.company.email
                  },
                  fn(sc: SupplierScope): { const struct{data, ctx} = sc; `The emails differ` },
                ),
              ],
            },
            new FieldView<SupplierScope, String>{
              key: "n10",
              parent: none,
              field: m.company.fields.description,
              widget: Prop.Computed{
                eval: fn(sc: SupplierScope): {
                  const struct{data, ctx} = sc
                  FieldWidget.Textarea{rows: (if ctx.params.tier == "gold": 8 else: 4)}
                },
              },
              label: Prop.Fixed{"Description"},
              default: Prop.Fixed{""},
              checks: [forms.maxLength(Fixed{2000})],
            },
            new FieldView<SupplierScope, "small" | "medium" | "large">{
              key: "n11",
              parent: none,
              field: m.company.fields.size,
              widget: Prop.Fixed{FieldWidget.Select{placeholder: none}},
              label: Prop.Fixed{"Size"},
              default: Prop.Fixed{"small"},
              checks: [],
              options: Options.Items{
                items: [
                  Item{value: "small", label: Prop.Fixed{"Small"}},
                  Item{value: "medium", label: Prop.Fixed{"Medium"}},
                  Item{
                    value: "large",
                    label: Prop.Computed{
                      eval: fn(sc: SupplierScope): {
                        const struct{data, ctx} = sc
                        if ctx.params.tier == "gold": "Large (priority)"
                        else: "Large"
                      },
                    },
                  },
                ],
              },
            },
            new FieldView<SupplierScope, "llc" | "plc" | "sole">{
              key: "n12",
              parent: none,
              field: m.company.fields.legalForm,
              widget: Prop.Fixed{FieldWidget.Radio{orientation: Orientation.Horizontal}},
              label: Prop.Fixed{"Legal form"},
              checks: [forms.answered()],
              options: Options.Items{
                items: [
                  Item{value: "llc", label: Prop.Fixed{"LLC"}},
                  Item{value: "plc", label: Prop.Fixed{"PLC"}},
                  Item{value: "sole", label: Prop.Fixed{"Sole trader"}},
                ],
              },
            },
            new FieldView<SupplierScope, Float>{
              key: "n13",
              parent: none,
              when: Prop.Computed{
                eval: fn(sc: SupplierScope): {
                  const struct{data, ctx} = sc
                  data.company.legalForm != "sole"
                },
              },
              field: m.company.fields.capital->node,
              hide: m.company.fields.capital,
              widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
              label: Prop.Fixed{"Share capital"},
              checks: [forms.answered(), forms.min(Fixed{0.0}), forms.multipleOf(Fixed{1000.0})],
            },
            new FieldView<SupplierScope, Int>{
              key: "n14",
              parent: none,
              field: m.company.fields.employees,
              widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
              label: Prop.Fixed{"Employees"},
              checks: [
                forms.answered(),
                forms.min(Fixed{1}),
                forms.max(
                  Prop.Computed{
                    eval: fn(sc: SupplierScope): {
                      const struct{data, ctx} = sc
                      if data.company.size == "small": 50
                      elif data.company.size == "medium": 250
                      else: 100000
                    },
                  },
                ),
                forms.rule(
                  fn(sc: SupplierScope): {
                    const struct{data, ctx} = sc
                    data.company.size != "small" or (data.company.employees ?? 0) <= 50
                  },
                  fn(sc: SupplierScope): {
                    const struct{data, ctx} = sc
                    forms.t(
                      translations,
                      ctx.user.lang,
                      "Only ${data.company.employees} employees allowed for a ${data.company.size} company",
                      `Only ${forms.text(data.company.employees)} employees allowed for a ${forms.text(data.company.size)} company`,
                      [forms.text(data.company.employees), forms.text(data.company.size)],
                    )
                  },
                ),
              ],
            },
            new FieldView<SupplierScope, forms.Date>{
              key: "n15",
              parent: none,
              field: m.company.fields.founded,
              widget: Prop.Fixed{FieldWidget.Datepicker},
              label: Prop.Fixed{"Founded"},
              checks: [
                forms.answered(),
                forms.min(Fixed{"1800-01-01"}),
                forms.max(
                  Prop.Computed{
                    eval: fn(sc: SupplierScope): { const struct{data, ctx} = sc; ctx.user.today },
                  },
                ),
              ],
            },
            new FieldView<SupplierScope, forms.FileId>{
              key: "n16",
              parent: none,
              field: m.company.fields.logo,
              widget: Prop.Fixed{FieldWidget.Upload{dropzone: true}},
              label: Prop.Fixed{"Logo"},
              checks: [
                forms.answered(),
                forms.accept(["image/png", "image/svg+xml"]),
                forms.maxBytes(1048576),
              ],
            },
            new FieldView<SupplierScope, String>{
              key: "n17",
              parent: none,
              field: m.company.fields.country,
              widget: Prop.Fixed{FieldWidget.Select{placeholder: none}},
              label: Prop.Fixed{"Country"},
              checks: [forms.answered()],
              options: Options.Rows{
                from: forms.awaited(Pending.Form, async fn(sc: SupplierScope): {
                  const struct{data, ctx} = sc
                  [
                    for row in await geo.countries(ctx.params.region): Choice{
                      value: (row.id),
                      label: (row.name),
                    }
                  ]
                }),
                resolve: forms.awaited(Pending.Form, async fn(sc: SupplierScope): {
                  const struct{data, ctx} = sc
                  (await geo.countries(ctx.params.region)).some(fn(c): c.id == data.company.country)
                }),
              },
            },
            ScopedView<SupplierScope, AddressScope>{
              key: "n18",
              parent: none,
              when: Prop.Computed{
                eval: fn(sc: SupplierScope): {
                  const struct{data, ctx} = sc
                  data.company.country != none
                },
              },
              hide: m.company.fields.address,
              label: Prop.Fixed{"Address"},
              scope: fn(sc: SupplierScope): {
                const struct{data, ctx} = sc
                Scope{
                  data: m.company.fields.address->node.seen(),
                  ctx: AddressCtx{
                    params: AddressParams{country: (data.company.country ?? "")},
                    user: ctx.user,
                  },
                }
              },
              view: addressView(m.company.fields.address->node.fields, "n18"),
            },
            new FieldView<SupplierScope, String>{
              key: "n19",
              parent: none,
              when: Prop.Computed{
                eval: fn(sc: SupplierScope): {
                  const struct{data, ctx} = sc
                  data.company.country != none
                },
              },
              field: m.company.fields.city->node,
              hide: m.company.fields.city,
              widget: Prop.Fixed{FieldWidget.Select{placeholder: none}},
              label: Prop.Fixed{"Main city"},
              checks: [forms.answered()],
              options: Options.Rows{
                from: forms.awaited(Pending.Node, async fn(sc: SupplierScope): {
                  const struct{data, ctx} = sc
                  [
                    for row in await geo.cities(data.company.country ?? ""): Choice{
                      value: (row.id),
                      label: (row.name),
                    }
                  ]
                }),
                resolve: forms.awaited(Pending.Node, async fn(sc: SupplierScope): {
                  const struct{data, ctx} = sc
                  (await geo.cities(data.company.country ?? "")).some(
                    fn(c): c.id == data.company.city,
                  )
                }),
              },
            },
          ],
        },
        new FieldView<SupplierScope, crm.User>{
          key: "n20",
          parent: none,
          field: m.manager,
          widget: Prop.Fixed{FieldWidget.Autocomplete{placeholder: "Type a name"}},
          label: Prop.Fixed{"Account manager"},
          checks: [forms.answered()],
          options: Options.Search{
            from: async fn(sc, search): {
              const ctx = struct{search, for k, v in ...sc.ctx: [k]: v}
              const data = sc.data
              [for row in await crm.users(ctx.search): Choice{value: row, label: (row.name)}]
            },
            resolve: forms.awaited(Pending.Form, async fn(sc: SupplierScope): {
              const struct{data, ctx} = sc
              (await crm.user(data.manager?.id ?? "")) != none
            }),
            same: fn(a, b): a.id == b.id,
          },
        },
        new FieldView<SupplierScope, Int>{
          key: "n21",
          parent: none,
          field: m.creditLimit->node,
          hide: m.creditLimit,
          widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
          label: Prop.Fixed{"Credit limit"},
          default: forms.awaited(Pending.Hidden, async fn(sc: SupplierScope): {
            const struct{data, ctx} = sc
            (await crm.creditLimit(data.company.vatId ?? "")) ?? 0
          }),
          checks: [],
        },
      ],
    },
    LayoutView<SupplierScope>{
      key: "n22",
      parent: none,
      widget: Prop.Fixed{LayoutWidget.Step{title: "Catalog", labels: none}},
      children: [
