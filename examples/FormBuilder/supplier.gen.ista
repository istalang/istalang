fn supplierModel(graph: Graph) -> Group<SupplierModel>: Group{
  fields: SupplierModel{
    company: Group{
      fields: struct{
        name: Field.make<String>(graph)
        vatId: Field.make<String>(graph)
        email: Field.make<String>(graph)
        description: Field.make<String>(graph)
        size: Field.make<"small" | "medium" | "large">(graph)
        legalForm: Field.make<"llc" | "plc" | "sole">(graph)
        capital: Hidden.make(graph, Field.make<Float>(graph))
        employees: Field.make<Int>(graph)
        founded: Field.make<Date>(graph)
        logo: Field.make<FileId>(graph)
        country: Field.make<String>(graph)
        address: Hidden.make(graph, addressModel(graph))
        city: Hidden.make(graph, Field.make<String>(graph))
      }
    }
    confirmEmail: Local{node: Field.make<String>(graph)}
    manager: Field.make<crm.User>(graph)
    creditLimit: Field.make<Int>(graph)
    prices: List.make(
      graph
      fn(x): Group{
        fields: struct{
          sku: Field.make<String>(graph, x?.sku)
          name: Field.make<String>(graph, x?.name)
          amount: Field.make<Float>(graph, x?.amount)
          regions: List.make(graph, fn(x): Field.make<String>(graph, x), x?.regions ?? [])
        }
      }
    )
    contacts: List.make(
      graph
      fn(x): Group{
        fields: struct{
          name: Field.make<String>(graph, x?.name)
          email: Field.make<String>(graph, x?.email)
          primary: Field.make<Bool>(graph, x?.primary)
          card: contactCard.model(graph, x?.card)
        }
      }
    )
    certifications: List.make(graph, fn(x): Field.make<"iso9001" | "iso14001">(graph, x))
    categories: List.make(graph, fn(x): categoryModel(graph))
    history: List.make(
      graph
      fn(x): Group{fields: struct{note: Field.make<String>(graph, x?.note)}}
    )
    payment: Variant{
      tag: Field.make<"card" | "wire" | "invoice">(graph)
      cases: struct{
        card: Group{
          fields: struct{holder: Field.make<String>(graph), last4: Field.make<String>(graph)}
        }
        wire: Group{
          fields: struct{
            deposit: Group{
              fields: struct{
                amount: Field.make<Float>(graph)
                currency: Field.make<"EUR" | "USD">(graph)
              }
            }
          }
        }
        invoice: Group{fields: struct{terms: Field.make<Int>(graph)}}
      }
    }
    delivery: Variant{
      tag: Field.make<"standard" | "express">(graph)
      cases: struct{
        standard: Group{fields: struct{window: Field.make<"am" | "pm">(graph)}}
        express: Group{fields: struct{at: Field.make<DateTime>(graph)}}
      }
    }
    extraForm: Field.make<formsCatalog.Entry>(graph)
    extra: Hidden.make(graph, Dynamic.make(graph))
    score: Field.make<Int>(graph)
    notes: Field.make<String>(graph)
    agree: Field.make<Bool>(graph)
  }
}

