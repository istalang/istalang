  children: List<CategoryChildrenRow>

type CategoryChildrenRow = Group<CategoryModel>

fn categoryView(at: Place, m: CategoryModel, ctx: CategoryCtx, k: String) -> View:
  const data = Group{fields: m}.scope()
  LayoutView{
    key: `${k}/n1`
    widget: fn(): LayoutWidget.Section(
      title: none
