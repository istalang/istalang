        widget: Prop.Computed(
          fn({data, ctx}): LayoutWidget.Step(
            title: forms.t(translations, ctx.user.lang, "Company", "Company", [])
            labels: LabelStyle.Start
          )
        )
        children: [
          LayoutView{
            key: "n3"
            parent: none
            widget: Prop.Computed(
              fn({data, ctx}): LayoutWidget.Markdown(
                (`Welcome, **${ctx.user.name}**. Tier: ${ctx.params.tier}.`)
              )
            )
            children: []
          }
          LayoutView{
            key: "n4"
            parent: none
            widget: Prop.Computed(
              fn({data, ctx}): LayoutWidget.Section(
                title: forms.t(translations, ctx.user.lang, "Company", "Company", [])
                description: "Legal details"
                collapsible: false
                labels: none
              )
            )
            children: [
              LayoutView{
                key: "n5"
                parent: none
                widget: Prop.Fixed(LayoutWidget.Hstack(gap: Gap.Md, labels: none))
                children: [
                  new FieldView{
                    key: "n6"
                    parent: Prop.Fixed(ParentUi.Hstack(2.0))
                    field: m.company.fields.name
                    widget: Prop.Fixed(FieldWidget.Input("ACME Ltd."))
                    label: Prop.Fixed("Name")
                    help: Prop.Fixed("As registered")
                    checks: [
                      forms.answered()
                      forms.required(Fixed(true))
                      forms.minLength(Fixed(2))
                      forms.maxLength(Fixed(100))
                    ]
                  }
                  new FieldView{
                    key: "n7"
                    parent: Prop.Fixed(ParentUi.Hstack(1.0))
                    field: m.company.fields.vatId
                    widget: Prop.Fixed(FieldWidget.Input(none))
                    label: Prop.Fixed("VAT ID")
                    checks: [forms.answered(), forms.pattern(Fixed("^[A-Z]{2}[0-9]{6,12}$"))]
                  }
                ]
              }
              new FieldView{
                key: "n8"
                parent: none
                field: m.company.fields.email
                widget: Prop.Fixed(FieldWidget.Input(none))
                label: Prop.Fixed("Email")
                checks: [forms.answered(), forms.format(Format.Email)]
              }
              new FieldView{
                key: "n9"
                parent: none
                field: m.confirmEmail->node
                widget: Prop.Fixed(FieldWidget.Input(none))
                label: Prop.Fixed("Confirm email")
                checks: [
                  forms.answered()
                  forms.rule(
                    fn({data, ctx}): data.confirmEmail == data.company.email
                    fn({data, ctx}): `The emails differ`
                  )
                ]
              }
              new FieldView{
                key: "n10"
                parent: none
                field: m.company.fields.description
                widget: Prop.Computed(
                  fn({data, ctx}): FieldWidget.Textarea((if ctx.params.tier == "gold": 8 else: 4))
                )
                label: Prop.Fixed("Description")
                default: Prop.Fixed("")
                checks: [forms.maxLength(Fixed(2000))]
              }
              new FieldView{
                key: "n11"
                parent: none
                field: m.company.fields.size
                widget: Prop.Fixed(FieldWidget.Select(none))
                label: Prop.Fixed("Size")
                default: Prop.Fixed("small")
                checks: []
                options: Options.Items([
                  Item{value: "small", label: Prop.Fixed("Small")}
                  Item{value: "medium", label: Prop.Fixed("Medium")}
                  Item{
                    value: "large"
                    label: Prop.Computed(
                      fn({data, ctx}): if ctx.params.tier == "gold": "Large (priority)"
                      else: "Large"
                    )
                  }
                ])
              }
              new FieldView{
                key: "n12"
                parent: none
                field: m.company.fields.legalForm
                widget: Prop.Fixed(FieldWidget.Radio(Orientation.Horizontal))
                label: Prop.Fixed("Legal form")
                checks: [forms.answered()]
