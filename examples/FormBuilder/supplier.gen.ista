      collapsible: none
      labels: none
    )
    children: [
      fn(at): FieldView{
        key: `${k}/n2`
        field: m.name
        widget: fn(): FieldWidget.Input(none)
        label: fn(): "Category"
        checks: [checks.answered()]
      }.build(at)
      fn(at): RepeatView{
        key: `${k}/n3`
        list: m.children
        widget: fn(): RepeatWidget.List(addLabel: "Add subcategory", reorderable: none)
        label: fn(): "Subcategories"
        canAdd: true
        item: fn(r1, row1, at): categoryView(
          at
          r1.fields
          CategoryCtx{user: ctx.user, paramsFrom: fn(): CategoryParams}
          `${k}/n4@${row1}`
        )
      }.build(at)
    ]
  }.build(at)

# ═══════════ form "supplier" ═══════════

struct SupplierParams:
  region: String
  tier: "basic" | "gold"
  products: Array<{ sku: String, name: String }>
  owner: crm.User

struct SupplierCtx:
  params: SupplierParams
  user: User

struct SupplierModel:
  company: Group<{
    name: Field<String>
    vatId: Field<String>
    email: Field<String>
    description: Field<String>
    size: Field<"small" | "medium" | "large">
    legalForm: Field<"llc" | "plc" | "sole">
    capital: Hidden<Field<Float>>
    employees: Field<Int>
    founded: Field<Date>
    logo: Field<FileId>
    country: Field<String>
    address: Hidden<Group<AddressModel>>
    city: Hidden<Field<String>>
  }>
  confirmEmail: Local<Field<String>>
  manager: Field<crm.User>
  creditLimit: Field<Int>
  prices: List<SupplierPricesRow>
  contacts: List<SupplierContactsRow>
  certifications: List<SupplierCertificationsRow>
  categories: List<SupplierCategoriesRow>
  history: List<SupplierHistoryRow>
  payment: Variant<SupplierPaymentCases>
  delivery: Variant<SupplierDeliveryCases>
  extraForm: Field<formsCatalog.Entry>
  extra: Hidden<Dynamic>
  score: Field<Int>
  notes: Field<String>
  agree: Field<Bool>

type SupplierPricesRegionsRow = Field<String>
type SupplierPricesRow = Group<{
  sku: Field<String>
  name: Field<String>
  amount: Field<Float>
  regions: List<SupplierPricesRegionsRow>
}>
type SupplierContactsRow = Group<{
  name: Field<String>
  email: Field<String>
  primary: Field<Bool>
  card: Group<contactCard.Model>
}>
type SupplierCertificationsRow = Field<"iso9001" | "iso14001">
type SupplierCategoriesRow = Group<CategoryModel>
type SupplierHistoryRow = Group<{ note: Field<String> }>
type SupplierPaymentCases = {
  card: Group<{ holder: Field<String>, last4: Field<String> }>
  wire: Group<{ deposit: Group<{ amount: Field<Float>, currency: Field<"EUR" | "USD"> }> }>
  invoice: Group<{ terms: Field<Int> }>
}
type SupplierDeliveryCases = {
  standard: Group<{ window: Field<"am" | "pm"> }>
  express: Group<{ at: Field<DateTime> }>
}

fn supplierView(at: Place, m: SupplierModel, ctx: SupplierCtx) -> View:
  const data = Group{fields: m}.scope()
  LayoutView{
    key: "n1"
    widget: fn(): LayoutWidget.Wizard
    children: [
      fn(at): LayoutView{
        key: "n2"
        widget: fn(): LayoutWidget.Step(
          title: checks.t(translations, ctx.user.lang, "Company", "Company", [])
          labels: LabelStyle.Start
        )
        children: [
          fn(at): LayoutView{
            key: "n3"
            widget: fn(): LayoutWidget.Markdown(
              (`Welcome, **${ctx.user.name}**. Tier: ${ctx.params.tier}.`)
            )
          }.build(at)
          fn(at): LayoutView{
            key: "n4"
            widget: fn(): LayoutWidget.Section(
              title: checks.t(translations, ctx.user.lang, "Company", "Company", [])
              description: "Legal details"
              collapsible: false
              labels: none
            )
            children: [
              fn(at): LayoutView{
                key: "n5"
                widget: fn(): LayoutWidget.Hstack(gap: Gap.Md, labels: none)
                children: [
                  fn(at): FieldView{
                    key: "n6"
                    parent: fn(): ParentUi.Hstack(2.0)
                    field: m.company.fields.name
                    widget: fn(): FieldWidget.Input("ACME Ltd.")
                    label: fn(): "Name"
                    help: fn(): "As registered"
                    checks: [
                      checks.required(fn(): true)
                      checks.minLength(fn(): 2)
                      checks.maxLength(fn(): 100)
                    ]
                  }.build(at)
                  fn(at): FieldView{
                    key: "n7"
                    parent: fn(): ParentUi.Hstack(1.0)
                    field: m.company.fields.vatId
                    widget: fn(): FieldWidget.Input(none)
                    label: fn(): "VAT ID"
                    checks: [checks.answered(), checks.pattern(fn(): "^[A-Z]{2}[0-9]{6,12}$")]
                  }.build(at)
                ]
              }.build(at)
              fn(at): FieldView{
                key: "n8"
                field: m.company.fields.email
                widget: fn(): FieldWidget.Input(none)
                label: fn(): "Email"
                checks: [checks.answered(), checks.format(checks.Format.Email)]
              }.build(at)
              fn(at): FieldView{
                key: "n9"
                field: m.confirmEmail.node
                widget: fn(): FieldWidget.Input(none)
                label: fn(): "Confirm email"
                checks: [
                  checks.answered()
                  checks.rule(
                    fn(): data.confirmEmail == data.company.email
                    fn(): `The emails differ`
                  )
                ]
              }.build(at)
              fn(at): FieldView{
                key: "n10"
                field: m.company.fields.description
                widget: fn(): FieldWidget.Textarea((if ctx.params.tier == "gold": 8 else: 4))
                label: fn(): "Description"
                default: fn(): ""
                checks: [checks.maxLength(fn(): 2000)]
              }.build(at)
              fn(at): FieldView{
                key: "n11"
                field: m.company.fields.size
                widget: fn(): FieldWidget.Select(none)
                label: fn(): "Size"
                default: fn(): "small"
                options: Options.Items([
                  Item{value: "small", label: fn(): "Small"}
                  Item{value: "medium", label: fn(): "Medium"}
                  Item{
                    value: "large"
                    label: fn(): if ctx.params.tier == "gold": "Large (priority)" else: "Large"
                  }
                ])
              }.build(at)
              fn(at): FieldView{
                key: "n12"
                field: m.company.fields.legalForm
                widget: fn(): FieldWidget.Radio(Orientation.Horizontal)
                label: fn(): "Legal form"
                checks: [checks.answered()]
                options: Options.Items([
                  Item{value: "llc", label: fn(): "LLC"}
                  Item{value: "plc", label: fn(): "PLC"}
                  Item{value: "sole", label: fn(): "Sole trader"}
                ])
              }.build(at)
              fn(at): FieldView{
                key: "n13"
                when: fn(): data.company.legalForm != "sole"
                field: m.company.fields.capital.node
                hide: m.company.fields.capital.shown
                widget: fn(): FieldWidget.Input(none)
                label: fn(): "Share capital"
                checks: [checks.answered(), checks.min(fn(): 0.0), checks.multipleOf(fn(): 1000.0)]
              }.build(at)
              fn(at): FieldView{
                key: "n14"
                field: m.company.fields.employees
                widget: fn(): FieldWidget.Input(none)
                label: fn(): "Employees"
                checks: [
                  checks.answered()
                  checks.min(fn(): 1)
                  checks.max(
                    fn(): if data.company.size == "small": 50
                    elif data.company.size == "medium": 250
                    else: 100000
                  )
                  checks.rule(
                    fn(): data.company.size != "small" or (data.company.employees ?? 0) <= 50
                    fn(): checks.t(
                      translations
                      ctx.user.lang
                      "Only ${data.company.employees} employees allowed for a ${data.company.size} company"
                      `Only ${checks.text(data.company.employees)} employees allowed for a ${checks.text(data.company.size)} company`
                      [checks.text(data.company.employees), checks.text(data.company.size)]
                    )
                  )
                ]
              }.build(at)
              fn(at): FieldView{
                key: "n15"
                field: m.company.fields.founded
                widget: fn(): FieldWidget.Datepicker
                label: fn(): "Founded"
                checks: [
                  checks.answered()
                  checks.min(fn(): "1800-01-01")
                  checks.max(fn(): ctx.user.today)
                ]
              }.build(at)
              fn(at): FieldView{
                key: "n16"
                field: m.company.fields.logo
                widget: fn(): FieldWidget.Upload(true)
                label: fn(): "Logo"
                checks: [
                  checks.answered()
                  checks.accept(["image/png", "image/svg+xml"])
                  checks.maxBytes(1048576)
                ]
              }.build(at)
              fn(at): FieldView{
                key: "n17"
                field: m.company.fields.country
                widget: fn(): FieldWidget.Select(none)
                label: fn(): "Country"
                checks: [checks.answered()]
                options: Options.Rows(
                  from: fn(): [
                    for row in geo.countries(ctx.params.region): Choice{
                      value: (row.id)
                      label: (row.name)
                    }
                  ]
                  resolve: fn(): geo.countries(ctx.params.region).some(
                    fn(c): c.id == data.company.country
                  )
                )
              }.build(at)
              fn(at): addressView(
                at.within(fn(): data.company.country != none, m.company.fields.address.shown)
                m.company.fields.address.node.fields
                AddressCtx{
                  user: ctx.user
                  paramsFrom: fn(): AddressParams{country: (data.company.country ?? "")}
                }
                "n18"
              )
              fn(at): FieldView{
                key: "n19"
                when: fn(): data.company.country != none
                field: m.company.fields.city.node
                hide: m.company.fields.city.shown
                widget: fn(): FieldWidget.Select(none)
                label: fn(): "Main city"
                checks: [checks.answered()]
                options: Options.Rows(
                  from: fn(): [
                    for row in geo.cities(data.company.country ?? ""): Choice{
                      value: (row.id)
                      label: (row.name)
                    }
                  ]
                  resolve: fn(): geo.cities(data.company.country ?? "").some(
                    fn(c): c.id == data.company.city
                  )
                )
              }.build(at)
            ]
          }.build(at)
          fn(at): FieldView{
            key: "n20"
            field: m.manager
            widget: fn(): FieldWidget.Autocomplete("Type a name")
            label: fn(): "Account manager"
            checks: [checks.answered()]
            options: Options.Search(
              from: fn(search): {
                const ctx = struct{search, params: ctx.params, user: ctx.user}
                [for row in crm.users(ctx.search): Choice{value: row, label: (row.name)}]
              }
              resolve: fn(): crm.user(data.manager?.id ?? "") != none
            )
          }.build(at)
          fn(at): FieldView{
            key: "n21"
            field: m.creditLimit
            widget: fn(): FieldWidget.Input(none)
            label: fn(): "Credit limit"
            default: fn(): crm.creditLimit(data.company.vatId ?? "") ?? 0
          }.build(at)
        ]
      }.build(at)
      fn(at): LayoutView{
        key: "n22"
        widget: fn(): LayoutWidget.Step(title: "Catalog", labels: none)
        children: [
          fn(at): RepeatView{
            key: "n23"
            list: m.prices
            widget: fn(): RepeatWidget.Table(none)
            label: fn(): "Prices"
            canAdd: false
            rows: fn(): [
              for p in ctx.params.products: struct{
                sku: p.sku
                name: p.name
                amount: none
                regions: []
              }
            ]
            rowKey: fn(price): price.sku
            recomputeUntil: Recompute.RowsEdited
            item: fn(r1, row1, at): {
              const price = r1.scope()
              LayoutView{
                key: `n24@${row1}`
                widget: fn(): LayoutWidget.Tablerow
                children: [
                  fn(at): FieldView{
                    key: `n25@${row1}`
                    field: r1.fields.sku
                    widget: fn(): FieldWidget.Input(none)
                    label: fn(): "SKU"
                    value: fn(): price.sku ?? ""
                  }.build(at)
                  fn(at): FieldView{
                    key: `n26@${row1}`
                    parent: fn(): ParentUi.Tablerow(240)
                    field: r1.fields.name
                    widget: fn(): FieldWidget.Input(none)
                    label: fn(): "Product"
                    default: fn(): ""
                  }.build(at)
                  fn(at): FieldView{
                    key: `n27@${row1}`
                    parent: fn(): ParentUi.Tablerow(100)
                    field: r1.fields.amount
                    widget: fn(): FieldWidget.Input(none)
                    label: fn(): "Price"
                    checks: [checks.answered(), checks.min(fn(): 0.0)]
                  }.build(at)
                  fn(at): RepeatView{
                    key: `n28@${row1}`
                    list: r1.fields.regions
                    widget: fn(): RepeatWidget.Multiselect(none)
                    label: fn(): "Regions"
                    checks: [checks.someItems(fn(): true)]
                    canAdd: true
                    item: fn(r2, row2, at): FieldView{
                      key: `n29@${row1}@${row2}`
                      field: r2
                      widget: fn(): FieldWidget.Choice
                      label: fn(): "Region"
                      checks: [checks.answered()]
                      options: Options.Rows(
                        from: fn(): [
                          for row in geo.regions(): Choice{value: (row.code), label: (row.name)}
                        ]
                        resolve: fn(): {
                          const region = r2.scope()
                          geo.regions().some(fn(r): r.code == region)
                        }
                      )
                    }.build(at)
                  }.build(at)
                ]
              }.build(at)
            }
          }.build(at)
          fn(at): RepeatView{
            key: "n30"
            list: m.contacts
            widget: fn(): RepeatWidget.List(addLabel: "Add contact", reorderable: true)
            label: fn(): "Contacts"
            checks: [
              checks.minItems(fn(): 1)
              checks.maxItems(fn(): if ctx.params.tier == "gold": 10 else: 3)
            ]
            canAdd: true
            item: fn(r1, row1, at): {
              const contact = r1.scope()
              LayoutView{
                key: `n31@${row1}`
                widget: fn(): LayoutWidget.Section(
                  title: none
                  description: none
                  collapsible: none
                  labels: none
                )
                children: [
                  fn(at): FieldView{
                    key: `n32@${row1}`
                    parent: fn(): ParentUi.Section(1)
                    field: r1.fields.name
                    widget: fn(): FieldWidget.Input(none)
                    label: fn(): "Name"
                    checks: [checks.answered()]
                  }.build(at)
                  fn(at): FieldView{
                    key: `n33@${row1}`
                    parent: fn(): ParentUi.Section(1)
                    field: r1.fields.email
                    widget: fn(): FieldWidget.Input(none)
                    label: fn(): "Email"
                    checks: [checks.answered(), checks.format(checks.Format.Email)]
                  }.build(at)
                  fn(at): FieldView{
                    key: `n34@${row1}`
                    field: r1.fields.primary
                    widget: fn(): FieldWidget.Toggle
                    label: fn(): "Primary contact"
                    default: fn(): false
                  }.build(at)
                  fn(at): contactCard.view(
                    at
                    r1.fields.card.fields
                    contactCard.Ctx{
                      user: ctx.user
                      paramsFrom: fn(): contactCard.Params{name: (contact.name ?? "")}
                    }
                    `n35@${row1}`
                  )
                ]
              }.build(at)
            }
          }.build(at)
          fn(at): RepeatView{
            key: "n36"
            list: m.certifications
            widget: fn(): RepeatWidget.Checkboxes(Orientation.Vertical)
            label: fn(): "Certifications"
            canAdd: true
            item: fn(r1, row1, at): FieldView{
              key: `n37@${row1}`
              field: r1
              widget: fn(): FieldWidget.Choice
              label: fn(): "Certification"
              checks: [checks.answered()]
              options: Options.Items([
                Item{value: "iso9001", label: fn(): "ISO 9001"}
                Item{value: "iso14001", label: fn(): "ISO 14001"}
              ])
            }.build(at)
          }.build(at)
          fn(at): RepeatView{
            key: "n38"
            list: m.categories
            widget: fn(): RepeatWidget.Cards(addLabel: "Add category", title: "Category")
            label: fn(): "Categories"
            canAdd: true
            item: fn(r1, row1, at): categoryView(
              at
              r1.fields
              CategoryCtx{user: ctx.user, paramsFrom: fn(): CategoryParams}
              `n39@${row1}`
            )
          }.build(at)
          fn(at): RepeatView{
            key: "n40"
            list: m.history
            widget: fn(): RepeatWidget.List(addLabel: none, reorderable: none)
            label: fn(): "Previous orders"
            canAdd: false
            rows: fn(): crm.orders(data.company.vatId ?? "")
            computedRows: true
            item: fn(r1, row1, at): {
              const h = r1.scope()
              FieldView{
                key: `n41@${row1}`
                field: r1.fields.note
                widget: fn(): FieldWidget.Input(none)
                label: fn(): "Order"
                value: fn(): h.note ?? ""
              }.build(at)
            }
          }.build(at)
        ]
      }.build(at)
      fn(at): LayoutView{
        key: "n42"
        widget: fn(): LayoutWidget.Step(title: "Payment", labels: none)
        children: [
          fn(at): FieldView{
            key: "n43"
            field: m.payment.tag
            widget: fn(): FieldWidget.Segmented
            label: fn(): "Method"
            checks: [checks.answered()]
            options: Options.Items([
              Item{value: "card", label: fn(): "Card"}
              Item{value: "wire", label: fn(): "Wire"}
              Item{value: "invoice", label: fn(): "Invoice"}
            ])
          }.build(at)
          fn(at): VariantView{
            key: "n44"
            variant: m.payment
            widget: fn(): VariantWidget.Panel("Details")
            label: fn(): "Payment details"
            cases: struct{
              card: CaseView{
                label: fn(): "Card"
                body: fn(at): {
                  const pay = m.payment.cases.card.scope()
                  LayoutView{
                    key: "n45"
                    widget: fn(): LayoutWidget.Section(
                      title: none
                      description: none
                      collapsible: none
                      labels: none
                    )
                    children: [
                      fn(at): FieldView{
                        key: "n46"
                        field: m.payment.cases.card.fields.holder
                        widget: fn(): FieldWidget.Input(none)
                        label: fn(): "Card holder"
                        checks: [checks.answered()]
                      }.build(at)
                      fn(at): FieldView{
                        key: "n47"
                        field: m.payment.cases.card.fields.last4
                        widget: fn(): FieldWidget.Input(none)
                        label: fn(): "Last 4 digits"
                        checks: [checks.answered(), checks.pattern(fn(): "^[0-9]{4}$")]
                      }.build(at)
                    ]
                  }.build(at)
                }
              }
              wire: CaseView{
                label: fn(): "Wire"
                body: fn(at): {
                  const pay = m.payment.cases.wire.scope()
                  LayoutView{
                    key: "n48"
                    widget: fn(): LayoutWidget.Money
                    label: fn(): "Deposit"
                    children: [
                      fn(at): FieldView{
                        key: "n49"
                        field: m.payment.cases.wire.fields.deposit.fields.amount
                        widget: fn(): FieldWidget.Raw
                        label: fn(): "Amount"
                        checks: [checks.answered(), checks.min(fn(): 0.0)]
                      }.build(at)
                      fn(at): FieldView{
                        key: "n50"
                        field: m.payment.cases.wire.fields.deposit.fields.currency
                        widget: fn(): FieldWidget.Choice
                        label: fn(): "Currency"
                        checks: [checks.answered()]
                        options: Options.Items([
                          Item{value: "EUR", label: fn(): "€"}
                          Item{value: "USD", label: fn(): "$"}
                        ])
                      }.build(at)
                    ]
                  }.build(at)
                }
              }
              invoice: CaseView{
                label: fn(): "Invoice"
                body: fn(at): {
                  const pay = m.payment.cases.invoice.scope()
                  FieldView{
                    key: "n51"
                    field: m.payment.cases.invoice.fields.terms
                    widget: fn(): FieldWidget.Input(none)
                    label: fn(): "Payment terms (days)"
                    default: fn(): 30
                    checks: [checks.min(fn(): 7), checks.max(fn(): 90)]
                  }.build(at)
                }
              }
            }
          }.build(at)
          fn(at): VariantView{
            key: "n52"
            variant: m.delivery
            widget: fn(): VariantWidget.Inline
            label: fn(): "Delivery"
            default: fn(): "standard"
            cases: struct{
              standard: CaseView{
                label: fn(): "Standard"
                body: fn(at): {
                  const d = m.delivery.cases.standard.scope()
                  FieldView{
                    key: "n53"
                    field: m.delivery.cases.standard.fields.window
                    widget: fn(): FieldWidget.Select(none)
                    label: fn(): "Time window"
                    checks: [checks.answered()]
                    options: Options.Items([
                      Item{value: "am", label: fn(): "Morning"}
                      Item{value: "pm", label: fn(): "Afternoon"}
                    ])
                  }.build(at)
                }
              }
              express: CaseView{
                label: fn(): "Express"
                body: fn(at): {
                  const d = m.delivery.cases.express.scope()
                  FieldView{
                    key: "n54"
                    field: m.delivery.cases.express.fields.at
                    widget: fn(): FieldWidget.Datepicker
                    label: fn(): "Deliver at"
                    checks: [checks.answered()]
                  }.build(at)
                }
              }
            }
          }.build(at)
          fn(at): FieldView{
            key: "n55"
            field: m.extraForm
            widget: fn(): FieldWidget.Select(none)
            label: fn(): "Additional questionnaire"
            checks: [checks.answered()]
            options: Options.Rows(
              from: fn(): [
                for row in formsCatalog.list(ctx.params.region): Choice{
                  value: row
                  label: (row.title)
                }
              ]
              resolve: fn(): formsCatalog.get(data.extraForm?.id ?? "") != none
            )
          }.build(at)
          fn(at): DynamicView{
            key: "n56"
            when: fn(): data.extraForm != none
            value: m.extra.node
            hide: m.extra.shown
            label: fn(): "Questionnaire"
            schema: fn(): data.extraForm?.schema
          }.build(at)
        ]
      }.build(at)
      fn(at): LayoutView{
        key: "n57"
        widget: fn(): LayoutWidget.Step(title: "Review", labels: none)
        children: [
          fn(at): LayoutView{
            key: "n58"
            widget: fn(): LayoutWidget.Markdown(
              (`Supplier **${data.company.name ?? "?"}**, ${data.prices.length()} prices.`)
            )
          }.build(at)
          fn(at): FieldView{
            key: "n59"
            widget: fn(): FieldWidget.Input(none)
            label: fn(): "Catalog value"
            value: fn(): logic.catalogValue(data.prices)
          }.build(at)
          fn(at): FieldView{
            key: "n60"
            field: m.score
            widget: fn(): FieldWidget.Input(none)
            label: fn(): "Risk score"
            value: fn(): logic.score(data.company.employees ?? 0, data.certifications.length())
          }.build(at)
          fn(at): FieldView{
            key: "n61"
            field: m.notes
            widget: fn(): FieldWidget.Textarea(none)
            label: fn(): if ctx.params.tier == "gold": "Notes for your account manager"
            else: "Notes"
            default: fn(): ""
            checks: [checks.required(fn(): (data.score ?? 0) > 70)]
          }.build(at)
          fn(at): FieldView{
            key: "n62"
            field: m.agree
            widget: fn(): FieldWidget.Checkbox
            label: fn(): "I accept the terms"
            checks: [
              checks.answered()
              checks.rule(fn(): data.agree == true, fn(): `Please accept the terms`)
            ]
          }.build(at)
          fn(at): LayoutView{key: "n63", widget: fn(): LayoutWidget.Divider}.build(at)
          fn(at): LayoutView{
            key: "n64"
            widget: fn(): LayoutWidget.Errors
            checks: [
              checks.rule(
                fn(): data.contacts.some(fn(c): c.primary == true)
                fn(): `Mark one contact as primary`
              )
              checks.rule(
                fn(): (data.score ?? 0) <
                  80 or
                  approvals.ask(ctx.params.owner.id, data.company.name ?? "")
                fn(): `The supplier was not approved`
              )
            ]
          }.build(at)
        ]
      }.build(at)
    ]
  }.build(at)

# The form on a graph of its own.
fn openSupplier(params: SupplierParams, user: User) -> Form<SupplierModel>:
  const graph = new Graph{}
  const model = Group.make<SupplierModel>(graph, none)
  Form.open(graph, model, fn(at): supplierView(at, model.fields, SupplierCtx{params, user}))

# ═══════════ The entry points its hosts start ═══════════

# The browser's: serves the form until a valid submit, and gives the value to submit.
live async fn supplierForm(params: SupplierParams, user: User) -> Group<SupplierModel>.Seen:
  await openSupplier(params, user).serve()

# The backend's: validates a whole value.
live fn validateSupplier(
  params: SupplierParams
  user: User
  value: Group<SupplierModel>.Seen
) -> Result<Group<SupplierModel>.Data, Problems>:
  openSupplier(params, user).validate(value)
