          parent: none,
          list: m.prices,
          widget: Prop.Fixed{RepeatWidget.Table{addLabel: none}},
          label: Prop.Fixed{"Prices"},
          checks: [],
          canAdd: false,
          rows: Prop.Computed{
            eval: fn(sc: SupplierScope): {
              const struct{data, ctx} = sc
              [
                for p in ctx.params.products: struct{
                  sku: p.sku,
                  name: p.name,
                  amount: none,
                  regions: [],
                }
              ]
            },
          },
          rowKey: fn(seen): { const price = seen; price.sku },
          recomputeUntil: Recompute.RowsEdited,
          item: fn(r1, row1): ScopedView<SupplierScope, SupplierScope1>{
            scope: fn(sc): SupplierScope1{data: sc.data, ctx: sc.ctx, price: r1.seen()},
            view: LayoutView<SupplierScope1>{
              key: `n24@${row1}`,
              parent: none,
              widget: Prop.Fixed{LayoutWidget.Tablerow},
              children: [
                new FieldView<SupplierScope1, String>{
                  key: `n25@${row1}`,
                  parent: none,
                  field: r1.fields.sku,
                  widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
                  label: Prop.Fixed{"SKU"},
                  value: Prop.Computed{
                    eval: fn(sc: SupplierScope1): {
                      const struct{data, ctx, price} = sc
                      price.sku ?? ""
                    },
                  },
                  checks: [],
                },
                new FieldView<SupplierScope1, String>{
                  key: `n26@${row1}`,
                  parent: Prop.Fixed{ParentUi.Tablerow{width: 240}},
                  field: r1.fields.name,
                  widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
                  label: Prop.Fixed{"Product"},
                  default: Prop.Fixed{""},
                  checks: [],
                },
                new FieldView<SupplierScope1, Float>{
                  key: `n27@${row1}`,
                  parent: Prop.Fixed{ParentUi.Tablerow{width: 100}},
                  field: r1.fields.amount,
                  widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
                  label: Prop.Fixed{"Price"},
                  checks: [forms.answered(), forms.min(Fixed{0.0})],
                },
                new RepeatView<SupplierScope1, SupplierPricesRegionsRow>{
                  key: `n28@${row1}`,
                  parent: none,
                  list: r1.fields.regions,
                  widget: Prop.Fixed{RepeatWidget.Multiselect{placeholder: none}},
                  label: Prop.Fixed{"Regions"},
                  checks: [forms.someItems(Fixed{true})],
                  canAdd: true,
                  item: fn(r2, row2): ScopedView<SupplierScope1, SupplierScope2>{
                    scope: fn(sc): SupplierScope2{
                      data: sc.data,
                      ctx: sc.ctx,
                      price: sc.price,
                      region: r2.seen(),
                    },
                    view: new FieldView<SupplierScope2, String>{
                      key: `n29@${row1}@${row2}`,
                      parent: none,
                      field: r2,
                      widget: Prop.Fixed{FieldWidget.Choice},
                      label: Prop.Fixed{"Region"},
                      checks: [forms.answered()],
                      options: Options.Rows{
                        from: forms.awaited(Pending.Form, async fn(sc: SupplierScope2): {
                          const struct{data, ctx, price, region} = sc
                          [
                            for row in await geo.regions(): Choice{
                              value: (row.code),
                              label: (row.name),
                            }
                          ]
                        }),
                        resolve: forms.awaited(Pending.Form, async fn(sc: SupplierScope2): {
                          const struct{data, ctx, price, region} = sc
                          (await geo.regions()).some(fn(r): r.code == region)
                        }),
                      },
                    },
                  },
                },
              ],
            },
          },
        },
        new RepeatView<SupplierScope, SupplierContactsRow>{
          key: "n30",
          parent: none,
          list: m.contacts,
          widget: Prop.Fixed{RepeatWidget.List{addLabel: "Add contact", reorderable: true}},
          label: Prop.Fixed{"Contacts"},
          checks: [
            forms.minItems(Fixed{1}),
            forms.maxItems(
              Prop.Computed{
                eval: fn(sc: SupplierScope): {
                  const struct{data, ctx} = sc
                  if ctx.params.tier == "gold": 10
                  else: 3
                },
              },
            ),
          ],
          canAdd: true,
          item: fn(r1, row1): ScopedView<SupplierScope, SupplierScope3>{
            scope: fn(sc): SupplierScope3{data: sc.data, ctx: sc.ctx, contact: r1.seen()},
            view: LayoutView<SupplierScope3>{
              key: `n31@${row1}`,
              parent: none,
              widget: Prop.Fixed{
                LayoutWidget.Section{
                  title: none,
                  description: none,
                  collapsible: none,
                  labels: none,
                },
              },
              children: [
                new FieldView<SupplierScope3, String>{
                  key: `n32@${row1}`,
                  parent: Prop.Fixed{ParentUi.Section{span: 1}},
                  field: r1.fields.name,
                  widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
                  label: Prop.Fixed{"Name"},
                  checks: [forms.answered()],
                },
                new FieldView<SupplierScope3, String>{
                  key: `n33@${row1}`,
                  parent: Prop.Fixed{ParentUi.Section{span: 1}},
                  field: r1.fields.email,
                  widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
                  label: Prop.Fixed{"Email"},
                  checks: [forms.answered(), forms.format(Format.Email)],
                },
                new FieldView<SupplierScope3, Bool>{
                  key: `n34@${row1}`,
                  parent: none,
                  field: r1.fields.primary,
                  widget: Prop.Fixed{FieldWidget.Toggle},
                  label: Prop.Fixed{"Primary contact"},
                  default: Prop.Fixed{false},
                  checks: [],
                },
                ScopedView<SupplierScope3, contactCard.Scope>{
                  key: `n35@${row1}`,
                  parent: none,
                  scope: fn(sc: SupplierScope3): {
                    const struct{data, ctx, contact} = sc
                    Scope{
                      data: r1.fields.card.seen(),
                      ctx: contactCard.Ctx{
                        params: contactCard.Params{name: (contact.name ?? "")},
                        user: ctx.user,
                      },
                    }
                  },
                  view: contactCard.view(r1.fields.card.fields, `n35@${row1}`),
                },
              ],
            },
          },
        },
        new RepeatView<SupplierScope, SupplierCertificationsRow>{
          key: "n36",
          parent: none,
          list: m.certifications,
          widget: Prop.Fixed{RepeatWidget.Checkboxes{orientation: Orientation.Vertical}},
          label: Prop.Fixed{"Certifications"},
          checks: [],
          canAdd: true,
          item: fn(r1, row1): ScopedView<SupplierScope, SupplierScope4>{
            scope: fn(sc): SupplierScope4{data: sc.data, ctx: sc.ctx, cert: r1.seen()},
            view: new FieldView<SupplierScope4, "iso9001" | "iso14001">{
              key: `n37@${row1}`,
              parent: none,
              field: r1,
              widget: Prop.Fixed{FieldWidget.Choice},
              label: Prop.Fixed{"Certification"},
              checks: [forms.answered()],
              options: Options.Items{
                items: [
                  Item{value: "iso9001", label: Prop.Fixed{"ISO 9001"}},
                  Item{value: "iso14001", label: Prop.Fixed{"ISO 14001"}},
                ],
              },
            },
          },
        },
        new RepeatView<SupplierScope, SupplierCategoriesRow>{
          key: "n38",
          parent: none,
          list: m.categories,
          widget: Prop.Fixed{RepeatWidget.Cards{addLabel: "Add category", title: "Category"}},
          label: Prop.Fixed{"Categories"},
          checks: [],
          canAdd: true,
          item: fn(r1, row1): ScopedView<SupplierScope, SupplierScope5>{
            scope: fn(sc): SupplierScope5{data: sc.data, ctx: sc.ctx, cat: r1.seen()},
            view: ScopedView<SupplierScope5, CategoryScope>{
              key: `n39@${row1}`,
              parent: none,
              scope: fn(sc: SupplierScope5): {
                const struct{data, ctx, cat} = sc
                Scope{data: r1.seen(), ctx: CategoryCtx{params: CategoryParams, user: ctx.user}}
              },
              view: categoryView(r1.fields, `n39@${row1}`),
            },
          },
        },
        new RepeatView<SupplierScope, SupplierHistoryRow>{
          key: "n40",
          parent: none,
          list: m.history->node,
          hide: m.history,
          widget: Prop.Fixed{RepeatWidget.List{addLabel: none, reorderable: none}},
          label: Prop.Fixed{"Previous orders"},
          checks: [],
          canAdd: false,
          rows: forms.awaited(Pending.Hidden, async fn(sc: SupplierScope): {
            const struct{data, ctx} = sc
            await crm.orders(data.company.vatId ?? "")
          }),
          computedRows: true,
          item: fn(r1, row1): ScopedView<SupplierScope, SupplierScope6>{
            scope: fn(sc): SupplierScope6{data: sc.data, ctx: sc.ctx, h: r1.seen()},
            view: new FieldView<SupplierScope6, String>{
              key: `n41@${row1}`,
              parent: none,
              field: r1.fields.note,
              widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
              label: Prop.Fixed{"Order"},
              value: Prop.Computed{
                eval: fn(sc: SupplierScope6): { const struct{data, ctx, h} = sc; h.note ?? "" },
              },
              checks: [],
            },
          },
        },
      ],
    },
    LayoutView<SupplierScope>{
      key: "n42",
      parent: none,
      widget: Prop.Fixed{LayoutWidget.Step{title: "Payment", labels: none}},
      children: [
        new FieldView<SupplierScope, "card" | "wire" | "invoice">{
          key: "n43",
          parent: none,
          field: m.payment.tag,
          widget: Prop.Fixed{FieldWidget.Segmented},
          label: Prop.Fixed{"Method"},
          checks: [forms.answered()],
          options: Options.Items{
            items: [
              Item{value: "card", label: Prop.Fixed{"Card"}},
              Item{value: "wire", label: Prop.Fixed{"Wire"}},
              Item{value: "invoice", label: Prop.Fixed{"Invoice"}},
            ],
          },
        },
        VariantView<SupplierScope, SupplierPaymentCases>{
          key: "n44",
          parent: none,
          variant: m.payment,
          widget: Prop.Fixed{VariantWidget.Panel{title: "Details"}},
          label: Prop.Fixed{"Payment details"},
          cases: struct{
            card: CaseView<SupplierScope>{
              label: Prop.Fixed{"Card"},
              body: ScopedView<SupplierScope, SupplierScope7>{
                scope: fn(sc): SupplierScope7{
                  data: sc.data,
                  ctx: sc.ctx,
                  pay: m.payment.cases.card.seen(),
                },
                view: LayoutView<SupplierScope7>{
                  key: "n45",
                  parent: none,
                  widget: Prop.Fixed{
                    LayoutWidget.Section{
                      title: none,
                      description: none,
                      collapsible: none,
                      labels: none,
                    },
                  },
                  children: [
                    new FieldView<SupplierScope7, String>{
                      key: "n46",
                      parent: none,
                      field: m.payment.cases.card.fields.holder,
                      widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
                      label: Prop.Fixed{"Card holder"},
                      checks: [forms.answered()],
                    },
                    new FieldView<SupplierScope7, String>{
                      key: "n47",
                      parent: none,
                      field: m.payment.cases.card.fields.last4,
                      widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
                      label: Prop.Fixed{"Last 4 digits"},
                      checks: [forms.answered(), forms.pattern(Fixed{"^[0-9]{4}$"})],
                    },
                  ],
                },
              },
            },
            wire: CaseView<SupplierScope>{
              label: Prop.Fixed{"Wire"},
              body: ScopedView<SupplierScope, SupplierScope8>{
                scope: fn(sc): SupplierScope8{
                  data: sc.data,
                  ctx: sc.ctx,
                  pay: m.payment.cases.wire.seen(),
                },
                view: LayoutView<SupplierScope8>{
                  key: "n48",
                  parent: none,
                  widget: Prop.Fixed{LayoutWidget.Money},
                  label: Prop.Fixed{"Deposit"},
                  children: [
                    new FieldView<SupplierScope8, Float>{
                      key: "n49",
                      parent: none,
                      field: m.payment.cases.wire.fields.deposit.fields.amount,
                      widget: Prop.Fixed{FieldWidget.Raw},
                      label: Prop.Fixed{"Amount"},
                      checks: [forms.answered(), forms.min(Fixed{0.0})],
                    },
                    new FieldView<SupplierScope8, "EUR" | "USD">{
                      key: "n50",
                      parent: none,
                      field: m.payment.cases.wire.fields.deposit.fields.currency,
                      widget: Prop.Fixed{FieldWidget.Choice},
                      label: Prop.Fixed{"Currency"},
                      checks: [forms.answered()],
                      options: Options.Items{
                        items: [
                          Item{value: "EUR", label: Prop.Fixed{"€"}},
                          Item{value: "USD", label: Prop.Fixed{"$"}},
                        ],
                      },
                    },
                  ],
                },
              },
            },
            invoice: CaseView<SupplierScope>{
              label: Prop.Fixed{"Invoice"},
              body: ScopedView<SupplierScope, SupplierScope9>{
                scope: fn(sc): SupplierScope9{
                  data: sc.data,
                  ctx: sc.ctx,
                  pay: m.payment.cases.invoice.seen(),
                },
                view: new FieldView<SupplierScope9, Int>{
                  key: "n51",
                  parent: none,
                  field: m.payment.cases.invoice.fields.terms,
                  widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
                  label: Prop.Fixed{"Payment terms (days)"},
                  default: Prop.Fixed{30},
                  checks: [forms.min(Fixed{7}), forms.max(Fixed{90})],
                },
              },
            },
          },
        },
        VariantView<SupplierScope, SupplierDeliveryCases>{
          key: "n52",
          parent: none,
          variant: m.delivery,
          widget: Prop.Fixed{VariantWidget.Inline},
          label: Prop.Fixed{"Delivery"},
          default: Prop.Fixed{"standard"},
          cases: struct{
            standard: CaseView<SupplierScope>{
              label: Prop.Fixed{"Standard"},
              body: ScopedView<SupplierScope, SupplierScope10>{
                scope: fn(sc): SupplierScope10{
                  data: sc.data,
                  ctx: sc.ctx,
                  d: m.delivery.cases.standard.seen(),
                },
                view: new FieldView<SupplierScope10, "am" | "pm">{
                  key: "n53",
                  parent: none,
                  field: m.delivery.cases.standard.fields.window,
                  widget: Prop.Fixed{FieldWidget.Select{placeholder: none}},
                  label: Prop.Fixed{"Time window"},
                  checks: [forms.answered()],
                  options: Options.Items{
                    items: [
                      Item{value: "am", label: Prop.Fixed{"Morning"}},
                      Item{value: "pm", label: Prop.Fixed{"Afternoon"}},
                    ],
                  },
                },
              },
            },
            express: CaseView<SupplierScope>{
              label: Prop.Fixed{"Express"},
              body: ScopedView<SupplierScope, SupplierScope11>{
                scope: fn(sc): SupplierScope11{
                  data: sc.data,
                  ctx: sc.ctx,
                  d: m.delivery.cases.express.seen(),
                },
                view: new FieldView<SupplierScope11, forms.DateTime>{
                  key: "n54",
                  parent: none,
                  field: m.delivery.cases.express.fields.at,
                  widget: Prop.Fixed{FieldWidget.Datepicker},
                  label: Prop.Fixed{"Deliver at"},
                  checks: [forms.answered()],
                },
              },
            },
          },
        },
        new FieldView<SupplierScope, formsCatalog.Entry>{
          key: "n55",
          parent: none,
          field: m.extraForm,
          widget: Prop.Fixed{FieldWidget.Select{placeholder: none}},
          label: Prop.Fixed{"Additional questionnaire"},
          checks: [forms.answered()],
          options: Options.Rows{
            from: forms.awaited(Pending.Form, async fn(sc: SupplierScope): {
              const struct{data, ctx} = sc
              [
                for row in await formsCatalog.list(ctx.params.region): Choice{
                  value: row,
                  label: (row.title),
                }
              ]
            }),
            resolve: forms.awaited(Pending.Form, async fn(sc: SupplierScope): {
              const struct{data, ctx} = sc
              (await formsCatalog.get(data.extraForm?.id ?? "")) != none
            }),
          },
        },
        new DynamicView<SupplierScope>{
          key: "n56",
          parent: none,
          when: Prop.Computed{
            eval: fn(sc: SupplierScope): { const struct{data, ctx} = sc; data.extraForm != none },
          },
          value: m.extra->node,
          hide: m.extra,
          label: Prop.Fixed{"Questionnaire"},
          schema: Prop.Computed{
            eval: fn(sc: SupplierScope): { const struct{data, ctx} = sc; data.extraForm?.schema },
          },
        },
      ],
    },
    LayoutView<SupplierScope>{
      key: "n57",
      parent: none,
      widget: Prop.Fixed{LayoutWidget.Step{title: "Review", labels: none}},
      children: [
        LayoutView<SupplierScope>{
          key: "n58",
          parent: none,
          widget: Prop.Computed{
            eval: fn(sc: SupplierScope): {
              const struct{data, ctx} = sc
              LayoutWidget.Markdown{
                markdown: (
                  `Supplier **${data.company.name ?? "?"}**, ${data.prices.length()} prices.`
                ),
              }
            },
          },
          children: [],
        },
        new FieldView<SupplierScope, Float>{
          key: "n59",
          parent: none,
          field: none,
          widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
          label: Prop.Fixed{"Catalog value"},
          value: Prop.Computed{
            eval: fn(sc: SupplierScope): {
              const struct{data, ctx} = sc
              logic.catalogValue(data.prices)
            },
          },
          checks: [],
        },
        new FieldView<SupplierScope, Int>{
          key: "n60",
          parent: none,
          field: m.score,
          widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
          label: Prop.Fixed{"Risk score"},
          value: Prop.Computed{
            eval: fn(sc: SupplierScope): {
              const struct{data, ctx} = sc
              logic.score(data.company.employees ?? 0, data.certifications.length())
            },
          },
          checks: [],
        },
        new FieldView<SupplierScope, String>{
          key: "n61",
          parent: none,
          field: m.notes,
          widget: Prop.Fixed{FieldWidget.Textarea{rows: none}},
          label: Prop.Computed{
            eval: fn(sc: SupplierScope): {
              const struct{data, ctx} = sc
              if ctx.params.tier == "gold": "Notes for your account manager"
              else: "Notes"
            },
          },
          default: Prop.Fixed{""},
          checks: [
            forms.required(
              Prop.Computed{
                eval: fn(sc: SupplierScope): {
                  const struct{data, ctx} = sc
                  (data.score ?? 0) > 70
                },
              },
            ),
          ],
        },
        new FieldView<SupplierScope, Bool>{
          key: "n62",
          parent: none,
          field: m.agree,
          widget: Prop.Fixed{FieldWidget.Checkbox},
          label: Prop.Fixed{"I accept the terms"},
          checks: [
            forms.answered(),
            forms.rule(
              fn(sc: SupplierScope): { const struct{data, ctx} = sc; data.agree == true },
              fn(sc: SupplierScope): { const struct{data, ctx} = sc; `Please accept the terms` },
            ),
          ],
        },
        LayoutView<SupplierScope>{
          key: "n63",
          parent: none,
          widget: Prop.Fixed{LayoutWidget.Divider},
          children: [],
        },
        LayoutView<SupplierScope>{
          key: "n64",
          parent: none,
          widget: Prop.Fixed{LayoutWidget.Errors},
          checks: [
            forms.rule(
              fn(sc: SupplierScope): {
                const struct{data, ctx} = sc
                data.contacts.some(fn(c): c.primary == true)
              },
              fn(sc: SupplierScope): {
                const struct{data, ctx} = sc
                `Mark one contact as primary`
              },
            ),
            forms.later(
              async fn(sc: SupplierScope) -> Future<String?>: {
                const struct{data, ctx} = sc
                if (data.score ?? 0) < 80 or await approvals.ask(ctx.params.owner.id, data.company.name ?? ""):
                  none
                else: `The supplier was not approved`
              },
              fn(sc: SupplierScope): {
                const struct{data, ctx} = sc
                forms.t(
                  translations,
                  ctx.user.lang,
                  "Waiting for approval by ${ctx.params.owner.name}",
                  `Waiting for approval by ${forms.text(ctx.params.owner.name)}`,
                  [forms.text(ctx.params.owner.name)],
                )
              },
            ),
          ],
          children: [],
        },
      ],
    },
  ],
}

# ═══════════ The entry point a workflow awaits ═══════════

async fn supplierForm(
  params: SupplierParams,
  user: User,
  events: Inbox<FormEvent>,
  views: Inbox<Node>,
) -> Future<SupplierData>:
  const m = supplierModel()
  await forms.run(m, supplierView(m.fields), SupplierCtx{params, user}, translations, events, views)
