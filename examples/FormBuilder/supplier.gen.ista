# ═══════════ def "#address" ═══════════

struct AddressParams:
  country: String

struct AddressCtx:
  user: User
  paramsFrom: inert fn() -> AddressParams

# Its params as its mount gives them, read when an expression reads them.
fn get params(self: AddressCtx) -> AddressParams: (self.paramsFrom)()

struct AddressModel:
  street: Field<String>
  zip: Field<String>
  city: Field<String>

fn addressView(at: Place, m: AddressModel, ctx: AddressCtx, k: String) -> View:
  const data = Group{fields: m}.scope()
  LayoutView{
    key: `${k}/n1`
    widget: fn(): LayoutWidget.Labeled(LabelStyle.Top)
    children: [
      fn(at): FieldView{
        key: `${k}/n2`
        field: m.street
        widget: fn(): FieldWidget.Input(none)
        label: fn(): "Street"
        checks: [checks.required(fn(): true), checks.maxLength(fn(): 120)]
      }.build(at)
      fn(at): LayoutView{
        key: `${k}/n3`
        widget: fn(): LayoutWidget.Hstack(gap: Gap.Sm, labels: none)
        children: [
          fn(at): FieldView{
            key: `${k}/n4`
            parent: fn(): ParentUi.Hstack(1.0)
            field: m.zip
            widget: fn(): FieldWidget.Input(none)
            label: fn(): "ZIP"
            checks: [checks.answered(), checks.pattern(fn(): logic.zipPattern(ctx.params.country))]
          }.build(at)
          fn(at): FieldView{
            key: `${k}/n5`
            parent: fn(): ParentUi.Hstack(3.0)
            field: m.city
            widget: fn(): FieldWidget.Input(none)
            label: fn(): "City"
            checks: [checks.answered()]
          }.build(at)
        ]
      }.build(at)
    ]
  }.build(at)

# ═══════════ def "#category" ═══════════

struct CategoryParams

struct CategoryCtx:
