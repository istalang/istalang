                    key: `n35@${row1}`
                    parent: none
                    scope: fn({data, ctx, contact}): Scope{
                      data: r1.fields.card.seen()
                      ctx: contactCard.Ctx{
                        params: contactCard.Params{name: (contact.name ?? "")}
                        user: ctx.user
                      }
                    }
                    view: contactCard.view(r1.fields.card.fields, `n35@${row1}`)
                  }
                ]
              }
            }
          }
          new RepeatView{
            key: "n36"
            parent: none
            list: m.certifications
            widget: Prop.Fixed(RepeatWidget.Checkboxes(Orientation.Vertical))
            label: Prop.Fixed("Certifications")
            checks: []
            canAdd: true
            item: fn(r1, row1): ScopedView{
              scope: fn(sc): struct{data: sc.data, ctx: sc.ctx, cert: r1.seen()}
              view: new FieldView{
                key: `n37@${row1}`
                parent: none
                field: r1
                widget: Prop.Fixed(FieldWidget.Choice)
                label: Prop.Fixed("Certification")
                checks: [forms.answered()]
                options: Options.Items([
                  Item{value: "iso9001", label: Prop.Fixed("ISO 9001")}
                  Item{value: "iso14001", label: Prop.Fixed("ISO 14001")}
                ])
              }
            }
          }
          new RepeatView{
            key: "n38"
            parent: none
            list: m.categories
            widget: Prop.Fixed(RepeatWidget.Cards(addLabel: "Add category", title: "Category"))
            label: Prop.Fixed("Categories")
            checks: []
            canAdd: true
            item: fn(r1, row1): ScopedView{
              scope: fn(sc): struct{data: sc.data, ctx: sc.ctx, cat: r1.seen()}
              view: ScopedView{
                key: `n39@${row1}`
                parent: none
                scope: fn({data, ctx, cat}): Scope{
                  data: r1.seen()
                  ctx: CategoryCtx{params: CategoryParams, user: ctx.user}
                }
                view: categoryView(r1.fields, `n39@${row1}`)
              }
            }
          }
          new RepeatView{
            key: "n40"
            parent: none
            list: m.history->node
            hide: m.history
            widget: Prop.Fixed(RepeatWidget.List(addLabel: none, reorderable: none))
            label: Prop.Fixed("Previous orders")
            checks: []
            canAdd: false
            rows: forms.awaited(
              Pending.Hidden
              async fn({data, ctx}): await crm.orders(data.company.vatId ?? "")
            )
            computedRows: true
            item: fn(r1, row1): ScopedView{
              scope: fn(sc): struct{data: sc.data, ctx: sc.ctx, h: r1.seen()}
              view: new FieldView{
                key: `n41@${row1}`
                parent: none
                field: r1.fields.note
                widget: Prop.Fixed(FieldWidget.Input(none))
                label: Prop.Fixed("Order")
                value: Prop.Computed(fn({data, ctx, h}): h.note ?? "")
                checks: []
              }
            }
          }
        ]
      }
      LayoutView{
        key: "n42"
        parent: none
        widget: Prop.Fixed(LayoutWidget.Step(title: "Payment", labels: none))
        children: [
          new FieldView{
            key: "n43"
            parent: none
            field: m.payment.tag
            widget: Prop.Fixed(FieldWidget.Segmented)
            label: Prop.Fixed("Method")
            checks: [forms.answered()]
            options: Options.Items([
              Item{value: "card", label: Prop.Fixed("Card")}
              Item{value: "wire", label: Prop.Fixed("Wire")}
              Item{value: "invoice", label: Prop.Fixed("Invoice")}
            ])
          }
          VariantView{
            key: "n44"
            parent: none
            variant: m.payment
            widget: Prop.Fixed(VariantWidget.Panel("Details"))
            label: Prop.Fixed("Payment details")
            cases: struct{
              card: CaseView{
                label: Prop.Fixed("Card")
                body: ScopedView{
                  scope: fn(sc): struct{
                    data: sc.data
                    ctx: sc.ctx
                    pay: m.payment.cases.card.seen()
                  }
                  view: LayoutView{
                    key: "n45"
                    parent: none
                    widget: Prop.Fixed(
                      LayoutWidget.Section(
                        title: none
                        description: none
                        collapsible: none
                        labels: none
                      )
                    )
                    children: [
                      new FieldView{
                        key: "n46"
                        parent: none
                        field: m.payment.cases.card.fields.holder
                        widget: Prop.Fixed(FieldWidget.Input(none))
                        label: Prop.Fixed("Card holder")
                        checks: [forms.answered()]
                      }
                      new FieldView{
                        key: "n47"
                        parent: none
                        field: m.payment.cases.card.fields.last4
                        widget: Prop.Fixed(FieldWidget.Input(none))
                        label: Prop.Fixed("Last 4 digits")
                        checks: [forms.answered(), forms.pattern(Fixed("^[0-9]{4}$"))]
                      }
                    ]
                  }
                }
              }
              wire: CaseView{
                label: Prop.Fixed("Wire")
                body: ScopedView{
                  scope: fn(sc): struct{
                    data: sc.data
                    ctx: sc.ctx
                    pay: m.payment.cases.wire.seen()
                  }
                  view: LayoutView{
                    key: "n48"
                    parent: none
                    widget: Prop.Fixed(LayoutWidget.Money)
                    label: Prop.Fixed("Deposit")
                    children: [
                      new FieldView{
                        key: "n49"
                        parent: none
                        field: m.payment.cases.wire.fields.deposit.fields.amount
                        widget: Prop.Fixed(FieldWidget.Raw)
                        label: Prop.Fixed("Amount")
                        checks: [forms.answered(), forms.min(Fixed(0.0))]
                      }
                      new FieldView{
                        key: "n50"
                        parent: none
                        field: m.payment.cases.wire.fields.deposit.fields.currency
                        widget: Prop.Fixed(FieldWidget.Choice)
                        label: Prop.Fixed("Currency")
                        checks: [forms.answered()]
                        options: Options.Items([
                          Item{value: "EUR", label: Prop.Fixed("€")}
                          Item{value: "USD", label: Prop.Fixed("$")}
                        ])
                      }
                    ]
                  }
                }
              }
              invoice: CaseView{
                label: Prop.Fixed("Invoice")
                body: ScopedView{
                  scope: fn(sc): struct{
                    data: sc.data
                    ctx: sc.ctx
                    pay: m.payment.cases.invoice.seen()
                  }
                  view: new FieldView{
                    key: "n51"
                    parent: none
                    field: m.payment.cases.invoice.fields.terms
                    widget: Prop.Fixed(FieldWidget.Input(none))
                    label: Prop.Fixed("Payment terms (days)")
                    default: Prop.Fixed(30)
                    checks: [forms.min(Fixed(7)), forms.max(Fixed(90))]
                  }
                }
              }
            }
          }
          VariantView{
            key: "n52"
            parent: none
            variant: m.delivery
            widget: Prop.Fixed(VariantWidget.Inline)
            label: Prop.Fixed("Delivery")
            default: Prop.Fixed("standard")
            cases: struct{
              standard: CaseView{
                label: Prop.Fixed("Standard")
                body: ScopedView{
                  scope: fn(sc): struct{
                    data: sc.data
                    ctx: sc.ctx
                    d: m.delivery.cases.standard.seen()
                  }
                  view: new FieldView{
                    key: "n53"
                    parent: none
                    field: m.delivery.cases.standard.fields.window
                    widget: Prop.Fixed(FieldWidget.Select(none))
                    label: Prop.Fixed("Time window")
                    checks: [forms.answered()]
                    options: Options.Items([
                      Item{value: "am", label: Prop.Fixed("Morning")}
                      Item{value: "pm", label: Prop.Fixed("Afternoon")}
                    ])
                  }
                }
              }
              express: CaseView{
                label: Prop.Fixed("Express")
                body: ScopedView{
                  scope: fn(sc): struct{
                    data: sc.data
                    ctx: sc.ctx
                    d: m.delivery.cases.express.seen()
                  }
                  view: new FieldView{
                    key: "n54"
                    parent: none
                    field: m.delivery.cases.express.fields.at
                    widget: Prop.Fixed(FieldWidget.Datepicker)
                    label: Prop.Fixed("Deliver at")
                    checks: [forms.answered()]
                  }
                }
              }
            }
          }
          new FieldView{
            key: "n55"
            parent: none
            field: m.extraForm
            widget: Prop.Fixed(FieldWidget.Select(none))
            label: Prop.Fixed("Additional questionnaire")
            checks: [forms.answered()]
            options: Options.Rows(
              from: forms.awaited(Pending.Form, async fn({data, ctx}): [
                for row in await formsCatalog.list(ctx.params.region): Choice{
                  value: row
                  label: (row.title)
                }
              ])
              resolve: forms.awaited(
                Pending.Form
                async fn({data, ctx}): (await formsCatalog.get(data.extraForm?.id ?? "")) != none
              )
            )
          }
          new DynamicView{
            key: "n56"
            parent: none
            when: Prop.Computed(fn({data, ctx}): data.extraForm != none)
            value: m.extra->node
            hide: m.extra
            label: Prop.Fixed("Questionnaire")
            schema: Prop.Computed(fn({data, ctx}): data.extraForm?.schema)
          }
        ]
      }
      LayoutView{
        key: "n57"
        parent: none
        widget: Prop.Fixed(LayoutWidget.Step(title: "Review", labels: none))
        children: [
          LayoutView{
            key: "n58"
            parent: none
            widget: Prop.Computed(
              fn({data, ctx}): LayoutWidget.Markdown(
                (`Supplier **${data.company.name ?? "?"}**, ${data.prices.length()} prices.`)
              )
            )
            children: []
          }
          new FieldView{
            key: "n59"
            parent: none
            field: none
            widget: Prop.Fixed(FieldWidget.Input(none))
            label: Prop.Fixed("Catalog value")
            value: Prop.Computed(fn({data, ctx}): logic.catalogValue(data.prices))
            checks: []
          }
          new FieldView{
            key: "n60"
            parent: none
            field: m.score
            widget: Prop.Fixed(FieldWidget.Input(none))
            label: Prop.Fixed("Risk score")
            value: Prop.Computed(
              fn({data, ctx}): logic.score(
                data.company.employees ?? 0
                data.certifications.length()
              )
            )
            checks: []
          }
          new FieldView{
            key: "n61"
            parent: none
            field: m.notes
            widget: Prop.Fixed(FieldWidget.Textarea(none))
            label: Prop.Computed(
              fn({data, ctx}): if ctx.params.tier == "gold": "Notes for your account manager"
              else: "Notes"
            )
            default: Prop.Fixed("")
            checks: [forms.required(Prop.Computed(fn({data, ctx}): (data.score ?? 0) > 70))]
          }
          new FieldView{
            key: "n62"
            parent: none
            field: m.agree
            widget: Prop.Fixed(FieldWidget.Checkbox)
            label: Prop.Fixed("I accept the terms")
            checks: [
              forms.answered()
              forms.rule(
                fn({data, ctx}): data.agree == true
                fn({data, ctx}): `Please accept the terms`
              )
            ]
          }
          LayoutView{
            key: "n63"
            parent: none
            widget: Prop.Fixed(LayoutWidget.Divider)
            children: []
          }
          LayoutView{
            key: "n64"
            parent: none
            widget: Prop.Fixed(LayoutWidget.Errors)
            checks: [
              forms.rule(
                fn({data, ctx}): data.contacts.some(fn(c): c.primary == true)
                fn({data, ctx}): `Mark one contact as primary`
              )
              forms.later(
                async fn({data, ctx}): {
                  if (data.score ?? 0) < 80 or await approvals.ask(ctx.params.owner.id, data.company.name ?? ""):
                    none
                  else: `The supplier was not approved`
                }
                fn({data, ctx}): forms.t(
                  translations
                  ctx.user.lang
                  "Waiting for approval by ${ctx.params.owner.name}"
                  `Waiting for approval by ${forms.text(ctx.params.owner.name)}`
                  [forms.text(ctx.params.owner.name)]
                )
              )
            ]
            children: []
          }
        ]
      }
    ]
  }

# ═══════════ The entry point a workflow awaits ═══════════

ista async fn supplierForm(
  params: SupplierParams
  user: User
  events: Inbox<FormEvent>
  views: Inbox<Node>
):
  const m = supplierModel()
  await forms.run(m, supplierView(m.fields), SupplierCtx{params, user}, translations, events, views)
