                  new FieldView{
                    key: `n26@${row1}`
                    parent: Prop.Fixed(ParentUi.Tablerow(240))
                    field: r1.fields.name
                    widget: Prop.Fixed(FieldWidget.Input(none))
                    label: Prop.Fixed("Product")
