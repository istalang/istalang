# The order form on the computed runtime (docs/work/done/computed/plan.md, C2): what a view shows, what
# an edit re-evaluates, and what validating a whole value gives. The live drivers wrap these steps;
# test/examples.test.ts runs them as their hosts do.

import assertEq, mock, Suite, Test, test from 'testing'
import * as approvals from './approvals'
import * as geo from './geo'
import Graph from './computed'
import Form, User, validate from './forms/form'
import Group from './forms/model'
import FieldWidget, FormEvent, Node from './forms/tree'
import openOrder, OrderModel, OrderParams from './order.gen'

@Suite{"order"}
fn orderSuite() -> Array<Test>: [
  test("shows the fields whose `when` holds", showsVisible)
  test("never runs a hidden field's expressions", hiddenNeverRuns)
  test("an edit re-evaluates only the nodes reading it", editsStayLocal)
  test("a view evaluates each node once", onceAView)
  test("a valid submit gives the data", validSubmit)
  test("a valid whole value gives its data, without hidden values", validValue)
  test("an invalid whole value gives errors by node key", invalidValue)
  test("S3: a rule's message in the user's language", localizedRule)
  test("S4: rows add up, and a note shows past a total", rowsAndConditions)
  test("S6: an approval refused blocks the submit", approvalBlocks)
  test("S7: a pattern's error", patternError)
]

const user = User:
  id: "u1"
  name: "Ann"
  lang: "en"
  role: "buyer"
  today: "2026-11-15"

fn open() -> Form<OrderModel>:
  openOrder(OrderParams{region: "eu"}, user)

fn countries(region: String) -> Array<geo.Country>: [
  geo.Country{id: "de", name: "Germany"}
  geo.Country{id: "fr", name: "France"}
]

fn cities(country: String) -> Array<geo.City>:
  if country == "de": [geo.City{id: "ber", name: "Berlin"}]
  else: []

fn approve(userId: String, totalQty: Int) -> Bool: true

fn tree(form: Form<OrderModel>) -> Node:
  form.view.drawn.read().nodes[0]

# The keys of the nodes `node` shows, depth first.
fn keys(node: Node) -> Array<String>: [for each in node.shown(): each.key()]

fn enter(self: Form<OrderModel>, key: String, json: String):
  self.apply(FormEvent.Set(key: key, value: json))

ista async fn showsVisible():
  hold _ = mock(geo.countries, countries)
  hold _ = mock(geo.cities, cities)
  const form = open()
  assertEq(keys(tree(form)), ["n1", "n2", "n4", "n8", "n9"])
  form.enter("n2", "\"de\"")
  assertEq(keys(tree(form)), ["n1", "n2", "n3", "n4", "n8", "n9"])

ista async fn hiddenNeverRuns():
  hold _ = mock(geo.countries, countries)
  const citiesCalls = mock(geo.cities, cities)
  const form = open()
  _ = tree(form)
  form.apply(FormEvent.AddRow("n4"))
  _ = tree(form) # the frontend sends events only to the keys it was shown
  form.enter("n7@r1", "50")
  _ = tree(form)
  assertEq(citiesCalls.calls().length(), 0)
  form.enter("n2", "\"de\"")
  _ = tree(form)
  assertEq(citiesCalls.calls(), [("de",)])

ista async fn editsStayLocal():
  const countriesCalls = mock(geo.countries, countries)
  const citiesCalls = mock(geo.cities, cities)
  const form = open()
  form.enter("n2", "\"de\"")
  _ = tree(form)
  const countriesBefore = countriesCalls.calls().length()
  const citiesBefore = citiesCalls.calls().length()
  form.apply(FormEvent.AddRow("n4"))
  _ = tree(form) # the frontend sends events only to the keys it was shown
  form.enter("n6@r1", "\"sku-1\"")
  form.enter("n7@r1", "3")
  _ = tree(form)
  assertEq(countriesCalls.calls().length(), countriesBefore)
  assertEq(citiesCalls.calls().length(), citiesBefore)

ista async fn onceAView():
  const countriesCalls = mock(geo.countries, countries)
  const form = open()
  _ = tree(form)
  _ = tree(form)
  assertEq(countriesCalls.calls().length(), 1) # `from` only: nothing to resolve yet, and no change

ista async fn validSubmit():
  hold _ = mock(geo.countries, countries)
  hold _ = mock(geo.cities, cities)
  hold _ = mock(approvals.ask, approve)
  const form = open()
  form.enter("n2", "\"de\"")
  form.enter("n3", "\"ber\"")
  form.apply(FormEvent.AddRow("n4"))
  _ = tree(form) # the frontend sends events only to the keys it was shown
  form.enter("n6@r1", "\"sku-1\"")
  form.enter("n7@r1", "2")
  form.enter("n9", "\"card\"")
  form.enter("n10", "\"1234\"")
  form.apply(FormEvent.Submit)
  match form.result():
    case Ok(data): {
      assertEq(data.country, "de")
      assertEq(data.items, [struct{sku: "sku-1", qty: 2}])
      assertEq(data.note, none)
    }
    case Err(problems): assertEq(problems, [:])

ista async fn validValue():
  hold _ = mock(geo.countries, countries)
  hold _ = mock(geo.cities, cities)
  hold _ = mock(approvals.ask, approve)
  match open().validate(
    struct{
      country: "de"
      city: "ber"
      items: [struct{sku: "sku-1", qty: 2}]
      payment: struct{
        tag: "card"
        value: struct{card: struct{last4: "1234"}, wire: none}
      }
      note: "a note the hidden field drops"
    }
  ):
    case Ok(data): {
      assertEq(data.city, "ber")
      assertEq(data.note, none)
    }
    case Err(problems): assertEq(problems, [:])

ista async fn invalidValue():
  hold _ = mock(geo.countries, countries)
  hold _ = mock(geo.cities, cities)
  hold _ = mock(approvals.ask, approve)
  match open().validate(Group.make<OrderModel>(new Graph{}, none).seen()):
    case Ok(...): assertEq("valid", "invalid")
    case Err(problems):
      assertEq(problems, ["n2": ["Required"], "n4": ["Minimum items is 1"], "n9": ["Required"]])

# What node `key` shows: its errors, and its widget's text rows if a textarea, from `node`'s tree.
fn errorsAt(node: Node, key: String) -> Array<String>?:
  node.shown().find(fn each: each.key() == key)?.errors()

fn fieldValue(node: Node, key: String) -> String?:
  match node.shown().find(fn each: each.key() == key):
    case Field(value: value, ...): value
    case _: none

fn noteRows(node: Node) -> Int?:
  match node.shown().find(fn each: each.key() == "n12"):
    case Field(widget: FieldWidget.Textarea(rows), ...): rows
    case _: none

fn rows(self: Form<OrderModel>, quantities: Array<Int>):
  for i in 0..quantities.length(): {
    self.apply(FormEvent.AddRow("n4"))
    _ = tree(self) # the frontend sends events only to the keys it was shown
    self.enter(`n6@r${i + 1}`, `"S${i + 1}"`)
    self.enter(`n7@r${i + 1}`, `${quantities[i]}`)
  }

ista async fn localizedRule():
  hold _ = mock(geo.countries, kpToo)
  hold _ = mock(geo.cities, cities)
  const form = openOrder(
    OrderParams{region: "eu"}
    User{...user, lang: "de"}
  )
  form.enter("n2", "\"kp\"")
  assertEq(errorsAt(tree(form), "n2"), ["Wir liefern nicht nach kp"])

fn kpToo(region: String) -> Array<geo.Country>: [
  geo.Country{id: "de", name: "Germany"}
  geo.Country{id: "kp", name: "North Korea"}
]

ista async fn rowsAndConditions():
  hold _ = mock(geo.countries, countries)
  const form = open()
  form.rows([60, 50])
  assertEq(fieldValue(tree(form), "n8"), "110")
  assertEq(noteRows(tree(form)), 3)
  form.apply(FormEvent.RemoveRow(key: "n4", row: "r2"))
  assertEq(fieldValue(tree(form), "n8"), "60")
  assertEq(keys(tree(form)).includes("n12"), false)

ista async fn approvalBlocks():
  hold _ = mock(geo.countries, countries)
  hold _ = mock(geo.cities, cities)
  const asked = mock(approvals.ask, refuse)
  const form = open()
  form.enter("n2", "\"de\"")
  form.enter("n3", "\"ber\"")
  form.rows([300, 300])
  form.enter("n12", "\"leave at the door\"")
  form.enter("n9", "\"card\"")
  form.enter("n10", "\"1234\"")
  form.apply(FormEvent.Submit)
  assertEq(errorsAt(tree(form), "n1"), ["The order was not approved"])
  assertEq(form.result() is Ok(...), false)
  assertEq(asked.calls(), [("u1", 600)])

fn refuse(userId: String, totalQty: Int) -> Bool: false

ista async fn patternError():
  hold _ = mock(geo.countries, countries)
  const form = open()
  form.enter("n9", "\"card\"")
  form.enter("n10", "\"12a4\"")
  assertEq(errorsAt(tree(form), "n10"), ["Invalid format"])
