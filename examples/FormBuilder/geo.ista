# geo.ista — external geography source for the order and supplier forms.

struct Country:
  id: String
  name: String

struct City:
  id: String
  name: String

struct Region:
  code: String
  name: String

extern fn countries(region: String) -> Future<Array<Country>>
extern fn cities(country: String) -> Future<Array<City>>
extern fn regions() -> Future<Array<Region>>
