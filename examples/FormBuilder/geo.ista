# geo.ista — external geography source for the order and supplier forms.

struct Country:
  id: String
  name: String

struct City:
  id: String
  name: String

struct Region:
  code: String
  name: String

extern live async fn countries(region: String) -> Array<Country>
extern live async fn cities(country: String) -> Array<City>
extern live async fn regions() -> Array<Region>
