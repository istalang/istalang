# geo.ista — external geography source for the order and supplier forms.

struct Country:
  id: String
  name: String

struct City:
  id: String
  name: String

struct Region:
  code: String
  name: String

extern ista fn countries(region: String) -> Future<Array<Country>, "ista">
extern ista fn cities(country: String) -> Future<Array<City>, "ista">
extern ista fn regions() -> Future<Array<Region>, "ista">
