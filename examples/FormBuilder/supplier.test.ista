# The supplier form, generated from supplier.form.json, on the computed runtime: the features its
# spec's §9 lists, each through what a view shows, what an event changes, and what validating a
# whole value gives. supplier-demo.ista runs it through the two live functions.

import Suite, Test, test, assertEq, mock, Mock from 'testing'
import FormEvent, Node, LayoutWidget, LabelStyle from './forms/tree'
import Form, User, validate from './forms/form'
import Group, FormSnapshot from './forms/model'
import * as geo from './geo'
import * as crm from './crm'
import * as approvals from './approvals'
import * as formsCatalog from './forms-catalog'
import Graph from './computed'
import SupplierModel, SupplierParams, openSupplier, supplierModel from './supplier.gen'

@Suite{"supplier"}
fn supplierSuite() -> Array<Test>: [
  test("the first view shows the steps, rows from params and localized titles", firstView)
  test("a hidden field's value is gone from what expressions see", hiddenField)
  test("a mounted def reads its params as its mount's expressions change them", mountParams)
  test("a default follows its source until the field is edited", sourceDefault)
  test("a computed bound and a localized rule follow the size", computedBound)
  test("a value kept out of the output is still checked", localValue)
  test("a search widget's options follow the typed text, and store the row", search)
  test("rows from params keep their keys, values and computed fields", defaultRows)
  test("a repeat's rows each mount the catalog form, with its own params", catalogRows)
  test("cards mount the recursive def", recursiveDef)
  test("computed rows follow their source, read-only", computedRows)
  test("an outside field writes a variant's tag", outsideTag)
  test("an inline variant starts on its default case", defaultCase)
  test("a dynamic ref mounts the form its expression yields, and takes its data", dynamicRef)
  test("the errors layout shows its rules once submitted", errorsLayout)
  test("a valid whole value gives its data, without hidden values", validValue)
  test("an empty whole value gives errors by node key", emptyValue)
  test("a whole value's rows are made from it, keyed as the browser keys them", loadedRows)
  test("a repeat's checks count its rows, whatever the rows hold", repeatCounts)
]

const user = User{id: "u1", name: "Ann", lang: "de", role: "buyer", today: "2026-11-15"}

fn open() -> Form<SupplierModel>:
  openSupplier(
    SupplierParams{
      region: "eu"
      tier: "gold"
      products: [struct{sku: "p1", name: "Widget"}, struct{sku: "p2", name: "Gadget"}]
      owner: crm.User{id: "o1", name: "Olga"}
    }
    user
  )

# ── the sources, mocked ──

fn countries(region: String) -> Array<geo.Country>: [
  geo.Country{id: "de", name: "Germany"}
  geo.Country{id: "nl", name: "Netherlands"}
]
fn cities(country: String) -> Array<geo.City>: [geo.City{id: "ber", name: "Berlin"}]
fn regions() -> Array<geo.Region>: [geo.Region{code: "eu", name: "Europe"}]
fn users(search: String) -> Array<crm.User>:
  [crm.User{id: "u7", name: "Anna"}, crm.User{id: "u8", name: "Ben"}].filter(
    fn(u): u.name.includes(search)
  )
fn userById(id: String) -> crm.User?: users("").filter(fn(u): u.id == id).at(0)
fn creditLimit(vatId: String) -> Int?:
  if vatId == "DE123456": 5000
  else: none
fn orders(vatId: String) -> Array<crm.Order>:
  if vatId == "DE123456": [struct{note: "first"}, struct{note: none}]
  else: []
fn entries(region: String) -> Array<formsCatalog.Entry>: [questionnaire]
fn entryById(id: String) -> formsCatalog.Entry?:
  if id == questionnaire.id: questionnaire
  else: none
fn approve(ownerId: String, companyName: String) -> Bool: true

const questionnaire = formsCatalog.Entry{
  id: "q1"
  title: "Questionnaire"
  schema: FormSnapshot{id: "q1", version: "1.0.0", module: "q1.gen"}
}

# Every source mocked, for as long as it is held.
struct Sources:
  countries: Mock<fn(String) -> Array<geo.Country>>
  cities: Mock<fn(String) -> Array<geo.City>>
  regions: Mock<fn() -> Array<geo.Region>>
  users: Mock<fn(String) -> Array<crm.User>>
  user: Mock<fn(String) -> crm.User?>
  creditLimit: Mock<fn(String) -> Int?>
  orders: Mock<fn(String) -> Array<crm.Order>>
  list: Mock<fn(String) -> Array<formsCatalog.Entry>>
  get: Mock<fn(String) -> formsCatalog.Entry?>
  ask: Mock<fn(String, String) -> Bool>

fn mocked() -> Sources: Sources{
  countries: mock(geo.countries, countries)
  cities: mock(geo.cities, cities)
  regions: mock(geo.regions, regions)
  users: mock(crm.users, users)
  user: mock(crm.user, userById)
  creditLimit: mock(crm.creditLimit, creditLimit)
  orders: mock(crm.orders, orders)
  list: mock(formsCatalog.list, entries)
  get: mock(formsCatalog.get, entryById)
  ask: mock(approvals.ask, approve)
}

# ── reading the tree ──

fn tree(form: Form<SupplierModel>) -> Node: form.view.drawn.read().nodes[0]

fn keys(form: Form<SupplierModel>) -> Array<String>: [for each in tree(form).shown(): each.key()]

fn at(form: Form<SupplierModel>, key: String) -> Node?:
  tree(form).shown().find(fn(each): each.key() == key)

fn shows(form: Form<SupplierModel>, key: String) -> Bool: at(form, key) != none

# A field's value, JSON-encoded, as the frontend gets it.
fn value(form: Form<SupplierModel>, key: String) -> String?:
  match at(form, key):
    case Field(value: v, ...): v
    case _: none

fn errors(form: Form<SupplierModel>, key: String) -> Array<String>: at(form, key)?.errors() ?? []

fn rowKeys(form: Form<SupplierModel>, key: String) -> Array<String>:
  match at(form, key):
    case Repeat(rows: rows, ...): [for row in rows: row.key]
    case _: []

fn enter(self: Form<SupplierModel>, key: String, json: String):
  _ = tree(self) # the frontend sends events only to the keys it was shown
  self.apply(FormEvent.Set(key: key, value: json))

fn add(self: Form<SupplierModel>, key: String):
  _ = tree(self)
  self.apply(FormEvent.AddRow(key))

# ── the features ──

ista async fn firstView():
  hold _ = mocked()
  const form = open()
  const shown = keys(form)
  for key in ["n1", "n2", "n13", "n22", "n23", "n42", "n57"]:
    assertEq((key, shown.includes(key)), (key, true))
  for key in ["n18/n1", "n19", "n56"]: assertEq((key, shown.includes(key)), (key, false))
  assertEq(rowKeys(form, "n23"), ["p1", "p2"])
  match at(form, "n3"):
    case Layout(widget: widget, ...):
      assertEq(widget, LayoutWidget.Markdown("Welcome, **Ann**. Tier: gold."))
    case _: assertEq("markdown", "missing")
  match at(form, "n2"):
    case Layout(widget: widget, ...):
      assertEq(widget, LayoutWidget.Step(title: "Unternehmen", labels: LabelStyle.Start))
    case _: assertEq("step", "missing")

ista async fn hiddenField():
  hold _ = mocked()
  const form = open()
  form.enter("n13", "1000")
  assertEq(form.model.fields.company.seen().capital, 1000.0)
  form.enter("n12", "\"sole\"")
  assertEq(shows(form, "n13"), false)
  assertEq(form.model.fields.company.seen().capital, none)

ista async fn mountParams():
  hold _ = mocked()
  const form = open()
  form.enter("n17", "\"de\"")
  assertEq(shows(form, "n18/n1"), true)
  form.enter("n18/n4", "\"12345\"")
  assertEq(errors(form, "n18/n4"), [])
  form.enter("n17", "\"nl\"")
  assertEq(errors(form, "n18/n4"), ["Invalid format"])

ista async fn sourceDefault():
  hold _ = mocked()
  const form = open()
  assertEq(value(form, "n21"), "0")
  form.enter("n7", "\"bad\"")
  assertEq(errors(form, "n7"), ["Invalid format"])
  form.enter("n7", "\"DE123456\"")
  assertEq(errors(form, "n7"), [])
  assertEq(value(form, "n21"), "5000")
  form.enter("n21", "7000")
  form.enter("n7", "\"DE999999\"")
  assertEq(value(form, "n21"), "7000")

ista async fn computedBound():
  hold _ = mocked()
  const form = open()
  form.enter("n14", "60")
  assertEq(value(form, "n60"), "40")
  assertEq(form.model.fields.score.seen(), 40)
  assertEq(errors(form, "n14"), [
    "Too large"
    "Nur 60 Mitarbeitende für ein Unternehmen der Größe small erlaubt"
  ])
  form.enter("n11", "\"medium\"")
  assertEq(errors(form, "n14"), [])

ista async fn localValue():
  hold _ = mocked()
  const form = open()
  form.enter("n8", "\"a@b.de\"")
  form.enter("n9", "\"a@b.com\"")
  assertEq(errors(form, "n9"), ["The emails differ"])
  form.enter("n9", "\"a@b.de\"")
  assertEq(errors(form, "n9"), [])

ista async fn search():
  const sources = mocked()
  const form = open()
  _ = tree(form)
  form.apply(FormEvent.Search(key: "n20", text: "Be"))
  match at(form, "n20"):
    case Field(options: options, ...): assertEq([for o in options: o.label], ["Ben"])
    case _: assertEq("manager", "missing")
  form.enter("n20", `{"id":"u8","name":"Ben"}`)
  assertEq(form.model.fields.manager.seen(), crm.User{id: "u8", name: "Ben"})
  assertEq(errors(form, "n20"), [])
  assertEq(sources.users.calls().includes(("Be",)), true)

ista async fn defaultRows():
  hold _ = mocked()
  const form = open()
  assertEq(value(form, "n25@p1"), "\"p1\"")
  assertEq(value(form, "n26@p2"), "\"Gadget\"")
  form.enter("n27@p1", "9.5")
  form.add("n28@p1")
  form.enter("n29@p1@r1", "\"eu\"")
  const prices = form.model.fields.prices.seen()
  assertEq(prices[0].amount, 9.5)
  assertEq(prices[0].regions, ["eu"])
  assertEq(value(form, "n59"), "9.5")
  match at(form, "n23"):
    case Repeat(canAdd: canAdd, ...): assertEq(canAdd, false)
    case _: assertEq("prices", "missing")

ista async fn catalogRows():
  hold _ = mocked()
  const form = open()
  form.add("n30")
  assertEq(rowKeys(form, "n30"), ["r1"])
  form.enter("n35@r1/n2", "\"+49 30 1234\"")
  form.enter("n32@r1", "\"Ada\"")
  assertEq(form.model.fields.contacts.seen()[0].card.phone, "+49 30 1234")
  assertEq(form.model.fields.contacts.seen()[0].name, "Ada")

ista async fn recursiveDef():
  hold _ = mocked()
  const form = open()
  form.add("n38")
  form.add("n39@r1/n3")
  form.enter("n39@r1/n4@r1/n2", "\"Bolts\"")
  assertEq(form.model.fields.categories.seen()[0].children[0].name, "Bolts")

ista async fn computedRows():
  hold _ = mocked()
  const form = open()
  assertEq(rowKeys(form, "n40"), [])
  form.enter("n7", "\"DE123456\"")
  assertEq(rowKeys(form, "n40"), ["c1", "c2"])
  assertEq(value(form, "n41@c1"), "\"first\"")
  assertEq(value(form, "n41@c2"), "\"\"")

ista async fn outsideTag():
  hold _ = mocked()
  const form = open()
  assertEq(shows(form, "n48"), false)
  form.enter("n43", "\"wire\"")
  assertEq(shows(form, "n48"), true)
  form.enter("n49", "100")
  assertEq(form.model.fields.payment.seen().value.wire?.deposit.amount, 100.0)

ista async fn defaultCase():
  hold _ = mocked()
  const form = open()
  match at(form, "n52"):
    case Variant(active: active, ...): assertEq(active, "standard")
    case _: assertEq("delivery", "missing")
  assertEq(shows(form, "n53"), true)

ista async fn dynamicRef():
  hold _ = mocked()
  const form = open()
  assertEq(shows(form, "n56"), false)
  form.enter(
    "n55"
    `{"id":"q1","title":"Questionnaire","schema":{"id":"q1","version":"1.0.0","module":"q1.gen"}}`
  )
  match at(form, "n56"):
    case Mount(form: snapshot, ...): assertEq(snapshot, questionnaire.schema)
    case _: assertEq("questionnaire", "missing")
  form.apply(FormEvent.Submit)
  assertEq(errors(form, "n56"), ["Required"])
  form.enter("n56", `{"answer":"yes"}`)
  assertEq(errors(form, "n56"), [])
  assertEq(form.model.fields.extra.seen(), `{"answer":"yes"}`)

ista async fn errorsLayout():
  hold _ = mocked()
  const form = open()
  assertEq(errors(form, "n64"), [])
  form.apply(FormEvent.Submit)
  assertEq(errors(form, "n64"), ["Mark one contact as primary"])

ista async fn validValue():
  hold _ = mocked()
  match open().validate(complete()):
    case Ok(data): {
      assertEq(data.company.capital, none) # sole trader: hidden
      assertEq(data.company.address?.zip, "10115")
      assertEq([for p in data.prices: p.sku], ["p1", "p2"])
      assertEq(data.prices[1].amount, 2.0)
      assertEq(data.contacts[0].card.phone, "+49 30 1234")
    }
    case Err(problems): assertEq(problems, [:])

ista async fn loadedRows():
  hold _ = mocked()
  const value = complete()
  const unpriced = struct{
    ...value
    prices: [struct{sku: "p1", name: "Widget", amount: none, regions: ["eu"]}, value.prices[1]]
  }
  match open().validate(unpriced):
    case Ok(...): assertEq("valid", "invalid")
    case Err(problems): assertEq(problems, ["n27@p1": ["Required"]])

ista async fn repeatCounts():
  hold _ = mocked()
  const form = open()
  form.add("n28@p1")
  form.add("n30")
  form.apply(FormEvent.Submit)
  assertEq(errors(form, "n28@p1"), []) # one region, not yet chosen
  assertEq(errors(form, "n29@p1@r1"), ["Required"])
  assertEq(errors(form, "n30"), []) # one contact, not yet filled in
  assertEq(errors(form, "n32@r1"), ["Required"])

ista async fn emptyValue():
  hold _ = mocked()
  match open().validate(supplierModel(new Graph{}).seen()):
    case Ok(...): assertEq("valid", "invalid")
    case Err(problems): {
      assertEq(problems["n6"], ["Required"])
      assertEq(problems["n30"], ["Minimum items is 1"])
      assertEq(problems["n64"], ["Mark one contact as primary"])
    }

# A whole valid value: a sole trader, so the capital it holds is dropped.
fn complete() -> Group<SupplierModel>.Seen: struct{
  company: struct{
    name: "ACME"
    vatId: "DE123456"
    email: "a@b.de"
    description: "Bolts"
    size: "small"
    legalForm: "sole"
    capital: 5000.0
    employees: 5
    founded: "2001-01-01"
    logo: "logo-1"
    country: "de"
    address: struct{street: "Main 1", zip: "10115", city: "Berlin"}
    city: "ber"
  }
  confirmEmail: "a@b.de"
  manager: crm.User{id: "u7", name: "Anna"}
  creditLimit: 5000
  prices: [
    struct{sku: "p1", name: "Widget", amount: 1.0, regions: ["eu"]}
    struct{sku: "p2", name: "Gadget", amount: 2.0, regions: ["eu"]}
  ]
  contacts: [
    struct{name: "Ada", email: "ada@b.de", primary: true, card: struct{phone: "+49 30 1234"}}
  ]
  certifications: ["iso9001"]
  categories: []
  history: [struct{note: "first"}, struct{note: none}]
  payment: struct{
    tag: "card"
    value: struct{card: struct{holder: "Ann", last4: "1234"}, wire: none, invoice: none}
  }
  delivery: struct{tag: "standard", value: struct{standard: struct{window: "am"}, express: none}}
  extraForm: questionnaire
  extra: `{"answer":"yes"}`
  score: none
  notes: ""
  agree: true
}
