                            },
                            new FieldView<OrderScope1, Int>{
                                key: `n7@${row1}`,
                                parent: Prop.Fixed{ParentUi.Tablerow{width: 80}},
                                field: r1.fields.qty,
                                widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
                                label: Prop.Fixed{"Qty"},
                                checks: [
