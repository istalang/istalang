                                field: r1.fields.sku,
                                widget: Prop.Fixed{FieldWidget.Input{placeholder: none}},
                                label: Prop.Fixed{"SKU"},
                                checks: [
                                    forms.answered(),
                                    forms.required(Prop.Fixed{true}),
